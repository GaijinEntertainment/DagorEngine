shader omm_compress_cs
{
  OMM_GLOBAL_CONSTANTS(cs)
  (cs) {
    g_LocalConstants@cbuf = omm_local_constants hlsl {
      #define OMM_DAGOR_DECLARE_CBUFFER_TYPES
      #include "omm_dagor_bindings.hlsli"
      #include <omm_compress.cs.resources.hlsli>
      OMM_DECLARE_LOCAL_CONSTANT_BUFFER
      ConstantBuffer<LocalConstants> g_LocalConstants@cbuf;
      #undef OMM_DAGOR_DECLARE_CBUFFER_TYPES
    };
    t_heap0@buf = omm_t_heap0 hlsl {
      ByteAddressBuffer t_heap0@buf;
    };
    u_vmArrayBuffer@uav = omm_u_vmArrayBuffer hlsl {
      RWByteAddressBuffer u_vmArrayBuffer@uav;
    };
    u_heap1@uav = omm_u_heap1 hlsl {
      RWByteAddressBuffer u_heap1@uav;
    };
  }
  hlsl(cs) {
    #include "omm_dagor_bindings.hlsli"
    #include <omm_compress.cs.hlsl>
  }
  compile("target_cs", "main");
}

