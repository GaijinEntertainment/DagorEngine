macro OMM_RASTERIZE_BINDINGS(code)
  (code) {
    g_LocalConstants@cbuf = omm_local_constants hlsl {
      #define OMM_DAGOR_DECLARE_CBUFFER_TYPES
      #include "omm_dagor_bindings.hlsli"
      #include <omm_rasterize.cs.resources.hlsli>
      OMM_DECLARE_LOCAL_CONSTANT_BUFFER
      ConstantBuffer<LocalConstants> g_LocalConstants@cbuf;
      #undef OMM_DAGOR_DECLARE_CBUFFER_TYPES
    };
    // Deliberately not t_alphaTexture: the SDK must read the alpha only through the hook macros, thus a
    // direct read fails to compile in place of skipping the cutout without a message.
    omm_alpha_tex@tex = omm_t_alphaTexture hlsl {
      Texture2D<float4> omm_alpha_tex@tex;
    };
    omm_uv_cutout_lines@f4 = omm_uv_cutout_lines;
    omm_uv_cutout_enabled@i1 = omm_uv_cutout_enabled;
    t_indexBuffer@buf = omm_t_indexBuffer hlsl {
      ByteAddressBuffer t_indexBuffer@buf;
    };
    t_texCoordBuffer@buf = omm_t_texCoordBuffer hlsl {
      ByteAddressBuffer t_texCoordBuffer@buf;
    };
    t_heap0@buf = omm_t_heap0 hlsl {
      ByteAddressBuffer t_heap0@buf;
    };
    t_heap1@buf = omm_t_heap1 hlsl {
      ByteAddressBuffer t_heap1@buf;
    };
    u_heap0@uav = omm_u_heap0 hlsl {
      RWByteAddressBuffer u_heap0@uav;
    };
    u_vmArrayBuffer@uav = omm_u_vmArrayBuffer hlsl {
      RWByteAddressBuffer u_vmArrayBuffer@uav;
    };
  }
endmacro

shader omm_rasterize_cs_r_cs
{
  OMM_GLOBAL_CONSTANTS(cs)
  OMM_RASTERIZE_BINDINGS(cs)
  hlsl(cs) {
    #include "omm_dagor_bindings.hlsli"
    #include "omm_uv_cutout.hlsli"
    #define IN_ALPHA_TEXTURE_CHANNEL 0
    #include <omm_rasterize_cs.hlsli>
    #undef IN_ALPHA_TEXTURE_CHANNEL
  }
  compile("target_cs", "main");
}

