buffer omm_t_indexBuffer;
buffer omm_t_texCoordBuffer;
buffer omm_t_heap0;
buffer omm_t_heap1;
buffer omm_t_ommDescArrayBuffer;
buffer omm_t_ommIndexBuffer;
buffer omm_u_heap0_read;

buffer omm_u_targetBuffer;
buffer omm_u_heap0;
buffer omm_u_heap1;
buffer omm_u_buffer0;
buffer omm_u_ommDescArrayBuffer;
buffer omm_u_ommDescArrayHistogramBuffer;
buffer omm_u_ommIndexHistogramBuffer;
buffer omm_u_ommIndexBuffer;
buffer omm_u_vmArrayBuffer;
buffer omm_u_postBuildInfo;

const_buffer omm_global_constants;
const_buffer omm_local_constants;

sampler omm_sampler0;

float4 omm_uv_cutout_lines = float4(0, 0, 0, 1);
int omm_uv_cutout_enabled = 0;

macro OMM_GLOBAL_CONSTANTS(code)
  (code) {
    g_GlobalConstants@cbuf = omm_global_constants hlsl {
      #define OMM_DAGOR_DECLARE_CBUFFER_TYPES
      #include "omm_dagor_bindings.hlsli"
      #include <omm_global_cb.hlsli>
      OMM_DECLARE_GLOBAL_CONSTANT_BUFFER
      ConstantBuffer<GlobalConstants> g_GlobalConstants@cbuf;
      #undef OMM_DAGOR_DECLARE_CBUFFER_TYPES
    };
    s_sampler0@sampler = omm_sampler0;
  }
endmacro

shader omm_clear_buffer_cs
{
  (cs) {
    g_LocalConstants@cbuf = omm_local_constants hlsl {
      #define OMM_DAGOR_DECLARE_CBUFFER_TYPES
      #include "omm_dagor_bindings.hlsli"
      #include <omm_clear_buffer.cs.resources.hlsli>
      OMM_DECLARE_LOCAL_CONSTANT_BUFFER
      ConstantBuffer<LocalConstants> g_LocalConstants@cbuf;
      #undef OMM_DAGOR_DECLARE_CBUFFER_TYPES
    };
    u_targetBuffer@uav = omm_u_targetBuffer hlsl {
      RWByteAddressBuffer u_targetBuffer@uav;
    };
  }
  hlsl(cs) {
    #include "omm_dagor_bindings.hlsli"
    #include <omm_clear_buffer.cs.hlsl>
  }
  compile("target_cs", "main");
}

shader omm_init_buffers_cs_cs
{
  OMM_GLOBAL_CONSTANTS(cs)
  (cs) {
    u_heap0@uav = omm_u_heap0 hlsl {
      RWByteAddressBuffer u_heap0@uav;
    };
    u_ommDescArrayHistogramBuffer@uav = omm_u_ommDescArrayHistogramBuffer hlsl {
      RWByteAddressBuffer u_ommDescArrayHistogramBuffer@uav;
    };
    u_ommIndexHistogramBuffer@uav = omm_u_ommIndexHistogramBuffer hlsl {
      RWByteAddressBuffer u_ommIndexHistogramBuffer@uav;
    };
  }
  hlsl(cs) {
    #include "omm_dagor_bindings.hlsli"
    #include <omm_init_buffers_cs.cs.hlsl>
  }
  compile("target_cs", "main");
}

