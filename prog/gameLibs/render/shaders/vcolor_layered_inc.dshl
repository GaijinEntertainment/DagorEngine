include "layered_inc.dshl"
include_optional "hmap_blend_use_inc.dshl"
include "translucent_inc.dshl"
include "sheen_common_inc.dshl"

define_macro_if_not_defined USE_HMAP_BLEND(pass_to_frame)
endmacro

macro VCOLOR_LAYERED_WEIGHT_BLENDING(stage)
hlsl(stage)
{
  half3 init_blend_weights(float3 vcolMask, float2 by_normal_params)
  {
    half3 weights = vcolMask;
    half weightsDot = vcolMask.x + vcolMask.y;
    weights.yz = vcolMask.xy * (weightsDot > 1 ? rcp(weightsDot) : 1);
    weights.x = saturate(1 - weightsDot);
    weights.y = lerp(weights.y, by_normal_params.x, by_normal_params.y);
    return weights;
  }
}
WEIGHT_BLENDING(stage)
endmacro

macro INIT_VCOLOR_LAYERED(always_use_normal_details)

  INIT_LAYERED(always_use_normal_details)

  static float4 invert_heights = (0, 0, 0, 0);
  static float4 paint_details = (0, 0, 0, 0);
  static int palette_index = 1;
  static float4 details_tile = (1, 1, 1, 0);
  static int atest = 0;
  interval atest: atestOff < 1, atestOn;
  static float4 overlay_color_from = (0.5, 0.5, 0.5, 0.5);
  static float4 overlay_color_to = (0.5, 0.5, 0.5, 0.5);

  if (shader == rendinst_cliff)
  {
    static int triplanar = 0 no_warnings;
    interval triplanar : triplanar_off < 1, triplanar_on;
    static float triplanar_scale = 6 no_warnings;
    static float triplanar_sharpness = 0.69 no_warnings;
    if (triplanar == triplanar_on)
    {
      hlsl {
        #define RI_TRIPLANAR 1
        #include "triplanar.hlsl"
      }
      (ps) {
        triplanar_scale_mul@f1 = 1 / triplanar_scale;
        triplanar_sharpness@f1 = triplanar_sharpness;
      }
    }
  }

  if (atest == atestOn)
  {
    static float4 details_alphatest = (0, 0, 0, 0);
  }

  if (shader == rendinst_cliff)
  {
    texture leaks_tex = material.texture[7];

    static float4 mask_by_normal = (0, 1, 0, 0);
    static float4 overlay_strenght = (0, 0, 0, 0);
    static float4 normal_overlay_color_from = (0, 0, 0, 0);
    static float4 normal_overlay_color_to = (0, 0, 0, 0);
    static float4 overlay_by_normal = (0, 1, 0, 0);
    static float4 gradient_overlay_color_from = (0.5, 0.5, 0.5, 1);
    static float4 gradient_overlay_color_to = (0.5, 0.5, 0.5, 1);
    static float4 gradient_overlay_vector = (0, 1, 0, 0);
    static float leaks_treshhold = (0);
    static float leaks_tex_size = (1);
    static float leaks_noise_size = (1);
    static float leaks_normal_strength = (0);
    static float leaks_removal_by_overlay_normal = (0);
    static float leaks_noise_strength = (4);
    (ps) {
      mask_by_normal@f4 = mask_by_normal;
      overlay_strenght@f4 = overlay_strenght;
      normal_overlay_color_from@f4 = normal_overlay_color_from;
      normal_overlay_color_to@f4 = normal_overlay_color_to;
      overlay_by_normal@f4 = overlay_by_normal;
      gradient_overlay_color_from@f4 = gradient_overlay_color_from;
      gradient_overlay_color_to@f4 = gradient_overlay_color_to;
      gradient_overlay_vector@f4 = gradient_overlay_vector;
      leaks_treshhold_size_noise_strength@f4 = float4(leaks_treshhold,leaks_tex_size,leaks_noise_size,leaks_normal_strength);
      leaks_removal_normal_noise_strength@f4 = float4(leaks_removal_by_overlay_normal,leaks_noise_strength,0,0);
    }
  }

  (vs) { paint_palette_row_index@f2 = (paint_details.w,palette_index,0,0); }

  (ps) {
    invert_heights@f4 = invert_heights;
    details_tile@f4 = details_tile;
    overlay_color_from@f4 = overlay_color_from;
    overlay_color_to@f4 = overlay_color_to;
    paint_details@f3 = paint_details;
  }
  if (atest == atestOn)
  {
    (ps) { details_alphatest@f4 = details_alphatest; }
  }
endmacro

macro USE_VCOLOR_LAYERED(stage)
  VCOLOR_LAYERED_WEIGHT_BLENDING(stage)
endmacro

macro USE_VCOLOR_LAYERED_TRIPLANAR_DISPLACEMENT()
  (vs) {
    triplanar_scale_mul@f1 = 1 / triplanar_scale;
    triplanar_sharpness@f1 = triplanar_sharpness;
  }
  hlsl(ds) {
    half3 sample_detail_heights_lod(float2 uv, float3 lod)
    {
      float3 tile = get_details_tile().xyz;
      half3 heights;
      heights.x = tex2DLodBindless(get_diffuse_tex(), float4(uv * tile.x, 0, lod.x)).a;
      heights.y = tex2DLodBindlessSampler(get_diffuse_tex1(), get_diffuse_tex().smp, float4(uv * tile.y, 0, lod.y)).a;
      heights.z = tex2DLodBindlessSampler(get_diffuse_tex2(), get_diffuse_tex().smp, float4(uv * tile.z, 0, lod.z)).a;
      return heights;
    }

    half3 triplanar_detail_heights(TriplanarCoords coords, float3 lod)
    {
      half3 heights = 0;
      TriplanarOrder sorted = sort_triplanar_axes(coords.weights);
      PlanarProjection proj = get_planar_projection(coords, sorted.axis.x, sorted.weight.x);
      heights += sample_detail_heights_lod(proj.uv, lod) * proj.weight;
      BRANCH
      if (sorted.weight.y > 0)
      {
        proj = get_planar_projection(coords, sorted.axis.y, sorted.weight.y);
        heights += sample_detail_heights_lod(proj.uv, lod) * proj.weight;
        BRANCH
        if (sorted.weight.z > 0)
        {
          proj = get_planar_projection(coords, sorted.axis.z, sorted.weight.z);
          heights += sample_detail_heights_lod(proj.uv, lod) * proj.weight;
        }
      }
      return heights;
    }
  }
endmacro

// If use_translucency is set to true, translucent_inc.dshl:INIT_TRANSLUCENCY_SETTING(ps) should be called before
macro VCOLOR_LAYERED_PS_IMPL(is_writing_gbuffer, is_blending_hmap, use_translucency, use_sheen, has_char_microdetail_sampler, order)
  USE_LAYERED_PS()
  USE_PIXEL_TANGENT_SPACE()
  if (is_writing_gbuffer)
  {
    WRITE_GBUFFER()
    INIT_AND_USE_DBG_GBUFF_TEX()
    if (use_sheen)
    {
      USE_SHEEN_COMMON()
    }
  }

  if (compatibility_mode == compatibility_mode_off)
  {
    USE_CHARACTER_MICRODETAIL_IMPL(has_char_microdetail_sampler, true)
  }

  if (is_writing_gbuffer && is_blending_hmap)
  {
    USE_HMAP_BLEND(true)
  }
  if (shader == rendinst_cliff)
  {
    if (leaks_tex != NULL)
    {
      (ps){leaks_tex@staticSmp = leaks_tex;}
    }
  }

  hlsl(ps) {
    #ifndef SAMPLE_TEX
      #define SAMPLE_TEX(tex, tc) tex2DBindless(tex, tc)
    #endif
    #ifndef SAMPLE_TEX_SAMPLER
      #define SAMPLE_TEX_SAMPLER(tex, smp, tc) tex2DBindlessSampler(tex, smp, tc)
    #endif

    #if RI_TRIPLANAR
      #ifndef SAMPLE_TEX_GRAD
        #define SAMPLE_TEX_GRAD(tex, tc, dx, dy) tex2DgradBindless(tex, tc, dx, dy)
      #endif
      #ifndef SAMPLE_TEX_SAMPLER_GRAD
        #define SAMPLE_TEX_SAMPLER_GRAD(tex, smp, tc, dx, dy) tex2DgradBindlessSampler(tex, smp, tc, dx, dy)
      #endif
      #ifndef SAMPLE_TEX_LOD
        #define SAMPLE_TEX_LOD(tex, tc, lod) tex2DLodBindless(tex, float4(tc, 0, lod))
      #endif
      #ifndef SAMPLE_TEX_SAMPLER_LOD
        #define SAMPLE_TEX_SAMPLER_LOD(tex, smp, tc, lod) tex2DLodBindlessSampler(tex, smp, float4(tc, 0, lod))
      #endif

      float detail_tex_lod(Texture2D tex, float tile, float lod_base)
      {
        float2 texSize;
        tex.GetDimensions(texSize.x, texSize.y);
        return lod_base + log2(tile * max(texSize.x, texSize.y));
      }

      void sample_detail_diffuse_proj(PlanarProjection proj, bool use_grad, out half4 diffuse0, out half4 diffuse1, out half4 diffuse2)
      {
        float3 tile = get_details_tile().xyz;
        // Grad is not cheap, but its necessary for sharp visual, but it is not noticable on non-dominant layers
        if (use_grad)
        {
          diffuse0 = SAMPLE_TEX_GRAD(get_diffuse_tex(), proj.uv * tile.x, proj.dx * tile.x, proj.dy * tile.x);
          diffuse1 = SAMPLE_TEX_SAMPLER_GRAD(get_diffuse_tex1(), get_diffuse_tex().smp, proj.uv * tile.y, proj.dx * tile.y, proj.dy * tile.y);
          diffuse2 = SAMPLE_TEX_SAMPLER_GRAD(get_diffuse_tex2(), get_diffuse_tex().smp, proj.uv * tile.z, proj.dx * tile.z, proj.dy * tile.z);
          return;
        }
        diffuse0 = SAMPLE_TEX_LOD(get_diffuse_tex(), proj.uv * tile.x, detail_tex_lod(get_diffuse_tex().tex, tile.x, proj.lod));
        diffuse1 = SAMPLE_TEX_SAMPLER_LOD(get_diffuse_tex1(), get_diffuse_tex().smp, proj.uv * tile.y, detail_tex_lod(get_diffuse_tex1(), tile.y, proj.lod));
        diffuse2 = SAMPLE_TEX_SAMPLER_LOD(get_diffuse_tex2(), get_diffuse_tex().smp, proj.uv * tile.z, detail_tex_lod(get_diffuse_tex2(), tile.z, proj.lod));
      }

      void add_detail_diffuse(PlanarProjection proj, bool use_grad, inout half4 diffuse0, inout half4 diffuse1, inout half4 diffuse2)
      {
        half4 d0, d1, d2;
        sample_detail_diffuse_proj(proj, use_grad, d0, d1, d2);
        diffuse0 += d0 * proj.weight;
        diffuse1 += d1 * proj.weight;
        diffuse2 += d2 * proj.weight;
      }

      void triplanar_detail_diffuse(TriplanarCoords coords, TriplanarOrder sorted, out half4 diffuse0, out half4 diffuse1, out half4 diffuse2)
      {
        diffuse0 = diffuse1 = diffuse2 = 0;
        add_detail_diffuse(get_planar_projection(coords, sorted.axis.x, sorted.weight.x), true, diffuse0, diffuse1, diffuse2);
        BRANCH
        if (sorted.weight.y > 0)
        {
          add_detail_diffuse(get_planar_projection(coords, sorted.axis.y, sorted.weight.y), false, diffuse0, diffuse1, diffuse2);
          BRANCH
          if (sorted.weight.z > 0)
            add_detail_diffuse(get_planar_projection(coords, sorted.axis.z, sorted.weight.z), false, diffuse0, diffuse1, diffuse2);
        }
      }

    #else
      void sample_detail_diffuse(float2 tc, out half4 diffuse0, out half4 diffuse1, out half4 diffuse2)
      {
        diffuse0 = SAMPLE_TEX(get_diffuse_tex(), tc * get_details_tile().x);
        diffuse1 = SAMPLE_TEX_SAMPLER(get_diffuse_tex1(), get_diffuse_tex().smp, tc * get_details_tile().y);
        diffuse2 = SAMPLE_TEX_SAMPLER(get_diffuse_tex2(), get_diffuse_tex().smp, tc * get_details_tile().z);
      }
    #endif


    ##if use_normal_details
      #if RI_TRIPLANAR
        void sample_detail_normals_proj(PlanarProjection proj, bool use_grad, out half4 packed0, out half4 packed1, out half4 packed2)
        {
          float3 tile = get_details_tile().xyz;
          // Grad is not cheap, but its necessary for sharp visual, but it is not noticable on non-dominant layers
          if (use_grad)
          {
            packed0 = SAMPLE_TEX_GRAD(get_normal_tex(), proj.uv * tile.x, proj.dx * tile.x, proj.dy * tile.x);
            packed1 = SAMPLE_TEX_SAMPLER_GRAD(get_normal_tex1(), get_normal_tex().smp, proj.uv * tile.y, proj.dx * tile.y, proj.dy * tile.y);
            packed2 = SAMPLE_TEX_SAMPLER_GRAD(get_normal_tex2(), get_normal_tex().smp, proj.uv * tile.z, proj.dx * tile.z, proj.dy * tile.z);
            return;
          }
          packed0 = SAMPLE_TEX_LOD(get_normal_tex(), proj.uv * tile.x, detail_tex_lod(get_normal_tex().tex, tile.x, proj.lod));
          packed1 = SAMPLE_TEX_SAMPLER_LOD(get_normal_tex1(), get_normal_tex().smp, proj.uv * tile.y, detail_tex_lod(get_normal_tex1(), tile.y, proj.lod));
          packed2 = SAMPLE_TEX_SAMPLER_LOD(get_normal_tex2(), get_normal_tex().smp, proj.uv * tile.z, detail_tex_lod(get_normal_tex2(), tile.z, proj.lod));
        }

        void add_detail_normals(PlanarProjection proj, bool use_grad, half3 layer_weights, half3 N, inout half4 packed_normal, inout half3 normal_sum)
        {
          half4 packed0, packed1, packed2;
          sample_detail_normals_proj(proj, use_grad, packed0, packed1, packed2);
          half4 packedValues = packed0 * layer_weights.x + packed1 * layer_weights.y + packed2 * layer_weights.z;
          packed_normal += packedValues * proj.weight;
          half3 localNorm = unpack_ag_normal(packedValues);
          normal_sum += (localNorm.z * N + localNorm.x * proj.tangent + localNorm.y * proj.bitangent) * proj.weight;
        }

        void triplanar_detail_normals(TriplanarCoords coords, TriplanarOrder sorted, half3 layer_weights, half3 N, out half4 packed_normal, out half3 world_normal)
        {
          packed_normal = 0;
          half3 normalSum = 0;
          add_detail_normals(get_planar_projection(coords, sorted.axis.x, sorted.weight.x), true, layer_weights, N, packed_normal, normalSum);
          BRANCH
          if (sorted.weight.y > 0)
          {
            add_detail_normals(get_planar_projection(coords, sorted.axis.y, sorted.weight.y), false, layer_weights, N, packed_normal, normalSum);
            BRANCH
            if (sorted.weight.z > 0)
              add_detail_normals(get_planar_projection(coords, sorted.axis.z, sorted.weight.z), false, layer_weights, N, packed_normal, normalSum);
          }
          world_normal = normalize(normalSum);
        }
      #else
        void sample_detail_normals(float2 tc, out half4 packed0, out half4 packed1, out half4 packed2)
        {
          packed0 = SAMPLE_TEX(get_normal_tex(), tc * get_details_tile().x);
          packed1 = SAMPLE_TEX_SAMPLER(get_normal_tex1(), get_normal_tex().smp, tc * get_details_tile().y);
          packed2 = SAMPLE_TEX_SAMPLER(get_normal_tex2(), get_normal_tex().smp, tc * get_details_tile().z);
        }
      #endif
    ##endif

    ##if (atest == atestOff)
      #ifdef USE_EARLY_DEPTH_STENCIL
        USE_EARLY_DEPTH_STENCIL
      #endif
    ##endif

    #if VOXELIZE_ALBEDO_PASS
      void vcolor_layered_ps(VsOutput input INPUT_VFACE)
    #else
      GBUFFER_OUTPUT vcolor_layered_ps(VsOutput input INPUT_VFACE HW_USE_SCREEN_POS
        ##if is_blending_hmap
          HW_USE_READ_SHADING_RATE
        ##endif
        )
    #endif
    {
      #if SET_UP_MULTIDRAW
        SET_DRAW_CALL_ID(GET_MATERIAL_OFFSET(input));
      #endif
      #ifdef VOXELIZE_DISCARD_PRIM
        VOXELIZE_DISCARD_PRIM
      #endif
      #ifndef IS_DYNAMIC
        #define IS_DYNAMIC 0
      #endif

      input.normal.xyz = MUL_VFACE(input.normal.xyz);
      half3 vertexNormal = normalize(input.normal.xyz);
      float2 texCoord = input.diffuseTexcoord.xy;
      float3 worldPos = world_view_pos.xyz-input.pointToEye.xyz;
      half4 diffuseColor, diffuseColor1, diffuseColor2;
      #if RI_TRIPLANAR
        float3 triPos = worldPos * get_triplanar_scale_mul();
        TriplanarCoords tri = make_triplanar_coords(triPos, vertexNormal, get_triplanar_sharpness());
        set_triplanar_derivatives(tri, ddx(triPos), ddy(triPos));
        TriplanarOrder triOrder = sort_triplanar_axes(tri.weights);
        triplanar_detail_diffuse(tri, triOrder, diffuseColor, diffuseColor1, diffuseColor2);
      #else
        sample_detail_diffuse(texCoord, diffuseColor, diffuseColor1, diffuseColor2);
      #endif
      float2 by_normal_params = float2(0, 0);
      ##if (shader == rendinst_cliff)
        by_normal_params = float2(max(dot(get_mask_by_normal().xyz, input.normal.xyz), 0), get_mask_by_normal().w);
      ##endif
      half3 weights = init_blend_weights(input.vcolMask, by_normal_params);
      half3 initialHeight = half3(diffuseColor.a, diffuseColor1.a, diffuseColor2.a);
      weights = get_blending_weights(weights, lerp(initialHeight, 1 - initialHeight, get_invert_heights().xyz));
      ##if (atest == atestOn)
        float alpha = 1;
        if (weights.x >= max(weights.y, weights.z))
          alpha = initialHeight.x - get_details_alphatest().x;
        if (weights.y >= max(weights.x, weights.z))
          alpha = initialHeight.y - get_details_alphatest().y;
        if (weights.z >= max(weights.x, weights.y))
          alpha = initialHeight.z - get_details_alphatest().z;
        clip(alpha);
      ##endif
      ##if (paint_details_tex != NULL) // note: legacy behavior, paint_details_tex is not always needed (eg. for overlay map color)
        diffuseColor.rgb  = lerp(diffuseColor.rgb , diffuseColor.rgb *input.colorMul, get_paint_details().x);
        diffuseColor1.rgb = lerp(diffuseColor1.rgb, diffuseColor1.rgb*input.colorMul, get_paint_details().y);
        diffuseColor2.rgb = lerp(diffuseColor2.rgb, diffuseColor2.rgb*input.colorMul, get_paint_details().z);
      ##endif

      #if VOXELIZE_ALBEDO_PASS
        diffuseColor = diffuseColor*weights.x + diffuseColor1*weights.y + diffuseColor2*weights.z;
        WRITE_SCENE25D_VOXEL_DATA(worldPos, diffuseColor.rgb, 0, 0);
      #else
        half3 worldNormal = vertexNormal;
        ##if use_normal_details
          #if RI_TRIPLANAR
            half4 packedNormalMap;
            triplanar_detail_normals(tri, triOrder, weights, vertexNormal, packedNormalMap, worldNormal);
            half3 normalMap = half3(0, 0, 1);
          #else
            half4 packedNormalMap, packedNormalMap1, packedNormalMap2;
            sample_detail_normals(texCoord, packedNormalMap, packedNormalMap1, packedNormalMap2);
            half3 normalMap;

            packedNormalMap = packedNormalMap * weights.x + packedNormalMap1 * weights.y + packedNormalMap2 * weights.z;
            normalMap = unpack_ag_normal(packedNormalMap);
          #endif
        ##else
          half4 packedNormalMap = 0;
          half3 normalMap = float3(0, 1, 0);
        ##endif

        half smoothness = packedNormalMap.r;
        ##if (shader == rendinst_cliff)
          #define INV_LEAKS_CONTRAST_VALUE 10
          #if RI_TRIPLANAR
            half3 overlayNormal = worldNormal;
          #else
            half3 overlayNormal = perturb_normal_precise( normalMap, normalize(input.normal.xyz), input.pointToEye.xyz, input.diffuseTexcoord.xy );
          #endif
          float overlayNormalMask = saturate(dot(get_overlay_by_normal().xyz, overlayNormal.xyz));
          float4 normalOverlayColor = lerp(get_normal_overlay_color_from(), get_normal_overlay_color_to(), overlayNormalMask);
          float4 overlayColor = lerp(get_overlay_color_from(), get_overlay_color_to(), input.vcolMask.z);
          float4 overlayGradient = lerp(get_gradient_overlay_color_from(), get_gradient_overlay_color_to(), input.gradientFactor);
          float4 overlayColorFinal = normalOverlayColor * overlayGradient * overlayColor * 8; // the last multiplier for correct modulate2x, *2 per member
          ##if leaks_tex != NULL
          float3 posWithNoise = worldPos + tex3D(perlin_noise3d, (worldPos / get_leaks_removal_normal_noise_strength().y)).xyz * get_leaks_treshhold_size_noise_strength().z;
          float4 leakDiffuse = SAMPLE_TEX(get_leaks_tex(), (posWithNoise.xz / get_leaks_treshhold_size_noise_strength().y));
          leakDiffuse.xyz *= COLOR_CORRECTION_MULTIPLIER; // gamma correction for the same visual in game and AV
          float leakStrength = get_leaks_treshhold_size_noise_strength().w;
          float normMask = (leakStrength * (1 - leakStrength * input.normal.y)) * 0.5;
          float leakMask = (leakDiffuse.w - normMask) * (1 - (overlayNormalMask*get_leaks_removal_normal_noise_strength().x));
          leakMask = saturate((leakMask - get_leaks_treshhold_size_noise_strength().x) * INV_LEAKS_CONTRAST_VALUE);
          float3 overlayLeak = lerp(float3(0.5,0.5,0.5), leakDiffuse.xyz, leakMask.xxx);
          overlayColorFinal.xyz *= overlayLeak * 2;
          ##endif
          diffuseColor.rgb =  lerp(diffuseColor.rgb,  diffuseColor.rgb  * overlayColorFinal.xyz, get_overlay_strenght().x);
          diffuseColor1.rgb = lerp(diffuseColor1.rgb, diffuseColor1.rgb * overlayColorFinal.xyz, get_overlay_strenght().y);
          diffuseColor2.rgb = lerp(diffuseColor2.rgb, diffuseColor2.rgb * overlayColorFinal.xyz, get_overlay_strenght().z);
          smoothness *= overlayColorFinal.a;
        ##endif
        diffuseColor = diffuseColor*weights.x + diffuseColor1*weights.y + diffuseColor2*weights.z;

        half metalnessOrTranslucency;

        ##if use_translucency
        if (SHOULD_USE_TRANLUCENCY && SHOULD_USE_OVERRIDEN_TRANLUCENCY)
          metalnessOrTranslucency = TRANSLUCENCY_OVERRIDE;
        else
        ##endif
          metalnessOrTranslucency = packedNormalMap.b;

        half reflectance = 0.5;
        half ao = 1;
        ##if compatibility_mode == compatibility_mode_off
          BRANCH
          if (character_micro_detail_layer>=0)
          {
            apply_character_micro_detail(sample_character_micro_detail(input.diffuseTexcoord.xy*get_character_micro_detail_scale().xy, character_micro_detail_layer),
                                        diffuseColor.rgb, normalMap, reflectance, smoothness);
          }
          // This is the only perturb_normal_precise needed for triplanar route, as it adds extra details, the rest
          // are done in the triplanar normal sampling itself
          worldNormal = perturb_normal_precise( normalMap, worldNormal, input.pointToEye.xyz, input.diffuseTexcoord.xy );

          #if NORMAL_RENDER_PASS
            apply_wetness_by_microdetail(character_micro_detail_layer, worldPos, diffuseColor.rgb, worldNormal, reflectance, smoothness, ao);
          #endif
        ##else
          #if !RI_TRIPLANAR
            worldNormal = perturb_normal_precise(normalMap, worldNormal, input.pointToEye.xyz, input.diffuseTexcoord.xy);
          #endif
        ##endif

        UnpackedGbuffer gbuffer;
        init_gbuffer(gbuffer);

        ##if use_translucency
        if (SHOULD_USE_TRANLUCENCY)
        {
          init_translucency(gbuffer, metalnessOrTranslucency);
          init_material(gbuffer, SHADING_SUBSURFACE);
          init_sss_profile(gbuffer, SSS_PROFILE_NEUTRAL_TRANSLUCENT);
        }
        else
        ##endif
        {
          init_metalness(gbuffer, metalnessOrTranslucency);
          init_material(gbuffer, SHADING_NORMAL);
        }
        ##if use_sheen
          #if OVERRIDE_MATERIAL
            init_material_override(gbuffer);
          #endif
        ##endif

        init_dynamic(gbuffer,IS_DYNAMIC);
        init_order(gbuffer, GBUFFER_ORDER_DYNAMIC);
        #ifdef MOTION_VECTORS_ENABLED
          float3 motion = encode_motion_vector( input.out_pos, input.out_pos_prev );
          init_motion_vector(gbuffer, motion);
        #endif
        init_ao(gbuffer, ao);
        ##if (shader != rendinst_cliff)
          diffuseColor.rgb *= lerp(get_overlay_color_from().xyz, get_overlay_color_to().xyz, input.vcolMask.b) * 2;
        ##endif
        init_smoothness(gbuffer, smoothness);
        init_reflectance(gbuffer, reflectance);
        init_normal(gbuffer, worldNormal);
        init_albedo(gbuffer, diffuseColor.rgb);
        #if RI_TRIPLANAR
          float2 densityTc = get_planar_projection(tri, triOrder.axis.x, triOrder.weight.x).uv;
        #else
          float2 densityTc = texCoord;
        #endif
        init_worldTexelDensity(gbuffer, get_diffuse_tex().tex, densityTc * get_details_tile().x, input.pointToEye.xyz);

        float4 screenpos = GET_SCREEN_POS(input.pos);

        ##if is_blending_hmap
          blend_with_landscape(gbuffer, screenpos, worldPos, normalize(input.normal.xyz), input.pointToEye.xyz,
            input.riHmapBlend, GET_SHADING_RATE);
        ##endif

        #ifdef PLOD_PS_GEN
          PLOD_PS_GEN(input, pack_gbuffer(gbuffer), normalMap)
        #endif

        #if DEBUG_DOMINANT_UV
          init_albedo(gbuffer, get_dominant_uv_debug_color(input.diffuseTexcoord.xy));
        #endif

        return encode_gbuffer(gbuffer, input.pointToEye.xyz, screenpos);
      #endif
    }
  }
  compile("target_ps", "vcolor_layered_ps");
endmacro

macro VCOLOR_LAYERED_PS(is_writing_gbuffer, is_blending_hmap, use_translucency, use_sheen, order)
  VCOLOR_LAYERED_PS_IMPL(is_writing_gbuffer, is_blending_hmap, use_translucency, use_sheen, true, order)
endmacro
