include "shader_global.dshl"
include "gbuffer.dshl"
include "neural_rendering_transfer_inc.dshl"
include "project_neural_rendering_tonemap.dshl"

// Project hook: frame gain for NR passes.
define_macro_if_not_defined USE_NEURAL_RENDERING_GAIN(code)
  hlsl(code) {
    #define neural_rendering_gain(frame, tc) 1
  }
endmacro

texture neural_rendering_source_frame;
texture neural_rendering_sdr_target;
texture neural_rendering_output_frame;
texture neural_rendering_target_frame;
texture neural_rendering_control_mask_target;

float4 neural_rendering_control_mask_default = (1, 1, 1, 1);
float4 neural_rendering_control_mask_skin = (1, 1, 1, 1);
float4 neural_rendering_control_mask_foliage = (1, 1, 1, 1);

shader neural_rendering_tonemap
{
  if (!hardware.pc || compatibility_mode == compatibility_mode_on) { dont_render; }

  NEURAL_RENDERING_TRANSFER(cs)
  USE_NEURAL_RENDERING_GAIN(cs)

  (cs) {
    sourceFrame@tex2d = neural_rendering_source_frame;
    sdrTarget@uav = neural_rendering_sdr_target hlsl { RWTexture2D<float4> sdrTarget@uav; }
    targetResolution@i2 = get_dimensions(neural_rendering_sdr_target, 0);
  }

  hlsl(cs) {
    [numthreads(8, 8, 1)]
    void main(uint2 dtId : SV_DispatchThreadID)
    {
      if (any(dtId >= uint2(targetResolution)))
        return;

      float3 frame = texture2DAt(sourceFrame, dtId).rgb;
      frame *= neural_rendering_gain(frame, (float2(dtId) + 0.5) / float2(targetResolution));
      texture2DAt(sdrTarget, dtId) = float4(neural_rendering_encode(frame), 1);
    }
  }

  compile("target_cs", "main");
}

shader neural_rendering_inverse_tonemap
{
  if (!hardware.pc || compatibility_mode == compatibility_mode_on) { dont_render; }

  NEURAL_RENDERING_HIGHLIGHT_MASK(cs)
  USE_NEURAL_RENDERING_GAIN(cs)

  (cs) {
    sourceFrame@tex2d = neural_rendering_source_frame;
    outputFrame@tex2d = neural_rendering_output_frame;
    targetFrame@uav = neural_rendering_target_frame hlsl { RWTexture2D<float4> targetFrame@uav; }
    targetResolution@i2 = get_dimensions(neural_rendering_target_frame, 0);
  }

  hlsl(cs) {
    [numthreads(8, 8, 1)]
    void main(uint2 dtId : SV_DispatchThreadID)
    {
      if (any(dtId >= uint2(targetResolution)))
        return;

      float3 originalHdr = texture2DAt(sourceFrame, dtId).rgb;
      originalHdr *= neural_rendering_gain(originalHdr, (float2(dtId) + 0.5) / float2(targetResolution));
      float3 recoveredHdr = neural_rendering_decode(texture2DAt(outputFrame, dtId).rgb);
      texture2DAt(targetFrame, dtId) = float4(lerp(recoveredHdr, originalHdr, neural_rendering_highlight_mask(originalHdr)), 1);
    }
  }

  compile("target_cs", "main");
}

shader neural_rendering_control_mask
{
  if (!hardware.pc || compatibility_mode == compatibility_mode_on) { dont_render; }

  // Same gbuffer setup as prepare_ray_reconstruction, so it compiles in every game that shares
  // this file. The mask does not use the emission color, so its color map is stubbed out.
  hlsl {
    #define DISABLE_TOONSHADING 1
    #define decodeEmissionColor(a) half3(0, 0, 0)
  }
  INIT_PACK_UNPACK_DYNSTCODE(cs)
  INIT_LOAD_GBUFFER_BASE(cs)
  USE_LOAD_GBUFFER_BASE(cs, false)
  INIT_LOAD_DEPTH_GBUFFER_BASE(cs)
  USE_LOAD_DEPTH_GBUFFER_BASE(cs)

  (cs) {
    maskDefault@f4 = neural_rendering_control_mask_default;
    maskSkin@f4 = neural_rendering_control_mask_skin;
    maskFoliage@f4 = neural_rendering_control_mask_foliage;
    controlMask@uav = neural_rendering_control_mask_target hlsl { RWTexture2D<float4> controlMask@uav; }
    targetResolution@i2 = get_dimensions(neural_rendering_control_mask_target, 0);
  }

  hlsl(cs) {
    [numthreads(16, 16, 1)]
    void main(uint2 dtId : SV_DispatchThreadID)
    {
      if (any(dtId >= uint2(targetResolution)))
        return;

      float4 mask = maskDefault;

      // The gbuffer is not written where the sky is visible, so it holds garbage there.
      BRANCH
      if (loadGbufferDepth(dtId) > 0)
      {
        ProcessedGbuffer gbuffer = processGbuffer(unpackGbuffer(loadPackedGbuffer(dtId)));
        // isFoliage only comes from the BVH flags in some games, so foliage is told by the material.
        mask = gbuffer.isSkinMaterial ? maskSkin : isFoliageShader(gbuffer.material) ? maskFoliage : maskDefault;
      }

      texture2DAt(controlMask, dtId) = mask;
    }
  }

  compile("target_cs", "main");
}
