
buffer context_gpu_data always_referenced;

// Must match the writer: add_animchar() writes collapser bits before the bones, add() doesn't.
int dynmodel_node_collapser_data = 1 always_referenced;
interval dynmodel_node_collapser_data : no < 1, yes;
assume_if_not_assumed dynmodel_node_collapser_data = yes;

// constraint: use_shared_skin_bones = yes requires dynmodel_node_collapser_data = no.
int use_shared_skin_bones = 0 always_referenced;
interval use_shared_skin_bones : no < 1, yes;
assume_if_not_assumed use_shared_skin_bones = no;

macro INIT_WORLD_LOCAL_BASE(code)
(code) {
  context_gpu_data@cbuf = context_gpu_data hlsl {
    cbuffer context_gpu_data@cbuf
    {
      float4 proj_to_world_tm_0;
      float4 proj_to_world_tm_1;
      float4 proj_to_world_tm_2;
      float4 proj_to_world_tm_3;

      float4 proj_to_view_tm_0;
      float4 proj_to_view_tm_1;
      float4 proj_to_view_tm_2;
      float4 proj_to_view_tm_3;

      float4 relative_world_to_proj_tm_0;
      float4 relative_world_to_proj_tm_1;
      float4 relative_world_to_proj_tm_2;
      float4 relative_world_to_proj_tm_3;
    }
  }
}
endmacro

macro USE_WORLD_LOCAL_BASE(code)
hlsl(code) {
  // Must match the writer: contexts with set_prev_matrices(false) upload neither the previous
  // node tm nor the previous bone rows. Only vertex variants define this per pass, the cs readers
  // keep the full layout, which set_instance_data_buffer asserts.
  #ifndef DYNREND_HAS_PREV_MATRICES
  #define DYNREND_HAS_PREV_MATRICES 1
  #endif

  #if DYNREND_HAS_PREV_MATRICES
    #define DYNREND_NODE_CHUNK_VECS 9
    #define SKIN_BONE_ROWS 6
    #define DYNREND_LOAD_PREV_GLOBTM(base)                                                                                 \
      float4 prev_globtm_0 = loadBuffer(INSTANCE_DATA_BUFFER, base + 4);                                                   \
      float4 prev_globtm_1 = loadBuffer(INSTANCE_DATA_BUFFER, base + 5);                                                   \
      float4 prev_globtm_2 = loadBuffer(INSTANCE_DATA_BUFFER, base + 6);                                                   \
      float4 prev_globtm_3 = loadBuffer(INSTANCE_DATA_BUFFER, base + 7);
  #else
    #define DYNREND_NODE_CHUNK_VECS 5
    #define SKIN_BONE_ROWS 3
    #define DYNREND_LOAD_PREV_GLOBTM(base)
  #endif

  #ifndef NODE_CHUNK_SIZE_GETTER
    #define NODE_CHUNK_SIZE_GETTER (get_immediate_dword_0() & 0xFF)
  #endif

##if DEBUG && !hardware.metal
  void checkDynrendNodeChunk(int node_chunk, int base, int stride, int rigid, uint dim, int file, int ln)
  {
    int bias = node_chunk - base;
    ##assert(node_chunk >= 0, "[%s:%d] dynrend node chunk underflow: base %d + bias %d = %d, clamped to 0 (rigid %d, stride %d)",
             file, ln, base, bias, node_chunk, rigid, stride);
    ##assert(uint(node_chunk) < dim, "[%s:%d] dynrend node chunk overrun: base %d + bias %d = %d, buffer holds %u (rigid %d, stride %d)",
             file, ln, base, bias, node_chunk, dim, rigid, stride);
  }

  #define CHECK_DYNREND_NODE_CHUNK(node_chunk, rigid_index)                                                              \
    INSTANCE_DATA_BUFFER.GetDimensions(bounds_check_dim);                                                                \
    checkDynrendNodeChunk(node_chunk, (int)OFFSET_TO_NODE_DATA(0), (int)NODE_CHUNK_SIZE_GETTER,                         \
      (int)((rigid_index) * 255.0 + 0.5), bounds_check_dim, _FILE_, __LINE__);
##else
  #define CHECK_DYNREND_NODE_CHUNK(node_chunk, rigid_index)
##endif

  #define SETUP_RENDER_VARS(rigid_index)                                                                                   \
    int rawOffsetToNodeChunk = (int)OFFSET_TO_NODE_DATA(rigid_index);                                                      \
    CHECK_DYNREND_NODE_CHUNK(rawOffsetToNodeChunk, rigid_index)                                                            \
    uint offsetToNodeChunk = max(rawOffsetToNodeChunk, 0);                                                                 \
    float4 globtm_0 = loadBuffer(INSTANCE_DATA_BUFFER, offsetToNodeChunk + 0);                                             \
    float4 globtm_1 = loadBuffer(INSTANCE_DATA_BUFFER, offsetToNodeChunk + 1);                                             \
    float4 globtm_2 = loadBuffer(INSTANCE_DATA_BUFFER, offsetToNodeChunk + 2);                                             \
    float4 globtm_3 = loadBuffer(INSTANCE_DATA_BUFFER, offsetToNodeChunk + 3);                                             \
    DYNREND_LOAD_PREV_GLOBTM(offsetToNodeChunk)                                                                            \
    float4 opacity__unused__extra = loadBuffer(INSTANCE_DATA_BUFFER, offsetToNodeChunk + DYNREND_NODE_CHUNK_VECS - 1);     \
    float2 opacity__unused = opacity__unused__extra.xy; /*.y is unused after addition of OFFSET_TO_INSTANCE_DATA */        \
    float2 node_extra_data = opacity__unused__extra.zw;                                                                    \
    float node_opacity = opacity__unused.x;                                                                                \
    float4 node_tm_0, node_tm_1, node_tm_2;                                                                                \
    if ( NODE_CHUNK_SIZE_GETTER > DYNREND_NODE_CHUNK_VECS)                                                                                       \
    {                                                                                                                      \
      node_tm_0 = loadBuffer(INSTANCE_DATA_BUFFER, offsetToNodeChunk + DYNREND_NODE_CHUNK_VECS + 0);                       \
      node_tm_1 = loadBuffer(INSTANCE_DATA_BUFFER, offsetToNodeChunk + DYNREND_NODE_CHUNK_VECS + 1);                       \
      node_tm_2 = loadBuffer(INSTANCE_DATA_BUFFER, offsetToNodeChunk + DYNREND_NODE_CHUNK_VECS + 2);                       \
    }                                                                                                                      \
    else                                                                                                                   \
    {                                                                                                                      \
      node_tm_0 = float4(1, 0, 0, 0);                                                                                      \
      node_tm_1 = float4(0, 1, 0, 0);                                                                                      \
      node_tm_2 = float4(0, 0, 1, 0);                                                                                      \
    }                                                                                                                      \
    uint offsetToInstanceChunk = max(OFFSET_TO_INSTANCE_DATA, 0);                                                          \
    float4 unpack_pos_mul = loadBuffer(INSTANCE_DATA_BUFFER, offsetToInstanceChunk + 0);                                   \
    float4 pos_ofs__cnt = loadBuffer(INSTANCE_DATA_BUFFER, offsetToInstanceChunk + 1);                                     \
    float3 unpack_pos_ofs = pos_ofs__cnt.xyz;                                                                              \
    float2 dynrend_params_offset_count = float2(offsetToInstanceChunk + 2.5, pos_ofs__cnt.w);

  struct bone_t { float4 r0, r1, r2; };

  float4 get_bone_row(int offset)
  {
    ##if dynmodel_node_collapser_data == yes
      return loadBuffer(INSTANCE_DATA_BUFFER, OFFSET_TO_NODE_DATA(0) + DYNREND_NODE_CHUNK_VECS + 2 + offset);
    ##elif use_shared_skin_bones == yes
      return loadBuffer(INSTANCE_DATA_BUFFER, OFFSET_TO_INSTANCE_DATA - 1 - offset); // bones are stored in reversed order
    ##else
      return loadBuffer(INSTANCE_DATA_BUFFER, OFFSET_TO_NODE_DATA(0) + DYNREND_NODE_CHUNK_VECS + offset);
    ##endif
  }

  bone_t get_bone(int bone_index)
  {
    bone_t bone;
    bone.r0 = get_bone_row(bone_index * SKIN_BONE_ROWS + 0);
    bone.r1 = get_bone_row(bone_index * SKIN_BONE_ROWS + 1);
    bone.r2 = get_bone_row(bone_index * SKIN_BONE_ROWS + 2);
    return bone;
  }

  // Left undefined without previous matrices, so that reading them is a compile error
  #if DYNREND_HAS_PREV_MATRICES
  bone_t get_prev_bone(int bone_index)
  {
    bone_t bone;
    bone.r0 = get_bone_row(bone_index * SKIN_BONE_ROWS + 3);
    bone.r1 = get_bone_row(bone_index * SKIN_BONE_ROWS + 4);
    bone.r2 = get_bone_row(bone_index * SKIN_BONE_ROWS + 5);
    return bone;
  }
  #endif

  #define GET_DYNREND_PARAM(param_no) ((int)param_no < (int)dynrend_params_offset_count.y ? \
    loadBuffer(INSTANCE_DATA_BUFFER, max(dynrend_params_offset_count.x + param_no, 0)) : float4(0, 0, 0, 0))
}
endmacro

macro INIT_WORLD_LOCAL_VS()
  INIT_WORLD_LOCAL_BASE(vs)
endmacro

macro USE_WORLD_LOCAL_VS()
  USE_WORLD_LOCAL_BASE(vs)
endmacro

macro WORLD_LOCAL_VS()
  INIT_WORLD_LOCAL_VS()
  USE_WORLD_LOCAL_VS()
endmacro