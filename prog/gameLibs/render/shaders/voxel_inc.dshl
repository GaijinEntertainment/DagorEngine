include "shader_global.dshl"
include "paint_details_inc.dshl"
include "gbuffer.dshl"

float4 voxel_depth_projection;
int voxel_data_offset;

texture voxel_color_atlas;
texture voxel_normal_atlas;
int4 voxel_atlas_offsets;

macro USE_RENDINST_VOXEL_VS()
  hlsl {
    struct VsOutput
    {
      linear noperspective centroid VS_OUT_POSITION(pos)
      float3 localPos                    : TEXCOORD0;
      nointerpolation float3 worldLocalX : TEXCOORD1;
      nointerpolation float3 worldLocalY : TEXCOORD2;
      nointerpolation float3 worldLocalZ : TEXCOORD3;
      float3 worldPos                    : TEXCOORD4;
      nointerpolation uint hashVal       : TEXCOORD5;
      #if SET_UP_MULTIDRAW
        VSOUT_DRAW_ID
      #endif
    };
  }

  hlsl(vs) {
    INSTANCING_BUFFERS

    struct VsInput
    {
      float3 pos : POSITION;
    };

    VsOutput voxel_vs(VsInput IN  HW_USE_INSTANCE_ID)
    {
      VsOutput output;

      #if SET_UP_MULTIDRAW
        INIT_MULTIDRAW(output);
        SET_DRAW_CALL_ID(GET_MATERIAL_OFFSET);
      #endif

      float3 localPos = IN.pos;
      float3 localNormal = 0;

      VB_PERFORM_INSTANCING

      output.pos = mulPointTm(worldPos + camera_base_offset.xyz, globtm);

      output.localPos = localPos;

      output.worldLocalX = worldLocalX;
      output.worldLocalY = worldLocalY;
      output.worldLocalZ = worldLocalZ;
      output.worldPos = worldPos;

      INSTANCING_HASH_VAL
      output.hashVal = hashVal;

      return output;
    }
  }

  compile("target_vs", "voxel_vs");
endmacro

macro USE_VOXEL_PS(use_overlay_map)
  (ps) {
    voxel_data@buf : register(ri_vertex_data_no) hlsl {
      ByteAddressBuffer voxel_data@buf;
    }
    voxel_data_offset@u1 = voxel_data_offset;
    color_tex@tex2d = voxel_color_atlas;
    color_tex_size@f2 = get_dimensions(voxel_color_atlas, 0);
    color_block_ofs@u1 = voxel_atlas_offsets.x;
    normal_tex@tex2d = voxel_normal_atlas;
    normal_tex_size@f2 = get_dimensions(voxel_normal_atlas, 0);
    normal_block_ofs@u1 = voxel_atlas_offsets.y;
    depth_proj@f4 = voxel_depth_projection;
    camera_base_offset@f3 = camera_base_offset;
    paint_details_tex@smp2d = paint_details_tex;
    screen_noise_frame@f1 = shadow_frame + 23; // frame offset so it's not correlated
  }

  if (use_overlay_map)
  {
    (ps) {
      cliff_color_overlay_map_tex@smp2d = cliff_color_overlay_map_tex;
      cliff_color_overlay_map_tex_exists@i1 = exists_tex(cliff_color_overlay_map_tex);
      cliff_color_overlay_map_scale_offset@f4 = (
          1.0 / (cliff_color_overlay_map_left_top_right_bottom.z - cliff_color_overlay_map_left_top_right_bottom.x),
          1.0 / (cliff_color_overlay_map_left_top_right_bottom.w - cliff_color_overlay_map_left_top_right_bottom.y),
          -cliff_color_overlay_map_left_top_right_bottom.x / (cliff_color_overlay_map_left_top_right_bottom.z - cliff_color_overlay_map_left_top_right_bottom.x),
          -cliff_color_overlay_map_left_top_right_bottom.y / (cliff_color_overlay_map_left_top_right_bottom.w - cliff_color_overlay_map_left_top_right_bottom.y));
    }
  }

  hlsl(ps) {
    #include <octahedral.hlsl>
    #include <interleavedGradientNoise.hlsl>

    #define VOXEL_DEPTH_BITS 14
    #define VOXEL_PALETTE_SIZE 16

    bool testSegmentBox(uint2 bitmap, float3 ray_pos, float3 ray_dir, float t0, float t1)
    {
      const float3 p0 = ray_pos + ray_dir * t0;
      const float3 p1 = ray_pos + ray_dir * t1;
      const int3 b0 = clamp(int3(floor(min(p0, p1) - 0.01)), 0, 3);
      const int3 b1 = clamp(int3(ceil (max(p0, p1) + 0.01)), 1, 4);
      const int3 size = b1 - b0;

      uint2 mask = 0;
      for (int y = b0.y; y < b1.y; y++)
      {
        const uint2 m = uint2(1u << ((y & 1) * 4 * 4 + b0.z * 4 + b0.x), 0);
        mask |= y < 2 ? m : m.yx;
      }

      mask |= mask << (size.x > 1 ? 1 : 0);
      mask |= mask << (size.x <= 2 ? 0 : size.x - 2);

      mask |= mask << ((size.z > 1 ? 1 : 0) * 4);
      mask |= mask << ((size.z <= 2 ? 0 : size.z - 2) * 4);

      return any((bitmap & mask) != 0);
    }

    ##if hardware.fsh_5_0
      #define DEPTH_SEMANTIC SV_DepthLessEqual
    ##else
      #define DEPTH_SEMANTIC SV_Depth
    ##endif

  ##if rendinst_render_pass == rendinst_render_pass_to_shadow || rendinst_render_pass == rendinst_render_pass_depth
    float4 voxel_ps(VsOutput IN HW_USE_SCREEN_POS, out float depth : DEPTH_SEMANTIC) : SV_Target0
  ##else
    GBUFFER_OUTPUT voxel_ps(VsOutput IN HW_USE_SCREEN_POS, out float depth : DEPTH_SEMANTIC)
  ##endif
    {
      #if SET_UP_MULTIDRAW
        SET_DRAW_CALL_ID(GET_MATERIAL_OFFSET(IN));
      #endif

      float4 screenpos = GET_SCREEN_POS(IN.pos);
      float3 p2e = -normalize(depth_proj.xyz + depth_proj.w * (IN.worldPos + camera_base_offset));

      // assuming orthogonal matrix
      float3 localRay = -float3(
        dot(p2e, IN.worldLocalX),
        dot(p2e, IN.worldLocalY),
        dot(p2e, IN.worldLocalZ))
      / max(1e-6, float3(
        lengthSq(IN.worldLocalX),
        lengthSq(IN.worldLocalY),
        lengthSq(IN.worldLocalZ)));

      ##if rendinst_render_pass == rendinst_render_pass_to_shadow || rendinst_render_pass == rendinst_render_pass_depth
        BRANCH
        if (voxel_data_offset == 0)
        {
          // shouldn't happen
          float2 pzw = mulPointTm(IN.worldPos + camera_base_offset, globtm).zw;
          depth = pzw.x * rcp(pzw.y);
          return 0;
        }
      ##else
        UnpackedGbuffer result;
        init_gbuffer(result);

        BRANCH
        if (voxel_data_offset == 0)
        {
          // shouldn't happen
          init_albedo(result, half3(1, 0, 1));
          init_material(result, SHADING_NORMAL);
          init_order(result, GBUFFER_ORDER_STATIC);
          float2 pzw = mulPointTm(IN.worldPos + camera_base_offset, globtm).zw;
          depth = pzw.x * rcp(pzw.y);
          return encode_gbuffer(result, p2e.xyz, screenpos);
        }
      ##endif

      const uint mipsAndLayers = loadBuffer(voxel_data, voxel_data_offset);
      const uint numMips = mipsAndLayers & 0xffff;
      const uint numLayers = mipsAndLayers >> 16;

      if (numLayers == 0 || numLayers > 4)
      {
        // shouldn't happen, bad data
        float2 pzw = mulPointTm(IN.worldPos + camera_base_offset, globtm).zw;
        depth = pzw.x * rcp(pzw.y);
        ##if rendinst_render_pass == rendinst_render_pass_to_shadow || rendinst_render_pass == rendinst_render_pass_depth
          return 0;
        ##else
          init_albedo(result, half3(1, 0, 0));
          init_material(result, SHADING_NORMAL);
          init_order(result, GBUFFER_ORDER_STATIC);
          return encode_gbuffer(result, p2e.xyz, screenpos);
        ##endif
      }

      const uint palOfs = voxel_data_offset + 4 + 4 * numMips;
      const uint palBlocksOfs = palOfs + VOXEL_PALETTE_SIZE * 2;
      uint mipOfs = loadBuffer(voxel_data, voxel_data_offset + 4) + voxel_data_offset;
      float voxelSize = asfloat(loadBuffer(voxel_data, mipOfs + 4 * 3));

      float3 pos = IN.localPos;

      // select mip
      const float bias = -0.5;
      const float voxelsPerPixel = min(length(ddx(pos)), length(ddy(pos))) / voxelSize;
      const uint mip = clamp(uint(ceil(log2(voxelsPerPixel) + bias)), 0, numMips - 1);
      mipOfs = loadBuffer(voxel_data, voxel_data_offset + 4 + 4 * mip) + voxel_data_offset;
      const uint3 numBlocks = loadBuffer3(voxel_data, mipOfs);
      voxelSize = asfloat(loadBuffer(voxel_data, mipOfs + 4 * 3));
      const float3 boxMin = asfloat(loadBuffer3(voxel_data, mipOfs + 4 * 4));
      pos = (pos - boxMin) / voxelSize;

      const float3 dir = normalize(localRay);
      const float3 absDir = abs(dir);
      const int3 dirSign = dir >= 0 ? 1 : -1;
      const float3 rayOrigin = pos;
      int3 blockPos = int3(floor(pos)) >> 2;
      const int3 rayLimit = dir >= 0 ? numBlocks - 1 : 0;
      const float3 blockTDelta = absDir > 1e-9 ? 4.0 / absDir : 0;
      const int3 nextPt = blockPos + max(0, dirSign);
      float3 blockTMax = absDir > 1e-9 ? ((nextPt << 2) - rayOrigin) / dir : 1e15;

      bool hit = false;
      int hitAxis = -1;
      float t = 0;
      int3 ipos;

      uint numSteps = numBlocks.x + numBlocks.y + numBlocks.z;
      uint2 bitmap = 0;

      // walk block grid
      for (; numSteps > 0; numSteps--)
      {
        const float nextBlockT = min(blockTMax.x, min(blockTMax.y, blockTMax.z));

        uint3 bp = uint3(blockPos);
        if (any(bp >= numBlocks))
        {
          if (any(blockPos * dirSign > rayLimit)) break;
        }
        else
        {
          bitmap = loadBuffer2(voxel_data, (((bp.y * numBlocks.z + bp.z) * numBlocks.x + bp.x) * 2 + 7) * 4 + mipOfs);
          if (all(bitmap == 0)) {}
          else if (!testSegmentBox(bitmap, rayOrigin - (blockPos << 2), dir, t, nextBlockT)) {}
          else
          {
            // compute tmax for voxel instead of block
            int3 lp = int3(floor(rayOrigin + dir * t));
            float3 tmax = absDir > 1e-9 ? (lp + max(0, dirSign) - rayOrigin) / dir : 1e15;

            // walk voxels in the block
            lp -= bp << 2;
            float vt = t;

            for (uint iter = 0; iter < 4 * 3; iter++)
            {
              if (all(uint3(lp) < 4))
              {
                uint voxelIndex = lp.y * 4 * 4 + lp.z * 4 + lp.x;
                if ((bitmap[voxelIndex >= 32 ? 1 : 0] & (1u << (voxelIndex & 31))) != 0)
                {
                  hit = true;
                  break;
                }
              }
              else if (iter > 0) break; // could be outside initially because of rounding

              vt = min(tmax.x, min(tmax.y, tmax.z));
              bool3 nextAxes = tmax == vt;
              lp += nextAxes ? dirSign : 0;
              tmax += nextAxes ? blockTDelta * (1.0/4) : 0;
              hitAxis = nextAxes.x ? 0 : (nextAxes.y ? 1 : 2);
            }

            if (hit)
            {
              ##if rendinst_render_pass == rendinst_render_pass_to_shadow || rendinst_render_pass == rendinst_render_pass_depth
                const float mainDelta = rcp(max(absDir.x, max(absDir.y, absDir.z)));
                t = vt + mainDelta * 1.5;
                ipos = int3(round(rayOrigin + dir * t));
              ##else
                t = vt;
                ipos = lp + (bp << 2);
              ##endif
              break;
            }
          }
        }

        t = nextBlockT;
        bool3 nextAxes = blockTMax == t;
        blockPos += nextAxes ? dirSign : 0;
        blockTMax += nextAxes ? blockTDelta : 0;
        hitAxis = nextAxes.x ? 0 : (nextAxes.y ? 1 : 2);
      }

      if (!hit) discard;

      // world pos
      float wt = t * voxelSize / length(localRay);
      float3 worldRay = localRay.x * IN.worldLocalX + localRay.y * IN.worldLocalY + localRay.z * IN.worldLocalZ;
      float3 worldPos = worldRay * wt + IN.worldPos;

      float2 pzw = mulPointTm(worldPos + camera_base_offset, globtm).zw;
      depth = pzw.x * rcp(pzw.y);

      ##if rendinst_render_pass == rendinst_render_pass_to_shadow || rendinst_render_pass == rendinst_render_pass_depth
        return 0;
      ##else
        if (!hit)
          return encode_gbuffer(result, p2e.xyz, screenpos);

        bool solidNeighbor[3];
        for (uint axis = 0; axis < 3; axis++)
        {
          if (axis == hitAxis)
          {
            solidNeighbor[axis] = false;
            continue;
          }

          int3 lp = ipos - (blockPos << 2) - (uint3(0, 1, 2) == axis ? dirSign : 0);
          if (all(uint3(lp) < 4))
          {
            // use last block
            uint voxelIndex = lp.y * 4 * 4 + lp.z * 4 + lp.x;
            solidNeighbor[axis] = (bitmap[voxelIndex >= 32 ? 1 : 0] & (1u << (voxelIndex & 31))) != 0;
          }
          else
          {
            // fetch neighbor block
            uint3 bp = ((blockPos << 2) + lp) >> 2;
            uint2 bm = 0;
            if (all(bp < numBlocks))
              bm = loadBuffer2(voxel_data, (((bp.y * numBlocks.z + bp.z) * numBlocks.x + bp.x) * 2 + 7) * 4 + mipOfs);
            uint voxelIndex = (lp.y & 3) * 4 * 4 + (lp.z & 3) * 4 + (lp.x & 3);
            solidNeighbor[axis] = (bm[voxelIndex >= 32 ? 1 : 0] & (1u << (voxelIndex & 31))) != 0;
          }
        }

        const half3 rawWeights = dir * dir;
        half3 weights = bool3(solidNeighbor[0], solidNeighbor[1], solidNeighbor[2]) ? 0 : rawWeights;
        float sumWeight = dot(1, weights);
        if (sumWeight < 1e-6)
        {
          weights = rawWeights;
          sumWeight = dot(1, weights);
        }

        const float rng = interleavedGradientNoiseFramed(screenpos.xy, screen_noise_frame) * sumWeight;
        hitAxis = rng < weights.x ? 0 : (rng < weights.x + weights.y ? 1 : 2);

        const uint faceId = (hitAxis << 1) | ((1 - dirSign[hitAxis]) >> 1);
        const uint faceAxis = hitAxis;
        const bool faceNeg = (faceId & 1) != 0;

        // face data offset
        uint faceOffset = mipOfs + (numBlocks.x * numBlocks.y * numBlocks.z * 2 + 7) * 4; // + 3d map

        faceOffset += faceId <= 0 ? 0 : numBlocks.z * numBlocks.y * 8 * numLayers;
        faceOffset += faceId <= 1 ? 0 : numBlocks.z * numBlocks.y * 8 * numLayers;
        faceOffset += faceId <= 2 ? 0 : numBlocks.z * numBlocks.x * 8 * numLayers;
        faceOffset += faceId <= 3 ? 0 : numBlocks.z * numBlocks.x * 8 * numLayers;
        faceOffset += faceId <= 4 ? 0 : numBlocks.x * numBlocks.y * 8 * numLayers;

        // get surface block indices from face map
        const uint2 itc = uint2(faceAxis == 0 ? ipos.zy : (faceAxis == 1 ? ipos.zx : ipos.xy));
        const int blockDepth = (faceAxis == 0 ? ipos.x : (faceAxis == 1 ? ipos.y : ipos.z)) >> 2;
        const uint2 faceSize = faceAxis == 0 ? numBlocks.zy : (faceAxis == 1 ? numBlocks.zx : numBlocks.xy);
        const bool inFace = all((itc >> 2) < faceSize);

        uint2 surfData = uint2(0, 0);
        uint surfLayer = 0;
        const uint dataOffset = ((itc.y >> 2) * faceSize.x + (itc.x >> 2)) * 8 * numLayers + faceOffset;
        for (uint li = 0; li < numLayers; li++)
        {
          const uint2 s = inFace ? loadBuffer2(voxel_data, dataOffset + 8 * li) : uint2(0, 0);
          const int d = (s.x >> (32 - VOXEL_DEPTH_BITS / 2)) | (s.y >> (32 - VOXEL_DEPTH_BITS / 2) << (VOXEL_DEPTH_BITS / 2));
          const bool sel = li == 0 || (faceNeg ? d > blockDepth : d <= blockDepth);
          surfData = sel ? s : surfData;
          surfLayer = sel ? li : surfLayer;
        }

        const uint  colorIndex = surfData.x & ((1u << (32 - VOXEL_DEPTH_BITS / 2)) - 1);
        const uint normalIndex = surfData.y & ((1u << (32 - VOXEL_DEPTH_BITS / 2)) - 1);
        const uint  colorBlock =  color_block_ofs + ( colorIndex == 0 ? 0 : (colorIndex - 1) * 2);
        const uint matBlock = colorBlock + 1;
        const uint normalBlock = normal_block_ofs + (normalIndex == 0 ? 0 : normalIndex - 1);

        // sample surface blocks
        const uint palBlock = loadBuffer(voxel_data, palBlocksOfs + (colorIndex == 0 ? 0 : colorIndex - 1) * 4);
        const uint voxelPalIndex = (palBlock >> ((palBlock & (1u << (8 + (itc.x & 3) + (itc.y & 3) * 4))) == 0 ? 0 : 4)) & 0xf;
        const uint palData = loadBuffer(voxel_data, palOfs + ((voxelPalIndex * 2) & ~3u))
          >> ((voxelPalIndex & 1) == 0 ? 0 : 16);
        const uint palette_index = (palData >> 15) & 1;
        const uint paint_palette_row = palData & 0x7fff;

        half3 colorMul;
      ##if use_overlay_map
        if (paint_palette_row == 0x7fff) // overlay map
        {
          colorMul = 0; // artist request
          if (cliff_color_overlay_map_tex_exists)
          {
            float2 tc = saturate(worldPos.xz * cliff_color_overlay_map_scale_offset.xy + cliff_color_overlay_map_scale_offset.zw);
            colorMul = tex2Dlod(cliff_color_overlay_map_tex, float4(tc, 0, 0)).rgb;
            colorMul *= 2; // modulation hack, see INIT_CONST_COLOR_OVERRIDES
          }
        }
        else
      ##endif
        {
          ##if paint_details_tex != NULL
            uint paint_palette_col = IN.hashVal;
            uint2 dim;
            paint_details_tex.GetDimensions(dim.x, dim.y);
            dim.x >>= 1; // 2 palettes merged together, palette_index will select one of them (but stub textures may have only 1, hence the max 1 below)

            colorMul = texture2DAt(paint_details_tex,
              uint2(paint_palette_col % max(dim.x, 1) + dim.x * palette_index, paint_palette_row % dim.y)).rgb;
            colorMul *= COLOR_CORRECTION_MULTIPLIER;
          ##else
            colorMul = 1;
          ##endif
        }

        half4 color = texelFetch(color_tex, uint2(
          ((colorBlock << 2) % uint(color_tex_size.x)) | (itc.x & 3),
          (((colorBlock << 2) / uint(color_tex_size.x)) << 2) | (itc.y & 3)
          ), 0);
        color.rgb = RemoveSRGBCurve_Fast(color.rgb);
        color.rgb += colorMul * color.a * 2;

        half4 material = texelFetch(color_tex, uint2(
          ((matBlock << 2) % uint(color_tex_size.x)) | (itc.x & 3),
          (((matBlock << 2) / uint(color_tex_size.x)) << 2) | (itc.y & 3)
          ), 0);

        half2 packedNormal = texelFetch(normal_tex, uint2(
          ((normalBlock << 2) % uint(normal_tex_size.x)) | (itc.x & 3),
          (((normalBlock << 2) / uint(normal_tex_size.x)) << 2) | (itc.y & 3)
          ), 0).rg;

        half3 localNormal = octDecodeh((packedNormal - 128.0/255) * (255/127.0));
        half3 normal = normalize(IN.worldLocalX * localNormal.x + IN.worldLocalY * localNormal.y + IN.worldLocalZ * localNormal.z);

        // color.rgb = surfLayer == 0 ? color.rgb : half3(1, 0, 1); //== mark layers for debugging
        init_albedo(result, color.rgb);
        init_smoothness(result, material.x);
        init_reflectance(result, material.y);
        init_metalness(result, material.z);
        init_translucency(result, material.w);
        init_normal(result, normal);

        init_ao(result, 1);
        init_shadow(result, 1);

        init_material(result, SHADING_NORMAL);
        init_order(result, GBUFFER_ORDER_STATIC);

        return encode_gbuffer(result, p2e.xyz, screenpos);
      ##endif
    }
  }

  compile("target_ps", "voxel_ps");
endmacro
