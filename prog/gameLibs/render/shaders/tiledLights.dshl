include "shader_global.dshl"
include "clustered/lights_cb.dshl"
include "viewVecVS.dshl"
include "camera_in_camera.dshl"

float4x4 globtm_inv;
int has_conservative_rasterization = 0;
interval has_conservative_rasterization : no < 1, yes;

int use_downsampled_depth_in_tiled_lights = 0;
interval use_downsampled_depth_in_tiled_lights : no < 1, far_only < 2, far_and_close;

int spot_cones_vertex_slices = 8;
int spot_cones_vertex_stacks = 10;

shader spot_lights_tiles, omni_lights_tiles
{
  INIT_AND_USE_ON_TOP_CAMERA_IN_CAMERA(ps)

  supports global_frame;
  cull_mode = none;
  z_test = false;
  z_write = false;

  (vs) {
    globtm@f44 = globtm;
    inv_screen_size@f2 = screen_pos_to_texcoord;
  }

  hlsl(vs) {
    #include <tiled_light_consts.hlsli>

    float4 clip_to_tile_grid(float4 clip_pos)
    {
      float2 screenSize = round(rcp(inv_screen_size));
      float2 gridScale = screenSize / (TILE_EDGE * ceil(screenSize / TILE_EDGE));
      clip_pos.x = (clip_pos.x + clip_pos.w) * gridScale.x - clip_pos.w;
      clip_pos.y = clip_pos.w - (clip_pos.w - clip_pos.y) * gridScale.y;
      return clip_pos;
    }
  }

  hlsl {
    struct VsOutput
    {
      VS_OUT_POSITION(pos)

      nointerpolation uint index : TEXCOORD0;
      nointerpolation float4 sourceToEye : TEXCOORD1;
      ##if shader == spot_lights_tiles
        nointerpolation float4 cone : TEXCOORD2;
      ##elif use_downsampled_depth_in_tiled_lights != no
        #if !NO_OMNI_LIGHT_FADE
          nointerpolation float3 boxPos : TEXCOORD2;
          nointerpolation float3 box0   : TEXCOORD3;
          nointerpolation float3 box1   : TEXCOORD4;
          nointerpolation float3 box2   : TEXCOORD5;
        #endif
      ##endif
      ##if shader == omni_lights_tiles
        nointerpolation float4 lightClipRadius : TEXCOORD6;
        nointerpolation float3 clipGradX : TEXCOORD7;
        nointerpolation float3 clipGradY : TEXCOORD8;
        nointerpolation float3 clipGradW : TEXCOORD9;
      ##endif
    };

    // 5% on both sides
    #define BOX_RANGE 1.05f
    #define REV_BOX_RANGE (1.0f / BOX_RANGE)
  }

  INIT_ZNZFAR()

  if (shader == spot_lights_tiles)
  {
    INIT_SPOT_LIGHTS_CB(vs)

    local float spot_cones_circumscribe_scale = 1.0 / cos(PI / (spot_cones_vertex_stacks - 1));
    (vs) {
      spot_cones_vertex_slices@i1 = spot_cones_vertex_slices;
      spot_cones_vertex_stacks@i1 = spot_cones_vertex_stacks;
      spot_cones_circumscribe_scale_vec@f3 = (spot_cones_circumscribe_scale, 1, spot_cones_circumscribe_scale);

      if (has_conservative_rasterization == no)
      {
        globtm_inv@f44 = globtm_inv;
      }
    }
    hlsl(vs) {

      VsOutput spot_lights_tiles_vs(uint vertexId : SV_VertexID, uint instanceId : SV_InstanceID)
      {
        RenderSpotLight light = spot_lights_cb[instanceId];
        float3 e1 = abs(light.lightDirectionAngleOffset.z) < 0.9 ? float3(0, 0, 1) : float3(1, 0, 0);
        float3 e2 = normalize(cross(light.lightDirectionAngleOffset.xyz, e1));
        e1 = normalize(cross(light.lightDirectionAngleOffset.xyz, e2));

        float halfCos = -light.lightDirectionAngleOffset.w / abs(light.lightColorAngleScale.w);

        const float3 lightWorldPos = light.lightPos_halfRadius_halfCullRadius.xyz;
        float3 sourceToEye = world_view_pos - lightWorldPos;
        float radius = decode_spot_light_radius_and_culling_radius(light.lightPos_halfRadius_halfCullRadius.w).x;

        int stackNo = vertexId % spot_cones_vertex_stacks;
        float ang = 2.0f * M_PI * float(stackNo) / (spot_cones_vertex_stacks - 1);
        float3 vertexPos = 0;

        vertexPos.x = cos(ang);
        vertexPos.z = sin(ang);

        ##if has_conservative_rasterization == no
          float3 noConservativeRasterizationShift = vertexPos;
        ##endif

        float lerpParam = 1;
        float halfTan = 0;
        float3 vertexPosNormalized = 0;
        const float CONE_SCALE_MULTIPLIER = 1.05;

        int sliceNo = vertexId / spot_cones_vertex_stacks;
        if (sliceNo == 0)
        {
          vertexPos.xz = 0;
        }
        else
        {
          lerpParam = float(sliceNo - 1) / float(spot_cones_vertex_slices - 2);

          float localHalfCos = saturate(lerp(halfCos, 1, lerpParam));

          halfTan = sqrt(1 / pow2(localHalfCos) - 1);
          float halfWidth = halfTan;

          vertexPos.xz *= halfWidth;
          vertexPos.y = 1;
          vertexPosNormalized = normalize(vertexPos);
          vertexPos = vertexPosNormalized * radius * CONE_SCALE_MULTIPLIER;
          vertexPos *= spot_cones_circumscribe_scale_vec;
        }

        float3 worldPos = lightWorldPos + vertexPos.x * e1 + vertexPos.z * e2 +
                                          vertexPos.y * light.lightDirectionAngleOffset.xyz;

        ##if has_conservative_rasterization == no
          float4 worldPosProjected = mul(float4(worldPos, 1), globtm);
          worldPosProjected /= worldPosProjected.w;
          worldPosProjected.xy -= TILE_EDGE * inv_screen_size;
          float4 worldPosPosShifted = mul(worldPosProjected, globtm_inv);
          worldPosPosShifted /= worldPosPosShifted.w;
          float noConservativeRasterizationExpansion = distance(worldPos, worldPosPosShifted.xyz);

          noConservativeRasterizationShift.y = -halfTan;

          float3 vertexPosCorrection = sliceNo == 0 ?
            float3(0, -1, 0) : // downward apex shift
            vertexPosNormalized * CONE_SCALE_MULTIPLIER * spot_cones_circumscribe_scale_vec
              + normalize(noConservativeRasterizationShift) * (1 - lerpParam); // outward cone surface shift

          vertexPosCorrection *= noConservativeRasterizationExpansion;

          worldPos += vertexPosCorrection.x * e1 + vertexPosCorrection.z * e2 +
                      vertexPosCorrection.y * light.lightDirectionAngleOffset.xyz;
        ##endif

        VsOutput output;
        output.pos = clip_to_tile_grid(mul(float4(worldPos, 1), globtm));
        output.pos.z = max(0.0000001, output.pos.z);
        output.index = instanceId + OMNI_DWORDS_PER_TILE * BITS_IN_UINT;
        output.cone = float4(light.lightDirectionAngleOffset.xyz, pow2(halfCos));
        output.sourceToEye.xyz = sourceToEye;
        output.sourceToEye.w = pow2(radius) - dot(sourceToEye, sourceToEye);
        return output;
      }
    }
    compile("target_vs", "spot_lights_tiles_vs");
  }
  else
  {
    INIT_AND_USE_PHOTOMETRY_TEXTURES(vs)
    INIT_AND_USE_OMNI_LIGHTS_CB(vs)
    if (has_conservative_rasterization == no)
    {
      hlsl(vs) {
        float get_no_conservative_rasterization_expansion(float3 world_pos)
        {
          float w = mul(float4(world_pos, 1), globtm).w;
          if (w <= 0)
            return 0;
          float3 gradX = float3(globtm[0].x, globtm[1].x, globtm[2].x);
          float3 gradY = float3(globtm[0].y, globtm[1].y, globtm[2].y);
          float3 gradW = float3(globtm[0].w, globtm[1].w, globtm[2].w);
          float gradWLenSq = max(dot(gradW, gradW), 1e-12);
          float projScaleXSq = max(dot(gradX, gradX) - pow2(dot(gradX, gradW)) / gradWLenSq, 1e-20);
          float projScaleYSq = max(dot(gradY, gradY) - pow2(dot(gradY, gradW)) / gradWLenSq, 1e-20);
          float2 halfTileNdc = TILE_EDGE * inv_screen_size;
          return w * sqrt(pow2(halfTileNdc.x) / projScaleXSq + pow2(halfTileNdc.y) / projScaleYSq);
        }
      }
    }
    hlsl(vs)
    {
      static const float MIN_INV_BOX_AXIS_LEN_SQ = 1e-12;
      // Must stay below znear: the proxy parts closer than this can light no visible pixel.
      static const float OMNI_TILES_MIN_CLIP_W = 1e-4;

      // One row per cube face (-x, +x, -y, +y, -z, +z), two triangles each.
      static const uint OMNI_TILES_CUBE_CORNERS[OMNI_TILES_CUBE_VERTICES] = {
        0, 2, 6, 0, 6, 4,
        1, 5, 7, 1, 7, 3,
        0, 4, 5, 0, 5, 1,
        2, 3, 7, 2, 7, 6,
        0, 1, 3, 0, 3, 2,
        4, 6, 7, 4, 7, 5
      };

      VsOutput omni_lights_tiles_vs(uint vertexId : SV_VertexID, uint instanceId : SV_InstanceID)
      {
        RenderOmniLight light = omni_lights_cb[instanceId];
        light.posRadius.w = light.posRelToOrigin_cullRadius.w > 0.0f ? light.posRelToOrigin_cullRadius.w : light.posRadius.w;

        VsOutput output;
        float radius = light.posRadius.w;
        float3 proxyCenter = light.posRadius.xyz;
        float3x3 proxyHalfAxes = float3x3(radius, 0, 0, 0, radius, 0, 0, 0, radius);
        float3x3 proxyAxisDirs = float3x3(1, 0, 0, 0, 1, 0, 0, 0, 1);
        bool proxyEmpty = false;

        #if !NO_OMNI_LIGHT_FADE
          float3 boxPos = float3(light.boxR0.w, light.boxR1.w, light.boxR2.w);
          float3x3 boxInvAxes = float3x3(light.boxR0.x, light.boxR1.x, light.boxR2.x,
                                         light.boxR0.y, light.boxR1.y, light.boxR2.y,
                                         light.boxR0.z, light.boxR1.z, light.boxR2.z);
          float3 invAxesLenSq = float3(dot(boxInvAxes[0], boxInvAxes[0]), dot(boxInvAxes[1], boxInvAxes[1]),
                                       dot(boxInvAxes[2], boxInvAxes[2]));
          bool hasBox = dot(boxPos, boxPos) > 0 && all(invAxesLenSq >= MIN_INV_BOX_AXIS_LEN_SQ);

          ##if use_downsampled_depth_in_tiled_lights != no
            output.boxPos = hasBox ? boxPos - world_view_pos : 0;
            output.box0 = light.boxR0.xyz;
            output.box1 = light.boxR1.xyz;
            output.box2 = light.boxR2.xyz;
          ##endif

          BRANCH
          if (hasBox)
          {
            float3 lightCenterInBox = 2 * mul(boxInvAxes, light.posRadius.xyz - boxPos);
            float3 sphereHalfSizeInBox = 2 * light.posRadius.w * sqrt(invAxesLenSq);
            float3 lo = max(lightCenterInBox - sphereHalfSizeInBox, -BOX_RANGE);
            float3 hi = min(lightCenterInBox + sphereHalfSizeInBox, BOX_RANGE);
            proxyEmpty = any(lo > hi);
            float3 midInBox = 0.5 * (lo + hi);
            float3 halfSizeInBox = 0.5 * (hi - lo);
            float3x3 halfBoxAxes = 0.5 * float3x3(boxInvAxes[0] / invAxesLenSq.x, boxInvAxes[1] / invAxesLenSq.y,
                                                  boxInvAxes[2] / invAxesLenSq.z);
            UNROLL
            for (uint axis = 0; axis < 3; ++axis)
            {
              float3 boxAxisDir = boxInvAxes[axis] * rsqrt(invAxesLenSq[axis]);
              proxyHalfAxes[axis] = boxAxisDir * (halfSizeInBox[axis] * length(halfBoxAxes[axis]));
              proxyAxisDirs[axis] = boxAxisDir;
            }
            proxyCenter = boxPos + mul(midInBox, halfBoxAxes);
          }
        #endif

        // With the z below nothing clips at the near plane, so drop a sphere wholly between the eye and it (z > w with reverse Z):
        // it lights no visible pixel, and the PS tests only the side planes of a tile.
        float4 lightCenterClip = mul(float4(light.posRadius.xyz, 1), globtm);
        float3 nearPlaneNormal = float3(globtm[0].z - globtm[0].w, globtm[1].z - globtm[1].w, globtm[2].z - globtm[2].w);
        proxyEmpty = proxyEmpty || lightCenterClip.z - lightCenterClip.w > OMNI_TILES_NEAR_CULL_RADIUS_SCALE * light.posRadius.w * length(nearPlaneNormal);

        uint corner = OMNI_TILES_CUBE_CORNERS[vertexId];
        // Bits 0, 1, 2 of the corner index give the x, y, z side of the corner: 0 is -1, 1 is +1.
        float3 cubePos = float3(corner & 1, (corner >> 1) & 1, (corner >> 2) & 1) * 2 - 1;
        float3 worldPos = proxyCenter + mul(cubePos, proxyHalfAxes);
        ##if has_conservative_rasterization == no
          worldPos += get_no_conservative_rasterization_expansion(worldPos) * mul(cubePos, proxyAxisDirs);
        ##endif

        output.pos = proxyEmpty ? float4(-2, -2, 0, 1) : clip_to_tile_grid(mul(float4(worldPos, 1), globtm));
        // The pass has no depth test: this z leaves only the clip plane w = OMNI_TILES_MIN_CLIP_W, so the near and far
        // planes do not cut the proxy, and the clip plane does not go through the eye, where clipping depends on the GPU.
        output.pos.z = 0.5 * (output.pos.w - OMNI_TILES_MIN_CLIP_W);
        output.index = instanceId;
        float3 sourceToEye = world_view_pos - light.posRadius.xyz;
        float3 gradX = float3(globtm[0].x, globtm[1].x, globtm[2].x);
        float3 gradY = float3(globtm[0].y, globtm[1].y, globtm[2].y);
        float3 gradW = float3(globtm[0].w, globtm[1].w, globtm[2].w);
        // The eye has clip xyw = 0 in perspective, so the eye-relative form keeps the precision far from the origin.
        // In ortho w = 1 at the eye, so only the full transform works there.
        float3 lightClipXYW = dot(gradW, gradW) > 0 ? -float3(dot(sourceToEye, gradX), dot(sourceToEye, gradY), dot(sourceToEye, gradW))
                                                    : lightCenterClip.xyw;
        output.lightClipRadius = float4(lightClipXYW, light.posRadius.w);
        output.clipGradX = gradX;
        output.clipGradY = gradY;
        output.clipGradW = gradW;
        output.sourceToEye.xyz = sourceToEye;
        output.sourceToEye.w = pow2(light.posRadius.w) - dot(sourceToEye, sourceToEye);
        return output;
      }
    }
    compile("target_vs", "omni_lights_tiles_vs");
  }

  (ps) {
    downsampled_far_depth_tex@smp2d = downsampled_far_depth_tex;
    close_depth_tex@tex2d = downsampled_close_depth_tex;
    screen_size@f4 = (1. / screen_pos_to_texcoord.x, 1. / screen_pos_to_texcoord.y, screen_pos_to_texcoord.x, screen_pos_to_texcoord.y);

    perTileLights@uav : register(1) hlsl {
      RWStructuredBuffer<uint> perTileLights@uav;
    }
  }
  USE_AND_INIT_VIEW_VEC(ps)

  hlsl(ps) {
    #include <tiled_light_consts.hlsli>

    bool check_ray_light_intersection(VsOutput input, float2 depth_min_max, float3 view_vec)
    {
      float sphereD2 = pow2(dot(view_vec, input.sourceToEye.xyz)) + input.sourceToEye.w * dot(view_vec, view_vec);
      BRANCH
      if (sphereD2 < 0)
        return false;
      float sphereD = sqrt(sphereD2);
      float t1 = (-dot(view_vec, input.sourceToEye.xyz) - sphereD) / dot(view_vec, view_vec);
      float t2 = (-dot(view_vec, input.sourceToEye.xyz) + sphereD) / dot(view_vec, view_vec);

##if shader == spot_lights_tiles
      float a = pow2(dot(view_vec, input.cone.xyz)) - input.cone.w * dot(view_vec, view_vec);
      float b = (dot(input.sourceToEye.xyz, input.cone.xyz) * dot(view_vec, input.cone.xyz) - dot(view_vec, input.sourceToEye.xyz) * input.cone.w) / a;
      float c = (pow2(dot(input.sourceToEye.xyz, input.cone.xyz)) - dot(input.sourceToEye.xyz, input.sourceToEye.xyz) * input.cone.w) / a;
      float coneD2 = pow2(b) - c;
      if (coneD2 < 0)
        return false;
      float coneD = sqrt(coneD2);
      float coneT1 = (-b - coneD);
      float coneT2 = (-b + coneD);
      if (dot(input.cone.xyz, normalize(input.sourceToEye.xyz + view_vec * coneT1)) < 0)
      {
        t1 = max(t1, coneT2);
      }
      else if (dot(input.cone.xyz, normalize(input.sourceToEye.xyz + view_vec * coneT2)) < 0)
      {
        t2 = min(t2, coneT1);
      }
      else
      {
        t1 = max(t1, coneT1);
        t2 = min(t2, coneT2);
      }
##else
      #if !NO_OMNI_LIGHT_FADE
        ##if use_downsampled_depth_in_tiled_lights != no
          BRANCH
          if (dot(input.boxPos, input.boxPos) > 0) // we don't want to check length of every component of matrix, so check box pos only
          {
            float3 posClose = depth_min_max.x * view_vec - input.boxPos;
            float3 posFar = depth_min_max.y * view_vec - input.boxPos;

            half3 posInBoxClose = REV_BOX_RANGE * 2 * (input.box0.xyz * posClose.x + input.box1.xyz * posClose.y + input.box2.xyz * posClose.z);
            half3 posInBoxFar   = REV_BOX_RANGE * 2 * (input.box0.xyz * posFar.x   + input.box1.xyz * posFar.y   + input.box2.xyz * posFar.z);

            // tricky check:
            // we already know that infinite ray is intersecting the box (we assume that in VS), so we need to check
            // only is our close-far ray intersecting it.
            // if far and close points are on different sides of box, we have negative value -> valid pixel
            // if far or close point have coodrs in box in -1..1 range, its valid pixel, and mul is less than 1
            float3 boxMul = clamp(posInBoxClose, -1, 1) * clamp(posInBoxFar, -1, 1);

            if (boxMul.x == 1 || boxMul.y == 1 || boxMul.z == 1)
              return false;
          }
        ##endif
      #endif
##endif

      const float EPS = 1e-5;
      return depth_min_max.x < t2 + EPS && depth_min_max.y > t1 - EPS;
    }

##if shader == omni_lights_tiles
    float4 dot_with_planes(float3 v, float3 plane_dirs[4])
    {
      return float4(dot(v, plane_dirs[0]), dot(v, plane_dirs[1]), dot(v, plane_dirs[2]), dot(v, plane_dirs[3]));
    }

    bool is_sphere_in_tile(VsOutput input, float2 ndc_min, float2 ndc_max)
    {
      float3 lightClipXYW = input.lightClipRadius.xyz;
      float lightRadius = input.lightClipRadius.w;

      float4 planeNdc = float4(ndc_min.x, ndc_max.x, ndc_min.y, ndc_max.y);
      float4 planeInsideSign = float4(1.0, -1.0, 1.0, -1.0);
      float4 planeValue = planeInsideSign * (lightClipXYW.xxyy - planeNdc * lightClipXYW.z);
      float3 planeNormals[4] = {input.clipGradX - planeNdc.x * input.clipGradW, -(input.clipGradX - planeNdc.y * input.clipGradW),
                                input.clipGradY - planeNdc.z * input.clipGradW, -(input.clipGradY - planeNdc.w * input.clipGradW)};
      float3 planeDirs[4];
      float4 centerToPlaneDist;
      UNROLL
      for (uint plane = 0; plane < 4; ++plane)
      {
        float invNormalLen = rsqrt(max(dot(planeNormals[plane], planeNormals[plane]), 1e-20));
        planeDirs[plane] = planeNormals[plane] * invNormalLen;
        centerToPlaneDist[plane] = planeValue[plane] * invNormalLen;
      }

      bool isSphereOutsideAnyPlane = any(centerToPlaneDist < -lightRadius);
      BRANCH
      if (isSphereOutsideAnyPlane)
        return false;

      bool isCenterInTilePyramid = all(centerToPlaneDist >= 0);
      BRANCH
      if (isCenterInTilePyramid)
        return true;

      float insideEps = 1e-3 * lightRadius;
      bool doesSphereTouchPyramid = false;

      UNROLL
      for (uint face = 0; face < 4; ++face)
      {
        float3 centerToProjection = -centerToPlaneDist[face] * planeDirs[face];
        float4 projectionToPlaneDist = centerToPlaneDist + dot_with_planes(centerToProjection, planeDirs);
        bool isClosestPointOnFace = centerToPlaneDist[face] < 0 && all(projectionToPlaneDist >= -insideEps);
        doesSphereTouchPyramid = doesSphereTouchPyramid || isClosestPointOnFace;
      }

      UNROLL
      for (uint xPlane = 0; xPlane < 2; ++xPlane)
        UNROLL
        for (uint yPlane = 2; yPlane < 4; ++yPlane)
        {
          float cosEdge = dot(planeDirs[xPlane], planeDirs[yPlane]);
          float sinEdgeSq = max(1.0 - cosEdge * cosEdge, 1e-6);
          float stepAlongXNormal = (centerToPlaneDist[xPlane] - cosEdge * centerToPlaneDist[yPlane]) / sinEdgeSq;
          float stepAlongYNormal = (centerToPlaneDist[yPlane] - cosEdge * centerToPlaneDist[xPlane]) / sinEdgeSq;
          float3 centerToEdgePoint = -(stepAlongXNormal * planeDirs[xPlane] + stepAlongYNormal * planeDirs[yPlane]);
          float4 edgePointToPlaneDist = centerToPlaneDist + dot_with_planes(centerToEdgePoint, planeDirs);
          bool isClosestPointOnEdge = all(edgePointToPlaneDist >= -insideEps);
          bool isEdgePointInSphere = dot(centerToEdgePoint, centerToEdgePoint) <= lightRadius * lightRadius;
          doesSphereTouchPyramid = doesSphereTouchPyramid || (isClosestPointOnEdge && isEdgePointInSphere);
        }

      bool isPerspective = dot(input.clipGradW, input.clipGradW) > 0;
      bool isApexInSphere = input.sourceToEye.w >= 0;
      return doesSphereTouchPyramid || (isPerspective && isApexInSphere);
    }

##endif

    void light_tiles_ps(VsOutput input INPUT_VFACE HW_USE_SCREEN_POS)
    {
      float4 screenpos = GET_SCREEN_POS(input.pos);
      screenpos.xy = floor(screenpos.xy); // Get rid of the .5 for  the viewVec logic

      float2 tileUvSize = screen_size.zw * TILE_EDGE;
      DISCARD_IF_TILE_INVALID_VIEW_AREA_PS(screenpos.xy * tileUvSize, tileUvSize);

      uint2 tileIdx = screenpos.xy;
      ##if shader == omni_lights_tiles
        float2 tilePixMin = tileIdx * TILE_EDGE;
        float2 tilePixMax = tilePixMin + TILE_EDGE;
        float2 ndcMin = float2(tilePixMin.x, tilePixMax.y) * screen_size.zw * float2(2, -2) + float2(-1, 1);
        float2 ndcMax = float2(tilePixMax.x, tilePixMin.y) * screen_size.zw * float2(2, -2) + float2(-1, 1);
        BRANCH
        if (!is_sphere_in_tile(input, ndcMin, ndcMax))
          return;
      ##endif
      uint2 depthTile = tileIdx;
      uint2 tiledGridSize = (screen_size.xy + TILE_EDGE - 1) / TILE_EDGE;
      depthTile = select(tileIdx * TILE_EDGE + TILE_EDGE - 1 < screen_size.xy, depthTile, depthTile - 1);
      uint index = input.index;
      uint finalIdx = (tileIdx.x * tiledGridSize.y + (tileIdx.y)) * DWORDS_PER_TILE + (index / BITS_IN_UINT);
      ##if use_downsampled_depth_in_tiled_lights == no
        InterlockedOr(structuredBufferAt(perTileLights, finalIdx), 1u << (index % BITS_IN_UINT));
      ##else
        depthTile = int2(depthTile);
        float farDepth = texelFetch(downsampled_far_depth_tex, depthTile, DIVIDE_RESOLUTION_BITS - 1).x;
        farDepth = linearize_z(farDepth, zn_zfar.zw);
        ##if use_downsampled_depth_in_tiled_lights == far_and_close
          float closeDepth = texelFetch(close_depth_tex, depthTile, DIVIDE_RESOLUTION_BITS - 1).x;
          closeDepth = linearize_z(closeDepth, zn_zfar.zw);
        ##else
          float closeDepth = 0;
        ##endif
        float3 viewVecTileLT = lerp_view_vec(screenpos.xy * screen_size.zw * TILE_EDGE);
        float3 viewVecTileLB = lerp_view_vec((screenpos.xy + float2(0, 1)) * screen_size.zw * TILE_EDGE);
        float3 viewVecTileRT = lerp_view_vec((screenpos.xy + float2(1, 0)) * screen_size.zw * TILE_EDGE);
        float3 viewVecTileRB = lerp_view_vec((screenpos.xy + float2(1, 1)) * screen_size.zw * TILE_EDGE);
        if (
          check_ray_light_intersection(input, float2(closeDepth, farDepth), viewVecTileLT)
          || check_ray_light_intersection(input, float2(closeDepth, farDepth), viewVecTileLB)
          || check_ray_light_intersection(input, float2(closeDepth, farDepth), viewVecTileRT)
          || check_ray_light_intersection(input, float2(closeDepth, farDepth), viewVecTileRB))
          InterlockedOr(structuredBufferAt(perTileLights, finalIdx), 1u << (index % BITS_IN_UINT));
      ##endif
    }
  }
  compile("target_ps", "light_tiles_ps");
}

buffer z_binning_lookup;
buffer z_binning_begins_ends_buf;

shader tiled_lights_zbinning_clear_cs
{
  (cs) {
    z_binning_begins_ends_buf@uav = z_binning_begins_ends_buf hlsl { RWStructuredBuffer<uint2> z_binning_begins_ends_buf@uav; };
  }

  hlsl(cs) {

    #include <tiled_light_consts.hlsli>
    #include <renderLightsConsts.hlsli>

    [numthreads(Z_BINNING_GROUP_SIZE, 1, 1)]
    void main(uint3 dispatch_thread_id : SV_DispatchThreadID)
    {
      if (dispatch_thread_id.x >= (uint)(2 * Z_BINS_COUNT))
        return;

      bool isSpot = dispatch_thread_id.x >= (uint)Z_BINS_COUNT;
      uint maxId = isSpot ? MAX_CLUSTERED_SPOT_LIGHTS : MAX_CLUSTERED_OMNI_LIGHTS;
      uint2 beginEndIdx = uint2(maxId, 0);

      structuredBufferAt(z_binning_begins_ends_buf, dispatch_thread_id.x) = beginEndIdx;
    }
  }

  compile("target_cs", "main");
}

shader tiled_lights_zbinning_pack_cs
{
  (cs) {
    z_binning_begins_ends_buf@buf = z_binning_begins_ends_buf hlsl { StructuredBuffer<uint2> z_binning_begins_ends_buf@buf; };
    z_binning_lookup@uav = z_binning_lookup hlsl { RWStructuredBuffer<uint> z_binning_lookup@uav; };
  }

  hlsl(cs) {

    #include <tiled_light_consts.hlsli>

    [numthreads(Z_BINNING_GROUP_SIZE, 1, 1)]
    void main(uint3 dispatch_thread_id : SV_DispatchThreadID)
    {
      if (dispatch_thread_id.x >= (uint)(2 * Z_BINS_COUNT))
        return;

      uint2 beginEndIdx = structuredBufferAt(z_binning_begins_ends_buf, dispatch_thread_id.x);
      structuredBufferAt(z_binning_lookup, dispatch_thread_id.x) = (beginEndIdx.x << 16) | beginEndIdx.y;
    }
  }

  compile("target_cs", "main");
}

float max_lights_distance;
float4 zbinning_view_pos;
float4 zbinning_view_dir;

shader tiled_lights_zbinning_cs
{
  INIT_OMNI_LIGHTS_CB(cs)
  INIT_SPOT_LIGHTS_CB(cs)
  USE_CLUSTERED_LIGHTS(cs)
  USE_OMNI_LIGHTS_BOUNDS(cs)
  USE_SPOT_LIGHTS_BOUNDS(cs)

  (cs) {
    max_lights_distance@f1 = max_lights_distance;
    view_pos@f3 = zbinning_view_pos;
    view_dir@f3 = zbinning_view_dir;
    z_binning_begins_ends_buf@uav = z_binning_begins_ends_buf hlsl { RWStructuredBuffer<uint2> z_binning_begins_ends_buf@uav; };
  }

  hlsl(cs) {

    #include <tiled_light_consts.hlsli>
    #include <renderLightsConsts.hlsli>

    groupshared float4 lightData[Z_BINNING_LIGHTS_BLOCK_SIZE];

    float4 get_light_cb_data(uint idx, bool is_spot)
    {
      BRANCH
      if (is_spot)
      {
        ##assert(idx < spotLightsCount, "spot_lights_cb OOB access. index = %f", idx);
        return getSpotLightBoundingSphere(spot_lights_cb[idx]);
      }
      ##assert(idx < omniLightsCount, "omni_lights_cb OOB access. index = %f", idx);
      return getOmniLightBoundingSphere(omni_lights_cb[idx]);
    };

    [numthreads(Z_BINNING_GROUP_SIZE, 1, 1)]
    void main(
        uint3 dispatch_thread_id : SV_DispatchThreadID,
        uint3 group_thread_id : SV_GroupThreadID,
        uint3 group_id : SV_GroupID
    )
    {
      uint omniBlocksCount = (omniLightsCount + Z_BINNING_LIGHTS_BLOCK_SIZE - 1) / Z_BINNING_LIGHTS_BLOCK_SIZE;
      bool isSpot = group_id.y >= omniBlocksCount;
      uint blockIdx = isSpot ? group_id.y - omniBlocksCount : group_id.y;
      uint lightsCount = isSpot ? spotLightsCount : omniLightsCount;

      uint startIndex = (uint)(Z_BINNING_LIGHTS_BLOCK_SIZE * blockIdx);
      uint preloadLightIndex = startIndex + group_thread_id.x;

      if ((group_thread_id.x < (uint)Z_BINNING_LIGHTS_BLOCK_SIZE) && (preloadLightIndex < lightsCount))
        lightData[group_thread_id.x] = get_light_cb_data(preloadLightIndex, isSpot);

      GroupMemoryBarrierWithGroupSync();

      if (dispatch_thread_id.x >= (uint)Z_BINS_COUNT)
        return;

      uint binLocalIdx = dispatch_thread_id.x;
      float distScale = (float)Z_BINS_COUNT / max_lights_distance;

      uint binLUTIdx = isSpot ? binLocalIdx + (uint)Z_BINS_COUNT : binLocalIdx;
      uint maxLightsCount = isSpot ? (uint)MAX_CLUSTERED_SPOT_LIGHTS : (uint)MAX_CLUSTERED_OMNI_LIGHTS;

      uint beginIdx = maxLightsCount;
      uint endIdx = 0;

      UNROLL
      for (uint j = 0; j < Z_BINNING_LIGHTS_BLOCK_SIZE; ++j)
      {
        uint lightIndex = startIndex + j;
        float3 lightPos = lightData[j].xyz;
        float radius = lightData[j].w;

        float depth = dot(view_dir, lightPos - view_pos);
        float minDepth = depth - radius;
        float maxDepth = depth + radius;
        int minBin = clamp(int(minDepth * distScale), 0, Z_BINS_COUNT);
        int maxBin = clamp(int(maxDepth * distScale), 0, Z_BINS_COUNT - 1);

        bool currentBinInLightRange = (lightIndex < lightsCount && minBin < Z_BINS_COUNT && (int)binLocalIdx >= minBin && (int)binLocalIdx <= maxBin);
        uint newBeginIdx = currentBinInLightRange ? lightIndex : beginIdx;
        uint newEndIdx = currentBinInLightRange ? lightIndex : endIdx;

        beginIdx = min(beginIdx, newBeginIdx);
        endIdx = max(endIdx, newEndIdx);
      }

      InterlockedMin(structuredBufferAt(z_binning_begins_ends_buf, binLUTIdx).x, beginIdx);
      InterlockedMax(structuredBufferAt(z_binning_begins_ends_buf, binLUTIdx).y, endIdx);
    }
  }

  compile("target_cs", "main");
}