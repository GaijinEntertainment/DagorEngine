int dynamic_lights_count = 0;
interval dynamic_lights_count: lights_off<1, lights_omni_1<2, lights_spot_1<3, lights_omnispot_1<4, lights_clustered;

bool dynamic_lights_has_omni = dynamic_lights_count != lights_off && dynamic_lights_count != lights_spot_1;
bool dynamic_lights_has_spot = dynamic_lights_count != lights_off && dynamic_lights_count != lights_omni_1;
bool dynamic_lights_omni_1 = dynamic_lights_count == lights_omni_1 || dynamic_lights_count == lights_omnispot_1;
bool dynamic_lights_spot_1 = dynamic_lights_count == lights_spot_1 || dynamic_lights_count == lights_omnispot_1;
