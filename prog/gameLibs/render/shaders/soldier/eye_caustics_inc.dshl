include "static_shadow.dshl"
include "sq_clouds_shadow.dshl"
include "csm.dshl"
include "use_tiled_lights.dshl"

float eye_caustics_strength_mul = 1;
float eye_caustics_light_lerp_mul = 1;
float eye_caustics_focal_offset_mul = 1;
float eye_caustics_iris_radius_mul = 1;
float eye_caustics_falloff_mul = 1;
float eye_caustics_concavity_mul = 1;
float eye_caustics_sun_mul = 1;
float eye_caustics_omni_mul = 1;
float eye_caustics_spot_mul = 1;
float eye_caustics_shadow_offset_mul = 1;
float eye_caustics_use_shadows = 1;


macro DECLARE_EYE_CAUSTICS()
  static float eye_caustics_strength = 1.3;
  static float eye_caustics_light_lerp_factor = 0.1;
  static float eye_caustics_focal_point_offset = 0.1;
  static float eye_caustics_iris_radius = 0.18;
  static float eye_caustics_falloff_strength = 0.6;
  static float eye_caustics_concavity_scale = 6.0;
  static float eye_caustics_shadow_offset = 0.03;
  static float eye_caustics_sun_shadow_offset = 0.7;
endmacro


macro INIT_EYE_CAUSTICS(need_init_shadows)
  if (in_editor_assume == no)
  {
    (ps)
    {
      eye_caustics_strength@f1 = eye_caustics_strength;
      eye_caustics_light_lerp_factor@f1 = eye_caustics_light_lerp_factor;
      eye_caustics_focal_point_offset@f1 = eye_caustics_focal_point_offset;
      eye_caustics_iris_radius@f1 = eye_caustics_iris_radius;
      eye_caustics_falloff_strength@f1 = eye_caustics_falloff_strength;
      eye_caustics_concavity_scale@f1 = eye_caustics_concavity_scale;
      eye_caustics_shadow_offset@f1 = eye_caustics_shadow_offset;
      eye_caustics_sun_shadow_offset@f1 = eye_caustics_sun_shadow_offset;
      eye_caustics_strength_mul@f1 = eye_caustics_strength_mul;
      eye_caustics_light_lerp_mul@f1 = eye_caustics_light_lerp_mul;
      eye_caustics_focal_offset_mul@f1 = eye_caustics_focal_offset_mul;
      eye_caustics_iris_radius_mul@f1 = eye_caustics_iris_radius_mul;
      eye_caustics_falloff_mul@f1 = eye_caustics_falloff_mul;
      eye_caustics_concavity_mul@f1 = eye_caustics_concavity_mul;
      eye_caustics_sun_mul@f1 = eye_caustics_sun_mul;
      eye_caustics_omni_mul@f1 = eye_caustics_omni_mul;
      eye_caustics_spot_mul@f1 = eye_caustics_spot_mul;
      eye_caustics_shadow_offset_mul@f1 = eye_caustics_shadow_offset_mul;
      eye_caustics_use_shadows@f1 = eye_caustics_use_shadows;
    }
    if (need_init_shadows)
    {
      INIT_STATIC_SHADOW_BASE_ONE_CASCADE(ps)
      INIT_CSM_SHADOW(ps)
      SQ_INIT_CLOUDS_SHADOW(ps)
    }
    INIT_TILED_LIGHTS(ps)

    if (dynamic_lights_count != lights_off)
    {
      (ps)
      {
        screen_size@f2 = (1./screen_pos_to_texcoord.x, 1./screen_pos_to_texcoord.y,0,0);
      }
    }
  }
endmacro


macro USE_EYE_CAUSTICS()
  hlsl(ps)
  {
    struct CausticsInput
    {
      float3x3 eyeRotationTm;
      float3 vertexNormal;
      float viewDepth;
      float3 pointToEye;
      float2 diffuseTexcoord;
      float2 screenpos;

      // cached:
      float irisPlaneDistance;
      float falloffStrength;
    };


    #define eye_caustics_strength           (get_eye_caustics_strength() * get_eye_caustics_strength_mul())
    #define eye_caustics_light_lerp_factor  (get_eye_caustics_light_lerp_factor() * get_eye_caustics_light_lerp_mul())
    #define eye_caustics_focal_point_offset (get_eye_caustics_focal_point_offset() * get_eye_caustics_focal_offset_mul())
    #define eye_caustics_iris_radius        (get_eye_caustics_iris_radius() * get_eye_caustics_iris_radius_mul())

    #define eye_caustics_falloff_strength   (get_eye_caustics_falloff_strength() * get_eye_caustics_falloff_mul())
    #define eye_caustics_concavity_scale    (get_eye_caustics_concavity_scale() * get_eye_caustics_concavity_mul())
    #define eye_caustics_shadow_offset      (get_eye_caustics_shadow_offset() * get_eye_caustics_shadow_offset_mul())
    #define eye_caustics_sun_shadow_offset  (get_eye_caustics_sun_shadow_offset() * get_eye_caustics_shadow_offset_mul())
    #define eye_caustics_sun_mul            get_eye_caustics_sun_mul()
    #define eye_caustics_omni_mul           get_eye_caustics_omni_mul()
    #define eye_caustics_spot_mul           get_eye_caustics_spot_mul()
    #define eye_caustics_use_shadows        get_eye_caustics_use_shadows()
  }

  if (in_editor_assume == no)
  {
    USE_STATIC_SHADOW_ONE_CASCADE(ps)
    USE_CSM_SHADOW_DEF_NUM_DEFAULT()
    SQ_CLOUDS_SHADOW(ps)

    hlsl(ps)
    {
      float calculate_eye_caustics(CausticsInput input, float3 lightDirWS)
      {
        float3 eyeForward = input.eyeRotationTm._31_32_33;
        lightDirWS = normalize(lerp(lightDirWS, eyeForward, eye_caustics_light_lerp_factor));
        float3 lightDirTS = mul(input.eyeRotationTm, lightDirWS);
        float2 focalPoint = 0.5 - lightDirTS.xy * eye_caustics_focal_point_offset;

        const float EPS = 0.00001;
        float irisPlaneDistance = input.irisPlaneDistance;
        float lightPlaneDist = length(lightDirTS.xy);
        float causticsRadiusInv = 1.0 / max(lerp(eye_caustics_iris_radius, input.falloffStrength, irisPlaneDistance * lightPlaneDist), EPS);

        float focalDist = length(input.diffuseTexcoord - focalPoint);
        float causticsIrisMask = pow2(max(1.0 - focalDist * causticsRadiusInv, 0));
        float lightFocusTerm = pow2(max(eye_caustics_iris_radius * causticsRadiusInv, 1.0));
        float3 causticNormal = normalize(lerp(eyeForward, -input.vertexNormal, 0.5*saturate(irisPlaneDistance * eye_caustics_concavity_scale)));
        float diffuseTerm = max(dot(causticNormal, lightDirWS), 0);

        return causticsIrisMask * lightFocusTerm * diffuseTerm;
      }

    }

    if (dynamic_lights_count != lights_off)
    {
      USE_PHOTOMETRY_TEXTURES(ps)
      USE_CLUSTERED_LIGHTS(ps)
      USE_OMNI_LIGHTS_CB(ps)
      USE_LIGHT_SHADOWS(ps)
      USE_COMMON_LIGHTS_SHADOWS_CB(ps)
    }

    hlsl(ps)
    {
      #define inv_lights_distance lights_distance.y

      #define WAVE_OR(v) (v)
      #define WAVE_MIN(v) (v)
      #define WAVE_MAX(v) (v)
    }
    USE_TILED_LIGHTS_HELPERS(ps)

    hlsl(ps)
    {
      #include <clustered/punctualLightsMath.hlsl>
##if (dynamic_lights_count != lights_off)
      void shade_caustics_omni_light(uint omni_light_index, CausticsInput input, float3 worldPos, inout float caustics, inout float3 caustics_color)
      {
        RenderOmniLight ol = omni_lights_cb[omni_light_index];
        float4 pos_and_radius = ol.posRadius;
        float4 color_and_specular = getFinalColor(ol, worldPos);
        float4 shadowTcToAtlas = getOmniLightShadowData(omni_light_index);
        float2 shadowZnZfar = ol.shadowZnZf_pad.xy;

        float3 point2light = pos_and_radius.xyz-worldPos.xyz;
        float distSqFromLight = dot(point2light,point2light);
        float radius2 = pow2(pos_and_radius.w);
        bool shouldExit = distSqFromLight >= radius2;
        BRANCH
        if (shouldExit)
          return;
        float invSqrRad = rcp(radius2);
        float attenuation = getDistanceAtt( distSqFromLight, invSqrRad );
        float3 lightDir = point2light*rsqrt(0.0000001+distSqFromLight);
        float NoL = 1;
        half shadowTerm = attenuation;//no shadows
        float3 shadowPos = worldPos + lightDir * eye_caustics_shadow_offset;
        shadowTerm *= eye_caustics_use_shadows ? getOmniShadow(shadowTcToAtlas, pos_and_radius, shadowPos, NoL, input.screenpos, shadowZnZfar) : 1;

        float omniCaustics = calculate_eye_caustics(input, lightDir);
        omniCaustics = max(0, omniCaustics * shadowTerm) * eye_caustics_omni_mul;
        caustics += omniCaustics;
        caustics_color += omniCaustics * color_and_specular.rgb;
      }

      void shade_caustics_spot_light(uint spot_light_index, CausticsInput input, float3 worldPos, inout float caustics, inout float3 caustics_color)
      {
        RenderSpotLight sl = spot_lights_cb[spot_light_index];
        float4 lightPosRadius = decode_spot_light_pos_radius(sl);
        float4 lightColor = sl.lightColorAngleScale;
        float4 lightDirection = sl.lightDirectionAngleOffset;
        float2 texId_scale = sl.texId_scale_illuminatingplane_packedDataBits.xy;
        float3 toLightDir = normalize(lightPosRadius.xyz - worldPos);
        float3 shadowPos = worldPos + toLightDir * eye_caustics_shadow_offset;
        float lightRollAngle = decode_light_roll_angle(sl);

        float lightAngleScale = lightColor.a;
        float lightAngleOffset = lightDirection.a;
        half geomAttenuation; half3 dirFromLight, point2light;//point2light - not normalized
        spot_light_params(worldPos.xyz, lightPosRadius, lightDirection.xyz, lightAngleScale, lightAngleOffset, geomAttenuation, dirFromLight, point2light);
        float NoL = 1;
        half attenuation = geomAttenuation;
        bool shouldExit = attenuation <= 0;
        BRANCH
        if (shouldExit)
          return;
        half spotShadow = 1;
        uint shadowDataBits = get_spot_light_shadow_data_bits(sl);
        BRANCH
        if (eye_caustics_use_shadows && spot_light_has_shadow(shadowDataBits))
        {
          float zbias = shadowZBias + shadowSlopeZBias / (abs(NoL)+0.1);
          float4 lightShadowTC = mul(getSpotLightTm(spot_light_index), float4(shadowPos.xyz+(point2light+dirFromLight)*zbias, 1));
          const float EPS = 1e-6;
          lightShadowTC.xyz /= max(lightShadowTC.w, EPS);
          float4 spotShadowUvBounds = getSpotLightShadowUvBounds(spot_light_index);
          bool shadowTcValid = all(lightShadowTC.xy == clamp(lightShadowTC.xy, spotShadowUvBounds.xy, spotShadowUvBounds.zw));
          FLATTEN
          if (shadowTcValid)
            spotShadow = 1-dynamic_shadow_sample(lightShadowTC.xy, lightShadowTC.z);
        }
        attenuation *= spotShadow;
        attenuation = applySpotLightPhotometry(-dirFromLight, lightDirection.xyz, lightRollAngle, texId_scale.x, texId_scale.y, attenuation);

        float spotCaustics = calculate_eye_caustics(input, toLightDir);
        spotCaustics = max(0, spotCaustics * attenuation) * eye_caustics_spot_mul;
        caustics += spotCaustics;
        caustics_color += spotCaustics * lightColor.rgb;
      }
##endif

      void get_dynamic_lighting(CausticsInput input, inout float caustics, inout float3 caustics_color)
      {
        ##if (dynamic_lights_count != lights_off)
          float3 worldPos = world_view_pos-input.pointToEye.xyz;

          uint2 tiledGridSize = (screen_size.xy + TILE_EDGE - 1) / TILE_EDGE;

          uint2 tileIdx = screen_uv_to_tile_idx(input.screenpos);
          uint tileOffset = (tileIdx.x * tiledGridSize.y + tileIdx.y) * DWORDS_PER_TILE;

          ##if (dynamic_lights_count != lights_spot_1)
            #define TILED_LIGHTS_WALK_SPOT 0
            #define TILED_LIGHTS_WALK_DEPTH input.viewDepth
            #define TILED_LIGHTS_WALK_TILE_OFFSET tileOffset
            ##if (dynamic_lights_count == lights_omni_1 || dynamic_lights_count == lights_omnispot_1)
              #define TILED_LIGHTS_WALK_SINGLE_WORD 1
            ##endif
            #define TILED_LIGHTS_WALK_LIGHT_BODY(omni_light_index) shade_caustics_omni_light(omni_light_index, input, worldPos, caustics, caustics_color);
            #include <tiled_lights_walk.hlsli>
          ##endif

          ##if (dynamic_lights_count != lights_omni_1)
            #define TILED_LIGHTS_WALK_SPOT 1
            #define TILED_LIGHTS_WALK_DEPTH input.viewDepth
            #define TILED_LIGHTS_WALK_TILE_OFFSET tileOffset
            ##if (dynamic_lights_count == lights_spot_1 || dynamic_lights_count == lights_omnispot_1)
              #define TILED_LIGHTS_WALK_SINGLE_WORD 1
            ##endif
            #define TILED_LIGHTS_WALK_LIGHT_BODY(spot_light_index) shade_caustics_spot_light(spot_light_index, input, worldPos, caustics, caustics_color);
            #include <tiled_lights_walk.hlsli>
          ##endif
        ##endif
      }
    }

    hlsl (ps)
    {
      float get_sun_shadow(CausticsInput input)
      {
        float3 shadowPos = world_view_pos - input.pointToEye - from_sun_direction * eye_caustics_sun_shadow_offset;
        float csm = get_csm_shadow(world_view_pos - shadowPos).x;
        float staticShadow = getStaticShadow(shadowPos);
        float cloudsShadow = clouds_shadow(shadowPos);
        return eye_caustics_use_shadows ? min(csm, staticShadow) * cloudsShadow : 1;
      }

      void get_sun_caustics(CausticsInput input, inout float caustics, inout float3 caustics_color)
      {
        float sunCaustics = calculate_eye_caustics(input, -from_sun_direction);
        sunCaustics = max(0, sunCaustics * get_sun_shadow(input)) * eye_caustics_sun_mul;
        caustics += sunCaustics;
        caustics_color += sunCaustics * sun_color_0;
      }

      void get_caustics(CausticsInput input, out float caustics, out float3 caustics_color)
      {
        caustics = 0;
        caustics_color = float3(0,0,0);

        const float MAX_DIST = 30.0;
        const float3 eyeForward = input.eyeRotationTm._31_32_33; // the VS zeroes the frame when the instance has no eye orientation data
        BRANCH
        if (dot(input.pointToEye, input.pointToEye) > MAX_DIST*MAX_DIST || dot(eyeForward, eyeForward) == 0)
          return;

        // cached data:
        input.irisPlaneDistance = length(input.diffuseTexcoord - 0.5);
        input.falloffStrength = -max(eye_caustics_falloff_strength, 0);

        get_sun_caustics(input, caustics, caustics_color);
        get_dynamic_lighting(input, caustics, caustics_color);

        caustics *=  eye_caustics_strength;
        caustics_color *=  eye_caustics_strength;
      }
    }
  }
  else
  {
    hlsl (ps)
    {
      void get_caustics(CausticsInput input, out float caustics, out float3 caustics_color)
      {
        caustics = 0;
        caustics_color = float3(0,0,0);
      }
    }
  }
endmacro