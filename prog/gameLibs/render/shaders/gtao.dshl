include "shader_global.dshl"
include "viewVecVS.dshl"
include "gbuffer.dshl"
include "contact_shadows.dshl"
include "ssao_use.dshl"
include "get_additional_shadows.dshl"
include "get_additional_ao.dshl"
include "ssao_reprojection.dshl"
include "halfres_close_depth_with_normals.dshl"
include "camera_in_camera.dshl"
include "camera_indoor_inc.dshl"

float gtao_cutoff_radius_mul = 1.68;
float gtao_cutoff_smoothness = 0.8;
float gtao_world_radius = 1.666;
float gtao_screen_radius = 0; // Portion of screen height. 0 by default to preserve old behavior (world space constant radius).
float gtao_max_pixel_radius = 64;
float gtao_half_hfov_tan = 1.0;
float gtao_temporal_directions = 0;
float gtao_temporal_offset = 0;
float4 gtao_sky_occlusion = (0, 1.5, 0, 0.1); // strength, half angle, strength indoors, reach / depth
int gtao_sky_occlusion_mode = 0;
interval gtao_sky_occlusion_mode : off < 1, on;
float gtao_frame_no = 0;
float gtao_max_raw_value = 1;
float gtao_sample_distribution_exponent = 1.5;
int4 temporal_shadow_frame;
int4 gtao_dispatch_grid_dim = (1, 1, 0, 0);
float4 hero_cockpit_vec = (0, 0, 0, 0);
texture raw_gtao_tex;
texture gtao_tex;
texture gtao_prev_tex;
float4 globtm_no_ofs_psf_0;
float4 globtm_no_ofs_psf_1;
float4 globtm_no_ofs_psf_2;
float4 globtm_no_ofs_psf_3;

float contact_shadow_min_len = 0.25;

int hero_cockpit_camera_fade = 0;
interval hero_cockpit_camera_fade : off < 1, on;

hlsl{
  float decode_depth(float depth, float2 decode_depth)
  {
    return linearize_z(depth,decode_depth);
  }
}

macro GTAO_MAIN_CORE(code)
  (code) {
    from_sun_direction@f3 = from_sun_direction;
  }
  supports none;

  assume_if_not_assumed use_contact_shadows = use_shadows;

  local float4 halfResTexSize = get_dimensions(downsampled_close_depth_tex, 0);
  local float pixelToTan = 2.0 * gtao_half_hfov_tan / halfResTexSize.x;
  (code) {
    world_view_pos@f3 = world_view_pos;
    gtao_texel_size@f4 = (1.0 / max(1, halfResTexSize.x), 1.0 / max(1, halfResTexSize.y), halfResTexSize.xy);
    gtao_temporal_directions@f1 = (gtao_temporal_directions);
    gtao_temporal_offset@f1 = (gtao_temporal_offset);
    gtao_half_fov_tan_xy@f2 = (gtao_half_hfov_tan, gtao_half_hfov_tan * halfResTexSize.y / max(1, halfResTexSize.x));
    hero_cockpit_vec@f4 = hero_cockpit_vec;

    local_view_x@f3 = local_view_x;
    local_view_y@f3 = local_view_y;
    local_view_z@f3 = local_view_z;

    shadow_params@f3 = (temporal_shadow_frame.x, contact_shadow_len, contact_shadow_min_len);

    viewProjectionMatrixNoOfs@f44 = { globtm_no_ofs_psf_0, globtm_no_ofs_psf_1, globtm_no_ofs_psf_2, globtm_no_ofs_psf_3 };

    encode_depth@f4 = (-zn_zfar.x / (zn_zfar.y - zn_zfar.x), zn_zfar.x * zn_zfar.y / (zn_zfar.y - zn_zfar.x),
      zn_zfar.x / (zn_zfar.x * zn_zfar.y), (zn_zfar.y - zn_zfar.x) / (zn_zfar.x * zn_zfar.y));

    gtao_cutoff_radius_mul@f1 = gtao_cutoff_radius_mul;
    gtao_cutoff_smoothness@f1 = gtao_cutoff_smoothness;
    gtao_world_radius@f1 = gtao_world_radius;
    gtao_sample_distribution_exponent@f1 = gtao_sample_distribution_exponent;

    tan_to_pixel_radius@f1 = 1.0 / pixelToTan;
    depth_to_radius_limit_max_pixel_radius@f1 = gtao_max_pixel_radius * pixelToTan;
    depth_to_radius_limit_min_screen_radius@f1 = gtao_screen_radius * halfResTexSize.y * pixelToTan;
  }

  if (gtao_sky_occlusion_mode == on)
  {
    (code) {
      // x is -strength * log2(e), for exp2
      gtao_sky_sector@f4 = (-1.442695 * (gtao_sky_occlusion.x + (gtao_sky_occlusion.z - gtao_sky_occlusion.x) * camera_indoor),
        gtao_sky_occlusion.y, gtao_sky_occlusion.w, gtao_sky_occlusion.w / pixelToTan);
    }
  }

  INIT_HALF_RES_CLOSE_DEPTH(code)
  INIT_HALF_RES_CLOSE_DEPTH_NORMALS(code)
  INIT_GLOBAL_LINEAR_CLAMP_SAMPLER(code)
  INIT_ZNZFAR_STAGE(code)
  (code) {
    downsampled_far_depth_tex_exists@i1 = exists_tex(downsampled_far_depth_tex);
    downsampled_far_depth_tex@tex2d = downsampled_far_depth_tex;
  }

  hlsl(code) {
    #define shadow_frame shadow_params.x
    #define contact_shadow_len shadow_params.y
    #define contact_shadow_min_len shadow_params.z
  }

  CONTACT_SHADOWS_BASE(code)
  APPLY_ADDITIONAL_AO(code)
  APPLY_ADDITIONAL_SHADOWS(code)
  USE_PACK_SSAO_BASE(code)
  INIT_READ_IS_HERO_COCKPIT(code)
  USE_READ_IS_HERO_COCKPIT(code)

  hlsl(code) {
    half3 GetCameraVec(half2 uv)
    {
      return half3(half2(uv.x * -2.0 + 1.0, uv.y * 2.0 - 1.0) * gtao_half_fov_tan_xy, 1.0);
    }

    half3 GetPosition(half2 uv)
    {
      float sceneDepth = decode_depth(tex2Dlod(half_res_close_depth, float4(uv.xy, 0, 0)).x, zn_zfar.zw);
      return GetCameraVec(uv) * sceneDepth;
    }

    float GTAO_SliceIndex(half2 uv)
    {
      uint2 position = (uint2)(uv * gtao_texel_size.zw) & 3;
      uint idx = position.y * 4 + position.x;
      // 4x4 slice indices {14,9,13,10, 2,5,1,6, 12,8,11,15, 4,0,3,7} packed into 2 constants (4 bits per slice).
      uint packedSliceIndex = idx < 8 ? 0x6152AD9Eu : 0x7304FB8Cu;
      return (packedSliceIndex >> ((idx & 7) * 4)) & 15;
    }

    #define SSAO_SAMPLES 4
    #define SSAO_THICKNESSMIX 0.2
    #define PI_HALF 1.5707963267948966192313216916398
    // One slice gives visibility up to PI/2, only the average over slices is in [0, 1]
    #define GTAO_INV_MAX_VISIBILITY (1.0 / PI_HALF)
    #define GTAO_TEMPORAL_LATTICE_JITTER_COEFF 215
    // Closer samples hit the center texel or a neighbour whose depth error is large for its distance: false self-occlusion.
    // Empirical value from XeGTAO (pixelTooCloseThreshold).
    #define GTAO_MIN_SAMPLE_PIXELS 1.3

    void SliceSample(half2 uv, float targetMip, half3 ray, half3 v,
      float cutoff_radius, float inv_falloff_range, float sky_cutoff, inout float closest, inout float sky_closest)
    {
      float rawDepth = tex2Dlod(half_res_close_depth, float4(uv.xy, 0, targetMip)).x;

      ##if (maybe(screen_mask_enabled))
        if (rawDepth >= 1)
          return;
      ##endif

      float depth = decode_depth(rawDepth, zn_zfar.zw);
      // Vector from current pixel to current slice sample
      half3 p = GetCameraVec(uv) * depth - ray;
      float pLen2 = dot(p, p);
      float invPLen = rsqrt(pLen2);
      float pLen = pLen2 * invPLen;
      // Cosine of the horizon angle of the current sample
      float current = dot(v, p) * invPLen;
      ##if gtao_sky_occlusion_mode == on
        // sky_closest >= -1, so maxes can form max3
        sky_closest = max(sky_closest, pLen < sky_cutoff ? current : -1.0);
      ##endif
      // Linear falloff for samples that are too far away from current pixel
      float falloff = saturate((cutoff_radius - pLen) * inv_falloff_range);
      FLATTEN
      if (current > closest)
        closest = lerp(closest, current, falloff);
      // Helps avoid overdarkening from thin objects
      closest = lerp(closest, current, SSAO_THICKNESSMIX * falloff);
    }

    float GTAOFastAcos(float x)
    {
      float res = -0.156583 * abs(x) + PI_HALF;
      res *= sqrt(1.0 - abs(x));
      return x >= 0 ? res : PI - res;
    }

    float IntegrateArc(float h1, float h2, float n)
    {
      float cosN = cos(n);
      float sinN = sin(n);
      return 0.25 * (-cos(2.0 * h1 - n) + cosN + 2.0 * h1 * sinN - cos(2.0 * h2 - n) + cosN + 2.0 * h2 * sinN);
    }

    ##if gtao_sky_occlusion_mode == on
    #define SKY_SLIVER 0.25
    #define SKY_FAR_MIP 2 // Coarse closest depth halves the tap cost

    // Inverse depth scaling: no divide, same cosine
    void SkyFarSample(half2 uv, half3 ray, half3 v, float sky_cutoff, inout float sky_closest)
    {
      float rawDepth = tex2Dlod(half_res_close_depth, float4(uv.xy, 0, SKY_FAR_MIP)).x;

      ##if (maybe(screen_mask_enabled))
        if (rawDepth >= 1)
          return;
      ##endif

      float invDepth = rawDepth * zn_zfar.w + zn_zfar.z;
      half3 p = GetCameraVec(uv) - ray * invDepth;
      float pLenSq = dot(p, p);
      float current = dot(v, p) * rsqrt(pLenSq);
      sky_closest = pLenSq < pow2(sky_cutoff * invDepth) ? max(sky_closest, current) : sky_closest;
    }

    // Arc bounds as slice angles, exp2 weight
    float3 SkyArc(half3 v, half3 planeNormal, float n)
    {
      half3 up = half3(-local_view_x.y, -local_view_y.y, local_view_z.y);
      // Slice frame is orthonormal: v, cross(v, planeNormal)
      float upX = dot(up, v);
      float upY = dot(up, cross(v, planeNormal));
      float upLenSq = upX * upX + upY * upY;
      float invUpLen = rsqrt(max(upLenSq, 1e-8));
      float u = GTAOFastAcos(clamp(upX * invUpLen, -1.0, 1.0));
      u = upY < 0 ? -u : u;
      // Half angle <= PI/2 needs one overlap
      float d = u - n;
      d -= 2 * PI * round(d * (0.5 / PI));
      float lo = max(d - gtao_sky_sector.y, -PI_HALF);
      float hi = max(min(d + gtao_sky_sector.y, PI_HALF), lo);
      // Weighted by in-slice up; slivers fade out
      float weight = upLenSq * invUpLen * min(rcp(hi - lo), 1.0 / SKY_SLIVER) * gtao_sky_sector.x;
      return float3(lo + n, hi + n, weight);
    }
    ##endif

    half gtao(half2 tc_original, half3 worldNormal)
    {

      // Vector from camera to the current pixel's position
      float sceneDepth = decode_depth(tex2Dlod(half_res_close_depth, float4(tc_original.xy, 0, 0)).x, zn_zfar.zw);
      half3 ray = GetCameraVec(tc_original) * sceneDepth;

      float3 normal = normalize(float3(
        -dot(local_view_x, worldNormal),
        -dot(local_view_y, worldNormal),
         dot(local_view_z, worldNormal)
      ));

      float worldRadiusLimitMaxPixelRadius = sceneDepth * depth_to_radius_limit_max_pixel_radius;
      float worldRadiusLimitMinScreenRadius = sceneDepth * depth_to_radius_limit_min_screen_radius;

      // World space radius is limited below by screen-constant radius (avoid AO disappearing on far objects, if needed)
      // and above by max-stride-related one to not thrash GPU cache
      float worldRadius = min(worldRadiusLimitMaxPixelRadius, max(gtao_world_radius, worldRadiusLimitMinScreenRadius));
      float pixelRadius = worldRadius / sceneDepth * tan_to_pixel_radius;

      // Compute cutoff relative to world space radius at current depth
      float cutoffRadius = max(gtao_world_radius, worldRadiusLimitMinScreenRadius) * gtao_cutoff_radius_mul;
      float invFalloffRange = 1.0 / (cutoffRadius * gtao_cutoff_smoothness);
      half2 dirMult = gtao_texel_size.xy * pixelRadius;

      // Get the view vector (normalized vector from pixel to camera)
      half3 v = normalize(-ray);

      // Slices are marched both ways, so the angles cover a half turn
      float sliceIndex = GTAO_SliceIndex(tc_original);
      float angle = (sliceIndex * (1.0 / 16.0) + gtao_temporal_directions) * PI;
      half2 aoDir = dirMult * half2(sin(angle), cos(angle));

      // Project world space normal to the slice plane
      half3 toDir = GetCameraVec(tc_original + aoDir);
      half3 planeNormal = normalize(cross(v, -toDir));
      half3 projectedNormal = normal - planeNormal * dot(normal, planeNormal);

      // Calculate angle n between view vector and projected normal vector
      half3 projectedDir = normalize(normalize(toDir) + v);
      float n = GTAOFastAcos(dot(-projectedDir, normalize(projectedNormal))) - PI_HALF;

      // Init variables
      float c1 = -1.0;
      float c2 = -1.0;
      float s1 = -1.0;
      float s2 = -1.0;
      float skyCutoff = 0;
      ##if gtao_sky_occlusion_mode == on
        skyCutoff = 1.5 * max(sceneDepth * gtao_sky_sector.z, worldRadius);
      ##endif

      float jitter = frac(sliceIndex * (GTAO_TEMPORAL_LATTICE_JITTER_COEFF / 16.0) + gtao_temporal_offset);
      float minS = saturate(GTAO_MIN_SAMPLE_PIXELS / pixelRadius);

      // Mipmapping is disabled as it is causing severe visual errors. See https://youtrack.gaijin.ru/issue/38-7328
      const float targetMip = 0.0;

      // Find horizons of the slice
      for (int i = 0; i < SSAO_SAMPLES; i++)
      {
        float t = (i + jitter) * (1.0 / SSAO_SAMPLES);
        half2 ofs = aoDir * lerp(minS, 1.0, pow(t, gtao_sample_distribution_exponent));
        SliceSample(tc_original - ofs, targetMip, ray, v, cutoffRadius, invFalloffRange, skyCutoff, c1, s1);
        SliceSample(tc_original + ofs, targetMip, ray, v, cutoffRadius, invFalloffRange, skyCutoff, c2, s2);
      }

      // Finalize
      float h1a = -GTAOFastAcos(c1);
      float h2a = GTAOFastAcos(c2);

      // Clamp horizons to the normal hemisphere
      float h1 = n + max(h1a - n, -PI_HALF);
      float h2 = n + min(h2a - n, PI_HALF);

      float visibility = IntegrateArc(h1, h2, n) * length(projectedNormal);

      ##if gtao_sky_occlusion_mode == on
        // aoDir * skyReach / worldRadius, without the divide
        half2 farOffset = gtao_texel_size.xy * max(gtao_sky_sector.w, pixelRadius) * half2(sin(angle), cos(angle));
        SkyFarSample(tc_original - farOffset, ray, v, skyCutoff, s1);
        SkyFarSample(tc_original + farOffset, ray, v, skyCutoff, s2);
        float3 skyArc = SkyArc(v, planeNormal, n);
        // Arc inside hemisphere: horizons need no clamp
        float open = max(min(skyArc.y, GTAOFastAcos(s2)) - max(skyArc.x, -GTAOFastAcos(s1)), 0);
        visibility *= exp2(skyArc.z * (skyArc.y - skyArc.x - open));
      ##endif

      return visibility;
    }

    SSAO_TYPE gtao_resolve(float2 screenpos, float2 texcoord, float3 viewVect)
    {
      SSAO_TYPE gtao_value;
      float rawDepth = tex2Dlod(half_res_close_depth, float4(texcoord, 0, 0)).x;
      BRANCH
      if (rawDepth <= 0 || rawDepth >= 1)//why not just rawDepth <= 0
        return (SSAO_TYPE)float3(GTAO_INV_MAX_VISIBILITY, 1, 1);

      float depth1 = decode_depth(rawDepth, zn_zfar.zw);
      half3 wsNormal = normalize(tex2Dlod(half_res_close_depth_normals, float4(texcoord, 0, 0)).xyz * 2 - 1);
      float3 cameraToPoint = depth1 * viewVect;
      float w = depth1;
      float3 pixelPos = cameraToPoint + world_view_pos;

      gtao_value.x = gtao(texcoord, wsNormal);
      gtao_value.x = getAdditionalAmbientOcclusion(float(gtao_value.x), pixelPos, wsNormal, texcoord);

      ##if maybe(ssao_contact_shadows)
      {
        #define shadow_steps 24
        float dither = interleavedGradientNoiseFramed(screenpos, shadow_frame);//if we have temporal aa
        float2 hitUV;
        gtao_value.CONTACT_SHADOWS_ATTR = 1;
        #if HAS_ADDITIONAL_PRE_SHADOW
        gtao_value.CONTACT_SHADOWS_ATTR = getAdditionalPreShadow(screenpos.xy, cameraToPoint, texcoord, w);
        #endif
        if (gtao_value.CONTACT_SHADOWS_ATTR > 0)
        {
          half shadow_strength = pow2(saturate(dot(wsNormal, from_sun_direction.xyz)*-2 + sqrt(0.5)));
          BRANCH
          if (shadow_strength>0)
          {
            half hitT;
            int filteredSteps = 1;
            int steps = shadow_steps - filteredSteps;
            if (get_downsampled_far_depth_tex_exists())
            {
              hitT = contactShadowFilteredRayCastWithScaleHitT(
                downsampled_far_depth_tex, half_res_close_depth_samplerstate, global_linear_clamp_sampler,
                cameraToPoint, -from_sun_direction,
                max(w * contact_shadow_len, min(contact_shadow_min_len, w)),
                filteredSteps, steps, dither - 0.5,
                projectionMatrix, w, viewProjectionMatrixNoOfs, hitUV, half4(1,1,0,0)
              );
            }
            else
            {
              hitT = contactShadowFilteredRayCastWithScaleHitT(
                half_res_close_depth, half_res_close_depth_samplerstate, global_linear_clamp_sampler,
                cameraToPoint, -from_sun_direction,
                max(w * contact_shadow_len, min(contact_shadow_min_len, w)),
                filteredSteps, steps, dither - 0.5,
                projectionMatrix, w, viewProjectionMatrixNoOfs, hitUV, half4(1,1,0,0)
              );
            }
            if (camera_has_sub_view() && is_wrong_camera_view_area_postfx(hitUV))
              hitT = 1;

            half contactShadow = 1.h - saturate(1.h - pow2(hitT));
            gtao_value.CONTACT_SHADOWS_ATTR *= lerp (1, contactShadow, shadow_strength);
          }
        }
        gtao_value.CONTACT_SHADOWS_ATTR = getAdditionalShadow(gtao_value.CONTACT_SHADOWS_ATTR, cameraToPoint, texcoord, w);
      }
      ##endif


      ##if gbuffer_has_hero_cockpit && hero_cockpit_camera_fade == on
        BRANCH
        if (isGbufferHeroCockpit(texcoord))
        {
          float fade = saturate(dot(float4(pixelPos, 1), hero_cockpit_vec));
          float fadeGtao = getAdditionalAmbientOcclusion(1.f, pixelPos, wsNormal, texcoord);
          gtao_value.x = lerp(gtao_value.x, fadeGtao, fade);
          ##if maybe(ssao_contact_shadows)
            float fadeShadow = getAdditionalShadow(1.f, cameraToPoint,  texcoord, w);
            gtao_value.CONTACT_SHADOWS_ATTR = lerp(gtao_value.CONTACT_SHADOWS_ATTR, fadeShadow, fade);
          ##endif
        }
      ##endif

      ##if maybe(ssao_wsao)
        gtao_value.WSAO_ATTR = getWsao(cameraToPoint + world_view_pos, wsNormal);
      ##endif
      gtao_value.x *= GTAO_INV_MAX_VISIBILITY;
      return setSSAO(gtao_value);
    }
  }
endmacro

shader gtao_main
{
  INIT_AND_USE_ON_TOP_CAMERA_IN_CAMERA(ps)

  z_write = false;
  z_test = false;
  cull_mode = none;
  color_write = rgb;

  USE_AND_INIT_VIEW_VEC_VS()
  POSTFX_VS_TEXCOORD_VIEWVEC(0, texcoord, viewVect)

  GTAO_MAIN_CORE(ps)

  hlsl(ps) {
    SSAO_TYPE gtao_resolve_ps(VsOutput input HW_USE_SCREEN_POS) : SV_Target0
    {
      DISCARD_IF_INVALID_VIEW_AREA_PS(input.texcoord.xy);
      return gtao_resolve(GET_SCREEN_POS(input.pos).xy, input.texcoord.xy, input.viewVect.xyz);
    }
  }
  compile("target_ps", "gtao_resolve_ps");
}

shader gtao_main_cs
{
  INIT_AND_USE_ON_TOP_CAMERA_IN_CAMERA(cs)

  hlsl {
    #define NO_GRADIENTS_IN_SHADER 1
  }

  USE_AND_INIT_VIEW_VEC_CS()
  GTAO_MAIN_CORE(cs)

  (cs) {
    gtao_dispatch_grid_dim@i2 = gtao_dispatch_grid_dim;
  }

  hlsl(cs) {
    #include "thread_group_swizzle.hlsli"

    RWTexture2D<SSAO_TYPE> gtao_target : register(u0);

    [numthreads( 8, 8, 1 )]
    void gtao_resolve_cs(uint2 group_id : SV_GroupID, uint2 group_thread_id : SV_GroupThreadID)
    {
      const uint GTAO_COL_WIDTH = 16;
      uint2 DTid = thread_group_swizzle_x(gtao_dispatch_grid_dim, uint2(8, 8), GTAO_COL_WIDTH, group_thread_id, group_id);

      if (any(DTid >= (uint2)gtao_texel_size.zw))
        return;

      float2 pixelCenter = DTid + 0.5;
      float2 texcoord = pixelCenter * gtao_texel_size.xy;

      DISCARD_IF_INVALID_VIEW_AREA_CS(texcoord.xy);

      float3 worldDir    = lerp_view_vec(texcoord);
      SSAO_TYPE ao = gtao_resolve(pixelCenter, texcoord, worldDir);
      texture2DAt(gtao_target, DTid) = ao;
    }
  }
  compile("target_cs", "gtao_resolve_cs");
}

macro GTAO_SPATIAL_CORE(code)
  supports none;

  INIT_ZNZFAR_STAGE(code)
  INIT_HALF_RES_CLOSE_DEPTH(code)
  INIT_VIEW_VEC_STAGE(code)
  USE_VIEW_VEC_STAGE(code)

  local float4 halfResTexSize = get_dimensions(raw_gtao_tex, 0);
  local int4 halfResTexSizeInt = get_dimensions(raw_gtao_tex, 0);
  (code) {
    raw_gtao_tex@smp2d = raw_gtao_tex;
    gtao_texel_size@f4 = (1.0 / halfResTexSize.xy, halfResTexSize.xy);
    gtao_texture_size@i2 = (halfResTexSizeInt.x, halfResTexSizeInt.y);
    gtao_max_raw_value@f1 = gtao_max_raw_value;
  }

  hlsl(code) {

    SSAO_TYPE gtao_spatial(float2 texcoord)
    {
      // Get the depth of the "center" sample - this reference depth is used to weight the other samples
      float rawDepth = tex2Dlod(half_res_close_depth, float4(texcoord, 0, 0)).r;

      BRANCH
      if (rawDepth >= 1 || rawDepth <= 0)
        return 1;

      float depth = decode_depth(rawDepth, zn_zfar.zw);
      float weightsSpatial = 0.0;
      SSAO_TYPE ao = 0.0;

      UNROLL
      for (int y = 0; y < 4; y++)
      {
        UNROLL
        for (int x = 0; x < 4; x++)
        {
          // Weight each sample by its distance from the refrence depth - but also scale the weight by 1/10 of the
          // reference depth so that the further from the camera the samples are, the higher the tolerance for depth
          // differences is.
          float2 uv = texcoord + float2(x - 2, y - 2) * gtao_texel_size.xy;
          float localDepth = decode_depth(tex2Dlod(half_res_close_depth, float4(uv, 0, 0)).r, zn_zfar.zw);
          float localWeight = max(0.0, 1.0 - abs(localDepth - depth) / (depth * 0.1));
          weightsSpatial += localWeight;
          ao += tex2Dlod(raw_gtao_tex, float4(uv, 0, 0)).SSAO_ATTRS * localWeight;
        }
      }
      ao /= weightsSpatial;
      ao.x *= gtao_max_raw_value;

      return ao;
    }
  }
endmacro

shader gtao_spatial
{
  z_write = false;
  z_test = false;
  cull_mode = none;
  color_write = rgb;

  POSTFX_VS_TEXCOORD(0, texcoord)
  GTAO_SPATIAL_CORE(ps)

  hlsl(ps) {

    SSAO_TYPE gtao_spatial_ps(VsOutput input) : SV_Target0
    {
      return gtao_spatial(input.texcoord);
    }
  }

  compile("target_ps", "gtao_spatial_ps");
}

shader gtao_spatial_cs
{
  GTAO_SPATIAL_CORE(cs)

  hlsl(cs) {
    #include "pixelPacking/Half2ToUint.hlsl"

    RWTexture2D<SSAO_TYPE> gtao_target : register(u0);

##if hardware.dx12 && !hardware.xbox && !hardware.scarlett
    #define USE_OPTIMIZED_CODE WAVE_INTRINSICS
##else
    #define USE_OPTIMIZED_CODE 0
##endif

    #define TG_WIDTH 8
    #define TG_HEIGHT 8

#if USE_OPTIMIZED_CODE
    // LG_ states for LANE_GROUP_
    #define LG_WIDTH 8
    #define LG_HEIGHT 4
    #define LG_SIZE (LG_WIDTH*LG_HEIGHT)
    #define LG_MASK (LG_SIZE - 1)

    #define LG_WIDTH_MASK (LG_WIDTH - 1)
    #define LG_WIDTH_BIT_COUNT 3
    #define LG_BIT_COUNT 5

    #define FILTER_WIDTH 4
    #define FILTER_HEIGHT 4
    #define FILTER_OFFSET 2

    #define CACHE_LINES_COUNT 2

    struct WaveCache
    {
      float depth;
      uint  packedAoXY;
    ##if ssao_has_blue
      float aoZ;
    ##endif
    };

    //  the structure of cache is 11x7, each iteration we load and use only 2 horizontal cache lines
    // ----------------------------------               ----------------------------------
    // |00|02|04|06|08|10|12|14|16|18|20| <- y=0        |  |  |  |  |  |  |  |  |  |  |  |
    // |  |  |  |  |  |  |  |  |  |  |  |               |00|02|04|06|08|10|12|14|16|18|20| <- y=1
    // |  |  |XX|XX|XX|XX|XX|XX|XX|XX|  |               |  |  |XX|XX|XX|XX|XX|XX|XX|XX|  |
    // |  |  |XX|XX|XX|XX|XX|XX|XX|XX|  |               |  |  |XX|XX|XX|XX|XX|XX|XX|XX|  |
    // |01|03|05|07|09|11|13|15|17|19|21|               |  |  |XX|XX|XX|XX|XX|XX|XX|XX|  |
    // |  |  |XX|XX|XX|XX|XX|XX|XX|XX|  |               |01|03|05|07|09|11|13|15|17|19|21|
    // |  |  |  |  |  |  |  |  |  |  |  |               |  |  |  |  |  |  |  |  |  |  |  |
    // |  |  |  |  |  |  |  |  |  |  |  |               |  |  |  |  |  |  |  |  |  |  |  |
    // ----------------------------------               ----------------------------------
    int2 get_cache_local_offset(uint laneIndex, int y)
    {
      return int2(laneIndex >> 1, (laneIndex&1)*FILTER_HEIGHT + y);
    }

    //  the example of access to cache using cache load lane
    // ----------------------------------
    // |00|02|04|06|08|10|12|14|16|18|20|
    // |  |  |  |  |  |  |  |  |  |  |  |
    // |  |  |  |  |  |  |  |  |  |  |  |
    // |  |  -------------  |  |  |  |  |
    // |01|03|05 07 09 11|13|15|17|19|21|
    // |  |  -------------  |  |  |  |  |
    // |  |  |  |  |  |  |  |  |  |  |  |
    // |  |  |  |  |  |  |  |  |  |  |  |
    // ----------------------------------
    uint get_base_cache_load_lane(uint2 laneOffset, int y)
    {
      uint selectedCacheLine = (laneOffset.y <= y ? 0 : 1);
      return laneOffset.x*CACHE_LINES_COUNT + selectedCacheLine;
    }

    WaveCache create_wave_cache_for_lane(uint laneIndex, int y, uint2 waveEdge)
    {
      int2 cachePixelOffset = int2(waveEdge) - FILTER_OFFSET;

      int2 localOffset = get_cache_local_offset(laneIndex, y);
      int2 pixelOffset = clamp(cachePixelOffset + localOffset, int2(0, 0), gtao_texture_size - 1);

      SSAO_TYPE ao = texelFetch(raw_gtao_tex, pixelOffset, 0).SSAO_ATTRS;

      WaveCache cache;
      cache.depth = decode_depth(texelFetch(half_res_close_depth, pixelOffset, 0).r, zn_zfar.zw);
      cache.packedAoXY = packHalf2ToUint(ao.xy);
      ##if ssao_has_blue
        cache.aoZ = ao.z;
      ##endif

      return cache;
    }

    bool is_third_ao_component_used(WaveCache cache)
    {
      ##if ssao_has_blue
        return WaveActiveAnyTrue(cache.aoZ != 0.0);
      ##else
        return false;
      ##endif
    }

    void accumulate_ao_horizontal(bool useAoZ, uint baseCacheLoadLane, WaveCache cache, float invDepth, inout float weightsSpatial, inout SSAO_TYPE ao)
    {
      UNROLL
      for (int x = 0; x < FILTER_WIDTH; x++)
      {
        uint cacheLoadLane = baseCacheLoadLane + x*CACHE_LINES_COUNT;

        float localDepth = WaveReadLaneAt(cache.depth, cacheLoadLane);
        float localWeight = max(0.0, 1.0 - 10.0*abs(localDepth*invDepth - 1.0));
        weightsSpatial += localWeight;

        half2 localAoXY = (half2) unpackHalf2FromUint(WaveReadLaneAt(cache.packedAoXY, cacheLoadLane));
        ao.xy += localAoXY*localWeight;
        ##if ssao_has_blue
          if (useAoZ)
            ao.z  += WaveReadLaneAt(cache.aoZ, cacheLoadLane)*localWeight;
        ##endif
      }
    }

    #define SHOULD_USE_FALLBACK ((WaveGetLaneCount() & LG_MASK) != 0)
#else
    #define SHOULD_USE_FALLBACK (true)
#endif // USE_OPTIMIZED_CODE

    [numthreads( TG_WIDTH, TG_HEIGHT, 1 )]
    void gtao_spatial_cs(uint2 GrId : SV_GroupID, uint2 GTId : SV_GroupThreadID, uint3 DTid : SV_DispatchThreadID)
    {
      if (SHOULD_USE_FALLBACK)
      {
        if (any(DTid.xy >= gtao_texel_size.zw))
          return;

        float2 pixelCenter = DTid.xy + 0.5;
        float2 texcoord    = pixelCenter * gtao_texel_size.xy;
        SSAO_TYPE ao = gtao_spatial(texcoord);
        texture2DAt(gtao_target, DTid.xy) = ao;

        return;
      }

#if USE_OPTIMIZED_CODE
      // use this code to split 8x8 thread group on 2 lane groups of size 8x4
      uint waveIndex = (WaveActiveAnyTrue((GTId.x + GTId.y) == 0) ? WaveGetLaneIndex() >> LG_BIT_COUNT : 1);
      uint2 waveEdge = uint2(GrId.x*TG_WIDTH, GrId.y*TG_HEIGHT + waveIndex*LG_HEIGHT);

      // lane index is bound to values inside current lane group (remove wave32/wave64 code dependency)
      uint  laneIndex = (WaveGetLaneIndex() & LG_MASK);
      uint2 laneOffset = uint2(laneIndex & LG_WIDTH_MASK, laneIndex >> LG_WIDTH_BIT_COUNT);

      // use this patch index to fix lane index value for wave64 setup
      uint laneIndexPatch = WaveGetLaneIndex() & (1 << LG_BIT_COUNT);

      uint2 outputPos = waveEdge + laneOffset;

      float rawDepth = texelFetch(half_res_close_depth, min(outputPos, gtao_texture_size - 1), 0).r;
      bool isInvalidDepth = (rawDepth >= 1 || rawDepth <= 0);

      BRANCH
      if (WaveActiveAllTrue(isInvalidDepth))
        return;

      const float depth = decode_depth(rawDepth, zn_zfar.zw);
      const float invDepth = rcp(depth);

      float weightsSpatial = 0.0;
      SSAO_TYPE ao = 0.0;

      LOOP
      for(int y = 0; y < FILTER_HEIGHT; ++y)
      {
        WaveCache cache = create_wave_cache_for_lane(laneIndex, y, waveEdge);
        uint baseCacheLoadLane = laneIndexPatch + get_base_cache_load_lane(laneOffset, y);

        BRANCH
        if (is_third_ao_component_used(cache))
          accumulate_ao_horizontal(true, baseCacheLoadLane, cache, invDepth, weightsSpatial, ao);
        else
          accumulate_ao_horizontal(false, baseCacheLoadLane, cache, invDepth, weightsSpatial, ao);
      }
      ao *= rcp(weightsSpatial);
      ao.x *= gtao_max_raw_value;

      if (all(outputPos < gtao_texel_size.zw))
        texture2DAt(gtao_target, outputPos) = ao;
#endif // USE_OPTIMIZED_CODE
    }
  }

  compile("target_cs", "gtao_spatial_cs");
}

macro GTAO_TEMPORAL_CORE(code)
  supports none;

  INIT_ZNZFAR_STAGE(code)
  SSAO_REPROJECTION(code, gtao_prev_tex)
  INIT_HALF_RES_CLOSE_DEPTH(code)
  INIT_VIEW_VEC_STAGE(code)
  USE_VIEW_VEC_STAGE(code)

  local float4 halfResTexSize = get_dimensions(gtao_tex, 0);
  (code) {
    gtao_tex@tex2d = gtao_tex;
    gtao_texel_size@f4 = (1.0 / halfResTexSize.xy, halfResTexSize.xy);
    gtao_limit_sample@f2 = (halfResTexSize.x - 1, halfResTexSize.y - 1,0,0);
    gtao_frame_no@f1 = gtao_frame_no;
  }

  hlsl(code) {
    #include <interleavedGradientNoise.hlsl>

    static const float depthScale = 10.f;
    void addSample(SSAO_TYPE ao, int2 coord, float invDepth10, inout float neighborWeights, inout SSAO_TYPE stdAo)
    {
      // Sample neighbor AO
      coord = clamp(coord, 0, int2(gtao_limit_sample.xy));
      SSAO_TYPE neighborAo = abs(texelFetch(gtao_tex, coord, 0).SSAO_ATTRS - ao);

      // Blend neighbor AO to center AO if neighbor depth is too different from center depth
      float neighborDepth = decode_depth(texelFetch(half_res_close_depth, coord, 0).x, zn_zfar.zw);
      //float neighborDepth = decode_depth(texelFetch(half_res_close_depth, pixel + int2(x,y), 0).r, zn_zfar.zw);
      float neighborWeight = saturate(1.0 - abs(neighborDepth*invDepth10 - depthScale));
      neighborWeights += neighborWeight;
      neighborAo = neighborAo*neighborWeight;
      stdAo = max(stdAo, neighborAo);
    }

    SSAO_TYPE gtao_temporal(int2 pixel)
    {
      // Reconstruct position from depth
      // Note that the position is relative to the camera position (not an absolute world space position)
      float rawDepth = texelFetch(half_res_close_depth, pixel, 0).r;

      BRANCH
      if (rawDepth <= 0)
        return 1;

      float neighborWeights = 0;

      SSAO_TYPE ao = texelFetch(gtao_tex, pixel, 0).SSAO_ATTRS;

      // Get neighborhood
      SSAO_TYPE stdAo = 0;
      float invDepth10 = depthScale*(rawDepth*zn_zfar.w + zn_zfar.z);

      #define KERNEL_R 1
      UNROLL for (int y = -KERNEL_R; y <= KERNEL_R; y++)
      {
        UNROLL for (int x = -KERNEL_R; x <= KERNEL_R; x++)
        {
          if (x != 0 || y != 0)
          {
            addSample(ao, int2(x,y) + pixel, invDepth10, neighborWeights, stdAo);
          }
        }
      }
      //#define ADDITIONAL_KERNEL 1
      #if KERNEL_R < 2
      addSample(ao, pixel + int2(-KERNEL_R-1, -KERNEL_R-1), invDepth10, neighborWeights, stdAo);
      addSample(ao, pixel + int2(+KERNEL_R+1, -KERNEL_R-1), invDepth10, neighborWeights, stdAo);
      addSample(ao, pixel + int2(-KERNEL_R-1, +KERNEL_R+1), invDepth10, neighborWeights, stdAo);
      addSample(ao, pixel + int2(+KERNEL_R+1, +KERNEL_R+1), invDepth10, neighborWeights, stdAo);
      #define SAMPLES_COUNT ((KERNEL_R*2+1)*(KERNEL_R*2+1) - 1 + 4)
      #else
      #define SAMPLES_COUNT ((KERNEL_R*2+1)*(KERNEL_R*2+1) - 1)
      #endif
      neighborWeights = neighborWeights*(1./SAMPLES_COUNT);
      stdAo = stdAo*neighborWeights;

      SSAO_TYPE minAo = saturate(ao - stdAo), maxAo = saturate(ao + stdAo);

      float3 viewVec = lerp_view_vec((pixel.xy + 0.5) * gtao_texel_size.xy);
      float2 texcoord  = (pixel.xy + 0.4999) * gtao_texel_size.xy;
      float3 cameraToPoint = viewVec * decode_depth(rawDepth, zn_zfar.zw);
      reproject_ssao_with_neighborhood(ao, minAo, maxAo, cameraToPoint, texcoord, rawDepth);

      float noise = interleavedGradientNoiseFramed(pixel.xy + 0.5, gtao_frame_no);
      // Apply stochastic rounding to avoid stuck values.
      return floor(ao * 255.0 + noise) * (1.0 / 255.0);
    }
  }
endmacro

shader gtao_temporal
{
  z_write = false;
  z_test = false;
  cull_mode = none;
  color_write = rgb;

  POSTFX_VS(0)
  GTAO_TEMPORAL_CORE(ps)

  hlsl(ps) {

    SSAO_TYPE gtao_temporal_ps(VsOutput input HW_USE_SCREEN_POS) : SV_Target0
    {
      float4 pos = GET_SCREEN_POS(input.pos);
      return gtao_temporal(int2(pos.xy));
    }
  }

  compile("target_ps", "gtao_temporal_ps");
}

shader gtao_temporal_cs
{
  GTAO_TEMPORAL_CORE(cs)

  hlsl(cs) {
    RWTexture2D<SSAO_TYPE> gtao_target : register(u0);

    [numthreads( 8, 8, 1 )]
    void gtao_temporal_cs(uint3 DTid : SV_DispatchThreadID)
    {
      if (any(DTid.xy >= gtao_texel_size.zw))
        return;

      SSAO_TYPE ao = gtao_temporal(DTid.xy);
      texture2DAt(gtao_target, DTid.xy) = ao;
    }
  }

  compile("target_cs", "gtao_temporal_cs");
}
