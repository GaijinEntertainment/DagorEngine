shader sort_batched_high_impl_lights_cs
{
  INIT_SORT_IMPL_LIGHTS_COMMON_PARAMS(cs)
  SORT_IMPL_LIGHTS_CORE(cs, true, MAX_SCENE_SORT_LIGHTS, LIGHTS_SORTER_HIGH_GROUP_SIZE, LIGHTS_SORTER_BATCHED_HIGH_STAGE_DATA_INDEX,
    LIGHTS_SORTER_MEDIUM_GROUP_SIZE)
  compile("target_cs", "main");
}

buffer visible_lights_transit_buffer;

shader visible_lights_pack_constant_buffers_data
{
  (cs) {
    scene_omni_render_lights@buf = scene_omni_render_lights hlsl {
      ByteAddressBuffer scene_omni_render_lights@buf;
    };
    scene_spot_render_lights@buf = scene_spot_render_lights hlsl {
      ByteAddressBuffer scene_spot_render_lights@buf;
    };
    scene_omni_managed_lights@buf = scene_omni_managed_lights hlsl {
      #include <lightsManager.hlsli>
      StructuredBuffer<ManagedLight> scene_omni_managed_lights@buf;
    };
    scene_spot_managed_lights@buf = scene_spot_managed_lights hlsl {
      #include <lightsManager.hlsli>
      StructuredBuffer<ManagedLight> scene_spot_managed_lights@buf;
    };
    visible_lights_data_buf@buf = visible_lights_data_buf hlsl {
      ByteAddressBuffer visible_lights_data_buf@buf;
    };
    visible_lights_counts_buf@buf = visible_lights_counts_buf hlsl {
      StructuredBuffer<uint> visible_lights_counts_buf@buf;
    };
    visible_lights_transit_buffer@uav = visible_lights_transit_buffer hlsl {
      RWByteAddressBuffer visible_lights_transit_buffer@uav;
    };
    partition_omni_lights_flags@uav = partition_omni_lights_flags hlsl {
      RWByteAddressBuffer partition_omni_lights_flags@uav;
    };
    partition_spot_lights_flags@uav = partition_spot_lights_flags hlsl {
      RWByteAddressBuffer partition_spot_lights_flags@uav;
    };
  }

  hlsl(cs) {
    #include <lightsPartition.hlsli>

    ##if (partition_omni_lights_flags != NULL || partition_spot_lights_flags != NULL)
      void pack_clustered_lights_masks(uint const_index)
      {
        bool isSpot = const_index >= VISIBLE_LIGHTS_TRANSIT_SPOT_MASKS_OFFSET;
        uint sectionOffset = isSpot ? VISIBLE_LIGHTS_TRANSIT_SPOT_MASKS_OFFSET : VISIBLE_LIGHTS_TRANSIT_OMNI_MASKS_OFFSET;
        uint countIndex = isSpot ? CLUSTERED_SPOT_LIGHTS_COUNT_INDEX : CLUSTERED_OMNI_LIGHTS_COUNT_INDEX;
        uint idsOffset = isSpot ? CLUSTERED_SPOT_LIGHTS_IDS_OFFSET : CLUSTERED_OMNI_LIGHTS_IDS_OFFSET;
        uint maxLights = isSpot ? MAX_CLUSTERED_SPOT_LIGHTS : MAX_CLUSTERED_OMNI_LIGHTS;

        uint rawLightsCount = structuredBufferAt(visible_lights_counts_buf, countIndex);
        ##assert(rawLightsCount <= maxLights, "clustered lights count %f exceeds max %f", rawLightsCount, maxLights);
        uint lightsCount = min(rawLightsCount, maxLights);
        uint maskIndex = const_index - sectionOffset;
        uint firstLightIndex = maskIndex * VISIBLE_LIGHTS_TRANSIT_MASKS_PER_THREAD;

        uint packedMask = 0u;
        for (
            uint i = 0u, lightIndex = firstLightIndex;
            lightIndex < lightsCount && i < VISIBLE_LIGHTS_TRANSIT_MASKS_PER_THREAD;
            ++i, ++lightIndex
        )
        {
          uint sceneLightIndex = loadBuffer(visible_lights_data_buf, (idsOffset + lightIndex) * 4u);
          uint shadowIdMask = 0u;
          BRANCH
          if (isSpot)
          {
            shadowIdMask = structuredBufferAt(scene_spot_managed_lights, sceneLightIndex).shadowId_mask;
          }
          else
          {
            shadowIdMask = structuredBufferAt(scene_omni_managed_lights, sceneLightIndex).shadowId_mask;
          }
          packedMask |= (decode_managed_mask(shadowIdMask) & 0xFFu) << (i * 8u);
        }
        BRANCH
        if (isSpot)
        {
          ##if (partition_spot_lights_flags != NULL)
            storeBuffer(partition_spot_lights_flags, maskIndex * 4u, packedMask);
          ##endif
        }
        else
        {
          ##if (partition_omni_lights_flags != NULL)
            storeBuffer(partition_omni_lights_flags, maskIndex * 4u, packedMask);
          ##endif
        }
      }
    ##endif

    struct TransitSection
    {
      uint constsOffset;
      uint countIndex;
      uint idsOffset;
      uint maxLights;
      uint lightConsts;
      bool isSpot;
    };

    TransitSection make_transit_section(uint consts_offset, uint count_index, uint ids_offset, uint max_lights, bool is_spot)
    {
      TransitSection section;
      section.constsOffset = consts_offset;
      section.countIndex = count_index;
      section.idsOffset = ids_offset;
      section.maxLights = max_lights;
      section.lightConsts = is_spot ? RENDER_SPOT_LIGHT_CONSTS_COUNT : RENDER_OMNI_LIGHT_CONSTS_COUNT;
      section.isSpot = is_spot;
      return section;
    }

    TransitSection get_transit_section(uint const_index)
    {
      bool isSpot = const_index >= VISIBLE_LIGHTS_TRANSIT_CLUSTERED_SPOT_OFFSET;
      bool isFar = const_index >= (isSpot ? VISIBLE_LIGHTS_TRANSIT_FAR_SPOT_OFFSET : VISIBLE_LIGHTS_TRANSIT_FAR_OMNI_OFFSET);

      uint constsOffset = isSpot ? (isFar ? VISIBLE_LIGHTS_TRANSIT_FAR_SPOT_OFFSET : VISIBLE_LIGHTS_TRANSIT_CLUSTERED_SPOT_OFFSET)
                                 : (isFar ? VISIBLE_LIGHTS_TRANSIT_FAR_OMNI_OFFSET : VISIBLE_LIGHTS_TRANSIT_CLUSTERED_OMNI_OFFSET);
      uint countIndex = isSpot ? (isFar ? FAR_SPOT_LIGHTS_COUNT_INDEX : CLUSTERED_SPOT_LIGHTS_COUNT_INDEX)
                               : (isFar ? FAR_OMNI_LIGHTS_COUNT_INDEX : CLUSTERED_OMNI_LIGHTS_COUNT_INDEX);
      uint idsOffset = isSpot ? (isFar ? FAR_SPOT_LIGHTS_IDS_OFFSET : CLUSTERED_SPOT_LIGHTS_IDS_OFFSET)
                              : (isFar ? FAR_OMNI_LIGHTS_IDS_OFFSET : CLUSTERED_OMNI_LIGHTS_IDS_OFFSET);
      uint maxLights = isFar ? MAX_VISIBLE_FAR_LIGHTS : (isSpot ? MAX_CLUSTERED_SPOT_LIGHTS : MAX_CLUSTERED_OMNI_LIGHTS);

      return make_transit_section(constsOffset, countIndex, idsOffset, maxLights, isSpot);
    }

    [numthreads(256, 1, 1)]
    void main(uint3 dispatch_thread_id : SV_DispatchThreadID)
    {
      uint constIndex = dispatch_thread_id.x;
      BRANCH
      if (constIndex >= VISIBLE_LIGHTS_TRANSIT_CONSTS_COUNT)
        return;

      ##if (partition_omni_lights_flags != NULL || partition_spot_lights_flags != NULL)
        BRANCH
        if (constIndex >= VISIBLE_LIGHTS_TRANSIT_OMNI_MASKS_OFFSET)
        {
          pack_clustered_lights_masks(constIndex);
          return;
        }
      ##endif

      TransitSection section = get_transit_section(constIndex);
      uint lightsCount = min(structuredBufferAt(visible_lights_counts_buf, section.countIndex), section.maxLights);
      uint constInSection = constIndex - section.constsOffset;

      BRANCH
      if (constInSection == 0)
      {
        uint4 header = uint4(lightsCount, (lightsCount + 31u) / 32u, lightsCount > 0u ? lightsCount - 1u : 0u, 0u);
        storeBuffer4(visible_lights_transit_buffer, constIndex * VISIBLE_LIGHTS_TRANSIT_CONST_SIZE, header);
        return;
      }

      uint lightIndex = (constInSection - 1u) / section.lightConsts;
      BRANCH
      if (lightIndex >= lightsCount)
        return;

      uint constInLight = (constInSection - 1u) % section.lightConsts;
      uint sceneLightIndex = loadBuffer(visible_lights_data_buf, (section.idsOffset + lightIndex) * 4u);
      uint srcByteOffset = (sceneLightIndex * section.lightConsts + constInLight) * VISIBLE_LIGHTS_TRANSIT_CONST_SIZE;

      uint4 value;
      BRANCH
      if (section.isSpot)
        value = loadBuffer4(scene_spot_render_lights, srcByteOffset);
      else
        value = loadBuffer4(scene_omni_render_lights, srcByteOffset);
      storeBuffer4(visible_lights_transit_buffer, constIndex * VISIBLE_LIGHTS_TRANSIT_CONST_SIZE, value);
    }
  }

  compile("target_cs", "main");
}

