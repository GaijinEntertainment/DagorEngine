  SORT_IMPL_LIGHTS_CORE(cs, false, MAX_SCENE_SORT_LIGHTS, LIGHTS_SORTER_HIGH_GROUP_SIZE, LIGHTS_SORTER_SCALAR_HIGH_STAGE_DATA_INDEX,
    LIGHTS_SORTER_MEDIUM_GROUP_SIZE)
