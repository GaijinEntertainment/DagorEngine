  SORT_IMPL_LIGHTS_CORE(cs, false, LIGHTS_SORTER_MEDIUM_GROUP_SIZE, LIGHTS_SORTER_MEDIUM_GROUP_SIZE,
    LIGHTS_SORTER_MEDIUM_STAGE_DATA_INDEX, LIGHTS_SORTER_BASIC_GROUP_SIZE)
