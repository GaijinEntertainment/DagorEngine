include "shader_global.dshl"
include "viewVecVS.dshl"
include "gbuffer.dshl"
include "depth_above.dshl"
include "heightmap_common.dshl"

int dao_show_mode = 0;
interval dao_show_mode: plain < 1, normal < 2, texel;

shader debug_depth_above
{
  z_write = false;
  z_test = false;
  cull_mode = none;

  INIT_ZNZFAR()
  USE_DECODE_DEPTH()
  INIT_PACK_UNPACK_DYNSTCODE(ps)
  INIT_READ_DEPTH_GBUFFER()
  INIT_READ_GBUFFER()
  USE_AND_INIT_VIEW_VEC_VS()
  USE_AND_INIT_VIEW_VEC_PS()
  INIT_DEPTH_ABOVE(ps, blurred_depth_transparent)
  USE_DEPTH_ABOVE(ps, blurred_depth_transparent)
  POSTFX_VS_TEXCOORD_VIEWVEC(0, texcoord, viewVect)
  USE_EMISSION_DECODE_COLOR_MAP(ps)
  USE_READ_DEPTH_GBUFFER()
  USE_READ_GBUFFER()

  (ps) {
    world_view_pos@f3 = world_view_pos;
    viewport@f4 = get_viewport();
  }

  hlsl(ps) {
    float4 debug_depth_above_ps(VsOutput input) : SV_Target
    {
      float sceneDepth = linearize_z(readGbufferDepth(input.texcoord), zn_zfar.zw);
      if (sceneDepth >= zn_zfar.y)
        discard;

      float3 viewVect = lerp_view_vec(input.texcoord);
      float3 cameraToPoint = sceneDepth * viewVect;
      float3 worldPos = world_view_pos + cameraToPoint;

      float3 normal = normalize(cross(ddx(cameraToPoint), ddy(cameraToPoint)));

      float depthVignette = 0;
      float3 biasedWorldPos = worldPos + normal;
      float depthAbove = get_depth_above_fast(biasedWorldPos, depthVignette);
      float depthInfl = 1 - saturate(depthAbove - biasedWorldPos.y);

      UnpackedGbuffer gbuf = unpackGbuffer(readPackedGbuffer(input.texcoord));
      ProcessedGbuffer gbuffer = processGbuffer(gbuf);

      float3 color = ApplySRGBCurve(gbuffer.diffuseColor);
      float2 daoMainTc = world_to_depth_ao.xy * biasedWorldPos.xz + world_to_depth_ao.zw;
      // same check as in `clamp_depth_above_tc`
      bool daoUsesExtra = depth_ao_extra_enabled > 0 && any(saturate(daoMainTc) != daoMainTc);
      bool daoInBounds = is_inside_depth_above_bounds(biasedWorldPos);

      const float3 outsidePurple = float3(0.5, 0.0, 0.5);
      const float3 firstCascadeGreen = float3(0.0, 1.0, 0.0);
      const float3 secondCascadeRed = float3(1.0, 0.0, 0.0);
      const float halfWay = 0.5;

    ##if dao_show_mode == normal
      float vignetteEffect;
      color = get_depth_above_normal(worldPos, 0, 1.0)*0.5+0.5;
    ##elif dao_show_mode == texel
      float texelsPerMeter = (daoUsesExtra ? world_to_depth_ao_extra.x : world_to_depth_ao.x) * depth_ao_texture_size;
      float2 worldTexel = worldPos.xz * texelsPerMeter;
      bool checker = ((int(floor(worldTexel.x)) + int(floor(worldTexel.y))) & 1) != 0;
      float shade = checker ? 1.0 : 0.4;
      if (daoInBounds)
      {
        if (daoUsesExtra)
          color =  lerp(color, secondCascadeRed * shade, halfWay);
        else
          color = lerp(color, firstCascadeGreen * shade, halfWay);
      }
    ##else
      if (daoInBounds && depthInfl < 0.0001)
      {
        // green = main cascade, red = extra (second) cascade
        if (daoUsesExtra)
          color = secondCascadeRed;
        else
          color = firstCascadeGreen;
      }
    ##endif

      if (!daoInBounds)
        color = lerp(color, outsidePurple, halfWay);

      return float4(color, 1);
    }
  }

  compile("target_ps", "debug_depth_above_ps");
}