
include "shader_global.dshl"
include "viewVecVS.dshl"
include "gbuffer.dshl"
include "motion_vector_access.dshl"

include "tsr.inc.dshl"
include "taa_inc.dshl"
include "tsr_stability_filter.dshl"
include "tsr_variance_clipping.dshl"
include "tsr_depth_rejection.dshl"
include "tsr_debug.dshl"

shader tsr_cs
{
  bool calc_weights_online = tsr_use_precalculated_filter_weights == no || tsr_vrs_mask != NULL;

  hlsl(cs)
  {
    #define DEBUG_SHOW_OUT_OF_BOUNDS 0
    #define TSR_CS_WORKGROUP_SIZE 8
  }

  VIEW_VEC_OPTIMIZED(cs)
  INIT_ZNZFAR_STAGE(cs)

  INIT_READ_DEPTH_GBUFFER_BASE(cs)
  USE_READ_DEPTH_GBUFFER_BASE(cs)

  INIT_FETCH_MOTION_VECTOR(cs, resolved)
  USE_FETCH_MOTION_VECTOR(cs, resolved)
  MOTION_MASK_NOJITTER(cs)

  INIT_TSR_STABILITY_FILTER(cs)
  USE_TSR_STABILITY_FILTER(cs)

  INIT_TSR_VARIANCE_CLIPPING(cs)
  USE_TSR_VARIANCE_CLIPPING(cs)

  INIT_TSR_DEPTH_REJECTION(cs)
  USE_TSR_DEPTH_REJECTION(cs)

  INIT_TSR_DEBUG(cs)
  USE_TSR_DEBUG(cs)

  local float4 input_tex_resolution = get_dimensions(tsr_input_color, 0);
  if (tsr_vrs_mask != NULL)
  {
    local float4 tsr_vrs_mask_dimensions = get_dimensions(tsr_vrs_mask, 0);
    (cs)
    {
      vrsMask@tex2d = tsr_vrs_mask;
      vrsMaskDimensions@f4 = (tsr_vrs_mask_dimensions.xy, 1.0 / tsr_vrs_mask_dimensions.xy);
    }
  }

  (cs)
  {
    inputColorTex@tex2d = tsr_input_color;

    historyColorTex@smp2d = tsr_history_color;
    historyDepthTex@smp2d = tsr_history_depth;
    historyConfidenceTex@smp2d = tsr_history_confidence;
    reactiveMask@smp2d = tsr_reactive_mask;
    jitterOffset@f2 = (tsr_jitter_offset.x, tsr_jitter_offset.y, 0, 0);
    outputResolution@f4 = (tsr_output_resolution.x, tsr_output_resolution.y, 1/tsr_output_resolution.x, 1/tsr_output_resolution.y);

    uv_transform@f4 = tsr_uv_transform;

    jitteredCamPosToUnjitteredHistoryClip@f44 = jitteredCamPosToUnjitteredHistoryClip;
    shouldRestart@f1 = tsr_should_restart;
    inputFilterSigmaInv@f1 = 1.0/tsr_input_sampling_sigma;
    sharpening@f1 = tsr_sharpening;
    resamplingLossSigmaInv@f1 = 1.0/tsr_resampling_loss_sigma;
    processLoss@f1 = tsr_process_loss;
    ractiveMaskGamma@f1 = tsr_reactive_mask_gamma;

    inputResolution@f4 = (tsr_input_resolution.x, tsr_input_resolution.y, 1/tsr_input_resolution.x, 1/tsr_input_resolution.y);
    inputTextureResolution@f4 = (input_tex_resolution.x, input_tex_resolution.y, 1/input_tex_resolution.x, 1/input_tex_resolution.y);
    upsamplingRatio@f2 = (tsr_output_resolution.x/tsr_input_resolution.x, tsr_output_resolution.y/tsr_input_resolution.y, 0, 0);
    upsamplingRatioInv@f2 = (tsr_input_resolution.x/tsr_output_resolution.x, tsr_input_resolution.y/tsr_output_resolution.y, 0, 0);
    phaseConfiguration@i4 = tsr_phase_configuration;

    kernelWeights@buf = tsr_kernel_weights hlsl {
      #include <tsr_coeffs.hlsli>
      StructuredBuffer<Weights>kernelWeights@buf;
    }

    outColor@uav : register(7) hlsl {
      RWTexture2D<float4> outColor@uav;
    }
    outConfidence@uav : register(6) hlsl {
      RWTexture2D<float> outConfidence@uav;
    }
    outDepth@uav : register(4) hlsl {
      RWTexture2D<float> outDepth@uav;
    }
  }

  if (tsr_use_stochastic_rounding == yes)
  {
    (cs) { frameNo@f1 = tsr_frame_no; }
  }

  hlsl(cs)
  {
    #include <pixelPacking/yCoCgSpace.hlsl>
    #include <tex2d_bicubic.hlsl>
    #include <interleavedGradientNoise.hlsl>

    static const float EPS = 1e-9;

    static const int2 reconstructionTexelOffsetsInt[] =
    {
      int2(-1, -1),
      int2( 0, -1),
      int2( 1, -1),
      int2(-1,  0),
      int2( 0,  0),
      int2( 1,  0),
      int2(-1,  1),
      int2( 0,  1),
      int2( 1,  1)
    };

    #ifndef DEBUG_SHOW_OUT_OF_BOUNDS
    #define DEBUG_SHOW_OUT_OF_BOUNDS 0
    #endif

    float gaussianKernel(float2 delta, float2 inv_sigma)
    {
      float2 exponentTerm = delta * inv_sigma;
      return exp(-0.5 * dot(exponentTerm, exponentTerm));
    }


    float3 tonemap(float3 color) { return color * rcp(abs(color.x) + 1); }

    float3 tonemap_inv(float3 color) { return color * rcp(max(EPS, 1 - abs(color.x))); }

    #define PREFETCH_CALLS_IN_THREAD 2
    #define BORDERED_RESULT_WARP_SIZE (TSR_CS_WORKGROUP_SIZE+2)
    #define BORDERED_RESULT_ENTRY_COUNT (BORDERED_RESULT_WARP_SIZE*BORDERED_RESULT_WARP_SIZE)

    groupshared float3 tonemappedInputColorCache[BORDERED_RESULT_ENTRY_COUNT];

    #define get_flat_bordered_index(pos) ((pos).y*BORDERED_RESULT_WARP_SIZE+(pos).x)

    static const int reconstructionTexelFlatOffsets[] =
    {
      get_flat_bordered_index(reconstructionTexelOffsetsInt[0]),
      get_flat_bordered_index(reconstructionTexelOffsetsInt[1]),
      get_flat_bordered_index(reconstructionTexelOffsetsInt[2]),
      get_flat_bordered_index(reconstructionTexelOffsetsInt[3]),
      get_flat_bordered_index(reconstructionTexelOffsetsInt[4]),
      get_flat_bordered_index(reconstructionTexelOffsetsInt[5]),
      get_flat_bordered_index(reconstructionTexelOffsetsInt[6]),
      get_flat_bordered_index(reconstructionTexelOffsetsInt[7]),
      get_flat_bordered_index(reconstructionTexelOffsetsInt[8]),
    };

    struct CacheParams
    {
      float2 prefetchInputTexelCoordBase;
      uint prefetchIndexBase;
      int flatCacheIndexOffset;
##if calc_weights_online
      float gaussKernel[9];
##endif
##if tsr_vrs_mask != NULL
      float vrsTileArea[9];
##endif
    };

    float2 inputTexelCoordToUv(float2 input_texel_coord)
    {
      float2 clampedInputTexelCoord = clamp(input_texel_coord, 0, inputResolution.xy - 1);
      return (clampedInputTexelCoord + 0.5) * inputTextureResolution.zw;
    }

    int2 inputTexelCoordToFetchCoord(float2 input_texel_coord)
    {
      return int2(clamp(input_texel_coord, 0, inputResolution.xy - 1));
    }

    int2 inputUvToFetchCoord(float2 uv)
    {
      return int2(clamp(uv * inputTextureResolution.xy, 0, inputTextureResolution.xy - 1));
    }

    CacheParams calcCacheParams(uint2 thread_id, float2 global_offset, float2 input_texel_coord)
    {
      CacheParams cacheParams = (CacheParams)0;

      // prefetch 2 horizontally sequential texels for each thread
      const uint CacheLineWidth = BORDERED_RESULT_WARP_SIZE/PREFETCH_CALLS_IN_THREAD;
      uint threadIndex = thread_id.y*TSR_CS_WORKGROUP_SIZE + thread_id.x;
      uint prefetchOffsetX = (threadIndex%CacheLineWidth)*PREFETCH_CALLS_IN_THREAD;
      uint prefetchOffsetY = threadIndex/CacheLineWidth;
      cacheParams.prefetchInputTexelCoordBase = global_offset + float2(prefetchOffsetX, prefetchOffsetY);

      cacheParams.prefetchIndexBase = threadIndex*PREFETCH_CALLS_IN_THREAD;

      // center of the 3x3 stencil must stay one texel inside the 10x10 cache; at input==output
      // res the fp reciprocal round-trip can tip the edge thread out of [1,8] and read OOB
      int2 borderedThreadId = clamp((int2)(input_texel_coord - global_offset), 1, BORDERED_RESULT_WARP_SIZE - 2);
  #if DEBUG_SHOW_OUT_OF_BOUNDS
      if (any(or(borderedThreadId < 1, borderedThreadId >= (BORDERED_RESULT_WARP_SIZE - 1))))
        borderedThreadId = BORDERED_RESULT_WARP_SIZE; // just out of bounds, great for testing if index is valid
  #endif
      cacheParams.flatCacheIndexOffset = get_flat_bordered_index(borderedThreadId);

      return cacheParams;
    }

    void prefetchCacheColor(inout CacheParams cache_params, float2 input_texel_coord, float2 sigma_inv)
    {
      BRANCH if (cache_params.prefetchIndexBase + PREFETCH_CALLS_IN_THREAD <= BORDERED_RESULT_ENTRY_COUNT)
      {
        UNROLL for(uint i = 0; i < PREFETCH_CALLS_IN_THREAD; ++i)
        {
          int2 tc = inputTexelCoordToFetchCoord(cache_params.prefetchInputTexelCoordBase + float2(i, 0));
          float3 color = tonemap(PackToYCoCg(texelFetch(inputColorTex, tc, 0).rgb));
          tonemappedInputColorCache[cache_params.prefetchIndexBase + i] = color;
        }
      }

      float2 texelCoordDiffMul = (frac(input_texel_coord) - 0.5) * upsamplingRatio;

##if calc_weights_online
      // heavy ALU calc while waiting for texture fetches to hide the latency
      UNROLL for(uint i = 0; i < 9; i++)
      {
        float2 deltaOnDisplay = (-(float2)reconstructionTexelOffsetsInt[i]) * upsamplingRatio + texelCoordDiffMul;
##if tsr_vrs_mask != NULL
        static const float centers[] = {0.f, 0.5f, 1.5f}; // tile centers by log(tileSize) without .5 offset
        float2 tapUV = inputTexelCoordToUv(floor(input_texel_coord) + (float2)reconstructionTexelOffsetsInt[i]);
        uint vrsMaskValue = asuint(texelFetch(vrsMask, tapUV * vrsMaskDimensions.xy, 0).x);
        uint2 logTileSize = uint2((vrsMaskValue>>2)&3, vrsMaskValue&3);
        uint2 tileSize = uint2(1, 1) << logTileSize;
        float2 center = float2(centers[logTileSize.x], centers[logTileSize.y]);
        uint2 transformedInputCoord = floor(tapUV * inputTextureResolution.xy);
        deltaOnDisplay += float2(transformedInputCoord & (tileSize - 1)) - center;
        cache_params.gaussKernel[i] = gaussianKernel(deltaOnDisplay, sigma_inv * rcp(tileSize));
        cache_params.vrsTileArea[i] = tileSize.x * tileSize.y;
##else
        cache_params.gaussKernel[i] = gaussianKernel(deltaOnDisplay, sigma_inv);
##endif
      }
##endif
    }

    float3 reconstructInput(in uint2 dtId, in const CacheParams cache_params, out float confidence, out float3 mean, out float3 variance)
    {
      float3 result = 0;
      float3 firstMoment = 0;
      float3 secondMoment = 0;

##if calc_weights_online
      float sumWeights = EPS;
##else
      uint2 phaseId = dtId * phaseConfiguration.xy % phaseConfiguration.zw;
      const Weights weights = kernelWeights[phaseId.y * phaseConfiguration.z + phaseId.x];
      float sumWeights = weights.sum;
##endif

      UNROLL
      for(uint i = 0; i < 9; i++)
      {
##if calc_weights_online
        float weight = cache_params.gaussKernel[i];
        sumWeights += weight;
##else
        float weight = weights.w[i];
##endif
        float3 color = tonemappedInputColorCache[cache_params.flatCacheIndexOffset + reconstructionTexelFlatOffsets[i]];

        result += weight * color;
        firstMoment += color;
##if tsr_vrs_mask != NULL
        secondMoment += color * color * cache_params.vrsTileArea[i];
##else
        secondMoment += color * color;
##endif
      }

      confidence = 1 - rcp(sumWeights + 1);
      firstMoment /= 9;
      mean = firstMoment;
      variance = max(EPS, secondMoment / 9 - firstMoment * firstMoment);

##if calc_weights_online
      return result / sumWeights;
##else
      return result;
##endif
    }

    struct DepthStatistics
    {
      float depth;
      float closestDepth;
      float farthestDepth;
      float2 closestUv;
      // 8-neighbor depth Laplacian: zero on planar surfaces regardless of slope, large on
      // geometric discontinuities/creases - a free edge detector over the taps we already read
      float laplacian;
    };

    DepthStatistics getDepthStatistics(float2 texelCoord)
    {
      DepthStatistics result;

      result.farthestDepth = 1;
      result.closestDepth = 0;
      result.laplacian = 0;

      float2 centerTexelCoord = floor(texelCoord);
      float2 texelCenterTc = inputTexelCoordToUv(centerTexelCoord);
      result.closestUv = texelCenterTc;

      UNROLL
      for(uint i = 0; i < 9; i++)
      {
        float2 tapUV = inputTexelCoordToUv(centerTexelCoord + (float2)reconstructionTexelOffsetsInt[i]);
        float currentDepth = readGbufferDepth(tapUV);

        result.laplacian += all(reconstructionTexelOffsetsInt[i] == int2(0, 0)) ? -8.0 * currentDepth : currentDepth;

        if (all(reconstructionTexelOffsetsInt[i] == int2(0, 0)))
          result.depth = currentDepth;

        FLATTEN
        if (currentDepth > result.closestDepth)
        {
          result.closestDepth = currentDepth;
          result.closestUv = tapUV;
        }

        result.farthestDepth = min(currentDepth, result.farthestDepth);
      }

      return result;
    }

    // calculates the loss term of the current sample being some subpixel distance away from the pixel's mid point
    // which will cause a loss of confidence
    float calculateResamplingLoss(float2 uv)
    {
      return gaussianKernel(frac(uv * outputResolution.xy) - 0.5, resamplingLossSigmaInv);
    }

    float3 reconstructHistory(float2 history_tc, out float depth, out float confidence)
    {
    ##if tsr_history_reconstruction == bicubic
      BicubicSharpenWeights weights;
      compute_bicubic_sharpen_weights(history_tc, outputResolution.xy, outputResolution.zw, sharpening, weights);

      float3 result = weights.w0 * tex2Dlod(historyColorTex, float4(weights.uv0, 0, 0)).rgb;
      result += weights.w1 * tex2Dlod(historyColorTex, float4(weights.uv1, 0, 0)).rgb;
      result += weights.w2 * tex2Dlod(historyColorTex, float4(weights.uv2, 0, 0)).rgb;
      result += weights.w3 * tex2Dlod(historyColorTex, float4(weights.uv3, 0, 0)).rgb;
      result += weights.w4 * tex2Dlod(historyColorTex, float4(weights.uv4, 0, 0)).rgb;
      result /= weights.weightsSum;
    ##else
      float3 result = tex2Dlod(historyColorTex, float4(history_tc, 0, 0)).rgb;
    ##endif

      // depth stays bilinear: the sharpen weights overshoot and would reject valid history
      depth = tex2Dlod(historyDepthTex, float4(history_tc, 0, 0)).x;

      confidence = max(EPS, tex2Dlod(historyConfidenceTex, float4(history_tc, 0, 0)).x);

      // the quality of the sample used should result in a loss of confidence
      confidence *= calculateResamplingLoss(history_tc);

      // even if there is no movement (resampling is perfect) there has to be some loss
      confidence *= processLoss;

      return tonemap(PackToYCoCg(result));
    }

    struct TemporalSuperResolutionOutput
    {
      float3 color: SV_Target0;
      float  confidence: SV_Target1;
      float  depth: SV_Target2;
    };

    bool is_valid(float4 x) { return isfinite(dot(x, 1)); }
    bool is_valid(float3 x) { return isfinite(dot(x, 1)); }
    bool is_valid(float2 x) { return isfinite(dot(x, 1)); }
    bool is_valid(float x) { return isfinite(x); }

    TemporalSuperResolutionOutput calcResult(float3 input_color, float input_depth, float input_confidence, float3 history_color, float history_depth, float history_confidence)
    {
      // the update function is s_next = (s_prev * w_prev + s_cur * w_cur) / (w_prev + w_cur)
      // and the weight update is w_next = w_prev + w_cur
      // using c = w/(w+1) to map the [0;inf] range of accumulated weights to [0;1]
      // after solving the above update equation for c it becomes the code below
      // this is the theoretical optimal accumulation of a stationary scene

      float c1 = input_confidence * (history_confidence - 1);
      float c2 = history_confidence * (input_confidence - 1);
      float c3 = history_confidence * input_confidence - 1;

      float updateRate = (c1 / (c1 + c2)) * debugUpdateOverride;

      TemporalSuperResolutionOutput result;
      result.color = max(0.0, UnpackFromYCoCg(tonemap_inv(lerp(history_color, input_color, updateRate))));
      result.depth = lerp(history_depth, input_depth, updateRate);
      result.confidence = (c1 + c2) / c3;

      bool isValid = is_valid(result.color + result.depth + result.confidence); // the sum is valid <=> all are valid
      result.confidence = isValid ? result.confidence : 0;
      result.depth = isValid ? result.depth : 0;
      result.color = isValid ? result.color : 0;
      return result;
    }

    void validateHistory(float2 historyUV, inout float3 history_color, inout float history_depth, inout float history_confidence, inout float rejection)
    {
      FLATTEN
      if (any(or(or(!is_valid(historyUV), historyUV >= 1.0), historyUV <= 0.0)) || shouldRestart > 0)
      {
        history_color = 0;
        history_depth = 0;
        history_confidence = EPS;
        rejection = 0;
      }
    }

    float3 fetchMotionVector(float raw_depth, float2 uv)
    {
      float3 uvz = fetch_motion_vector_unjittered(uv, raw_depth);
      float prevLinearZ = linearize_z(raw_depth, zn_zfar.zw) + uvz.z;  // TODO: switch to rejection by linear Z
      float prevDepth = inv_linearizeZ(prevLinearZ, zn_zfar);
      return float3(uvz.xy, prevDepth - raw_depth);
    }

    // Rounds the input color up or down to the R11G11B10F number grid with probability of rounding up
    // proportional to how close the value is to the next grid number. Doesn't account for subnormal numbers.
    float3 roundStochasticR11G11B10F(float3 color, float noise)
    {
      const uint3 TARGET_MANTISSA_BITS = uint3(6, 6, 5);
      const uint3 FRACTION_MASK = (1u << (23 - TARGET_MANTISSA_BITS)) - 1u;
      const uint3 QUANTIZATION_MASK = ~FRACTION_MASK;
      uint3 roundUp = uint3((asuint(color) & FRACTION_MASK) > uint3(noise * (FRACTION_MASK + 1u)));
      return asfloat((asuint(color) & QUANTIZATION_MASK) + (roundUp << (23 - TARGET_MANTISSA_BITS)));
    }

    [numthreads( TSR_CS_WORKGROUP_SIZE, TSR_CS_WORKGROUP_SIZE, 1)]
    void tsr_cs(uint2 dtId : SV_DispatchThreadID, uint2 tid : SV_GroupThreadID, uint2 gId : SV_GroupID, uint flatTid : SV_GroupIndex)
    {
      float2 screenTc = (dtId+0.5)*outputResolution.zw;
      float2 jitteredInputTexelCoord = screenTc * inputResolution.xy + jitterOffset;

      float2 globalOffset = floor(((float2)gId * TSR_CS_WORKGROUP_SIZE + 0.5) * upsamplingRatioInv + jitterOffset - 1); // top-left bordered corner: tid==0 case -1
      CacheParams cacheParams = calcCacheParams(tid, globalOffset, jitteredInputTexelCoord);

      DepthStatistics depthStats = getDepthStatistics(jitteredInputTexelCoord);

      float3 motionVector = fetchMotionVector(depthStats.closestDepth, depthStats.closestUv);
      float2 historyUV = screenTc + motionVector.xy;
      ##if tsr_reactive_mask != NULL
        float reactive = tex2Dlod(reactiveMask, float4(inputTexelCoordToUv(jitteredInputTexelCoord), 0, 0)).x;
        reactive = pow(reactive, ractiveMaskGamma);
      ##else
        float reactive = 0;
      ##endif

      float historyConfidence;
      float historyDepth;
      float3 historyColor = reconstructHistory(historyUV, historyDepth, historyConfidence);

      float expectedDepth = historyDepth - motionVector.z;
      float rejection = calcTsrDepthRejection(expectedDepth, depthStats.farthestDepth, depthStats.closestDepth);
      historyConfidence *= rejection;

      validateHistory(historyUV, historyColor, historyDepth, historyConfidence, rejection);

      prefetchCacheColor(cacheParams, jitteredInputTexelCoord, inputFilterSigmaInv);
      GroupMemoryBarrierWithGroupSync();
      if (any(dtId >= uint2(outputResolution.xy)))
        return;
      BRANCH
      if (is_motion_mask_no_jitter(motionVector.xy))
      {
          float4 motionMaskedColor = texelFetch(inputColorTex, inputUvToFetchCoord(screenTc), 0);
          texture2DAt(outColor, dtId) = motionMaskedColor;
          texture2DAt(outDepth, dtId) = depthStats.depth;
          texture2DAt(outConfidence, dtId) = 0;
          return;
      }
      float inputConfidence;
      float3 inputMean;
      float3 inputVariance;
      float3 inputColor = reconstructInput(dtId, cacheParams, inputConfidence, inputMean, inputVariance);

      float aabbScale = calculateAabbScale(length(motionVector.xy), reactive);
      float3 rectifiedhistoryColor = clipHistory(historyColor, inputColor, inputMean, inputVariance, aabbScale);

      ##if tsr_stability_filter_allowed == yes && (tsr_stability_filter == on || tsr_debug == on)
        TsrStability stability = calcTsrStability(inputColor.x, rectifiedhistoryColor.x, depthStats.laplacian,
          depthStats.depth, motionVector.xy * outputResolution.xy, reactive);
      ##endif
      ##if tsr_stability_filter_allowed == yes && tsr_stability_filter == on
        inputConfidence *= stability.scale;
      ##endif

      TemporalSuperResolutionOutput result = calcResult(inputColor, depthStats.depth, inputConfidence, rectifiedhistoryColor, historyDepth, historyConfidence);

    ##if tsr_use_stochastic_rounding == yes
      float noise = interleavedGradientNoiseFramed(dtId + 0.5, frameNo);
      texture2DAt(outColor, dtId) = float4(roundStochasticR11G11B10F(result.color, noise), 0);
    ##else
      texture2DAt(outColor, dtId) = float4(result.color, 0);
    ##endif
      texture2DAt(outDepth, dtId) = result.depth;
      texture2DAt(outConfidence, dtId) = result.confidence;

    ##if tsr_debug == on
      TsrDebug dbg;
      dbg.confidence = result.confidence;
      dbg.rejection = rejection;
      dbg.aabbScale = aabbScale;
      dbg.inputColor = UnpackFromYCoCg(inputColor);
      dbg.historyColor = UnpackFromYCoCg(tonemap_inv(historyColor));
      dbg.rectifiedHistoryColor = UnpackFromYCoCg(tonemap_inv(rectifiedhistoryColor));
      dbg.inputLuma = inputColor.x;
      dbg.historyLuma = historyColor.x;
      dbg.rectifiedHistoryLuma = rectifiedhistoryColor.x;
      dbg.inputConfidence = inputConfidence;
      dbg.historyConfidence = historyConfidence;
      ##if tsr_stability_filter_allowed == yes
      dbg.stabilityScale = stability.scale;
      dbg.stabilityEdginess = stability.edginess;
      ##endif
      writeTsrDebug(dtId, dbg);
    ##endif
    }
  }

  compile("target_cs", "tsr_cs");
}
