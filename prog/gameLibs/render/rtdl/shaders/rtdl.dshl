endmacro

texture precomputed_dynamic_lights;
texture rt_direct_lighting_sun_shadow;
texture rt_direct_lighting_radiance;
texture rt_direct_lighting_unshadowed;
texture rt_direct_lighting_shadow_samples;
texture rt_direct_lighting_normals;
buffer rt_direct_lighting_shadows;
buffer rt_direct_lighting_shadows_prev;
texture rt_direct_lighting_motion_vectors;
texture rt_direct_lighting_history;
texture rt_direct_lighting_history_prev;
buffer rt_direct_lighting_sun_samples;
texture rt_direct_lighting_tiles;
texture rt_direct_lighting_tiles_dilated;
texture rt_direct_lighting_tiles_dilated_prev;
texture rt_direct_lighting_change_tiles;
texture rt_direct_lighting_change_tiles_prev;
texture rt_direct_lighting_sun_spatial;
texture rt_direct_lighting_sun_hit;

float4 rt_direct_lighting_resolution = (1, 1, 1, 1);
int4 rt_direct_lighting_resolutionI = (1, 1, 1, 1);
int4 rt_direct_lighting_full_resolutionI = (1, 1, 0, 0);
float4 rt_direct_lighting_params = (0.1, 2, 8, 1.5);
int rtsm_add_far_screen_space_shadows = 0;
interval rtsm_add_far_screen_space_shadows : no < 1, yes;
float4 rtsm_tree_area;
