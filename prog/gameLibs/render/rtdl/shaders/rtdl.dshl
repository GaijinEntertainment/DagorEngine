float4 rt_direct_lighting_stabilize_params = (16, 3, 4, 8);
int4 rt_direct_lighting_frame_params = (0, 0, 1, 0);
int rt_direct_lighting_sun_quality = 1;
interval rt_direct_lighting_sun_quality : high < 1, medium < 2, low;
int rt_direct_lighting_dynamic_lights = 1;
