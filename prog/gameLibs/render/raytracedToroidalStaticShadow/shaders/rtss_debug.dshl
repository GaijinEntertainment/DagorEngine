include "shader_global.dshl"
include "gbuffer.dshl"
include "postfx_inc.dshl"
include "viewVecVS.dshl"
include "rtss_lookup.dshl"
include_optional "project_rtss_reference.dshl"

define_macro_if_not_defined PROJECT_RTSS_REFERENCE(code)
  hlsl(code) {
    // tc: the screen uv of the pixel; false when the project has no reference for it
    bool project_rtss_reference(float2 tc, out float visibility) { visibility = 1; return false; }
  }
endmacro

int rtss_debug_mode = 1;
int rtss_debug_level = 0;
int rtss_debug_counters_uav_no = 1;

shader rtss_debug_screen
{
  supports global_frame;
  supports none;
  cull_mode = none;
  z_write = false;
  z_test = false;
  blend_src = sa;
  blend_dst = isa;

  USE_AND_INIT_VIEW_VEC_VS()
  POSTFX_VS_TEXCOORD_VIEWVEC(1, texcoord, viewvec)
  INIT_READ_DEPTH_GBUFFER()
  USE_READ_DEPTH_GBUFFER()
  INIT_ZNZFAR()
  INIT_RTSS(ps)
  USE_RTSS(ps)
  PROJECT_RTSS_REFERENCE(ps)
  (ps) {
    debug_world_view_pos@f3 = world_view_pos;
    rtss_debug_mode@i1 = rtss_debug_mode;
    rtss_debug_counters@uav : register(rtss_debug_counters_uav_no) hlsl {
      RWStructuredBuffer<uint> rtss_debug_counters@uav;
    }
  }

  hlsl(ps) {
    #include <interleavedGradientNoise.hlsl>

    float4 rtss_debug_screen_ps(VsOutput IN HW_USE_SCREEN_POS) : SV_Target
    {
      float rawDepth = readGbufferDepth(IN.texcoord);
      if (rawDepth <= 0)
        return 0;
      float3 viewPos = IN.viewvec * linearize_z(rawDepth, zn_zfar.zw);
      float3 worldNormal = normalize(cross(ddx(viewPos), ddy(viewPos)));
      float dither = interleavedGradientNoise(GET_SCREEN_POS(IN.pos).xy);
      float3 posRel = (debug_world_view_pos - rtss_origin) + viewPos;
      RtssTap tap;
      uint level;
      half visibility = rtss_lookup_rel(posRel, worldNormal, dither, level, tap);
      float lod, fade;
      uint selected = rtss_select_level(posRel, dither, lod, fade), miss = RTSS_TAP_HIT;
      RtssTap selectedTap;
      if (level != RTSS_NO_LEVEL && level > selected)
        miss = rtss_find_tap(selected, rtss_normal_offset_pos(posRel, worldNormal, lod), selectedTap);
      if (rtss_params.y == 0)
      {
        InterlockedAdd(structuredBufferAt(rtss_debug_counters, RTSS_COUNTER_LOOKUPS), 1);
        if (level == RTSS_NO_LEVEL && ceil(lod) < rtss_params_i.x) // not past the coarsest level in level 0 axes
          InterlockedAdd(structuredBufferAt(rtss_debug_counters, RTSS_COUNTER_NO_DATA), 1);
        else if (miss != RTSS_TAP_HIT)
          InterlockedAdd(structuredBufferAt(rtss_debug_counters, RTSS_COUNTER_NO_DATA + miss), 1);
      }
      if (rtss_debug_mode == 4)
      {
        if (level == RTSS_NO_LEVEL)
          return float4(0, 0, visibility, 1);
        const float3 missColors[4] = {visibility.xxx, float3(1, 0, 0), float3(1, 0.5, 0), float3(1, 0, 1)};
        return float4(missColors[miss] * (miss == RTSS_TAP_HIT ? 1 : 0.5 + 0.5 * visibility), 1);
      }
      if (rtss_debug_mode == 5)
      {
        float reference;
        bool hasReference = project_rtss_reference(IN.texcoord, reference);
        float NoL = dot(worldNormal, -rtss_level_row(0, uint(rtss_params.z) * 3 + 2).xyz);
        if (NoL <= 0 || level == RTSS_NO_LEVEL || !hasReference)
          return float4(0.25 * visibility.xxx, 1);
        InterlockedAdd(structuredBufferAt(rtss_debug_counters, RTSS_COUNTER_REF_PIXELS), 1);
        float diff = visibility - reference;
        if (abs(diff) > 0.5)
          InterlockedAdd(structuredBufferAt(rtss_debug_counters, RTSS_COUNTER_REF_DIFF), 1);
        return float4(diff < -0.5 ? float3(1, 0, 0) : diff > 0.5 ? float3(0, 0, 1) : visibility.xxx, 1);
      }
      if (rtss_debug_mode != 2 && rtss_debug_mode != 3)
        return float4(visibility.xxx, 1);
      if (level == RTSS_NO_LEVEL)
        return float4(0, 0, 0, 1);
      float3 hue = saturate(abs(frac(level * (1. / RTSS_MAX_LEVELS) + float3(0, 2. / 3, 1. / 3)) * 6 - 3) - 1);
      bool second = tap.bit != (rtss_level_window(level).z & RTSS_LEVEL_NEWEST_BIT);
      float3 tint = second ? float3(0.5, 1, 0.5) : tap.bit ? float3(1, 0.8, 0.6) : float3(0.6, 0.8, 1);
      float3 color = rtss_debug_mode == 2 ? hue : tint;
      return float4(color * ((tap.slot.x + tap.slot.y) & 1 ? 0.8 : 1) * (0.5 + 0.5 * visibility), 1);
    }
  }
  compile("target_ps", "rtss_debug_screen_ps");
}

shader rtss_debug_atlas
{
  supports global_frame;
  supports none;
  cull_mode = none;
  z_write = false;
  z_test = false;

  POSTFX_VS_TEXCOORD(0, texcoord)
  INIT_RTSS(ps)
  (ps) {
    rtss_debug_level@i1 = rtss_debug_level;
  }

  hlsl(ps) {
    #include <rtss_common.hlsli>

    float4 rtss_debug_atlas_ps(VsOutput IN) : SV_Target
    {
      uint W = uint(rtss_params_i.y), S = uint(rtss_params_i.z);
      uint level = min(uint(rtss_debug_level), uint(max(rtss_params_i.x, 1)) - 1);
      uint2 texel = min(uint2(IN.texcoord * float(W * S)), W * S - 1);
      uint2 slot = texel / S;
      uint4 s = rtss_slot((level * W + slot.y) * W + slot.x);
      float2 depth = asfloat(s.zw);
      float3 color = float3(0.25, 0, 0.25);
      if ((s.y & RTSS_SLOT_VALID) != 0)
      {
        float z = rtss_atlas[uint3(texel, level)];
        float grey = z == RTSS_MISS ? 0 : 0.2 + 0.8 * frac((depth.x + z * (depth.y - depth.x)) * (1. / 32));
        color = grey * ((s.y & RTSS_SLOT_BIT) != 0 ? float3(1, 0.8, 0.6) : float3(0.6, 0.8, 1));
      }
      if (any(texel % S == 0))
        color *= 0.5;
      return float4(color, 1);
    }
  }
  compile("target_ps", "rtss_debug_atlas_ps");
}
