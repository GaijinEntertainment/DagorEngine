include "use_downsampled_checkerboard_depth_tex.dshl"

int rtr_rendered = 0;
int rtr_bindless_slot = -1;
int rtr_bindless_sampler_slot = -1;

int rtr_normal_roughness_bindless_slot = -1;
int rtr_normal_roughness_bindless_sampler_slot = -1;

int rtr_output_type = 0;
int rtr_res_mul = 1;
float rtr_probe_treshold = 0.75;
float rtr_blur_radius = 0.03;
int4 rtr_resolutionI = (1,1,1,1);
int4 rtr_output_resolutionI = (1,1,1,1); // only the reflection trace writes it, the glass and the water traces write rtr_resolutionI

int rtr_depth_mode = 0;
interval rtr_depth_mode : def < 1, checker < 2, smart;

texture half_selected_depth_rtr;

macro CHECKING_RTR(stage)
  if (use_hw_raytracing)
  {
    (stage) {
      rtr_rendered@i1 = rtr_rendered;
    }

    hlsl (stage) {
      bool isRTREnabled()
      {
        return rtr_rendered != 0;
      }
    }
  }
  else
  {
    hlsl (stage) {
      bool isRTREnabled()
      {
        return false;
      }
    }
  }
endmacro

macro USING_RTR(stage)
  if (use_hw_raytracing)
  {
    (stage) {
      rtr_rendered@i1 = rtr_rendered;
      rtr_bindless_slot@i1 = rtr_bindless_slot;
      rtr_bindless_sampler_slot@u1 = rtr_bindless_sampler_slot;
      rtr_normal_roughness_bindless_slot@i1 = rtr_normal_roughness_bindless_slot;
      rtr_normal_roughness_bindless_sampler_slot@u1 = rtr_normal_roughness_bindless_sampler_slot;
      rtr_output_type@i1 = rtr_output_type;
      rtr_probe_treshold@f1 = rtr_probe_treshold;
      rtr_blur_radius_texels@f1 = rtr_blur_radius * rtr_output_resolutionI.y;
      inv_output_resolution_rt@f2 = (1.0 / (rtr_output_resolutionI.x * rtr_res_mul), 1.0 / (rtr_output_resolutionI.y * rtr_res_mul));
      rtr_res_mul@u1 = rtr_res_mul;
    }

    if (rtr_depth_mode == checker)
    {
      (stage) { rtr_sample_depth@smp2d = downsampled_checkerboard_depth_tex; }
    }
    else if (rtr_depth_mode == smart)
    {
      (stage) { rtr_sample_depth@smp2d = half_selected_depth_rtr; }
    }


    hlsl (stage) {
      #include <NRD.hlsli>

      #define HAS_RTR 1

      #define RTR_REBLUR 0
      #define RTR_RELAX  1
      #define RTR_RR     255
      #define RTR_BLUR   2

      ##if rtr_depth_mode == def
        #define SOFTWARE_BILATERAL_FILTERING 0
      ##else
        #define SOFTWARE_BILATERAL_FILTERING 1
      ##endif

      #include <rt_texture_outputs.inc.hlsli>

      bool isRTREnabled()
      {
        return rtr_rendered != 0 && rtr_bindless_slot >= 0;
      }

      // the blur traces only below the probe treshold, the other pixels take the reflection of the resolve
      bool isRTRCovered(float roughness)
      {
        return rtr_output_type != RTR_BLUR || roughness < rtr_probe_treshold;
      }

      // the output at a full res pixel, still packed: a half res output takes its texels by the roughness
      float4 getRTRPacked(uint2 tci, float roughness, float w, uint nrd_material)
      {
        BRANCH
        if (rtr_res_mul != 1)
        {
          // Read the roughness for the RTR as well. Sample an RTR value where the roughness matches the gbuffer.
          // TODO: Supplying uv as-is for gather4 is not correct. Revisit it later
          float2 uv = (tci.xy + 0.5) * inv_output_resolution_rt;



          float4 color = 1;

          #if SOFTWARE_BILATERAL_FILTERING
            float4 rawDepths = rtr_sample_depth.GatherRed(rtr_sample_depth_samplerstate, uv, 0);

            float4 linearDepths = linearize_z4(rawDepths, zn_zfar.zw);

            float4 red   = uniformBindlessTex2D(rt_texture_outputs, rtr_bindless_slot).GatherRed  (global_samplers_array[rtr_bindless_sampler_slot], uv, 0);
            float4 green = uniformBindlessTex2D(rt_texture_outputs, rtr_bindless_slot).GatherGreen(global_samplers_array[rtr_bindless_sampler_slot], uv, 0);
            float4 blue  = uniformBindlessTex2D(rt_texture_outputs, rtr_bindless_slot).GatherBlue (global_samplers_array[rtr_bindless_sampler_slot], uv, 0);

            float4 weights = pow2(w / max(abs(w - linearDepths), 1e-6));

            #if NRD_NORMAL_ENCODING == NRD_NORMAL_ENCODING_R10G10B10A2_UNORM
               uint4 rtrMaterialIds = round(uniformBindlessTex2D(rt_texture_outputs, rtr_normal_roughness_bindless_slot)
                                            .GatherAlpha(global_samplers_array[rtr_normal_roughness_bindless_sampler_slot], uv, 0) * 3);
               weights *= rtrMaterialIds == nrd_material;
            #endif

            // a Blur code is no radius: only the texels with a ray mix, and with none of them there is no ray
            float4 blurAlpha = 0;
            BRANCH
            if (rtr_output_type == RTR_BLUR)
            {
              blurAlpha = uniformBindlessTex2D(rt_texture_outputs, rtr_bindless_slot).GatherAlpha(global_samplers_array[rtr_bindless_sampler_slot], uv, 0);
              weights *= blurAlpha >= 0;
            }

            float3 accum = float3(dot(weights, red), dot(weights, green), dot(weights, blue));
            float weightSum = dot(weights, 1);

            color.rgb = accum / max(weightSum, 1e-6);
            BRANCH
            if (rtr_output_type == RTR_BLUR)
              color.a = weightSum > 0 ? dot(weights, blurAlpha) / weightSum : -2;
          #else
            float4 rtrRoughness;
            #if( NRD_NORMAL_ENCODING == NRD_NORMAL_ENCODING_R10G10B10A2_UNORM )
              float4 s = uniformBindlessTex2D(rt_texture_outputs, rtr_normal_roughness_bindless_slot).GatherBlue(global_samplers_array[rtr_normal_roughness_bindless_sampler_slot], uv, 0);
              rtrRoughness = abs(2*s-1);
            #else
              rtrRoughness = uniformBindlessTex2D(rt_texture_outputs, rtr_normal_roughness_bindless_slot).GatherAlpha(global_samplers_array[rtr_normal_roughness_bindless_sampler_slot], uv, 0);
            #endif
            #if( NRD_ROUGHNESS_ENCODING == NRD_ROUGHNESS_ENCODING_SQRT_LINEAR )
              rtrRoughness *= rtrRoughness;
            #elif( NRD_ROUGHNESS_ENCODING == NRD_ROUGHNESS_ENCODING_SQ_LINEAR )
              rtrRoughness = sqrt(saturate(rtrRoughness));
            #endif

            const float tolerance = 0.1;

            float minr = min(min(rtrRoughness.x, rtrRoughness.y), min(rtrRoughness.z, rtrRoughness.w));
            float maxr = max(max(rtrRoughness.x, rtrRoughness.y), max(rtrRoughness.z, rtrRoughness.w));

            float4 blurAlpha = 0;
            BRANCH
            if (rtr_output_type == RTR_BLUR)
              blurAlpha = uniformBindlessTex2D(rt_texture_outputs, rtr_bindless_slot).GatherAlpha(global_samplers_array[rtr_bindless_sampler_slot], uv, 0);
            // a linear sample would mix a Blur code into a radius
            bool closeMatch = abs(minr - maxr) < tolerance && all(blurAlpha >= 0);
            [branch]
            if (closeMatch)
              color = uniformBindlessTex2D(rt_texture_outputs, rtr_bindless_slot).SampleLevel(global_samplers_array[rtr_bindless_sampler_slot], uv, 0);
            else
            {
              uint di = 0;
              float d = abs(roughness - rtrRoughness[0]);

              UNROLL
              for (uint i = 1; i < 4; ++i)
              {
                float ds = abs(roughness - rtrRoughness[i]);
                if (ds < d)
                {
                  d = ds;
                  di = i;
                }
              }

              color.r = uniformBindlessTex2D(rt_texture_outputs, rtr_bindless_slot).GatherRed(global_samplers_array[rtr_bindless_sampler_slot], uv, 0)[di];
              color.g = uniformBindlessTex2D(rt_texture_outputs, rtr_bindless_slot).GatherGreen(global_samplers_array[rtr_bindless_sampler_slot], uv, 0)[di];
              color.b = uniformBindlessTex2D(rt_texture_outputs, rtr_bindless_slot).GatherBlue(global_samplers_array[rtr_bindless_sampler_slot], uv, 0)[di];
              BRANCH
              if (rtr_output_type == RTR_BLUR)
                color.a = blurAlpha[di];
            }
          #endif

          return color;
        }
        else
        {
          float2 uv = (tci.xy + 0.5) * inv_output_resolution_rt;
          return uniformBindlessTex2D(rt_texture_outputs, rtr_bindless_slot).SampleLevel(global_samplers_array[rtr_bindless_sampler_slot], uv, 0);
        }
      }

      float3 getRTR(uint2 tci, float roughness, float w, uint nrd_material)
      {
        BRANCH
        if (rtr_output_type == RTR_RR)
          return texture2DAt(uniformBindlessTex2D(rt_texture_outputs, rtr_bindless_slot), tci).gba;
        float4 color = getRTRPacked(tci, roughness, w, nrd_material);
        return rtr_output_type == RTR_REBLUR
             ? REBLUR_BackEnd_UnpackRadianceAndNormHitDist(color).rgb
             : RELAX_BackEnd_UnpackRadiance(color).rgb;
      }

      // The Blur output: rgb is the reflection, a is 1 where its texel had a ray and 0 where the reader keeps its own
      // reflection. Mip 0 holds the blur up to rtr_blur_radius and in alpha the radius the lobe needs, or a code of the
      // blur (-1 the trace value, -2 no ray). The mips hold the pyramid for a wider lobe, premultiplied by coverage.
      bool isRTRWeighted()
      {
        return rtr_output_type == RTR_BLUR;
      }

      float3 getRTRPyramid(float2 uv, float mip)
      {
        float4 texel = uniformBindlessTex2D(rt_texture_outputs, rtr_bindless_slot)
                         .SampleLevel(global_samplers_array[rtr_bindless_sampler_slot], uv, max(mip, 1));
        return texel.rgb / max(texel.a, 1e-7);
      }

      float4 getRTRWeighted(uint2 tci, float roughness, float w)
      {
        float4 base = getRTRPacked(tci, roughness, w, 0);
        BRANCH
        if (base.a < -1.5)
          return 0;
        BRANCH
        if (base.a < 0.25)
          return float4(base.rgb, 1);
        float2 uv = (tci.xy + 0.5) * inv_output_resolution_rt;
        float mip = log2(base.a);
        float3 lobe = base.rgb;
        BRANCH
        if (base.a > rtr_blur_radius_texels)
          lobe = lerp(base.rgb, getRTRPyramid(uv, mip), saturate(log2(base.a / rtr_blur_radius_texels)));
        // the 1/4 of the GGX lobe that lobe_radius of reflection_blur.dshl leaves out, none where it fits in a texel
        return float4(lerp(lobe, getRTRPyramid(uv, mip + 2), 0.25 * saturate(mip + 2)), 1);
      }

      float3 getRTRFiltered(uint2 tci, float roughness, float w, uint nrd_material)
      {
        BRANCH
        if (rtr_output_type == RTR_RR)
        {
          return getRTR(tci, roughness, w, nrd_material);
        }
        else
        {
          float2 uv = (tci.xy + 0.5) * inv_output_resolution_rt;
          float4 red = uniformBindlessTex2D(rt_texture_outputs, rtr_bindless_slot).GatherRed(global_samplers_array[rtr_bindless_sampler_slot], uv);

          bool4 isColorFinite = isfinite(red);
          if (all(isColorFinite))
            return getRTR(tci, roughness, w, nrd_material);
          if (!any(isColorFinite))
            return 0;

          float4 green = uniformBindlessTex2D(rt_texture_outputs, rtr_bindless_slot).GatherGreen(global_samplers_array[rtr_bindless_sampler_slot], uv);
          float4 blue = uniformBindlessTex2D(rt_texture_outputs, rtr_bindless_slot).GatherBlue(global_samplers_array[rtr_bindless_sampler_slot], uv);

          float4 weight = float4(isColorFinite);
          float weightTotal = dot(weight, weight);

          float4 color = 0;
          UNROLL
          for(int i = 0; i < 4; i++)
          {
            if (isColorFinite[i])
            {
              float4 colorSample = float4(red[i], green[i], blue[i], 0);
              float4 colorDecoded = rtr_output_type == RTR_REBLUR
                ? REBLUR_BackEnd_UnpackRadianceAndNormHitDist(colorSample)
                : RELAX_BackEnd_UnpackRadiance(colorSample);
              color += colorDecoded;
            }
          }
          color /= weightTotal;

          return color.rgb;
        }
      }
    }
  }
  else
  {
    hlsl (stage) {
      bool isRTREnabled()
      {
        return false;
      }

      float3 getRTR(uint2 tci, float roughness, float w, uint nrd_material)
      {
        return 0;
      }
      float3 getRTRFiltered(uint2 tci, float roughness, float w, uint nrd_material)
      {
        return 0;
      }
    }
  }
endmacro