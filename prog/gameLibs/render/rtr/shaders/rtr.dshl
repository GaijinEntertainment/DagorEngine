include "shader_global.dshl"
include "gbuffer.dshl"
include "viewVecVS.dshl"
include "bvh.dshl"
include "rt/rt_lighting.dshl"
include "rt/rt_direct_surface_reflection.dshl"
include "rt/rt_prev_frame_sample.dshl"
include "rt_path_tracing.dshl"
include "use_prefiltered_gf.dshl"
include "wetness_inc.dshl"
include "bvh_common_includes.dshl"
include "camera_in_camera.dshl"
include "rtao_use.dshl"
include "ssao_use.dshl"
include "use_downsampled_checkerboard_depth_tex.dshl"

float4x4 inv_proj_tm;

texture rtr_target;
texture rtr_denoised;

texture translucent_gbuffer;
texture translucent_gbuffer_depth;
texture rt_nr;

texture rtr_validation_texture;
float4 rtr_validation_uv_scale = (1, 1, 0, 0);

int rtr_frame_index;

float4 rtr_hit_dist_params;

int4 rtr_resolutionI = (1,1,1,1);

texture denoiser_view_z;

float rtr_rough_ray_length;
float rtr_ray_limit_coeff = 0;
float rtr_ray_limit_power = 1;

int rtr_output_type = 0;

int rtr_res_mul = 1;
interval rtr_res_mul: full_res < 2, half_res;
int rtr_checkerboard = 1;

float rtr_probe_treshold = 0.75;
int rtr_use_prev_frame_sample = 1;
int rtr_is_binocular = 0;

int rtr_use_specular_occlusion;
interval rtr_use_specular_occlusion: no<1, yes;

int rtr_hack_reflection_dir_by_geometry_normal = 0;
interval rtr_hack_reflection_dir_by_geometry_normal: no < 1, yes;
assume_if_not_assumed rtr_hack_reflection_dir_by_geometry_normal = no;

int rtr_depth_mode = 0;
interval rtr_depth_mode : def < 1, checker < 2, smart;

texture half_selected_depth_rtr;

int rtr_rr_stochastic_ray = 1;
int denoiser_apply_wetness = 0;
interval denoiser_apply_wetness : no < 1, yes;

// The count includes the reflection ray
int rtr_pt_max_bounces = 3;
// Without the probe fallback a short ray misses into the bright sky
float rtr_pt_min_ray_length = 100;
float rtr_pt_max_ray_length = 400;
int rtr_has_path_tracing;
interval rtr_has_path_tracing: no < 1, yes;
assume_if_not_assumed rtr_has_path_tracing = no;

hlsl {
  #pragma hlsl2021

  #define RTR_REBLUR 0
  #define RTR_RELAX  1
  #define RTR_RR     255
  #define RTR_BLUR   2
}

shader rt_reflection, rt_reflection_pt
{
  INIT_AND_USE_ON_TOP_CAMERA_IN_CAMERA(cs)

  if (compatibility_mode == compatibility_mode_on || !use_hw_raytracing) { dont_render; }
  if (shader == rt_reflection_pt && rtr_has_path_tracing == no) { dont_render; }

  (cs) {
    from_sun_direction@f3 = from_sun_direction;
    sun_color_0@f3 = sun_color_0;
  }

  USE_EMISSION_DECODE_COLOR_MAP_STUB(cs)

  (cs) {
    inv_proj_tm@f44 = inv_proj_tm;
    world_view_pos@f3 = world_view_pos;
    resolution@u2 = rtr_resolutionI;
    inv_aligned_resolution@f2 = rtr_res_mul * screen_pos_to_texcoord.xy;
    hit_dist_params@f3 = rtr_hit_dist_params;
    rough_ray_length@f1 = rtr_rough_ray_length;
    frame_index@i1 = rtr_frame_index;
    rtr_res_mul@i1 = rtr_res_mul;
    rtr_checkerboard@i1 = rtr_checkerboard;
    ray_limit_coeff@f1 = rtr_ray_limit_coeff;
    ray_limit_power@f1 = rtr_ray_limit_power;
    probe_treshold@f1 = rtr_probe_treshold;
    output@uav = rtr_target hlsl { RWTexture2D<float4> output@uav; };
    denoised@uav = rtr_denoised hlsl { RWTexture2D<float4> denoised@uav; };
    viewZTexture@uav = denoiser_view_z hlsl { RWTexture2D<float> viewZTexture@uav; };
    rtr_use_prev_frame_sample@i1 = rtr_use_prev_frame_sample;
    rtr_rr_stochastic_ray@i1 = rtr_rr_stochastic_ray;
    rtr_is_binocular@i1 = rtr_is_binocular;
    rtr_output_type@u1 = rtr_output_type;
    nr_texture@tex2d = rt_nr;
  }

  if (shader == rt_reflection_pt)
  {
    (cs) {
      max_bounces@u1 = rtr_pt_max_bounces;
      min_ray_length@f1 = rtr_pt_min_ray_length;
      max_ray_length@f1 = rtr_pt_max_ray_length;
    }
  }

  if (rtr_depth_mode == checker)
  {
    (cs) { rtr_tracing_depth@smp2d = downsampled_checkerboard_depth_tex; }
  }
  else if (rtr_depth_mode == smart)
  {
    (cs) { rtr_tracing_depth@smp2d = half_selected_depth_rtr; }
  }

  hlsl(cs) {
    #include <NRD.hlsli>

    // We collide with SH1 otherwise
    namespace ml
    {
      #include <ml.hlsli>
    }
  }

  USE_AND_INIT_VIEW_VEC_CS()
  INIT_ZNZFAR_STAGE(cs)
  INIT_PACK_UNPACK_DYNSTCODE(cs)

  INIT_BVH(cs, 0, false)

  INIT_BVH_BINDLESS_GBUFFER(cs)
  INIT_LOAD_BVH_FLAGS_BASE(cs)
  USE_LOAD_GBUFFER_BASE(cs, true)
  USE_LOAD_IS_HERO_COCKPIT(cs)
  USE_LOAD_BVH_FLAGS_BASE(cs)
  USE_LOAD_DEPTH_GBUFFER_BASE(cs)
  USE_BVH_FOR_REFLECTION(cs)
  USE_BVH_FX_RENDER(cs, false)

  USE_ADAPTIVE_RAY_OFFSET(cs)

  if (shader == rt_reflection_pt)
  {
    INIT_RT_LIGHTING(cs, false, true, false, true)
    USE_RT_LIGHTING(cs, 0, false)
    USE_RT_PATH_TRACING(cs)
  }
  else
  {
    INIT_RT_LIGHTING(cs, false, true, true, rtr_shadow == on)
    INIT_RT_DIRECT_SURFACE_REFLECTION(cs)
    USE_RT_LIGHTING(cs, 0, false)
    USE_RT_DIRECT_SURFACE_REFLECTION(cs)
  }
  INIT_BVH_ATMOSPHERE(cs)
  USE_BVH_ATMOPHERE(cs)
  RT_PREV_FRAME_SAMPLE(cs, RTRScreenSample, rtr_use_prev_frame_sample)

  if (rtr_res_mul == full_res)
  {
    USE_CALC_GEOMETRY_NORMAL(cs)
  }
  else
  {
    USE_CALC_GEOMETRY_NORMAL_HALF(cs)
  }
  INIT_BVH_WATER_FADE_RTR(cs)
  USE_BVH_WATER_FADE_RTR(cs)
  INIT_RT_WATER_MEDIUM(cs)
  USE_RT_WATER_MEDIUM(cs)

  GET_SCATTERED_REFLECTION_VECTOR(cs)

  if (rtr_use_specular_occlusion == yes)
  {
    (cs) {
      ssao_tex@tex2d = ssao_tex;
      ssao_apply_strength@f1 = ssao_apply_strength;
    }
    USE_SCREENPOS_TO_LOWRES_TC_BASE(cs)
    hlsl(cs) {
      float getSSAOSimple(float2 screenpos)
      {
        float2 ssaotc = screen_pos_to_lowres_tc(screenpos);
        float ssao = ssao_tex.SampleLevel(bvh_clamp_sampler, ssaotc, 0).x;
        ssao = pow(ssao, ssao_apply_strength);
        return ssao;
      }
    }
    USING_RTAO(cs)
  }

  if (gbuffer_has_hero_cockpit){
    hlsl(cs) {
      bool isHeroCockpit(float2 uv)
      {
        if (rtr_output_type != RTR_RR)
        {
          ##if rtr_res_mul == full_res
            return isGbufferHeroCockpit(uv * rtr_res_mul);
          ##else
            bool isHeroCockpit00  = isGbufferHeroCockpit(uv * rtr_res_mul + uint2(0, 0));
            bool isHeroCockpit10  = isGbufferHeroCockpit(uv * rtr_res_mul + uint2(1, 0));
            bool isHeroCockpit01  = isGbufferHeroCockpit(uv * rtr_res_mul + uint2(0, 1));
            bool isHeroCockpit11  = isGbufferHeroCockpit(uv * rtr_res_mul + uint2(1, 1));
            return isHeroCockpit00 || isHeroCockpit10 || isHeroCockpit01 || isHeroCockpit11;
          ##endif
        }
        else
        {
          ProcessedGbuffer gbuffer = processGbuffer(unpackGbuffer(loadPackedGbuffer(uv)));
          return gbuffer.isHeroCockpit > 0;
        }
      }
    }
  }

  hlsl(cs)
  {
    #define MAX_ACCUM_DENOISE_FRAMES 30

    #define PT_SPEC_LOBE_ENERGY 0.95

    float load_trace_depth(uint2 index)
    {
      ##if rtr_res_mul == half_res
        ##if rtr_depth_mode != def
          return texture2DAt(rtr_tracing_depth, index).r;
        ##else
          return texture2DAt(half_res_depth_tex, index).r;
        ##endif
      ##else
        return loadGbufferDepth(index);
      ##endif
    }

    ##if denoiser_apply_wetness == yes
      float wet(float roughness, float3 world_pos, float3 vertical_normal, float3 view, float material, bool isLandscape, float3 normal)
      {
        half3 albedo = 1;
        half smoothness = 1 - roughness;
        half reflectance = 1;
        apply_env_wetness(world_pos, vertical_normal, view, material, isLandscape, albedo, smoothness, normal, reflectance);
        return 1 - smoothness;
      }
    ##endif

    // the denoise skips a marked pixel, one with an INF view z: the ones this trace marks and the ones the shadow
    // trace marked before it, so every marked pixel takes the traced value
    void write_marked(uint2 index, bool mark, float4 value)
    {
      if (mark)
        texture2DAt(viewZTexture, index) = INF;
      // a sky pixel of the pair has an INF view z too and keeps its clear
      if ((mark || texture2DAt(viewZTexture, index) >= INF) && load_trace_depth(index) > 0)
        texture2DAt(denoised, index) = value;
    }

    float calc_ray_length(float roughness)
    {
      const float invThresholdRoughness = 1/0.01;
      return ray_limit_coeff > 0 ?
          min(hit_dist_params.x, ray_limit_coeff * pow(roughness * invThresholdRoughness, ray_limit_power)) :
          lerp(hit_dist_params.x, rough_ray_length, roughness);
    }

    ##if shader == rt_reflection_pt
      #define PT_THROUGHPUT_THRESHOLD 0.001
      #define PT_SKY_DIFFUSE_MIP 3
      #define PT_SHADOW_RAY_LENGTH 10000

      // Light that reaches the reflection hit from the rest of the path, as seen from the hit
      float3 trace_bounces(SurfaceParams surface, float path_length)
      {
        float3 radiance = 0;
        float3 throughput = 1;

        [loop]
        for (uint bounce = 1; bounce < max_bounces && any(throughput > PT_THROUGHPUT_THRESHOLD); ++bounce)
        {
          if (bounce > 1 && !rt_pt_survive(throughput))
            break;

          bool isDiffuse = rt_pt_choose_diffuse_lobe(surface, throughput);
          float3 sampleDir = rt_pt_sample_lobe(surface, isDiffuse);
          throughput *= calc_throughput_mod(surface, isDiffuse, sampleDir, surface.albedo);

          float3 origin = applyAdaptiveRayOffset(surface.position, surface.normal);
          float lobeRoughness = isDiffuse ? 1 : 1 - surface.smoothness;
          float rayLength = clamp(calc_ray_length(lobeRoughness), min_ray_length, max_ray_length);
          float traceEnd = rt_water_trace_end(origin, sampleDir, rayLength);

          // Alpha test on the bounces costs much and gives little
          HitInfo hitInfo;
          bool isHit = trace_ray_with_screen_sample<RTRScreenSample>(bvhMain, origin, sampleDir, 0, traceEnd, path_length, bvhGroupGI, hitInfo, RAY_FLAG_FORCE_OPAQUE);

          float3 waterTransmittance, waterInscatter;
          if (!isHit)
          {
            rt_water_segment(origin, sampleDir, false, 0, waterTransmittance, waterInscatter);
            float skyMip = isDiffuse ? PT_SKY_DIFFUSE_MIP : ComputeReflectionCaptureMipFromRoughness(1 - surface.smoothness);
            radiance += (sample_envi_probe(half4(sampleDir, skyMip)).rgb * waterTransmittance + waterInscatter) * throughput;
            break;
          }

          rt_water_segment(origin, sampleDir, true, hitInfo.t, waterTransmittance, waterInscatter);

          if (hitInfo.isScreenHit)
          {
            // The previous frame is already fully lit, the path can stop here
            radiance += (hitInfo.screenRadiance * waterTransmittance + waterInscatter) * throughput;
            break;
          }

          SurfaceParams hitSurface = calc_surface_params(hitInfo, -sampleDir, path_length, path_length);
          path_length += hitInfo.t;

          half3 hitLighting = light_hit_surface(hitSurface, -sampleDir, path_length, hitInfo.t, PT_SHADOW_RAY_LENGTH, 0, false, RAY_FLAG_FORCE_OPAQUE);
          radiance += (hitLighting * waterTransmittance + waterInscatter) * throughput;
          throughput *= waterTransmittance;
          surface = hitSurface;
        }

        return radiance;
      }
    ##endif

    [numthreads(8, 8, 1)]
    void rt_reflection_cs(uint2 dtid : SV_DispatchThreadID)
    {
      #ifndef BVH_GRASS
        #define BVH_GRASS 0
      #endif
      #ifndef BVH_FOLIAGE
        #define BVH_FOLIAGE 0
      #endif

      uint2 rayIndex = dtid;
      uint2 outputIndex = rayIndex;

      if (rtr_output_type != RTR_RR)
      {
        BRANCH
        if (rtr_checkerboard)
        {
          rayIndex.x *= 2;

          bool evenFrame = ( frame_index & 1 ) == 0;
          bool evenLine  = ( rayIndex.y & 1 ) == 0;

          if ( evenFrame != evenLine && rayIndex.x + 1 != resolution.x) // on odd resolution.x, don't checkerboard on the edge.
            rayIndex.x += 1;
        }
      }

      [branch]
      if (any(rayIndex >= resolution))
        return;

      float rawDepth = load_trace_depth(rayIndex);
      bool noSurface = rawDepth <= 0 || !bvhMainValid;

      if (rtr_output_type != RTR_RR && noSurface)
        texture2DAt(output, outputIndex) = 0;

      [branch]
      if (noSurface)
        return;

      float2 tc = (float2(rayIndex) + 0.5) * inv_aligned_resolution;
      DISCARD_IF_INVALID_VIEW_AREA_CS(tc);

      float w = linearize_z(rawDepth, zn_zfar.zw);

      ##if rtr_res_mul == full_res
        uint2 gbufferTexel = rayIndex * rtr_res_mul;
        uint bvhFlags  = loadBvhFlags(gbufferTexel);
        bool isGrass   = bvhFlags & BVH_GRASS;
        bool isFoliage = bvhFlags & BVH_FOLIAGE;
      ##else
        // Todo: Replace with gather
        float4 depths;
        depths.x = loadGbufferDepth(rayIndex * rtr_res_mul + uint2(0, 0));
        depths.y = loadGbufferDepth(rayIndex * rtr_res_mul + uint2(1, 0));
        depths.z = loadGbufferDepth(rayIndex * rtr_res_mul + uint2(0, 1));
        depths.w = loadGbufferDepth(rayIndex * rtr_res_mul + uint2(1, 1));
        bool4 aoMask = depths == rawDepth;
        uint2 offsetForSampling = aoMask.x ? uint2(0, 0) : (aoMask.y ? uint2(1, 0) : (aoMask.z ? uint2(0, 1) : uint2(1, 1)));
        uint2 gbufferTexel = rayIndex * rtr_res_mul + offsetForSampling;
        uint bvhFlags  = loadBvhFlags(gbufferTexel);
        bool isGrass   = bvhFlags & BVH_GRASS;
        bool isFoliage = bvhFlags & BVH_FOLIAGE;
      ##endif

      float3 relPos = calc_camera_relative_pos(rayIndex, w, inv_aligned_resolution);
      half3 toPoint = (half3)normalize(relPos);

      half3 normal;
      half roughness;
      ##if rtr_use_specular_occlusion == yes
        half ao;
      ##endif
      if (rtr_output_type == RTR_RR)
      {
        ProcessedGbuffer gbuffer = processGbuffer(unpackGbuffer(loadPackedGbuffer(rayIndex)));
        normal = gbuffer.normal;
        roughness = gbuffer.linearRoughness;
        ##if denoiser_apply_wetness == yes
          roughness = wet(gbuffer.linearRoughness, bvh_origin + relPos, gbuffer.normal, -toPoint, gbuffer.material, gbuffer.isLandscape, gbuffer.normal);
        ##endif
        ##if rtr_use_specular_occlusion == yes
          ao = gbuffer.ao;
        ##endif
      }
      else
      {
        float4 surfaceNormal_roughness = NRD_FrontEnd_UnpackNormalAndRoughness(texture2DAt(nr_texture, rayIndex));
        normal = (half3)normalize(surfaceNormal_roughness.xyz);
        roughness = surfaceNormal_roughness.w;
        ##if rtr_use_specular_occlusion == yes
          ##if rtr_res_mul == full_res
            ao = processGbuffer(unpackGbuffer(loadPackedGbuffer(rayIndex))).ao;
          ##else
            ao = processGbuffer(unpackGbuffer(loadPackedGbuffer((rayIndex * rtr_res_mul + offsetForSampling)))).ao;
          ##endif
        ##endif
      }

      bool isBinocularArea = false;
      ##if gbuffer_has_hero_cockpit
        if (rtr_is_binocular)
          isBinocularArea = isHeroCockpit(rayIndex);
      ##endif

      ml::Rng::Hash::Initialize(rayIndex, frame_index);

      float3 toCamera = -toPoint;

      float rayCastChance = 1;
      float3 sampleDir;
      BRANCH
      if (rtr_output_type == RTR_BLUR)
        sampleDir = normalize(getRoughReflectionVec(reflect(normalize(relPos), float3(normal)), normal, roughness * roughness));
      else
      {
        float2 rnd = ml::Rng::Hash::GetFloat2();

        [branch]
        if (rtr_output_type == RTR_RR && rtr_rr_stochastic_ray)
        {
          rayCastChance = lerp(1.0, 0.5, roughness);
          [branch]
          if (ml::Rng::Hash::GetFloat() >= rayCastChance)
          {
            texture2DAt(output, outputIndex) = 0;
            return;
          }
        }

        float3x3 localBasis = ml::Geometry::GetBasis(normal);
        float3 localVector = ml::Geometry::RotateVector(localBasis, toCamera);
        float3 localRay = ml::ImportanceSampling::VNDF::GetRay(rnd, roughness, localVector, PT_SPEC_LOBE_ENERGY);
        localRay = reflect(-localVector, localRay);
        sampleDir = ml::Geometry::RotateVectorInverse(localBasis, localRay);
      }
      float3 cubeDir = sampleDir;

      float3 geometryNormal = normal;
      if (!isGrass)
      {
        ##if rtr_res_mul == full_res
          geometryNormal = calc_geometry_normal(rayIndex, inv_aligned_resolution, resolution);
        ##else
          geometryNormal = calc_geometry_normal_half(rayIndex, inv_aligned_resolution, resolution);
        ##endif
        ##if rtr_hack_reflection_dir_by_geometry_normal == yes
          half SoN = dot(geometryNormal, sampleDir);
          // The ray points into the surface, lets mirror it to the surface
          if (SoN < 0)
            sampleDir = reflect(sampleDir, geometryNormal);
        ##endif
      }

      relPos = applyAdaptiveRayOffset(relPos, geometryNormal);

      float maxReflectionDistance = calc_ray_length(roughness);
      ##if shader == rt_reflection_pt
        // Only the minimum here, a gloss ray keeps its full length
        maxReflectionDistance = max(maxReflectionDistance, min_ray_length);
      ##endif

      bool isDynamicSurface = unpackGbuffer(loadPackedGbuffer(gbufferTexel)).dynamic;
      float underwaterFade = calc_underwater_fade(w, rayIndex, inv_aligned_resolution, world_view_pos, isDynamicSurface);

      // The surface area of grass and foliage surfaces is small on the screen, so a reflection image will
      // not form on it. There is no need to shoot rays from them, calc_direct_surface_reflection should be
      // used directly instead.
      bool shootReflectionRay = !isGrass && !isFoliage && !isBinocularArea && underwaterFade > 0;
      shootReflectionRay &= roughness < probe_treshold;

      HitInfo hitInfo;
      bool isHit = false;
      float traceEnd = maxReflectionDistance;
      [branch]
      if (shootReflectionRay)
      {
        float terrainEnd = rt_water_trace_end(relPos, sampleDir, 100000);
        traceEnd = min(terrainEnd, maxReflectionDistance);
        if (rtr_output_type != RTR_RR)
        {
          isHit = trace_ray_with_screen_sample<RTRScreenSample>(bvhMain, relPos, sampleDir, 0, traceEnd, w, bvhGroupRender, hitInfo);
        }
        else
        {
          isHit = trace_ray(bvhMain, relPos, sampleDir, 0, traceEnd, w, bvhGroupRender, hitInfo);
        }

        // main TLAS hits only: the terrain fallback sees no occluders and terrain is never culled
        if (isHit)
          bvh_voxel_activity_mark(hitInfo.position);

        ##if shader == rt_reflection_pt
          bool probesCoverMiss = false;
        ##else
          bool probesCoverMiss = rtr_probes_cover_miss(maxReflectionDistance);
        ##endif
        [branch]
        if (!isHit && bvhTerrainValid && terrainEnd > maxReflectionDistance && !probesCoverMiss)
          isHit = trace_ray<true>(bvhTerrain, relPos, sampleDir, maxReflectionDistance, terrainEnd, w, bvhGroupRender, hitInfo);
      }

      half3 reflectionColor;
      float reflectionDistance;
      if (isHit)
      {
        if (!hitInfo.isScreenHit)
        {
          SurfaceParams hitSurface = calc_surface_params(hitInfo, -sampleDir, w, w);
          reflectionColor = light_hit_surface(hitSurface, -sampleDir, w + hitInfo.t, hitInfo.t, hit_dist_params.x, 1.0 - roughness, true);
          ##if shader == rt_reflection_pt
            reflectionColor += (half3)trace_bounces(hitSurface, w + hitInfo.t);
          ##endif
          calc_atmosphere(reflectionColor, hitInfo.position, hitInfo.t);
        }
        else
          reflectionColor = hitInfo.screenRadiance;
        reflectionDistance = hitInfo.t;
      }
      else
      {
        reflectionDistance = NRD_FP16_MAX;
        BRANCH
        if (rtr_output_type == RTR_BLUR)
        {
          // the cube of the resolve above the probe treshold, in its direction without the geometry normal hack: misses and
          // the upsample at a roughness edge show no seam
          reflectionColor = (half3)texCUBElod(envi_probe_specular, float4(cubeDir, ComputeReflectionCaptureMipFromRoughness(roughness))).rgb;
        }
        else
        {
        ##if shader == rt_reflection_pt
          // An unshot ray has no lobe sample of its own, the prefiltered mip stands in for it
          float skyMip = shootReflectionRay ? 0 : ComputeReflectionCaptureMipFromRoughness(roughness);
          reflectionColor = (half3)sample_envi_probe(float4(sampleDir, skyMip)).rgb;
        ##else
          reflectionColor = calc_direct_surface_reflection(bvh_origin + relPos, normal, roughness, toCamera, w, length(relPos), sampleDir, shootReflectionRay ? maxReflectionDistance : 0, rayIndex, reflectionDistance);
        ##endif
        }
        ##if rtr_use_specular_occlusion == yes
          if (!shootReflectionRay)
          {
            float2 pixelCenter = float2(rayIndex * rtr_res_mul) + 0.5;
              BRANCH
              if (isRTAOEnabled() && !isGrass)
                ao *= getRTAO(pixelCenter);
              else
                ao *= getSSAOSimple(pixelCenter);
          }
          half specularAOcclusion = computeSpecOcclusion(saturate(dot(-toPoint, normal)), ao, roughness * roughness);
          reflectionColor *= specularAOcclusion;
        ##endif
      }

      float3 waterTransmittance, waterInscatter;
      rt_water_segment(relPos, sampleDir, reflectionDistance < NRD_FP16_MAX, reflectionDistance, waterTransmittance, waterInscatter);
      reflectionColor = half3(reflectionColor * waterTransmittance + waterInscatter);

      if (shootReflectionRay)
      {
        float fxt = -1;
        float3 fxColor;
        float fxCoverage;
        trace_ray_fx_translucent_split(relPos, sampleDir, 0, isHit ? hitInfo.t : traceEnd, w, fxColor, fxCoverage, fxt, 1.0 - roughness);

        if (fxt > 0)
        {
          rt_water_segment(relPos, sampleDir, true, fxt, waterTransmittance, waterInscatter);
          reflectionColor = half3(reflectionColor * (1 - fxCoverage) + fxColor * waterTransmittance + fxCoverage * waterInscatter);
        }

        if (!isHit && fxt > 0)
          reflectionDistance = fxt;
      }

      #if RTR__USE_NANS_UNDERWATER
        if (underwaterFade == 0)
          reflectionColor = rtr_output_type == RTR_RR ? 0 : NaN;
      #else
        BRANCH
        if (underwaterFade < 1)
        {
          half3 reflectionVector = reflect(toPoint, normal);
          float mip = ComputeReflectionCaptureMipFromRoughness(roughness);
          half3 reflectionColorUnderwater = (half3)texCUBElod(envi_probe_specular, float4(reflectionVector, mip)).rgb;
          reflectionColor = lerp(reflectionColorUnderwater, reflectionColor, underwaterFade);
        }
      #endif
      if (isBinocularArea)
      {
        reflectionColor = float3(0.0, 0.0, 0.0);
      }

      if (rtr_output_type == RTR_RR)
      {
        texture2DAt(output, outputIndex) = float4(reflectionDistance, reflectionColor / rayCastChance);
      }
      else
      {
        float4 packedReflection;
        if (rtr_output_type == RTR_REBLUR)
        {
          float hitDist = REBLUR_FrontEnd_GetNormHitDist(reflectionDistance, w, hit_dist_params, roughness);
          packedReflection = REBLUR_FrontEnd_PackRadianceAndNormHitDist(reflectionColor, hitDist, false);
        }
        else
        {
          // a Blur texel without a ray (grass, foliage, above the gate) packs hit distance 0, reflection_blur.dshl reads it
          packedReflection = RELAX_FrontEnd_PackRadianceAndHitDist(reflectionColor,
            rtr_output_type == RTR_BLUR && !shootReflectionRay ? 0 : reflectionDistance, false);
        }

        texture2DAt(output, outputIndex) = packedReflection;

        const bool mark = underwaterFade == 0 || isBinocularArea;
        uint2 zIndex = dtid;
        BRANCH
        if (rtr_checkerboard)
        {
          zIndex.x *= 2;
          write_marked(zIndex, mark, packedReflection);
          zIndex.x = min(zIndex.x + 1, resolution.x - 1);
          write_marked(zIndex, mark, packedReflection);
        }
        else
          write_marked(zIndex, mark, packedReflection);
      }
    }
  }

  compile("cs_6_5", "rt_reflection_cs");
}

shader rt_glass_reflection
{
  INIT_AND_USE_ON_TOP_CAMERA_IN_CAMERA(cs)

  if (compatibility_mode == compatibility_mode_on || !use_hw_raytracing) { dont_render; }

  (cs) {
    from_sun_direction@f3 = from_sun_direction;
    sun_color_0@f3 = sun_color_0;
    inv_proj_tm@f44 = inv_proj_tm;
    resolution@u2 = rtr_resolutionI.xy;
    inv_resolution@f2 = (1.0 / get_dimensions(translucent_gbuffer, 0).xy);
    hit_dist_params@f3 = rtr_hit_dist_params;
    rt_glass_gbuffer@uav = translucent_gbuffer hlsl { RWTexture2D<float4> rt_glass_gbuffer@uav; };
    rt_glass_gbuffer_depth@tex2d = translucent_gbuffer_depth;
    world_view_pos@f3 = world_view_pos;
    downsampled_far_depth_tex@smp2d = downsampled_far_depth_tex;
  }

  hlsl(cs) {
    #define toonshading 0

    #include <NRD.hlsli>
  }

  USE_AND_INIT_VIEW_VEC_CS()
  INIT_ZNZFAR_STAGE(cs)

  INIT_BVH(cs, 0, true)
  USE_BVH_FOR_REFLECTION(cs)
  USE_BVH_FX_RENDER(cs, false)

  USE_EMISSION_DECODE_COLOR_MAP_STUB(cs)
  INIT_PACK_UNPACK_DYNSTCODE(cs)
  PACK_UNPACK_GBUFFER_BASE(cs)

  USE_ADAPTIVE_RAY_OFFSET(cs)

  INIT_RT_LIGHTING(cs, true, true, true, glass_rtr_shadow == on)
  USE_RT_LIGHTING(cs, 1, false)
  INIT_BVH_ATMOSPHERE(cs)
  USE_BVH_ATMOPHERE(cs)
  INIT_RT_WATER_MEDIUM(cs)
  USE_RT_WATER_MEDIUM(cs)

  USE_CALC_CAMERA_RELATIVE_POS(cs)

  hlsl (cs)
  {
    RT_GROUP_SIZE
    void rt_glass_reflection_cs(uint2 dtid : SV_DispatchThreadID)
    {
      BRANCH
      if (any(dtid >= resolution))
        return;

      float2 tc = float2(dtid + 0.5) * inv_resolution;
      DISCARD_IF_INVALID_VIEW_AREA_CS(tc);

      float rawDepth = texture2DAt(rt_glass_gbuffer_depth, dtid).x;

      BRANCH
      if (rawDepth <= 0 || !bvhMainValid)
      {
        texture2DAt(rt_glass_gbuffer, dtid) = 0;
        return;
      }

      float rawFarDepth = tex2Dlod(downsampled_far_depth_tex, float4(tc,0,0)).x;
      if (rawFarDepth > rawDepth)
      {
        texture2DAt(rt_glass_gbuffer, dtid) = 0;
        return;
      }

      float4 gbuffer = texture2DAt(rt_glass_gbuffer, dtid);

      float w = linearize_z(rawDepth, zn_zfar.zw);
      float3 relPos = calc_camera_relative_pos(dtid, w, inv_resolution);

      float3 worldNormal = gbuffer.xyz * 2 - 1;
      float3 reflectionVector = reflect(normalize(relPos), worldNormal);
      float3 sampleDir = reflectionVector;

      float maxReflectionDistance = hit_dist_params.x;

      float terrainEnd = rt_water_trace_end(relPos, sampleDir, 100000);
      float traceEnd = min(terrainEnd, maxReflectionDistance);
      HitInfo hitInfo;
      bool isHit = trace_ray(bvhMain, relPos, sampleDir, 0, traceEnd, w, bvhGroupRender, hitInfo);

      // main TLAS hits only: the terrain fallback sees no occluders and terrain is never culled
      if (isHit)
        bvh_voxel_activity_mark(hitInfo.position);

      [branch]
      if (!isHit && bvhTerrainValid && terrainEnd > maxReflectionDistance)
        isHit = trace_ray<true>(bvhTerrain, relPos, sampleDir, maxReflectionDistance, terrainEnd, w, bvhGroupRender, hitInfo);

      float3 reflectionColor;

      if (isHit)
      {
        SurfaceParams hitSurface = calc_surface_params(hitInfo, -sampleDir, w, w);
        reflectionColor = light_hit_surface(hitSurface, -sampleDir, w + hitInfo.t, hitInfo.t, hit_dist_params.x, 1, true);
        calc_atmosphere(reflectionColor, hitInfo.position, hitInfo.t);
      }
      else
        reflectionColor = texCUBElod(envi_probe_specular, float4(sampleDir, 0)).rgb * apply_sky_polarization_filter();

      float3 waterTransmittance, waterInscatter;
      rt_water_segment(relPos, sampleDir, isHit, isHit ? hitInfo.t : 0, waterTransmittance, waterInscatter);
      reflectionColor = reflectionColor * waterTransmittance + waterInscatter;

      float fxt = -1;
      float3 fxColor;
      float fxCoverage;
      trace_ray_fx_translucent_split(relPos, sampleDir, 0, isHit ? hitInfo.t : traceEnd, w, fxColor, fxCoverage, fxt, 1.0);
      if (fxt > 0)
      {
        rt_water_segment(relPos, sampleDir, true, fxt, waterTransmittance, waterInscatter);
        reflectionColor = reflectionColor * (1 - fxCoverage) + fxColor * waterTransmittance + fxCoverage * waterInscatter;
      }
      texture2DAt(rt_glass_gbuffer, dtid) = float4(reflectionColor * rt_water_receiver_fade(relPos), 1);
    }
  }

  compile("cs_6_5", "rt_glass_reflection_cs");
}

texture rtr_reflection_decode_src;
texture rtr_reflection_decode_dst;
int4 rtr_reflection_decode_size;

shader rt_reflection_decode
{
  if (compatibility_mode == compatibility_mode_on || !use_hw_raytracing) { dont_render; }
  (cs) {
    input@tex2d = rtr_reflection_decode_src;
    output@uav = rtr_reflection_decode_dst hlsl { RWTexture2D<float4> output@uav; };
    input_resolution@i4 = rtr_reflection_decode_size; // the node sets the valid size, a checkerboard trace output is packed
    rtr_output_type@u1 = rtr_output_type;
  }

  hlsl(cs) {
    #include <NRD.hlsli>

    [numthreads(8, 8, 1)]
    void rt_reflection_cs(uint2 dtid : SV_DispatchThreadID)
    {
      // 2x2 texels of the input, the output only grows with the dynamic resolution
      BRANCH
      if (any(dtid >= uint2(input_resolution.xy) / 2))
        return;

      float3 c1, c2, c3, c4;
      if (rtr_output_type == RTR_REBLUR)
      {
        c1 = REBLUR_BackEnd_UnpackRadianceAndNormHitDist(texture2DAt(input, dtid * 2 + uint2(0, 0))).rgb;
        c2 = REBLUR_BackEnd_UnpackRadianceAndNormHitDist(texture2DAt(input, dtid * 2 + uint2(0, 1))).rgb;
        c3 = REBLUR_BackEnd_UnpackRadianceAndNormHitDist(texture2DAt(input, dtid * 2 + uint2(1, 0))).rgb;
        c4 = REBLUR_BackEnd_UnpackRadianceAndNormHitDist(texture2DAt(input, dtid * 2 + uint2(1, 1))).rgb;

      }
      else if (rtr_output_type == RTR_RELAX || rtr_output_type == RTR_BLUR)
      {
        c1 = RELAX_BackEnd_UnpackRadiance(texture2DAt(input, dtid * 2 + uint2(0, 0))).rgb;
        c2 = RELAX_BackEnd_UnpackRadiance(texture2DAt(input, dtid * 2 + uint2(0, 1))).rgb;
        c3 = RELAX_BackEnd_UnpackRadiance(texture2DAt(input, dtid * 2 + uint2(1, 0))).rgb;
        c4 = RELAX_BackEnd_UnpackRadiance(texture2DAt(input, dtid * 2 + uint2(1, 1))).rgb;
      }
      else if (rtr_output_type == RTR_RR)
      {
        c1 = texture2DAt(input, dtid * 2 + uint2(0, 0)).gba;
        c2 = texture2DAt(input, dtid * 2 + uint2(0, 1)).gba;
        c3 = texture2DAt(input, dtid * 2 + uint2(1, 0)).gba;
        c4 = texture2DAt(input, dtid * 2 + uint2(1, 1)).gba;
      }

      texture2DAt(output, dtid) = float4((c1 + c2 + c3 + c4) / 4, 1);
    }
  }

  compile("cs_6_5", "rt_reflection_cs");
}

texture rtr_blur_debug_lobe;
texture rtr_blur_debug_trace;
texture rtr_blur_debug_dst;
int4 rtr_blur_debug_size; // xy: the size, z: 1 the lobe radius or 2 the hit distance, w: the largest blur radius

shader rtr_blur_debug
{
  if (compatibility_mode == compatibility_mode_on || !use_hw_raytracing) { dont_render; }
  (cs) {
    lobe_tex@tex2d = rtr_blur_debug_lobe;
    trace_tex@tex2d = rtr_blur_debug_trace;
    output@uav = rtr_blur_debug_dst hlsl { RWTexture2D<float4> output@uav; };
    debug_size@i4 = rtr_blur_debug_size;
    rtr_checkerboard@i1 = rtr_checkerboard;
  }

  hlsl(cs) {
    #include <NRD.hlsli>

    float3 heat(float t)
    {
      return saturate(float3(2 - 4 * t, min(4 * t, 4 - 4 * t), 4 * t - 2));
    }

    [numthreads(8, 8, 1)]
    void rtr_blur_debug_cs(uint2 dtid : SV_DispatchThreadID)
    {
      if (any(dtid >= uint2(debug_size.xy)))
        return;

      float lobe = texture2DAt(lobe_tex, dtid).a;
      float4 color = 0;
      if (lobe < -1.5)
        color = float4(1, 0, 1, 0.5);
      else if (lobe >= 0 && debug_size.z == 1)
      {
        float mip = log2(max(lobe, 1));
        float maxMip = log2(max(float(debug_size.w), 2));
        float3 c = lobe <= debug_size.w ? float3(0, 0.25 + 0.75 * saturate(mip / maxMip), 0)
                                        : lerp(float3(1, 1, 0), float3(1, 0, 0), saturate((mip - maxMip) / 5));
        color = float4(c * ((uint(mip) & 1) ? 0.75 : 1), 0.75);
      }
      else if (lobe >= 0)
      {
        // a checkerboard trace holds its output packed in the left half, a hole shows the traced texel of its pair
        float hitDist = texture2DAt(trace_tex, uint2(rtr_checkerboard != 0 ? dtid.x >> 1 : dtid.x, dtid.y)).a;
        float octave = max(log2(hitDist) + 4, 0);
        color = hitDist >= NRD_FP16_MAX ? float4(1, 1, 1, 0.75)
                                        : float4(heat(saturate(octave / 14)) * ((uint(octave) & 1) ? 0.75 : 1), 0.75);
      }
      texture2DAt(output, dtid) = color;
    }
  }

  compile("cs_6_5", "rtr_blur_debug_cs");
}

shader rtr_validation_renderer
{
  cull_mode  = none;
  z_test = false;
  z_write = false;

  blend_src = sa; blend_dst = isa;

  hlsl {
    struct VsOutput
    {
      VS_OUT_POSITION(pos)
      float2 uv : TEXCOORD0;
    };
  }

  (ps) {
    rtr_validation_texture@smp2d = rtr_validation_texture;
    rtr_validation_uv_scale@f2 = rtr_validation_uv_scale;
  }

  USE_POSTFX_VERTEX_POSITIONS()

  hlsl(vs) {
    VsOutput rtr_validation_renderer_vs(uint vertexId : SV_VertexID)
    {
      VsOutput o;
      o.pos = float4(getPostfxVertexPositionById(vertexId), 0, 1);
      o.uv = screen_to_texcoords(o.pos.xy);
      return o;
    }
  }

  hlsl(ps) {
    float4 rtr_validation_renderer_ps(VsOutput i) : SV_Target
    {
      // the frame fills the top left of the debug copy
      return tex2D(rtr_validation_texture, i.uv * rtr_validation_uv_scale);
    }
  }

  compile("target_vs", "rtr_validation_renderer_vs");
  compile("target_ps", "rtr_validation_renderer_ps");
}
