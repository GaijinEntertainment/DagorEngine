texture rtr_probes;
texture rtr_probe_locations;
sampler rtr_probe_sampler;

int rtr_probes_tex_slot = -1;
int rtr_probe_locations_tex_slot = -1;
int rtr_probe_sampler_slot = -1;
int4 rtr_probes_count;
int4 rtr_usable_probes_count;

// probes trace from scattered positions: 0 stops their hits from keeping content alive,
// also the hits of the far occlusion ray that stands in for the probes under RR
int rtr_probes_mark_voxel_activity = 1;

hlsl {
  #include <rtr_constants.hlsli>

  uint2 rtr_probe_cell(uint2 probe_index, uint layer)
  {
    return uint2(probe_index.x * PROBE_LAYER_MUL + layer, probe_index.y);
  }
}

macro INIT_RTR_PROBES_NO_SAMPLER(stage, use_bindless)
  (stage) {
    if (use_bindless) {
      rtr_probes_tex_slot@i1 = rtr_probes_tex_slot;
      rtr_probe_locations_tex_slot@i1 = rtr_probe_locations_tex_slot;
    }
    else {
      rtr_probes@tex2d = rtr_probes;
      rtr_probe_locations@tex2d = rtr_probe_locations;
    }
    inv_probe_count@f2 = 1.0 / (max(rtr_probes_count.xy, 1), 1, 1);
    usable_probe_count@u2 = rtr_usable_probes_count;
  }

  hlsl(stage) {
    ##if use_bindless
      #define rtr_probes uniformBindlessTex2D(bvh_textures, rtr_probes_tex_slot)
      #define rtr_probe_locations uniformBindlessTex2D(bvh_textures, rtr_probe_locations_tex_slot)

      bool rtr_probes_enabled()
      {
        return rtr_probes_tex_slot >= 0 && rtr_probe_locations_tex_slot >= 0 && usable_probe_count.x > 0;
      }
    ##else
      bool rtr_probes_enabled()
      {
        return usable_probe_count.x > 0;
      }
    ##endif

    float4 rtr_probe_location(uint2 probe_index, uint layer)
    {
      return texture2DAt(rtr_probe_locations, rtr_probe_cell(probe_index, layer));
    }
  }
endmacro

macro INIT_RTR_PROBES(stage, use_bindless)
  INIT_RTR_PROBES_NO_SAMPLER(stage, use_bindless)
  if (use_bindless) {
    (stage) {
      rtr_probe_sampler_slot@i1 = rtr_probe_sampler_slot;
    }
    hlsl(stage) {
      #ifndef global_samplers_array_defined
        BINDLESS_SMP_ARRAY(SamplerState, global_samplers_array, 1);
        #define global_samplers_array_defined
      #endif
      #define rtr_probes_samplerstate global_samplers_array[rtr_probe_sampler_slot]
    }
  }
  else {
    (stage) {
      rtr_probes_samplerstate@sampler = rtr_probe_sampler;
    }
  }
endmacro

macro USE_RTR_PROBES(stage)
  hlsl(stage) {
    #include <octahedral.hlsl>

    float2 remap_texcoord(float2 uv)
    {
      float borderUV = float(PROBE_BORDER) / float(PROBE_RESOLUTION_WITH_BORDER);
      float scaleUV = float(PROBE_RESOLUTION) / float(PROBE_RESOLUTION_WITH_BORDER);
      return uv * scaleUV + borderUV;
    }

    float4 sample_probe(uint2 probeIndex, uint layer, float3 dir)
    {
      float2 uv = octEncode(dir) * 0.5 + 0.5;
      uv = remap_texcoord(uv);
      float2 invCell = float2(inv_probe_count.x * 0.5, inv_probe_count.y);
      uv = (uv + rtr_probe_cell(probeIndex, layer)) * invCell;
      return rtr_probes.SampleLevel(rtr_probes_samplerstate, uv, 0);
    }
  }
endmacro
