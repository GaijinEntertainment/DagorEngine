int rtao_rendered = 0;
int rtao_bindless_slot = -1;
int rtao_bindless_sampler_slot = -1;
int rtao_res_mul = 1;
int4 rtao_resolutionI = (1,1,1,1);

macro CHECKING_RTAO(stage)
  if (use_hw_raytracing)
  {
    (stage) {
      rtao_rendered@i1 = rtao_rendered;
    }

    hlsl (stage) {
      bool isRTAOEnabled()
      {
        return rtao_rendered != 0;
      }
    }
  }
  else
  {
    hlsl (stage) {
      bool isRTAOEnabled()
      {
        return false;
      }
    }
  }
endmacro

macro USING_RTAO(stage)
  if (use_hw_raytracing)
  {
    (stage) {
      rtao_rendered@i1 = rtao_rendered;
      rtao_bindless_slot@i1 = rtao_bindless_slot;
      rtao_bindless_sampler_slot@u1 = rtao_bindless_sampler_slot;
      inv_output_resolution@f2 = (1.0 / (rtao_resolutionI.x * rtao_res_mul), 1.0 / (rtao_resolutionI.y * rtao_res_mul));
    }

    hlsl (stage) {
      #define HAS_RTAO 1

      #include <rt_texture_outputs.inc.hlsli>

      #ifndef global_samplers_array_defined
        BINDLESS_SMP_ARRAY(SamplerState, global_samplers_array, 1);
        #define global_samplers_array_defined
      #endif

      bool isRTAOEnabled()
      {
        return rtao_rendered != 0 && rtao_bindless_slot >= 0;
      }

      float getRTAO(uint2 tci)
      {
        float2 uv = (tci.xy + 0.5) * inv_output_resolution;
        return uniformBindlessTex2D(rt_texture_outputs, rtao_bindless_slot).SampleLevel(global_samplers_array[rtao_bindless_sampler_slot], uv, 0).r;
      }
    }
  }
  else
  {
    hlsl (stage) {
      bool isRTAOEnabled()
      {
        return false;
      }

      float getRTAO(uint2 tci)
      {
        return 1;
      }
    }
  }
endmacro