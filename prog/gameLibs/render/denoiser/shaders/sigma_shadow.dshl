hlsl(cs) {
  #pragma hlsl2021
  #define NRD_INTERNAL

  float4 cbuf0Sentinel: register(c33);
}

shader nrd_sigma_shadow_classify_tiles
{
  hlsl(cs) {
    #pragma wave32
    #include "SIGMA_ClassifyTiles.cs.hlsl"
  }

  compile("cs_6_5", "main");
}

shader nrd_sigma_shadow_smooth_tiles
{
  hlsl(cs) {
    #include "SIGMA_SmoothTiles.cs.hlsl"
  }

  compile("cs_6_5", "main");
}

shader nrd_sigma_shadow_blur
{
  hlsl(cs) {
    #define FIRST_PASS 1
    #include "SIGMA_Blur.cs.hlsl"
  }

  compile("cs_6_5", "main");
}

shader nrd_sigma_shadow_post_blur
{
  hlsl(cs) {
    #define FIRST_PASS 0
    #include "SIGMA_Blur.cs.hlsl"
  }

  compile("cs_6_5", "main");
}

shader nrd_sigma_shadow_stabilize
{
  hlsl(cs) {
    #include "SIGMA_TemporalStabilization.cs.hlsl"
  }

  compile("cs_6_5", "main");
}
