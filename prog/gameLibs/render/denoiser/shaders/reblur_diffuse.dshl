include "hardware_defines.dshl"

int denoiser_gi_second_chance = 0;
interval denoiser_gi_second_chance: no < 1, yes;

hlsl(cs) {
  #pragma hlsl2021

  #define NRD_SIGNAL DIFF
  #define NRD_MODE   RADIANCE
  #define NRD_INTERNAL
  #define MODE_5X5 0

  float4 cbuf0Sentinel: register(c54);
}

shader nrd_reblur_diffuse_prepass
{
  hlsl(cs) {
    #include "REBLUR_PrePass.cs.hlsl"
  }

  compile("cs_6_5", "main");
}

shader nrd_reblur_perf_diffuse_prepass
{
  hlsl(cs) {
    #define REBLUR_PERFORMANCE_MODE 1
    #include "REBLUR_PrePass.cs.hlsl"
  }

  compile("cs_6_5", "main");
}

shader nrd_reblur_diffuse_temporal_accumulation
{
  if (denoiser_gi_second_chance == yes)
  {
    hlsl(cs) {
      #define REBLUR_SECOND_CHANCE_HISTORY
    }
  }

  hlsl(cs) {
    #include "REBLUR_TemporalAccumulation.cs.hlsl"
  }

  compile("cs_6_5", "main");
}

shader nrd_reblur_perf_diffuse_temporal_accumulation
{
  if (denoiser_gi_second_chance == yes)
  {
    hlsl(cs) {
      #define REBLUR_SECOND_CHANCE_HISTORY
    }
  }

  hlsl(cs) {
    #define REBLUR_PERFORMANCE_MODE 1
    #include "REBLUR_TemporalAccumulation.cs.hlsl"
  }

  compile("cs_6_5", "main");
}

