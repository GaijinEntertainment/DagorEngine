Root    ?= ../../../.. ;
local LibPath = gameLibs/daPCG/das ;
Location = prog/$(LibPath) ;
Target      = $(LibPath).lib ;
StrictCompile = yes ;
TargetType  = lib ;

include $(Root)/prog/_jBuild/defaults.jam ;
include $(Root)/prog/gameLibs/daCSG/daCSG-options.jam ;

AddIncludes +=
  $(Root)/prog/1stPartyLibs/daScript/include
;

Sources =
  sceneModule.cpp
  materialModule.cpp
;

StringifySourceFile scene.das : scene.das.inl : sceneModule.cpp ;
StringifySourceFile material.das : material.das.inl : materialModule.cpp ;

UseProgLibs =
  gameLibs/daPCG/scene
  gameLibs/daPCG/material
  gameLibs/daCSG/das
  1stPartyLibs/daScript
;

include $(Root)/prog/_jBuild/build.jam ;
