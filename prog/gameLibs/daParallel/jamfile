Root    ?= ../../.. ;
Location = prog/gameLibs/daParallel ;
StrictCompile = yes ;

include $(Root)/prog/_jBuild/defaults.jam ;

TargetType  = lib ;
Target      = gameLibs/daParallel.lib ;

Sources =
  parallel.cpp
;

# no: every loop runs on the caller and nothing of the engine thread pool is linked
daParallel ?= yes ;
if ! ( $(daParallel) in yes no ) { Exit daParallel: yes or no, not $(daParallel) ; }
if $(daParallel) = no { CPPopt += -DDAPARALLEL=0 ; Target = $(Target:S=~serial.lib) ; }
else { UseProgLibs += engine/baseUtil ; }

include $(Root)/prog/_jBuild/build.jam ;
