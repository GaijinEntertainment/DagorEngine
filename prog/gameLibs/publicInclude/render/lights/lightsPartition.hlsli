#ifndef LIGHTS_PARTITION_INCLUDED
#define LIGHTS_PARTITION_INCLUDED 1

#include "renderLightsConsts.hlsli"
#include "renderLights.hlsli"

#define OMNI_LIGHT_BOUND_SPHERE_RADIUS_SCALE 1.1f

#define CLUSTERED_OMNI_LIGHTS_COUNT_INDEX 0
#define FAR_OMNI_LIGHTS_COUNT_INDEX 2
#define CLUSTERED_SPOT_LIGHTS_COUNT_INDEX 4
#define FAR_SPOT_LIGHTS_COUNT_INDEX 6
#define LIGHTS_COUNTS_BUF_RECORDS_COUNT 8

#define CLUSTERED_OMNI_LIGHTS_IDS_OFFSET 0
#define FAR_OMNI_LIGHTS_IDS_OFFSET MAX_SCENE_OMNI_LIGHTS
#define CLUSTERED_SPOT_LIGHTS_IDS_OFFSET (2 * MAX_SCENE_OMNI_LIGHTS)
#define FAR_SPOT_LIGHTS_IDS_OFFSET (2 * MAX_SCENE_OMNI_LIGHTS + MAX_SCENE_SPOT_LIGHTS)
#define LIGHTS_DATA_BUF_RECORDS_COUNT (2 * MAX_SCENE_OMNI_LIGHTS + 2 * MAX_SCENE_SPOT_LIGHTS)

#define VISIBLE_LIGHTS_TRANSIT_CONST_SIZE 16
#define RENDER_OMNI_LIGHT_CONSTS_COUNT (RENDER_OMNI_LIGHT_STRIDE_SIZE / VISIBLE_LIGHTS_TRANSIT_CONST_SIZE)
#define RENDER_SPOT_LIGHT_CONSTS_COUNT (RENDER_SPOT_LIGHT_STRIDE_SIZE / VISIBLE_LIGHTS_TRANSIT_CONST_SIZE)

#define VISIBLE_LIGHTS_TRANSIT_SECTION_END(section_offset, max_lights, light_consts_count) \
  ((section_offset) + 1 + (max_lights) * (light_consts_count))

#define VISIBLE_LIGHTS_TRANSIT_CLUSTERED_OMNI_OFFSET 0
#define VISIBLE_LIGHTS_TRANSIT_FAR_OMNI_OFFSET \
  VISIBLE_LIGHTS_TRANSIT_SECTION_END(VISIBLE_LIGHTS_TRANSIT_CLUSTERED_OMNI_OFFSET, MAX_CLUSTERED_OMNI_LIGHTS, RENDER_OMNI_LIGHT_CONSTS_COUNT)
#define VISIBLE_LIGHTS_TRANSIT_CLUSTERED_SPOT_OFFSET \
  VISIBLE_LIGHTS_TRANSIT_SECTION_END(VISIBLE_LIGHTS_TRANSIT_FAR_OMNI_OFFSET, MAX_VISIBLE_FAR_LIGHTS, RENDER_OMNI_LIGHT_CONSTS_COUNT)
#define VISIBLE_LIGHTS_TRANSIT_FAR_SPOT_OFFSET \
  VISIBLE_LIGHTS_TRANSIT_SECTION_END(VISIBLE_LIGHTS_TRANSIT_CLUSTERED_SPOT_OFFSET, MAX_CLUSTERED_SPOT_LIGHTS, RENDER_SPOT_LIGHT_CONSTS_COUNT)
#define VISIBLE_LIGHTS_TRANSIT_OMNI_MASKS_OFFSET \
  VISIBLE_LIGHTS_TRANSIT_SECTION_END(VISIBLE_LIGHTS_TRANSIT_FAR_SPOT_OFFSET, MAX_VISIBLE_FAR_LIGHTS, RENDER_SPOT_LIGHT_CONSTS_COUNT)

#define VISIBLE_LIGHTS_TRANSIT_MASKS_PER_THREAD 4
#define VISIBLE_LIGHTS_TRANSIT_SPOT_MASKS_OFFSET \
  (VISIBLE_LIGHTS_TRANSIT_OMNI_MASKS_OFFSET + MAX_CLUSTERED_OMNI_LIGHTS / VISIBLE_LIGHTS_TRANSIT_MASKS_PER_THREAD)
#define VISIBLE_LIGHTS_TRANSIT_CONSTS_COUNT \
  (VISIBLE_LIGHTS_TRANSIT_SPOT_MASKS_OFFSET + MAX_CLUSTERED_SPOT_LIGHTS / VISIBLE_LIGHTS_TRANSIT_MASKS_PER_THREAD)

#endif
