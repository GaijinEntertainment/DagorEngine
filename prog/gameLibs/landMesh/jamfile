Root    ?= ../../.. ;
include $(Root)/prog/_jBuild/defaults.jam ;

Location = prog/gameLibs/landMesh ;

TargetType  = lib ;
Target      = gameLibs/landMesh.lib ;

Sources =
  landMicroDetails.cpp
  lmeshManager.cpp
  lmeshWeightAtlas.cpp
  lmeshWeightAtlasLegacyCpu.cpp
  lmeshWeightAtlasLegacyGpu.cpp
  lmeshLandClasses.cpp
  lmeshRenderer.cpp
  lmeshRenderingModeState.cpp
  lmeshRendererLandClasses.cpp
#  clipmap.cpp
  virtualtexture.cpp
  landRayTracerSoA4.cpp
  lmeshRendererGlue.cpp
  lastClip.cpp
  biomeQuery.cpp
  heightmapQuery.cpp
  lmeshMirroring.cpp
  lmeshHoles.cpp
;

AddIncludes =
  $(Root)/prog/gameLibs/publicInclude
  $(Root)/prog/gameLibs/gamePhys/collision
  $(Root)/prog/engine/sharedInclude
  $(Root)/prog/engine/lib3d
  $(Root)/prog/3rdPartyLibs
;

UseProgLibs =
  gameLibs/landMesh/rendinstIntegration
  gameLibs/heightmap
  gameLibs/physMap
  3rdPartyLibs/eastl
  engine/daBVH
  3rdPartyLibs/convert/fastDXT
;

if $(Config) in dbg dev {
  Sources += clipmapDebug.cpp ;
  UseProgLibs += 
    3rdPartyLibs/imgui
    engine/imgui 
  ;
} else {
  Sources += clipmapDebugStub.cpp ;
}

if $(PlatformSpec) in gcc clang { # degenerate SoA4 leaf lanes self-reject via det == 0, which FMA contraction breaks
  local xclang = - ;
  if $(Platform) in windows xboxOne scarlett { xclang = /clang:- ; }
  if $(PlatformSpec) = clang { CPPopt += -Wno-overriding-option ; } # for -fno-trapping-math after -fno-unsafe-math-optimizations
  if $(Platform) in macOS iOS ps4 ps5 nswitch linux { CPPopt += -Wno-overriding-t-option ; } # ditto for older clang ver
  CPPopt += $(xclang)fno-unsafe-math-optimizations $(xclang)fno-trapping-math $(xclang)ffp-contract=off ;
  if $(PlatformArch) in x86 x86_64 { CPPopt += $(xclang)mno-fma ; }
}
CPPopt += -DVECMATH_NO_FMA ; # v_madd on NEON is explicit vfmaq that ignores ffp-contract=off

include $(Root)/prog/_jBuild/build.jam ;
