include "shader_global.dshl"

int clipmap_use_ri_vtex = 0 always_referenced;

interval clipmap_use_ri_vtex: no < 1, yes;
assume_if_not_assumed clipmap_use_ri_vtex = no;

hlsl {
  #include <vtex.hlsli>

##if (clipmap_use_ri_vtex == yes)
  #define MAX_RI_OFFSET (MAX_RI_VTEX_CNT)
  #define RI_VTEX_CNT_BITS (MAX_RI_VTEX_CNT_BITS)
  #define CLIPMAP_HIST_TOTAL_ELEMENTS (CLIPMAP_HIST_WITH_RI_VTEX_ELEMENTS)
##else
  #define MAX_RI_OFFSET (1)
  #define RI_VTEX_CNT_BITS (0)
  #define CLIPMAP_HIST_TOTAL_ELEMENTS (CLIPMAP_HIST_NO_RI_VTEX_ELEMENTS)
##endif
}

macro USE_AUTO_SET_BASE(stage)
  DETECT_LAND_REFLECTANCE_BASE(stage)
  DETECT_LAND_SMOOTHNESS_BASE(stage)
  hlsl(stage)
  {
  #ifndef AUTO_SET_DEFINED
  #define AUTO_SET_DEFINED 1
    void auto_set(inout Vtex vtex, float2 worldPosXZ)
    {
      set_smoothness(vtex, get_land_smoothness(vtex.diffuse));
      set_reflectance(vtex, get_land_reflectance(vtex.diffuse));
    }
  #endif
  }
endmacro

macro USE_AUTO_SET()
  USE_AUTO_SET_BASE(ps)
endmacro

macro USE_VTEX_BASE(stage)
hlsl(stage){
  struct Vtex
  {
    half3 diffuse;
    half3 normal;
    half reflectance, smoothness, micro_detail, ao, emission;
  };
  Vtex create_vtex(){Vtex vtex; vtex.diffuse = half3(0.0, 0.0, 0.0); vtex.normal = half3(0.0, 0.0, 1.0); vtex.ao = half(1.0); vtex.emission = half(0.0); vtex.reflectance = vtex.smoothness = vtex.micro_detail = half(0.0); return vtex;}
  void set_diffuse(inout Vtex vtex, half3 d){vtex.diffuse = d;}
  void set_reflectance(inout Vtex vtex, half t){vtex.reflectance = t;}
  void set_smoothness(inout Vtex vtex, half s){vtex.smoothness = s;}
  void set_normal(inout Vtex vtex, half3 n){vtex.normal = n;}
  void set_normalXY(inout Vtex vtex, half2 n){vtex.normal.xy = n; vtex.normal.z = sqrt(saturate(1-dot(n.xy,n.xy)));}
  void set_micro_detail(inout Vtex vtex, half d){vtex.micro_detail = d;}
  void set_ao(inout Vtex vtex, half a){vtex.ao = a;}
  void set_emission(inout Vtex vtex, half a){vtex.emission = a;}

  Vtex lerp_vtex(Vtex a, Vtex b, half t)
  {
    Vtex r;
    r.diffuse = lerp(a.diffuse, b.diffuse, t);
    r.normal = lerp(a.normal, b.normal, t);
    r.reflectance = lerp(a.reflectance, b.reflectance, t);
    r.smoothness = lerp(a.smoothness, b.smoothness, t);
    r.ao = lerp(a.ao, b.ao, t);
    r.micro_detail = t<0.5 ? a.micro_detail : b.micro_detail;
    r.emission = t<0.5 ? a.emission : b.emission;
    return r;
  }
}
endmacro

macro USE_VTEX()
  USE_VTEX_BASE(ps)
endmacro

macro READ_PACKED_VTEX_BASE(stage)
  USE_VTEX_BASE(stage)

  hlsl(stage) {
    Vtex unpack_vtex(half4 cache0)
    {
      Vtex ret;
      ret.diffuse = cache0.rgb;
      ret.micro_detail = cache0.a;
      ret.normal = half3(0,0,1);
      ret.ao = 1;
      ret.smoothness = 0;
      ret.reflectance = 0;
      ret.emission = 0;
      return ret;
    }

    Vtex unpack_vtex(half4 cache0, half2 normal)
    {
      Vtex ret = unpack_vtex(cache0);
      ret.normal = restore_normal(normal);
      return ret;
    }

    Vtex unpack_vtex(half4 cache0, half2 normal, half4 cache2)
    {
      Vtex ret = unpack_vtex(cache0, normal);
      ret.ao = cache2.r;
      ret.reflectance = cache2.g;
      ret.emission = cache2.b;
      ret.smoothness = cache2.a;
      return ret;
    }
  }
endmacro

macro AUTO_DETECT_OTHER_BASE(stage)
  USE_AUTO_SET_BASE(stage)

  hlsl(stage) {
    void auto_detect_other(inout Vtex vtex, float2 worldPosXZ)
    {
      auto_set(vtex, worldPosXZ);
    }
  }
endmacro

macro USE_CLIPMAP_MRT_OUTPUT()
USE_VTEX()
hlsl(ps) {

  ##if (render_with_normalmap == render_displacement) // render heightmap only
    struct VTEX_MRT
    {
      float4 height  : SV_Target0;
    };
  ##else
    struct VTEX_MRT
    {
      float4 diffuse                         : SV_Target0;
      float4 normal__smoothness_or_lq_detail : SV_Target1;
      ##if (clipmap_use_cache_output2)
        float4 ao_reflectance_detail         : SV_Target2;
      ##endif
    };

    half3 pack_detail_ao_reflectance_emission(half detail, half ao, half reflectance, half emission)
    {
      // we can't use 127.f / 255.f as barrier between emission and ao due to clipmap compresiion which can shift resulting value
      // so we get false-positive emission from areas with high ao
      half ao_emission = emission < 0.01 ? saturate(ao) * 0.4f : emission * 0.4f + 0.6f;
      return half3(ao_emission, reflectance, detail);
    }

    VTEX_MRT create_render_vtex(inout Vtex vtex)
    {
      VTEX_MRT ret;
      ret.diffuse = vtex.diffuse.rgbr;

      // FIX-ME: On normal__smoothness_or_lq_detail we either store float3(normal.xy, smoothness), float(micro_detail) or float3(normal.xy, micro_detail)
      // Artists use "write_vtexmask" as color_write mask assuming the first case is used (non-compatibility with normal). We should migrate the mask.
      ##if (clipmap_use_cache_output2)
        ret.normal__smoothness_or_lq_detail = vtex.smoothness.rrrr;
      ##else
        ret.normal__smoothness_or_lq_detail = vtex.micro_detail.rrrr;
      ##endif
      ##if (clipmap_use_cache_output1)
        ret.normal__smoothness_or_lq_detail.rg = vtex.normal.xy*0.5+0.5;
      ##endif

      ##if (clipmap_use_cache_output2)
        ret.ao_reflectance_detail = pack_detail_ao_reflectance_emission(vtex.micro_detail, vtex.ao, vtex.reflectance, vtex.emission).rgbb;
      ##endif
      return ret;
    }
    void multiply_target(inout VTEX_MRT mrt, half v)//additive blending
    {
      mrt.diffuse *= v;
      mrt.normal__smoothness_or_lq_detail *= v;
      ##if (clipmap_use_cache_output2)
        mrt.ao_reflectance_detail *= v;
      ##endif
    }
    void set_alpha_diffuse(inout VTEX_MRT mrt, half v)//blending
    {
      mrt.diffuse.a = v;
    }
    void set_alpha_normal_smoothness_or_lq_detail(inout VTEX_MRT mrt, half v)//blending
    {
      mrt.normal__smoothness_or_lq_detail.a = v;
    }
    void set_alpha_ao_reflectance_detail(inout VTEX_MRT mrt, half v)//blending
    {
      ##if (clipmap_use_cache_output2)
        mrt.ao_reflectance_detail.a = v;
      ##endif
    }
    void set_alpha(inout VTEX_MRT mrt, half v)//blending
    {
      set_alpha_diffuse(mrt, v);
      set_alpha_normal_smoothness_or_lq_detail(mrt, v);
      set_alpha_ao_reflectance_detail(mrt, v);
    }
  ##endif
}
endmacro