include "writeToTex.dshl"
include "atmosphere.dshl"
include "sky_shader_global.dshl"
include "brunetonSkies.dshl"
include "statistical_clouds_shadow.dshl"
include "skies_rainmap.dshl"
include "nuke_scattering_inc.dshl"

float4 prepare_origin;
float4 prepare_sun_light_dir;
//texture skies_transmittance_texture;
texture skies_ms_texture;
float4 prepare_color_mul;
float4 prepare_resolution = (1, 1, 1, 1);
float min_ground_offset;
float skies_scattering_effect = 1.; // it's only purpose is cuisine royale eclipse.
float last_skies_scattering_effect = 1.;
float skies_froxels_prev_dist=10000;

macro PREPARE_TRANSMITTANCE(code)
  (code) {
    use_camera_altitude@f1 = (max(0.01, (prepare_origin.y-min_ground_offset)/1000), prepare_origin.y,0,0);//skies_world_view_pos.y
    //use_camera_altitude@f1 = ((prepare_origin.y-min_ground_offset)/1000, 0,0,0);//skies_world_view_pos.y
    preparedScatteringDistToTc@f4 = preparedScatteringDistToTc;
    skies_transmittance_texture@smp2d = skies_transmittance_texture;
  }

  ATMO(code)
  GET_ATMO(code)
  hlsl(code) {
    half3 getTransmittance(uint2 scri, Length d, Number mu)
    {
      Length r = use_camera_altitude + theAtmosphere.bottom_radius;
      float3 camera = float3(0,0,r);
      if (abs(r - theAtmosphere.top_radius) < 0.01)
        r = theAtmosphere.top_radius+0.01;

      Number mu_horiz = -SafeSqrt(
          1.0 - pow2(theAtmosphere.bottom_radius / r));
      if (use_camera_altitude > 0 && mu < mu_horiz-0.01)//limit rays that significantly lower than horizon only
      {
        Length dground = DistanceToBottomAtmosphereBoundarySigned(theAtmosphere, r, mu);
        d = lerp(d, dground >= 0 ? min(d, dground) : d, saturate(d/40.-0.5)); //this way we fight with discontinuities (if point is below planet surface it is dark)\
        //d = dground >= 0 ? min(d, dground) : d; //this way we fight with discontinuities (if point is below planet surface it is dark)\
      }
      if (scri.x == 0)
        return 1;
      int sampleCount = min(64, 8 + int(d));//each 8 km increase by one step
      float3 tr = saturate(ComputeTransmittanceToTopAtmosphereBoundary(theAtmosphere, r, mu, d, sampleCount,
        Position(0,0,0), Direction(0,0,0)//custom fog should not affect extinction _COLOR_.
      ));
      return (scri.x == 0) ? 1 : tr;
      //fails near horizon, so we use computations instead.
      //we can also just compute always
    }
  }
endmacro

shader skies_prepare_transmittance_for_altitude_ps
{
  WRITE_TO_TEX2D_TC()
  PREPARE_TRANSMITTANCE(ps)

  hlsl(ps) {
    float4 skies_gen_ps(VsOutput input HW_USE_SCREEN_POS): SV_Target0
    {
      float4 screenpos = GET_SCREEN_POS(input.pos);
      float2 texcoord = input.texcoord.xy;
      Length d = scattering_TcToDist_Km(input.texcoord.x, preparedScatteringDistToTc);
      Number mu = scattering_tcToViewZ(input.texcoord.y);
      return float4(getTransmittance(int2(screenpos.xy), d, mu), 0.0);
    }
  }
  compile("target_ps", "skies_gen_ps")
}

shader skies_prepare_transmittance_for_altitude_cs
{
  PREPARE_TRANSMITTANCE(cs)
  (cs) {
    prepare_resolution@f4 = (1./prepare_resolution.x,1./prepare_resolution.y,prepare_resolution.x,prepare_resolution.y);
    output@uav : register(0) hlsl {
      RWTexture2D<float4> output@uav;
    }
  }

  hlsl(cs) {
    [numthreads(8, 8, 1)]
    void skies_gen_cs(uint3 dtId : SV_DispatchThreadID)
    {
      // some mobile GPUs may launch more threads than specified
      // avoid failing on followup UAV OOB in this case
      BRANCH
      if (any(dtId.xy >= prepare_resolution.zw))
        return;

      float2 texcoord = (dtId.xy+0.5)*prepare_resolution.xy;
      Length d = scattering_TcToDist_Km(texcoord.x, preparedScatteringDistToTc);
      Number mu = scattering_tcToViewZ(texcoord.y);
      texture2DAt(output, dtId.xy) = float4(getTransmittance(dtId.xy, d, mu), 0.0);
    }
  }
  compile("cs_5_0", "skies_gen_cs")
}

include "viewVecVS.dshl"
include "skies_shadows.dshl"
include "panorama.dshl"
texture prev_skies_frustum_scattering;
int skies_frustum_scattering_frame;
float4 prev_globtm_no_ofs_psf_0;
float4 prev_globtm_no_ofs_psf_1;
float4 prev_globtm_no_ofs_psf_2;
float4 prev_globtm_no_ofs_psf_3;
float4 prev_view_vecLT;
float4 prev_view_vecRT;
float4 prev_view_vecLB;
float4 prev_view_vecRB;
int skies_continue_temporal = 1;
float skies_froxels_history_blur = 0.1; // 0 = tent radius follows the reprojection delta, 1 = constant quarter texel, fractions blend

int skies_render_panorama_scattering;
interval skies_render_panorama_scattering:off<1, on;

float4 move_world_view_pos;


macro FROXELS_SCATTERING(code)
  (code) {
    use_camera_altitude@f1 = (max(0.01, (prepare_origin.y-min_ground_offset)/1000), prepare_origin.y,0,0);//prepare_origin.y
    prepare_resolution@f3 = (1./skies_froxels_resolution.x,1./skies_froxels_resolution.y,1./skies_froxels_resolution.z);
    skies_froxels_dist@f1 = skies_froxels_dist;
    skies_froxels_resolutionI@u3  = skies_froxels_resolution.xyz;
    skies_transmittance_texture@smp2d = skies_transmittance_texture;
    skies_ms_texture@smp2d = skies_ms_texture;
    skies_primary_sun_light_dir@f3 = skies_primary_sun_light_dir;
    skies_primary_sun_color@f3 = (skies_primary_sun_color.x * skies_scattering_effect,
                                  skies_primary_sun_color.y * skies_scattering_effect,
                                  skies_primary_sun_color.z * skies_scattering_effect, 0);
    skies_secondary_sun_light_dir@f3 = skies_secondary_sun_light_dir;
    skies_secondary_sun_color@f3 = (skies_secondary_sun_color.x * skies_scattering_effect,
                                    skies_secondary_sun_color.y * skies_scattering_effect,
                                    skies_secondary_sun_color.z * skies_scattering_effect, 0);
    prev_skies_frustum_scattering@smp3d = prev_skies_frustum_scattering;
    skies_frustum_scattering_frame@f1 = (skies_frustum_scattering_frame);
    skies_continue_temporal__old_effect@f2 = (skies_continue_temporal*2-1, skies_scattering_effect / max(0.001, last_skies_scattering_effect), 0, 0);
    prev_globtm_no_ofs_psf@f44 = { prev_globtm_no_ofs_psf_0, prev_globtm_no_ofs_psf_1, prev_globtm_no_ofs_psf_2, prev_globtm_no_ofs_psf_3 };
    prev_view_vecLT@f3 = prev_view_vecLT;
    prev_view_vecRT_minus_view_vecLT@f3 = (prev_view_vecRT-prev_view_vecLT);
    prev_view_vecLB_minus_view_vecLT@f3 = (prev_view_vecLB-prev_view_vecLT);
    skies_panoramic_scattering@f1 = (skies_panoramic_scattering);
    move_world_view_pos@f3 = move_world_view_pos;
    skies_froxels_prev_dist@f3 =(1./skies_froxels_prev_dist, skies_froxels_dist/skies_froxels_prev_dist, skies_froxels_prev_dist);
    skies_frustum_scattering_last_tz@f1 = (skies_frustum_scattering_last_tz);
    skies_froxels_history_blur@f1 = (skies_froxels_history_blur);
  }
  if (skies_render_panorama_scattering == on)
  {
    INIT_AND_USE_PANORAMA_VIEW_VECT(code)

    hlsl(code) {
      #define RENDER_PANORAMA_SCATTERING 1
    }
  }
  SKIES_RAINMAP(code)
  VIEW_VEC_OPTIMIZED(code)
  //INIT_SKIES_LUT(code)
  //USE_SKIES_LUT(code)
  //shadows
  SKY_CLOUDS_SHADOWS(code, prepare_origin, skies_primary_sun_light_dir.x, skies_primary_sun_light_dir.z, skies_primary_sun_light_dir.y)
  ATMO(code)
  GET_ATMO(code)
  BASE_FOG_MATH(code)
  INIT_ZNZFAR_STAGE(code)
  hlsl(code) {
    float3 getPrevViewVecOptimized(float2 tc) {return prev_view_vecLT + prev_view_vecRT_minus_view_vecLT*tc.x + prev_view_vecLB_minus_view_vecLT*tc.y;}
    #include <interleavedGradientNoise.hlsl>
    #include <fp16_aware_lerp.hlsl>
    // motion-proportional history filter: at rest a single tap keeps the temporal feedback
    // all-pass so texel-scale structure (godrays) converges at full contrast; while moving,
    // the xy tent radius (in texels) follows the reprojection delta up to a quarter texel;
    // skies_froxels_history_blur blends toward the legacy constant radius
    float historyBlurGate(float2 prev_uv, float2 cur_uv)
    {
      float2 dxy = abs(prev_uv - cur_uv) * float2(skies_froxels_resolutionI.xy);
      return lerp(min(max(dxy.x, dxy.y), 0.25), 0.25, skies_froxels_history_blur);
    }
    #define skies_continue_temporal skies_continue_temporal__old_effect.x
    #define old_effect skies_continue_temporal__old_effect.y
  }
endmacro

shader skies_integrate_froxel_scattering_ps
{
  if (hardware.metal)
  {
    dont_render;
  }
  FROXELS_SCATTERING(ps)
  WRITE_TO_VOLTEX_TC()
  hlsl(ps) {
    float4 skies_gen_ps(VsOutput input HW_USE_SCREEN_POS):SV_Target0
    {
      float3 texcoord = float3(input.texcoord, (input.slice_index+0.5)*prepare_resolution.z);
      float4 screenpos = GET_SCREEN_POS(input.pos);
      #if RENDER_PANORAMA_SCATTERING
        float3 viewVect = get_panorama_viewvect(texcoord.xy);
      #else
        float3 viewVect;
        if (skies_panoramic_scattering)//cubic
          viewVect = get_panoramic_scattering_view(texcoord.xy);
        else
          viewVect = normalize(getViewVecOptimized(texcoord.xy));
      #endif
      Length r = use_camera_altitude + theAtmosphere.bottom_radius;
      Length d = pow2(texcoord.z)*(skies_froxels_dist/1000/skies_frustum_scattering_last_tz);//3 consts mul. todo: move to preshader
      if (texcoord.z >= skies_frustum_scattering_last_tz)
        d = 245000;
      if (abs(r - theAtmosphere.top_radius) < 0.01)
        r = theAtmosphere.top_radius+0.01;
      Number mu = viewVect.y;

      Number mu_horiz = -SafeSqrt(
          1.0 - pow2(theAtmosphere.bottom_radius / r));
      if (use_camera_altitude > 0 && mu < mu_horiz-0.01)//limit rays that significantly lower than horizon only
      {
        Length dground = DistanceToBottomAtmosphereBoundarySigned(theAtmosphere, r, mu);
        //d = lerp(d, dground >= 0 ? min(d, dground) : d, saturate(d/40.-0.5)); //this way we fight with discontinuities (if point is below planet surface it is dark)\
        //d = dground >= 0 ? min(d, dground) : d; //this way we fight with discontinuities (if point is below planet surface it is dark)\
      }
      #if !RENDER_PANORAMA_SCATTERING
        float3 prevUV;
        float3 camPos = viewVect*1000*d;
        prevUV.z = sqrt(length(camPos - move_world_view_pos)*skies_froxels_prev_dist.x);
        float4 prevClip = mul(float4(camPos, 1), prev_globtm_no_ofs_psf);
        float2 prevScreen = prevClip.w > 0 ? prevClip.xy/prevClip.w : float2(2, 2);
        prevUV.xy = float2(prevScreen.xy*float2(0.5, -0.5) + float2(0.5, 0.5));
        if (skies_panoramic_scattering)
          prevUV = float3(texcoord.xy, texcoord.z*skies_froxels_prev_dist.y);
        bool canReproject = max(abs(prevUV.x*2-1), abs(prevUV.y*2-1)) < skies_continue_temporal;
        // equal-mean 5-stratum ladder (see ladderShadowOffset in the CS): the per-texel
        // 5-frame mean is exact, so no frozen grain enters the temporal average
        float randomOfs = 0;
        if (skies_continue_temporal >= 0)
          randomOfs = (float((uint(skies_frustum_scattering_frame) + min(uint(interleavedGradientNoise(screenpos.xy) * 5), 4u) + uint(input.slice_index)) % 5u) + 0.5) * 0.2;
      #else
        bool canReproject = false;
        float randomOfs = 0;
      #endif

      SingleScatteringResult ss = IntegrateScatteredLuminanceMS(
        theAtmosphere,
        SamplerTexture2DFromName(skies_transmittance_texture),
        SamplerTexture2DFromName(skies_ms_texture),
        shadow_origin, viewVect*1000., randomOfs,//only for shadows
        canReproject ? 16 : 32, true, canReproject ? float2(16, 32) : float2(24, 48),
        r, mu,
        dot(viewVect.xzy, skies_primary_sun_light_dir), skies_primary_sun_light_dir.z,
        false,//RayIntersectsGround(theAtmosphere, r, mu)
        d);
      float3 colorMul = skies_primary_sun_color.rgb*theAtmosphere.solar_irradiance;
      //colorMul = 1;
      //float4 ret = half4((ss.ray + ss.ms/RayleighPhaseFunction(nu))*colorMul, ss.mie.x*colorMul.x);
      float4 ret = half4(ss.L*colorMul, dot(ss.Transmittance, 1./3));
      if (any(skies_secondary_sun_color.rgb>0))
      {
        SingleScatteringResult ss = IntegrateScatteredLuminanceMS(
          theAtmosphere,
          SamplerTexture2DFromName(skies_transmittance_texture),
          SamplerTexture2DFromName(skies_ms_texture),
          shadow_origin, viewVect*1000., randomOfs,//todo: remove shadows, leave statistical only!
          canReproject ? 12 : 24, true, canReproject ? float2(12, 24) : float2(16, 32),
          r, mu,
          dot(viewVect.xzy, skies_secondary_sun_light_dir), skies_secondary_sun_light_dir.z,
          false,//RayIntersectsGround(theAtmosphere, r, mu)
          d);
          ret.rgb += ss.L*skies_secondary_sun_color.rgb*theAtmosphere.solar_irradiance;
      }

      #if !RENDER_PANORAMA_SCATTERING
        if (canReproject)
        {
          float blurR = historyBlurGate(prevUV.xy, texcoord.xy);
          float4 old;
          BRANCH
          if (blurR < 0.002)
            old = tex3Dlod(prev_skies_frustum_scattering, float4(prevUV, 0));
          else
          {
            float2 ofs = prepare_resolution.xy*blurR;
            old =
              tex3Dlod(prev_skies_frustum_scattering, float4(prevUV - float3(ofs, 0), 0))+
              tex3Dlod(prev_skies_frustum_scattering, float4(prevUV + float3(ofs.x, -ofs.y, 0), 0))+
              tex3Dlod(prev_skies_frustum_scattering, float4(prevUV + float3(-ofs.x, ofs.y, 0), 0))+
              tex3Dlod(prev_skies_frustum_scattering, float4(prevUV + float3(ofs, 0), 0));
            old *= 0.25;
          }
          // no groupshared here to z-blur the current frame like the parallel-Z CS does, so history keeps
          // a z tent always: two center-column taps at half a texel, weighted to match the
          // legacy kernel's z-neighbor mass (fades near the camera); the tail slice is a
          // different distance domain, no z mixing across last_tz
          // prevUV.z is not saturated here (unlike the CS); keep the kernel weights convex
          float wz = texcoord.z < skies_frustum_scattering_last_tz ? 0.25*pow2(min(prevUV.z, 1.)) : 0.;
          float zofs = 0.5*prepare_resolution.z;
          old = old*(1. - 2.*wz)
            + (tex3Dlod(prev_skies_frustum_scattering, float4(prevUV.xy, prevUV.z - zofs, 0))
             + tex3Dlod(prev_skies_frustum_scattering, float4(prevUV.xy, min(prevUV.z + zofs, skies_frustum_scattering_last_tz), 0)))*wz;
          old.rgb *= old_effect;
          ret = fp16_aware_lerp_filtered(old, ret, 0.06);
        }
      #endif
      return ret;
    }
  }
  compile("target_ps", "skies_gen_ps")
}

// substep count for additional fog sampling to avoid incorrect sampling on dense fog layers near the ground
// 1 additional substep makes sense, 2 just slightly better than 1, values > 2 make no difference at all
int frustum_scattering_additional_substep_max_count = 0;
float frustum_scattering_substep_height_threshold = 400.0;

// TODO: Remove "skies_integrate_froxel_scattering_cs_use_parallel_z = no" interval when
// parallel Z accumulation proves to be stable.
int skies_integrate_froxel_scattering_cs_use_parallel_z = 1;
interval skies_integrate_froxel_scattering_cs_use_parallel_z: no < 1, yes;

// This interval allows to divide skies_integrate_froxel_scattering_cs into two stages:
// 1. precomputing getShadow(...) results into an intermediate 3D-texture
// 2. scattering computation
// Multi-stage version allows the shader to have smaller per-instance footprint.
// This is necessary to run the shader on a footprint-sensitive HW, such as Adreno 6XX series.
// NOTE: on the last "infinity" slice, shadow values in multi-stage mode are replaced with 1.0,
// because storing actual values would require too much memory I/O (potentially more than 10 samples per froxel).
int skies_integrate_froxel_scattering_cs_stage = 0;
interval skies_integrate_froxel_scattering_cs_stage: full < 1, precompute_shadow < 2, use_precomputed_shadow;

int skies_integrate_froxel_scattering_cs_use_multistage = 0;
interval skies_integrate_froxel_scattering_cs_use_multistage: no < 1, yes;
assume_if_not_assumed skies_integrate_froxel_scattering_cs_use_multistage = no;

texture skies_froxel_precomputed_shadow;

shader skies_integrate_froxel_scattering_cs
{
  if (skies_integrate_froxel_scattering_cs_use_multistage == no)
  {
    assume skies_integrate_froxel_scattering_cs_stage = full;
  }

  USE_PS5_WAVE32_MODE()
  FROXELS_SCATTERING(cs)
  INIT_NUKE_FOG_LIGHT(cs)
  USE_NUKE_FOG_LIGHT(cs)

  (cs) {
    additional_substep_max_count@i1 = frustum_scattering_additional_substep_max_count;
    substep_height_threshold@f1 = frustum_scattering_substep_height_threshold;
  }

  if (skies_integrate_froxel_scattering_cs_stage != precompute_shadow)
  {
    (cs) {
      output@uav : register(0) hlsl {
        RWTexture3D<float4> output@uav;
      }
    }
    if (skies_integrate_froxel_scattering_cs_stage == use_precomputed_shadow)
    {
      (cs) {
        skies_froxel_precomputed_shadow@tex3d = skies_froxel_precomputed_shadow;
      }
    }
  }
  else
  {
    (cs) {
      output@uav : register(0) hlsl {
        RWTexture3D<float> output@uav;
      }
    }
    hlsl(cs)
    {
      // For precomputed shadows it should be enough to use per-slice values without substeps
      #ifdef ALLOW_SKIES_SCATTERING_SUBSTEPS
        #undef ALLOW_SKIES_SCATTERING_SUBSTEPS
      #endif
    }
  }

  hlsl(cs) {

    struct ScatterRayConstData
    {
      Length r;
      Length mu;
      Position worldPos;
      Direction viewVect;
      float shadow_offset;
      Number primaryNu, primaryMu_s;
      Number secondaryNu, secondaryMu_s;
      Number primaryRayleighPhaseValue;
      Number primaryMiePhaseValue;
      Number secondaryRayleighPhaseValue;
      Number secondaryMiePhaseValue;

      TransmittanceTexture transmittance_texture;
      MultipleScatteringTexture multiple_scattering_approx;
    };

    IrradianceSpectrum scatterSlice(ScatterRayConstData c, Length dt, Length prevD, inout DimensionlessSpectrum throughput, inout float opaqueShadow)
    {
      // lighting (sun transmittance, MS, phase angles, shadow) is evaluated at the same
      // jittered distance as the medium sample, so temporal accumulation supersamples it too
      Length d = prevD + c.shadow_offset * dt;
      Length r_d = ClampRadius(theAtmosphere, SafeSqrt(d * d + 2.0 * c.r * c.mu * d + c.r * c.r));
      Number primaryMu_s_d = ClampCosine((c.r * c.primaryMu_s + d * c.primaryNu) / r_d),
            secondaryMu_s_d = ClampCosine((c.r * c.secondaryMu_s + d * c.secondaryNu) / r_d);

      Position curWorldPos = c.worldPos + d * c.viewVect * 1000;
      MediumSampleRGB medium = SampleMediumFull(theAtmosphere, r_d-theAtmosphere.bottom_radius, curWorldPos);
      // degenerate atmospheres can reach zero extinction; the analytic in-scatter integral divides by it
      medium.extinction = max(medium.extinction, 1e-7);

      float3 sampleOpticalDepth = medium.extinction * dt;
      float3 sampleTransmittance = exp(-sampleOpticalDepth);

      float3 primaryTransmittanceToSun = GetTransmittanceToSun( theAtmosphere, c.transmittance_texture, r_d, primaryMu_s_d);

      #if SHADOWMAP_ENABLED
      // First evaluate opaque shadow
        ##if skies_integrate_froxel_scattering_cs_stage == use_precomputed_shadow
          float primaryShadow = opaqueShadow;
        ##else
          float primaryShadow = getShadow(curWorldPos, d, r_d, primaryMu_s_d);
          ##if skies_integrate_froxel_scattering_cs_stage == precompute_shadow
            opaqueShadow = primaryShadow;
            return IrradianceSpectrum(0.0f,0.0f,0.0f);
          ##endif
        ##endif
        primaryTransmittanceToSun *= finalShadowFromShadowTerm(primaryShadow);
      #endif

      IrradianceSpectrum irradiance = IrradianceSpectrum(0.0f,0.0f,0.0f);

      ##if nuke_in_atmosphere == on
        irradiance += get_nuke_fog_step(curWorldPos, throughput, medium.extinction, sampleTransmittance, c.viewVect);
      ##endif

      float3 primaryPhaseTimesScattering = medium.scatteringMie * c.primaryMiePhaseValue + medium.scatteringRay * c.primaryRayleighPhaseValue;

      float3 primaryMultiScatteredLuminance = GetMultipleScattering(theAtmosphere, c.multiple_scattering_approx, r_d, primaryMu_s_d) * medium.scattering;

      float3 primaryS = (primaryTransmittanceToSun * primaryPhaseTimesScattering + primaryMultiScatteredLuminance);
      primaryS *= skies_primary_sun_color.rgb;
      float3 throughput_div_extinction = throughput / medium.extinction;
      throughput = throughput*sampleTransmittance; // throughput change affects next slice only.

      // See slide 28 at http://www.frostbite.com/2015/08/physically-based-unified-volumetric-rendering-in-frostbite/
      irradiance += (primaryS - primaryS * sampleTransmittance)*throughput_div_extinction;
      BRANCH
      if (any(skies_secondary_sun_color.rgb > 0))
      {
        float3 secondaryTransmittanceToSun = GetTransmittanceToSun( theAtmosphere, c.transmittance_texture, r_d, secondaryMu_s_d);
        #if SHADOWMAP_ENABLED
          secondaryTransmittanceToSun *= finalShadowFromShadowTerm(getCloudsStatisticalShadow(r_d, secondaryMu_s_d));
        #endif
        float3 secondaryPhaseTimesScattering = medium.scatteringMie * c.secondaryMiePhaseValue + medium.scatteringRay * c.secondaryRayleighPhaseValue;
        float3 secondryMultiScatteredLuminance = GetMultipleScattering(theAtmosphere, c.multiple_scattering_approx, r_d, secondaryMu_s_d) * medium.scattering;
        float3 secondaryS = (secondaryTransmittanceToSun * secondaryPhaseTimesScattering + secondryMultiScatteredLuminance);
        secondaryS *= skies_secondary_sun_color.rgb;
        irradiance += (secondaryS - secondaryS * sampleTransmittance)*throughput_div_extinction;
      }

      return irradiance;
    }

    // equal-mean 5-stratum jitter ladder: every (texel, slice) walks all strata over 5
    // frames (mean exactly 0.5); a biased per-texel mean freezes grain into the temporal
    // average that no filter can remove without also removing godrays
    float ladderShadowOffset(uint phase, uint slice)
    {
      return (float((phase + slice) % 5u) + 0.5) * 0.2;
    }

    void writeScatteringRet(uint3 writeTo, float4 ret)
    {
      ##if skies_integrate_froxel_scattering_cs_stage != precompute_shadow
        if (all(writeTo.xy < skies_froxels_resolutionI.xy))
          texture3DAt(output, writeTo) = ret;
      ##endif
    }

    void writePrecalculatedShadow(uint3 writeTo, float shadow)
    {
      ##if skies_integrate_froxel_scattering_cs_stage == precompute_shadow
        if (all(writeTo.xy < skies_froxels_resolutionI.xy))
          texture3DAt(output, writeTo) = shadow;
      ##endif
    }

    float loadPrecalculatedShadow(uint3 tc)
    {
      ##if skies_integrate_froxel_scattering_cs_stage == use_precomputed_shadow
        return texelFetch(skies_froxel_precomputed_shadow, tc, 0);
      ##else
        return 1.0;
      ##endif
    }

##if skies_integrate_froxel_scattering_cs_use_parallel_z == yes
    #define GROUP_X_DIM 4
    #define GROUP_Y_DIM 2

    groupshared float4 sharedMem[2][GROUP_X_DIM][GROUP_Y_DIM][SCATTERING_PARALLEL_Z];
    // last z-lane of the previous batch: the z-blur's cross-batch lower neighbor
    groupshared float4 prevSliceRet[GROUP_X_DIM][GROUP_Y_DIM];
    groupshared uint use_double_sampling;

    // Implementing product and sum prefix/scan based on Hillis and Steele algorithm.
    // If SCATTERING_PARALLEL_Z_LOG2 is even number a GroupMemoryBarrierWithGroupSync between prefixProductGetPrevious/prefixAccumulate uses is
    // required.

    float3 prefixProductGetPrevious(float3 value, inout float3 prevBatchInOut, uint3 gtId)
    {
      sharedMem[0][gtId.x][gtId.y][gtId.z].xyz = value;
      GroupMemoryBarrierWithGroupSync();

      UNROLL
      for (uint k = 0; k < SCATTERING_PARALLEL_Z_LOG2; k++)
      {
        uint r = 1u << k;
        if (gtId.z >= r)
          value *= sharedMem[k%2][gtId.x][gtId.y][gtId.z - r].xyz;

        sharedMem[(k+1)%2][gtId.x][gtId.y][gtId.z].xyz = value;
        GroupMemoryBarrierWithGroupSync();
      }
      float3 prevProduct = gtId.z > 0 ? prevBatchInOut * sharedMem[SCATTERING_PARALLEL_Z_LOG2 % 2][gtId.x][gtId.y][gtId.z - 1].xyz : prevBatchInOut;
      prevBatchInOut *= sharedMem[SCATTERING_PARALLEL_Z_LOG2 % 2][gtId.x][gtId.y][SCATTERING_PARALLEL_Z - 1].xyz;
      return prevProduct;
    }

    float3 prefixAccumulate(float3 value, inout float3 prevBatchInOut, uint3 gtId)
    {
      sharedMem[0][gtId.x][gtId.y][gtId.z].xyz = value;
      GroupMemoryBarrierWithGroupSync();

      UNROLL
      for (uint k = 0; k < SCATTERING_PARALLEL_Z_LOG2; k++)
      {
        uint r = 1u << k;
        if (gtId.z >= r)
          value += sharedMem[k%2][gtId.x][gtId.y][gtId.z - r].xyz;

        sharedMem[(k+1)%2][gtId.x][gtId.y][gtId.z].xyz = value;
        GroupMemoryBarrierWithGroupSync();
      }
      float3 sum = prevBatchInOut + value;
      prevBatchInOut += sharedMem[SCATTERING_PARALLEL_Z_LOG2 % 2][gtId.x][gtId.y][SCATTERING_PARALLEL_Z - 1].xyz;
      return sum;
    }

    [numthreads(GROUP_X_DIM, GROUP_Y_DIM, SCATTERING_PARALLEL_Z)]
    void skies_gen_cs(uint2 dtId : SV_DispatchThreadID, uint3 gtId : SV_GroupThreadID)
    {
      float2 texcoord = (dtId+0.5)*prepare_resolution.xy;
      ScatterRayConstData c;
      #if RENDER_PANORAMA_SCATTERING
        c.viewVect = get_panorama_viewvect(texcoord);
        bool jitterOn = false;
        uint jitterPhase = 0;
        //#define SUB_SAMPLE_RES_SHIFT 1
        #define DOUBLE_SAMPLING 1
        #define SUBSTEP_COUNT 1
      #else
        #if !_HARDWARE_METAL
          if (all(gtId == 0))
            use_double_sampling = 0;
          GroupMemoryBarrierWithGroupSync();
        #endif

        uint doubleSampling = 0;
        bool jitterOn = skies_continue_temporal >= 0;
        // frame-independent IGN rotates the ladder order per texel: phases stay spatially decorrelated
        uint jitterPhase = uint(skies_frustum_scattering_frame) % 5u + min(uint(interleavedGradientNoise(dtId.xy) * 5), 4u);
        if (skies_panoramic_scattering)//cubic
        {
          c.viewVect = get_panoramic_scattering_view(texcoord.xy);
        } else
        {
          c.viewVect = normalize(getViewVecOptimized(texcoord.xy));
          float4 prevClip = mul(float4(c.viewVect*1000, 0), prev_globtm_no_ofs_psf);
          float2 prevScreen = prevClip.xy*rcp(prevClip.w);
          if (max(abs(prevScreen.x), abs(prevScreen.y)) >= 1 || prevClip.w<=0)//off screen pixel
          {
            // have to disable this because it results in gpu hangs on intel macs
            #if !_HARDWARE_METAL
              doubleSampling = 1;
            #endif
            jitterOn = false;
          }
        }
        // NOTE: I tried to #define DOUBLE_SAMPLING WaveActiveBitOr(doubleSampling) instead
        // of using shared memory and it didn't change much of anything. Maybe need to try harder?
        //todo: use dx12 merge all lanes here!
        #if !_HARDWARE_METAL
          if (gtId.z == 0)
            InterlockedOr(use_double_sampling, doubleSampling);
          GroupMemoryBarrierWithGroupSync();
          doubleSampling = use_double_sampling;
        #endif
        //-todo: use dx12 merge all lanes here!
        #define DOUBLE_SAMPLING doubleSampling
        #if ALLOW_SKIES_SCATTERING_SUBSTEPS && !_HARDWARE_METAL
          #define SUBSTEP_COUNT substepCount
        #else
          #define SUBSTEP_COUNT 1
        #endif
      #endif
      c.r = use_camera_altitude + theAtmosphere.bottom_radius;
      if (abs(c.r - theAtmosphere.top_radius) < 0.01)
        c.r = theAtmosphere.top_radius+0.01;
      c.mu = c.viewVect.y;

      c.primaryNu = dot(c.viewVect.xzy, skies_primary_sun_light_dir);
      c.primaryMu_s = skies_primary_sun_light_dir.z;
      c.secondaryNu = dot(c.viewVect.xzy, skies_secondary_sun_light_dir);
      c.secondaryMu_s = skies_secondary_sun_light_dir.z;

      c.transmittance_texture = SamplerTexture2DFromName(skies_transmittance_texture);
      c.multiple_scattering_approx = SamplerTexture2DFromName(skies_ms_texture);
      c.worldPos = shadow_origin;

      //float3 skiesScattering = sample_skies_scattering_color_camera(texcoord.xy, viewVect);
      //===================
      {
      // Compute next intersection with atmosphere or ground
      //float tMax = DistanceToNearestAtmosphereBoundary(theAtmosphere, c.r, c.mu, false);
      //tMax = min(tMax, skies_froxels_dist/1000);

      // Sample count
      ##assert(skies_frustum_scattering_last_tz != 0.0);
      const float tMax = skies_froxels_dist/1000/max(skies_frustum_scattering_last_tz, 0.1);

      // Phase functions
      //const Number uniformPhase = 1.0 / (4.0 * PI);
      c.primaryRayleighPhaseValue = RayleighPhaseFunction(c.primaryNu);
      c.primaryMiePhaseValue = c.primaryRayleighPhaseValue * MiePhaseFunctionDivideByRayleighOptimized(theAtmosphere.mie_phase_consts, c.primaryNu);
      c.secondaryRayleighPhaseValue = RayleighPhaseFunction(c.secondaryNu);
      c.secondaryMiePhaseValue = c.secondaryRayleighPhaseValue * MiePhaseFunctionDivideByRayleighOptimized(theAtmosphere.mie_phase_consts, c.secondaryNu);

      IrradianceSpectrum irradiancePrevBatch = IrradianceSpectrum(0.0f,0.0f,0.0f);
      DimensionlessSpectrum throughputPrevBatch = DimensionlessSpectrum(1.0,1.0,1.0);

      ##assert(all(skies_froxels_resolutionI != 0));
      uint sampleCount = (skies_frustum_scattering_last_tz < 1) ? max(skies_froxels_resolutionI.z, 1)-1 : skies_froxels_resolutionI.z;
      sampleCount <<= DOUBLE_SAMPLING;

      uint loops = (sampleCount + SCATTERING_PARALLEL_Z - 1) / SCATTERING_PARALLEL_Z;
      for (uint i = 0, slice = gtId.z; i < loops; i++, slice += SCATTERING_PARALLEL_Z)
      {
        float texcoordZ = max(float(slice), 0.5)/float(sampleCount);
        float prevTexcoordZ = slice != 0 ? max(float(slice - 1), 0.5)/float(sampleCount) : 0;
        Length realD = pow2(texcoordZ)*tMax;
        Length prevD = pow2(prevTexcoordZ)*tMax;
        Length dt = realD - prevD;
        float worldHeight = c.worldPos.y + realD * c.viewVect.y * 1000;

        // substeps for fog calculation on lower layers. Problem is: raymarching can skip dense fog layer, so it leads to circular fog pattern on low heights
        // more than 2 subteps provides almost no differece, so limit iteration count to unroll loop
        #define MAX_SUBSTEP_COUNT 2
        // use substeps only if we observing ground/water from above
        uint substepCount = 1 + additional_substep_max_count * saturate (-c.viewVect.y*2) * (worldHeight > substep_height_threshold ? 0 : 1);

        IrradianceSpectrum irradianceLocal = IrradianceSpectrum(0.0f,0.0f,0.0f);
        DimensionlessSpectrum throughputLocal = DimensionlessSpectrum(1.0,1.0,1.0);

        // lanes past the ray range stay identity: their throughput/inscatter would enter
        // the batch carries, and the tail march re-integrates the same segment

        const uint3 writeTo = uint3(dtId, slice>>DOUBLE_SAMPLING);
        float opaqueShadow = loadPrecalculatedShadow(writeTo);
        if (slice < sampleCount)
        {
          c.shadow_offset = jitterOn ? ladderShadowOffset(jitterPhase, slice) : 0.5;
          for (uint j = 0; j < min(SUBSTEP_COUNT, MAX_SUBSTEP_COUNT); j++)
          {
            Length substepDt = dt / SUBSTEP_COUNT;
            irradianceLocal += scatterSlice(c, substepDt, prevD + substepDt*j, throughputLocal, opaqueShadow);
          }
        }

        DimensionlessSpectrum throughputPrevPrefix = prefixProductGetPrevious(throughputLocal, throughputPrevBatch, gtId);
        irradianceLocal *= throughputPrevPrefix;

        IrradianceSpectrum irradiancePrefix = prefixAccumulate(irradianceLocal, irradiancePrevBatch, gtId);

        // z-blur the CURRENT frame while the whole ray is in-group: applied once per frame,
        // never inside the temporal feedback, and fresh texels get it too. Scan buffer 0 is
        // dead after the scans; the to-infinity tail is a different distance domain, kept sharp.
        float4 rawRet = float4(irradiancePrefix*theAtmosphere.solar_irradiance, dot(throughputPrevPrefix * throughputLocal, 1./3));
        sharedMem[0][gtId.x][gtId.y][gtId.z] = rawRet;
        GroupMemoryBarrierWithGroupSync();
        uint zStride = 1u << DOUBLE_SAMPLING;
        float4 loVal = rawRet, hiVal = rawRet;
        bool loValid = slice >= zStride;
        if (loValid)
        {
          if (gtId.z >= zStride)
            loVal = sharedMem[0][gtId.x][gtId.y][gtId.z - zStride];
          else
            loVal = prevSliceRet[gtId.x][gtId.y];
        }
        bool hiValid = gtId.z + zStride < SCATTERING_PARALLEL_Z && slice + zStride < sampleCount;
        if (hiValid)
          hiVal = sharedMem[0][gtId.x][gtId.y][gtId.z + zStride];
        // [f/8, 1-f/4, f/8] tent: f keeps the old near-camera radius fade; edges renormalize
        float wn = pow2((float(slice>>DOUBLE_SAMPLING) + 0.5)*prepare_resolution.z) * 0.125;
        float4 blurredRet = (rawRet*(1. - 2.*wn) + loVal*(loValid ? wn : 0.) + hiVal*(hiValid ? wn : 0.))
          / (1. - (loValid ? 0. : wn) - (hiValid ? 0. : wn));
        GroupMemoryBarrierWithGroupSync();
        // the cross-batch lower neighbor is only consumed by the first written slice of a
        // batch (write cond below), whose slice-zStride neighbor is always the previous
        // batch's last lane - for any DOUBLE_SAMPLING
        if (gtId.z == SCATTERING_PARALLEL_Z - 1)
          prevSliceRet[gtId.x][gtId.y] = rawRet;

        if (slice < sampleCount && (slice & DOUBLE_SAMPLING) == DOUBLE_SAMPLING)//assuming DOUBLE_SAMPLING == 1. correct one is if ((slice&(1<<DOUBLE_SAMPLING) - 1) == (1<<DOUBLE_SAMPLING) - 1)
        {
          writePrecalculatedShadow(writeTo, opaqueShadow);

          float4 ret = blurredRet;

          //bool canReproject = skies_continue_temporal > 0;
          #if !RENDER_PANORAMA_SCATTERING
            const float3 curUV = float3(texcoord, (writeTo.z+0.5)*prepare_resolution.z);
            float3 prevUV = curUV;
            if (!skies_panoramic_scattering)
            {
              float3 camPos = c.viewVect*(pow2(prevUV.z)*skies_froxels_dist);
              float prevLinearDist = length(camPos - move_world_view_pos);
              float prevLinearUVZ = saturate(prevLinearDist*skies_froxels_prev_dist.x);
              prevUV.z = sqrt(prevLinearUVZ);

              #if 0
              //instead of sampling with previous UV, we can make correct sampling, with linear distribution between samples
              //basically, when previous Z are not center of froxel
              // HW will use linear filtering
              // and yet uvw.z is calculated with sqrt distribution
              // so, if we need linear sampling, we should redjust, based on location of two froxels: at floor(uvw.z*resolution - 0.5) and ceil(uvw.z*resolution - 0.5)
              // we calculate their linear UVZ params, then calc frction of linear (uvz.w-floored_pos)/(ceiled_pos-floored_pos)
              //unfortunatele scattering distribution is rarely linear
              float prevUVTexel = (prevUV.z*skies_froxels_resolution.z-0.5);
              float prevUVTexelFloored = floor(prevUVTexel);
              float flooredUVZ = (prevUVTexelFloored+0.5)*prepare_resolution.z;
              float flooredPrevTexelPosZ = pow2(flooredUVZ);
              //float ceilPrevTexelPosZ = pow2((prevUVTexelFloored+1.5)*prepare_resolution.z);
              //float linearDistanceBetweenTexels = ceilPrevTexelPosZ - flooredPrevTexelPosZ;//a^2-b^2 = (a-b)*(a+b) == 2*res.z^2
              float linearDistanceBetweenTexels = (2+2*prevUVTexelFloored);//a^2-b^2 = (a-b)*(a+b) == 2*res.z^2
              prevUV.z = flooredUVZ + saturate((prevLinearUVZ - flooredPrevTexelPosZ)*rcp(linearDistanceBetweenTexels))*skies_froxels_resolution.z;
              #endif

              float4 prevClip = mul(float4(camPos, 1), prev_globtm_no_ofs_psf);
              float2 prevScreen = prevClip.w > 0 ? prevClip.xy/prevClip.w : float2(2, 2);
              prevUV.xy = float2(prevScreen.xy*float2(0.5, -0.5) + float2(0.5, 0.5));
              //float prevDepth = prevClip.w*length(getPrevViewVecOptimized(prevUV.xy));
              //prevUV.z = sqrt(prevDepth/skies_froxels_dist);
              //canReproject = max(abs(prevUV.x*2-1), abs(prevUV.y*2-1)) < skies_continue_temporal;
            }
            if (max(abs(prevUV.x*2-1), abs(prevUV.y*2-1)) < skies_continue_temporal)
            {
              float blurR = historyBlurGate(prevUV.xy, curUV.xy);
              prevUV.z = min(prevUV.z, skies_frustum_scattering_last_tz);
              float4 old;
              BRANCH
              if (blurR < 0.002)
                old = tex3Dlod(prev_skies_frustum_scattering, float4(prevUV, 0));
              else
              {
                float2 ofs = prepare_resolution.xy*blurR;
                old =
                  tex3Dlod(prev_skies_frustum_scattering, float4(prevUV - float3(ofs, 0), 0))+
                  tex3Dlod(prev_skies_frustum_scattering, float4(prevUV + float3(ofs.x, -ofs.y, 0), 0))+
                  tex3Dlod(prev_skies_frustum_scattering, float4(prevUV + float3(-ofs.x, ofs.y, 0), 0))+
                  tex3Dlod(prev_skies_frustum_scattering, float4(prevUV + float3(ofs, 0), 0));
                old *= 0.25;
              }
              old.rgb *= old_effect;
              ret = fp16_aware_lerp_filtered(old, ret, 0.06);
            }
          #endif
          writeScatteringRet(writeTo, ret);
        }
      }
      BRANCH
      if (skies_frustum_scattering_last_tz < 1)
      {
        Length startD = tMax * pow2(float(sampleCount - 1) / float(sampleCount));
        Length dground = DistanceToBottomAtmosphereBoundarySigned(theAtmosphere, c.r, c.mu);
        //everything here is in km: mixing in metres made the tail overshoot the
        //atmosphere so the last slice accumulated almost nothing beyond tMax.
        //no-ground rays march to the atmosphere top: near the horizon that is ~1000 km,
        //a fixed cap would cut most of the inscatter the PS/reference path integrates
        Length dfar = dground > 0 ? dground : DistanceToTopAtmosphereBoundary(theAtmosphere, c.r, c.mu);
        Length totalD = max(0.001, dfar - startD);

        //one geometric batch (dt doubles per lane) spans any atmosphere at a fixed
        //cost of one scan block, densest where the air is: no-ground tails put the
        //finest steps at the froxel edge and stretch into the thin upper atmosphere,
        //ground-terminating tails reverse the ladder so the finest steps hug the
        //ground; the analytic per-step integration in scatterSlice stays
        //energy-conserving for the large steps through thin air
        Length dt0 = totalD * (1. / ((1u << SCATTERING_PARALLEL_Z) - 1));
        bool groundTail = dground > 0;
        {
          uint slice = gtId.z;
          Length prevD = startD + dt0 * (groundTail ? (1u << SCATTERING_PARALLEL_Z) - (1u << (SCATTERING_PARALLEL_Z - slice)) : (1u << slice) - 1);
          Length dt = dt0 * (1u << (groundTail ? SCATTERING_PARALLEL_Z - 1 - slice : slice));

          c.shadow_offset = jitterOn ? ladderShadowOffset(jitterPhase, sampleCount + slice) : 0.5;
          float opaqueShadow = 1.0;
          DimensionlessSpectrum throughputLocal = DimensionlessSpectrum(1.0,1.0,1.0);
          IrradianceSpectrum irradianceLocal = scatterSlice(c, dt, prevD, throughputLocal, opaqueShadow);

          DimensionlessSpectrum throughputPrevPrefix = prefixProductGetPrevious(throughputLocal, throughputPrevBatch, gtId);
          irradianceLocal *= throughputPrevPrefix;

          prefixAccumulate(irradianceLocal, irradiancePrevBatch, gtId);
        }

        if (gtId.z == 0)
        {
          float4 ret = float4(irradiancePrevBatch*theAtmosphere.solar_irradiance, dot(throughputPrevBatch, 1./3));

          //bool canReproject = skies_continue_temporal > 0;
          #if !RENDER_PANORAMA_SCATTERING
            const float3 curUV = float3(texcoord, 1);
            float3 prevUV = curUV;
            if (!skies_panoramic_scattering)
            {
              float3 camPos = c.viewVect*(pow2(prevUV.z)*skies_froxels_dist);
              float prevLinearDist = length(camPos - move_world_view_pos);
              float prevLinearUVZ = saturate(prevLinearDist*skies_froxels_prev_dist.x);
              prevUV.z = sqrt(prevLinearUVZ);

              float4 prevClip = mul(float4(camPos, 1), prev_globtm_no_ofs_psf);
              float2 prevScreen = prevClip.w > 0 ? prevClip.xy/prevClip.w : float2(2, 2);
              prevUV.xy = float2(prevScreen.xy*float2(0.5, -0.5) + float2(0.5, 0.5));
              //float prevDepth = prevClip.w*length(getPrevViewVecOptimized(prevUV.xy));
              //prevUV.z = sqrt(prevDepth/skies_froxels_dist);
              //canReproject = max(abs(prevUV.x*2-1), abs(prevUV.y*2-1)) < skies_continue_temporal;
            }
            if (max(abs(prevUV.x*2-1), abs(prevUV.y*2-1)) < skies_continue_temporal)
            {
              float blurR = historyBlurGate(prevUV.xy, curUV.xy);
              float4 old;
              BRANCH
              if (blurR < 0.002)
                old = tex3Dlod(prev_skies_frustum_scattering, float4(prevUV, 0));
              else
              {
                float2 ofs = prepare_resolution.xy*blurR;
                old =
                  tex3Dlod(prev_skies_frustum_scattering, float4(prevUV - float3(ofs, 0), 0))+
                  tex3Dlod(prev_skies_frustum_scattering, float4(prevUV + float3(ofs.x, -ofs.y, 0), 0))+
                  tex3Dlod(prev_skies_frustum_scattering, float4(prevUV + float3(-ofs.x, ofs.y, 0), 0))+
                  tex3Dlod(prev_skies_frustum_scattering, float4(prevUV + float3(ofs, 0), 0));
                old *= 0.25;
              }
              old.rgb *= old_effect;
              ret = fp16_aware_lerp_filtered(old, ret, 0.06);
            }
            #endif
            writeScatteringRet(uint3(dtId, skies_froxels_resolutionI.z-1), ret);
        }
      }
      }//
    }
##else // skies_integrate_froxel_scattering_cs_use_parallel_z == no
    groupshared uint use_double_sampling;
##if hardware.ps5 || hardware.dx12
    [numthreads(8, 2, 1)]
##else
    [numthreads(8, 8, 1)]
##endif
    void skies_gen_cs(uint2 dtId : SV_DispatchThreadID, uint3 gtId : SV_GroupThreadID)
    {
      float2 texcoord = (dtId+0.5)*prepare_resolution.xy;
      ScatterRayConstData c;
      #if RENDER_PANORAMA_SCATTERING
        c.viewVect = get_panorama_viewvect(texcoord);
        bool jitterOn = false;
        uint jitterPhase = 0;
        //#define SUB_SAMPLE_RES_SHIFT 1
        #define DOUBLE_SAMPLING 1
        #define SUBSTEP_COUNT 1
      #else
        uint doubleSampling = 0;
        #if !_HARDWARE_METAL
          if (all(gtId == 0))
            use_double_sampling = 0;
          GroupMemoryBarrierWithGroupSync();
        #endif
        bool jitterOn = skies_continue_temporal >= 0;
        // frame-independent IGN rotates the ladder order per texel: phases stay spatially decorrelated
        uint jitterPhase = uint(skies_frustum_scattering_frame) % 5u + min(uint(interleavedGradientNoise(dtId.xy) * 5), 4u);
        if (skies_panoramic_scattering)//cubic
        {
          c.viewVect = get_panoramic_scattering_view(texcoord.xy);
        } else
        {
          c.viewVect = normalize(getViewVecOptimized(texcoord.xy));
          float4 prevClip = mul(float4(c.viewVect*1000, 0), prev_globtm_no_ofs_psf);
          float2 prevScreen = prevClip.xy*rcp(prevClip.w);
          if (max(abs(prevScreen.x), abs(prevScreen.y)) >= 1 || prevClip.w<=0)//off screen pixel
          {
            // have to disable this because it results in gpu hangs on intel macs
            #if !_HARDWARE_METAL
              doubleSampling = 1;
            #endif
            jitterOn = false;
          }
        }
        // NOTE: I tried to #define DOUBLE_SAMPLING WaveActiveBitOr(doubleSampling) instead
        // of using shared memory and it didn't change much of anything. Maybe need to try harder?
        //todo: use dx12 merge all lanes here!
        #if !_HARDWARE_METAL
        InterlockedOr(use_double_sampling, doubleSampling);
        GroupMemoryBarrierWithGroupSync();
        doubleSampling |= use_double_sampling;
        #endif
        //-todo: use dx12 merge all lanes here!
        #define DOUBLE_SAMPLING doubleSampling
        #if ALLOW_SKIES_SCATTERING_SUBSTEPS && !_HARDWARE_METAL
          #define SUBSTEP_COUNT substepCount
        #else
          #define SUBSTEP_COUNT 1
        #endif
      #endif
      c.r = use_camera_altitude + theAtmosphere.bottom_radius;
      if (abs(c.r - theAtmosphere.top_radius) < 0.01)
        c.r = theAtmosphere.top_radius+0.01;
      c.mu = c.viewVect.y;

      c.primaryNu = dot(c.viewVect.xzy, skies_primary_sun_light_dir);
      c.primaryMu_s = skies_primary_sun_light_dir.z;
      c.secondaryNu = dot(c.viewVect.xzy, skies_secondary_sun_light_dir);
      c.secondaryMu_s = skies_secondary_sun_light_dir.z;

      c.transmittance_texture = SamplerTexture2DFromName(skies_transmittance_texture);
      c.multiple_scattering_approx = SamplerTexture2DFromName(skies_ms_texture);
      c.worldPos = shadow_origin;

      //float3 skiesScattering = sample_skies_scattering_color_camera(texcoord.xy, viewVect);
//===================
      {
      // Compute next intersection with atmosphere or ground
      //float tMax = DistanceToNearestAtmosphereBoundary(theAtmosphere, c.r, c.mu, false);
      //tMax = min(tMax, skies_froxels_dist/1000);

      // Sample count
      ##assert(skies_frustum_scattering_last_tz != 0.0);
      float tMax = skies_froxels_dist/1000/max(skies_frustum_scattering_last_tz, 0.1);
      float prevD = 0;

      // Phase functions
      //const Number uniformPhase = 1.0 / (4.0 * PI);
      c.primaryRayleighPhaseValue = RayleighPhaseFunction(c.primaryNu);
      c.primaryMiePhaseValue = c.primaryRayleighPhaseValue * MiePhaseFunctionDivideByRayleighOptimized(theAtmosphere.mie_phase_consts, c.primaryNu);
      c.secondaryRayleighPhaseValue = RayleighPhaseFunction(c.secondaryNu);
      c.secondaryMiePhaseValue = c.secondaryRayleighPhaseValue * MiePhaseFunctionDivideByRayleighOptimized(theAtmosphere.mie_phase_consts, c.secondaryNu);

      // Ray march the atmosphere to integrate optical depth
      IrradianceSpectrum L = IrradianceSpectrum(0.0f,0.0f,0.0f);
      DimensionlessSpectrum throughput = DimensionlessSpectrum(1.0,1.0,1.0);

      ##assert(all(skies_froxels_resolutionI != 0));
      uint sampleCount = (skies_frustum_scattering_last_tz < 1) ? max(skies_froxels_resolutionI.z, 1)-1 : skies_froxels_resolutionI.z;
      sampleCount <<= DOUBLE_SAMPLING;

      for (uint i = 0; i < sampleCount; i++)
      {
        float texcoordZ = max(float(i), 0.5)/float(sampleCount);
        Length realD = pow2(texcoordZ)*tMax;
        Length dt = realD - prevD;
        float worldHeight = c.worldPos.y + realD * c.viewVect.y * 1000;

        // substeps for fog calculation on lower layers. Problem is: raymarching can skip dense fog layer, so it leads to circular fog pattern on low heights
        // more than 2 subteps provides almost no differece, so limit iteration count to unroll loop
        #define MAX_SUBSTEP_COUNT 2
        // use substeps only if we observing ground/water from above
        uint substepCount = 1 + additional_substep_max_count * saturate (-c.viewVect.y*2) * (worldHeight > substep_height_threshold ? 0 : 1);
        c.shadow_offset = jitterOn ? ladderShadowOffset(jitterPhase, i) : 0.5;
        const uint3 writeTo = uint3(dtId, i>>DOUBLE_SAMPLING);

        float opaqueShadow = loadPrecalculatedShadow(writeTo);
        for (uint j = 0; j < min(SUBSTEP_COUNT, MAX_SUBSTEP_COUNT); j++)
        {
          Length substepDt = dt / SUBSTEP_COUNT;
          L += scatterSlice(c, substepDt, prevD + substepDt*j, throughput, opaqueShadow);
        }
        prevD = realD;

        bool shouldWrite = false;

        if ((i&DOUBLE_SAMPLING) == DOUBLE_SAMPLING)//assuming DOUBLE_SAMPLING == 1. correct one is if ((i&(1<<DOUBLE_SAMPLING) - 1) == (1<<DOUBLE_SAMPLING) - 1)
          shouldWrite = true;

        if (shouldWrite)
        {
          writePrecalculatedShadow(writeTo, opaqueShadow);

          float4 ret = float4(L*theAtmosphere.solar_irradiance, dot(throughput, 1./3));

          //bool canReproject = skies_continue_temporal > 0;
          #if !RENDER_PANORAMA_SCATTERING
            const float3 curUV = float3(texcoord, (writeTo.z+0.5)*prepare_resolution.z);
            float3 prevUV = curUV;
            if (!skies_panoramic_scattering)
            {
              float3 camPos = c.viewVect*(pow2(prevUV.z)*skies_froxels_dist);
              float prevLinearDist = length(camPos - move_world_view_pos);
              float prevLinearUVZ = saturate(prevLinearDist*skies_froxels_prev_dist.x);
              prevUV.z = sqrt(prevLinearUVZ);

              #if 0
              //instead of sampling with previous UV, we can make correct sampling, with linear distribution between samples
              //basically, when previous Z are not center of froxel
              // HW will use linear filtering
              // and yet uvw.z is calculated with sqrt distribution
              // so, if we need linear sampling, we should redjust, based on location of two froxels: at floor(uvw.z*resolution - 0.5) and ceil(uvw.z*resolution - 0.5)
              // we calculate their linear UVZ params, then calc frction of linear (uvz.w-floored_pos)/(ceiled_pos-floored_pos)
              //unfortunatele scattering distribution is rarely linear
              float prevUVTexel = (prevUV.z*skies_froxels_resolution.z-0.5);
              float prevUVTexelFloored = floor(prevUVTexel);
              float flooredUVZ = (prevUVTexelFloored+0.5)*prepare_resolution.z;
              float flooredPrevTexelPosZ = pow2(flooredUVZ);
              //float ceilPrevTexelPosZ = pow2((prevUVTexelFloored+1.5)*prepare_resolution.z);
              //float linearDistanceBetweenTexels = ceilPrevTexelPosZ - flooredPrevTexelPosZ;//a^2-b^2 = (a-b)*(a+b) == 2*res.z^2
              float linearDistanceBetweenTexels = (2+2*prevUVTexelFloored);//a^2-b^2 = (a-b)*(a+b) == 2*res.z^2
              prevUV.z = flooredUVZ + saturate((prevLinearUVZ - flooredPrevTexelPosZ)*rcp(linearDistanceBetweenTexels))*skies_froxels_resolution.z;
              #endif

              float4 prevClip = mul(float4(camPos, 1), prev_globtm_no_ofs_psf);
              float2 prevScreen = prevClip.w > 0 ? prevClip.xy/prevClip.w : float2(2, 2);
              prevUV.xy = float2(prevScreen.xy*float2(0.5, -0.5) + float2(0.5, 0.5));
              //float prevDepth = prevClip.w*length(getPrevViewVecOptimized(prevUV.xy));
              //prevUV.z = sqrt(prevDepth/skies_froxels_dist);
              //canReproject = max(abs(prevUV.x*2-1), abs(prevUV.y*2-1)) < skies_continue_temporal;
            }
            if (max(abs(prevUV.x*2-1), abs(prevUV.y*2-1)) < skies_continue_temporal)
            {
              float blurR = historyBlurGate(prevUV.xy, curUV.xy);
              prevUV.z = min(prevUV.z, skies_frustum_scattering_last_tz);
              float4 old;
              BRANCH
              if (blurR < 0.002)
                old = tex3Dlod(prev_skies_frustum_scattering, float4(prevUV, 0));
              else
              {
                float2 ofs = prepare_resolution.xy*blurR;
                old =
                  tex3Dlod(prev_skies_frustum_scattering, float4(prevUV - float3(ofs, 0), 0))+
                  tex3Dlod(prev_skies_frustum_scattering, float4(prevUV + float3(ofs.x, -ofs.y, 0), 0))+
                  tex3Dlod(prev_skies_frustum_scattering, float4(prevUV + float3(-ofs.x, ofs.y, 0), 0))+
                  tex3Dlod(prev_skies_frustum_scattering, float4(prevUV + float3(ofs, 0), 0));
                old *= 0.25;
              }
              // no groupshared current-frame z-blur in this legacy variant, so like the PS
              // the z tent stays on the history side; the tail is a different distance domain
              float wz = curUV.z < skies_frustum_scattering_last_tz ? 0.25*pow2(prevUV.z) : 0.;
              float zofs = 0.5*prepare_resolution.z;
              old = old*(1. - 2.*wz)
                + (tex3Dlod(prev_skies_frustum_scattering, float4(prevUV.xy, prevUV.z - zofs, 0))
                 + tex3Dlod(prev_skies_frustum_scattering, float4(prevUV.xy, min(prevUV.z + zofs, skies_frustum_scattering_last_tz), 0)))*wz;
              old.rgb *= old_effect;
              ret = fp16_aware_lerp_filtered(old, ret, 0.06);
            }
          #endif
          writeScatteringRet(writeTo, ret);
        }
      }
      BRANCH
      if (skies_frustum_scattering_last_tz < 1)
      {
        Length dground = DistanceToBottomAtmosphereBoundarySigned(theAtmosphere, c.r, c.mu);
        //everything here is in km: mixing in metres made the tail overshoot the
        //atmosphere so the last slice accumulated almost nothing beyond the froxel range.
        //no-ground rays march to the atmosphere top: near the horizon that is ~1000 km,
        //a fixed cap would cut most of the inscatter the PS/reference path integrates
        Length dfar = dground > 0 ? dground : DistanceToTopAtmosphereBoundary(theAtmosphere, c.r, c.mu);
        Length totalD = max(0.001, dfar - prevD);
        //same geometric ladder as the parallel path (incl. the ground reversal), but
        //scaled: short tails keep the old one-step-per-60km count, only long ones
        //grow to the full ladder
        uint steps = min(max(1, ceil(totalD/60.0)), SCATTERING_PARALLEL_Z);
        Length dt0 = totalD * rcp(float((1u << steps) - 1));
        bool groundTail = dground > 0;

        float opaqueShadow = 1.0;
        for (uint i = 0; i < steps; i++)
        {
          Length dt = dt0 * (1u << (groundTail ? steps - 1 - i : i));
          c.shadow_offset = jitterOn ? ladderShadowOffset(jitterPhase, sampleCount + i) : 0.5;
          L += scatterSlice(c, dt, prevD, throughput, opaqueShadow);
          prevD += dt;
        }

        float4 ret = float4(L*theAtmosphere.solar_irradiance, dot(throughput, 1./3));

        //bool canReproject = skies_continue_temporal > 0;
        #if !RENDER_PANORAMA_SCATTERING
          const float3 curUV = float3(texcoord, 1);
          float3 prevUV = curUV;
          if (!skies_panoramic_scattering)
          {
            float3 camPos = c.viewVect*(pow2(prevUV.z)*skies_froxels_dist);
            float prevLinearDist = length(camPos - move_world_view_pos);
            float prevLinearUVZ = saturate(prevLinearDist*skies_froxels_prev_dist.x);
            prevUV.z = sqrt(prevLinearUVZ);

            float4 prevClip = mul(float4(camPos, 1), prev_globtm_no_ofs_psf);
            float2 prevScreen = prevClip.w > 0 ? prevClip.xy/prevClip.w : float2(2, 2);
            prevUV.xy = float2(prevScreen.xy*float2(0.5, -0.5) + float2(0.5, 0.5));
            //float prevDepth = prevClip.w*length(getPrevViewVecOptimized(prevUV.xy));
            //prevUV.z = sqrt(prevDepth/skies_froxels_dist);
            //canReproject = max(abs(prevUV.x*2-1), abs(prevUV.y*2-1)) < skies_continue_temporal;
          }
          if (max(abs(prevUV.x*2-1), abs(prevUV.y*2-1)) < skies_continue_temporal)
          {
            float blurR = historyBlurGate(prevUV.xy, curUV.xy);
            float4 old;
            BRANCH
            if (blurR < 0.002)
              old = tex3Dlod(prev_skies_frustum_scattering, float4(prevUV, 0));
            else
            {
              float2 ofs = prepare_resolution.xy*blurR;
              old =
                tex3Dlod(prev_skies_frustum_scattering, float4(prevUV - float3(ofs, 0), 0))+
                tex3Dlod(prev_skies_frustum_scattering, float4(prevUV + float3(ofs.x, -ofs.y, 0), 0))+
                tex3Dlod(prev_skies_frustum_scattering, float4(prevUV + float3(-ofs.x, ofs.y, 0), 0))+
                tex3Dlod(prev_skies_frustum_scattering, float4(prevUV + float3(ofs, 0), 0));
              old *= 0.25;
            }
            old.rgb *= old_effect;
            ret = fp16_aware_lerp_filtered(old, ret, 0.06);
          }
        #endif
        writeScatteringRet(uint3(dtId, skies_froxels_resolutionI.z-1), ret);
      }
      }//
    }
  }
  compile("cs_5_0", "skies_gen_cs")
}

