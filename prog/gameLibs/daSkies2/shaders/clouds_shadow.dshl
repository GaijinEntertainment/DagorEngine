include "clouds2/cloudsShadowVolume.dshl"
include "clouds2/clouds_alt_fraction.dshl"
include "clouds2/clouds_bsm.dshl"

int clouds_disable_own_shadow = 0;
interval clouds_disable_own_shadow: no < 1, yes;
assume_if_not_assumed clouds_disable_own_shadow = no;

macro INIT_CLOUDS_SHADOW_BASE_COMMON(light_dir_x, light_dir_y, light_dir_z, code)
  (code) {
    world_pos_to_clouds_alt@f4 = (0.001/clouds_thickness2, -clouds_start_altitude2/clouds_thickness2,
      0.5 + clouds_origin_offset.x/clouds_weather_size, 0.5 + clouds_origin_offset.y/clouds_weather_size);
    clouds_weather_inv_size__alt_scale@f4 = (1/clouds_weather_size,
      light_dir_x*clouds_thickness2*-1000/max(0.02, light_dir_y),
      light_dir_z*clouds_thickness2*-1000/max(0.02, light_dir_y),
      0//1000*skies_planet_radius
      );
      //clouds_shadow_light_dir@f4 = (light_dir_x, light_dir_y, light_dir_z, 1000*1000*(clouds_start_altitude2 + skies_planet_radius)*(clouds_start_altitude2 + skies_planet_radius));
    clouds_hole_pos@f4 = clouds_hole_pos;
  }
endmacro

//the hole displaces the RENDERED clouds only when the project defines
//ALLOW_CLOUD_HOLE (see clouds_hole_pos.dshl); the hole finder still runs and
//publishes a nonzero position - adding it unconditionally shifts the shadows
//away from clouds that were never displaced
macro USE_CLOUDS_HOLE_SHADOW_UV(code)
  hlsl(code) {
    #ifndef CLOUDS_HOLE_SHADOW_UV
      #if ALLOW_CLOUD_HOLE
        #define CLOUDS_HOLE_SHADOW_UV clouds_hole_pos.zw
      #else
        #define CLOUDS_HOLE_SHADOW_UV float2(0, 0)
      #endif
    #endif
  }
endmacro

//volume-only transmittance: true 3D in-layer shadow structure, valid while the wrap
//content matches (within the cascade near radius); expanded by the ref path in the
//bsm-off variant and by the sky/godray path in both (shafts want in-layer structure)
macro CLOUDS_VOL_TRANSMITTANCE(code)
  USE_CLOUDS_HOLE_SHADOW_UV(code)
  hlsl(code) {
    half base_clouds_transmittance_vol(float3 worldPos)
    {
      #if DISABLE_CLOUDS_SHADOW
        return 1.0h;
      #else
        float alt = world_pos_to_clouds_alt.x*worldPos.y + world_pos_to_clouds_alt.y;
        worldPos.xz = clouds_weather_inv_size__alt_scale.yz*min(0, alt) + worldPos.xz;
        //that should be actually calculated with correct lighting attenuation and then blurred.
        //we can do that for 2d
        return half(getCloudsShadows3d(float3(worldPos.xz*clouds_weather_inv_size__alt_scale.x + world_pos_to_clouds_alt.zw + CLOUDS_HOLE_SHADOW_UV, max(0, alt))).x);
      #endif
    }
  }
endmacro

//reference shadow implementation: the Beer shadow map, valid at any receiver
//altitude - a mountain in clouds gets the correct partial-column shadow. The map
//REPLACES the wrap shadow volume for receivers (register-neutral: one texture
//swaps for one texture - big project shaders sit at the SM5 limits, and bindings
//often live in shared blocks where interval branching cannot follow the shader
//variant). A closed or never-baked map is simply not bound - the null texture
//reads zero, which decodes to unshadowed - so no on/off flag exists
macro INIT_CLOUDS_SHADOW_BASE_REF(light_dir_x, light_dir_y, light_dir_z, code)
  INIT_CLOUDS_SHADOW_BASE_COMMON(light_dir_x, light_dir_y, light_dir_z, code)
  INIT_CLOUDS_BSM(code)
endmacro

macro USE_CLOUDS_SHADOW_BASE_REF(code)
  hlsl(code) {
    #define INV_WEATHER_SIZE (clouds_weather_inv_size__alt_scale.x)
    #ifndef DISABLE_CLOUDS_SHADOW
      ##if clouds_disable_own_shadow == yes
        #define DISABLE_CLOUDS_SHADOW 1
      ##else
        #define DISABLE_CLOUDS_SHADOW 0
      ##endif
    #endif
  }
  USE_CLOUDS_BSM(code)
  hlsl(code) {
    half base_clouds_transmittance(float3 worldPos)
    {
      #if DISABLE_CLOUDS_SHADOW
        return 1.0h;
      #else
        //outside the map window the lookup falls back to the statistical mean (never
        //to the volume: its slant-displaced bottom slice wraps the tile at grazing
        //sun and decorrelates from the clouds actually overhead)
        return clouds_bsm_transmittance_soft(worldPos);
      #endif
    }
  }
  hlsl(code) {
    half clouds_shadow_from_extinction(half extinction)
    {
      #if DISABLE_CLOUDS_SHADOW
        return 1.0h;
      #else
        return clouds_bsm_shadow_curve(extinction);
      #endif
    }
    half clouds_shadow(float3 worldPos)
    {
      #if DISABLE_CLOUDS_SHADOW
        return 1.0h;
      #else
        return clouds_shadow_from_extinction(base_clouds_transmittance(worldPos));
      #endif
    }
  }
endmacro

//legacy 2D-map interface: the blurred ground-only 2D texture is replaced by the Beer
//shadow map, valid at any receiver altitude. Macro names and signatures are kept so
//project shaders that chose the 2D path keep compiling. The _TEX/_SMP pair keeps its
//contract too: the map is sampled through the caller-provided sampler and no BSM
//sampler is bound - the heavy receiver shaders that chose it (RT lighting) sit at
//the SM5 sampler limit
macro INIT_CLOUDS_SHADOW_BASE_2D(light_dir_x, light_dir_y, light_dir_z, code)
  INIT_CLOUDS_BSM(code)
endmacro

macro INIT_CLOUDS_SHADOW_BASE_2D_TEX(light_dir_x, light_dir_y, light_dir_z, code)
  INIT_CLOUDS_BSM_TEX(code)
endmacro

macro USE_CLOUDS_SHADOW_BASE_2D_SMP(code, smpl)
  USE_CLOUDS_BSM_SMP(code, smpl)
  hlsl(code) {
    #ifndef DISABLE_CLOUDS_SHADOW
      #define DISABLE_CLOUDS_SHADOW 0
    #endif
    half clouds_shadow(float3 worldPos)
    {
      #if DISABLE_CLOUDS_SHADOW
        return 1.0h;
      #else
        //the soft receiver footprint, same gate and ms curve as the ref path
        return get_clouds_shadow_soft(worldPos);
      #endif
    }
  }
endmacro

macro USE_CLOUDS_SHADOW_BASE_2D(code)
  USE_CLOUDS_SHADOW_BASE_2D_SMP(code, clouds_bsm_samplerstate)
endmacro

//kept for source compatibility: both paths are the ref one now
macro INIT_CLOUDS_SHADOW_BASE_AUTO(light_dir_x, light_dir_y, light_dir_z, code)
  INIT_CLOUDS_SHADOW_BASE_REF(light_dir_x, light_dir_y, light_dir_z, code)
endmacro

macro USE_CLOUDS_SHADOW_BASE_AUTO(code)
  USE_CLOUDS_SHADOW_BASE_REF(code)
endmacro

//by default use volume shadows, as they don't need any flags
float4 light_shadow_dir;

macro SKIP_INIT_CLOUDS_SHADOWS()
  DEFINE(skip_init_cloud_shadows)
endmacro
macro SKIP_USE_CLOUDS_SHADOWS()
  DEFINE(skip_use_cloud_shadows)
endmacro
macro SKIP_INIT_AND_USE_CLOUDS_SHADOWS()
  SKIP_INIT_CLOUDS_SHADOWS()
  SKIP_USE_CLOUDS_SHADOWS()
endmacro

macro INIT_CLOUDS_SHADOW_BASE(legacy_light_dir_y, code)
  if (!DEFINED(skip_init_cloud_shadows)){
    INIT_CLOUDS_SHADOW_BASE_REF(light_shadow_dir.x, light_shadow_dir.y, light_shadow_dir.z, code)
  }
endmacro
macro USE_CLOUDS_SHADOW_BASE(code)
  if (!DEFINED(skip_use_cloud_shadows)) {
    USE_CLOUDS_SHADOW_BASE_REF(code)
  }
endmacro
macro INIT_CLOUDS_SHADOW(legacy_light_dir_y)
  INIT_CLOUDS_SHADOW_BASE(legacy_light_dir_y, ps)
endmacro
macro USE_CLOUDS_SHADOW()
  USE_CLOUDS_SHADOW_BASE(ps)
endmacro
