  AllSrcFolder_ES += debug ;
}

SourceES = ;
AutoscanBuildLists $(AllSrcFolder_ES) : *ES.cpp.inl : SourceES ;

include $(Root)/prog/3rdPartyLibs/phys/setup-phys.jam ;

for s in $(SourceES) { GenESSourceFile $(s) ; }

include $(Root)/prog/_jBuild/build.jam ;

