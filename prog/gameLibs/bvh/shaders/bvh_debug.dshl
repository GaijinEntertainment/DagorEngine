include "shader_global.dshl"
include "bvh.dshl"
include "rt/rt_lighting.dshl"
include "tonemapHelpers/use_full_tonemap_lut_inc.dshl"
include "viewVecVS.dshl"
include "bvh_common_includes.dshl"
include "gbuffer.dshl"

texture bvh_debug_target;
texture bvh_postfx_source;

int bvh_debug_mode = 0;
int bvh_debug_use_atmosphere = 1;
float rtsm_sun_angle_multiplier = 0.5;

int rt_debug_rt_shadow = 1;
interval rt_debug_rt_shadow: off < 1, on;
int rt_debug_use_csm = 0;

float bvh_debug_intersection_count_threshold = 16.0;

float bvh_debug_min_t = 0;

int bvh_debug_back_view = 0;

int bvh_disable_ahs_with_omm = 0;

// Debug-only meta-index -> (RI LOD + 1) table, rebuilt on the CPU while the LOD view is active.
// 0 means "not a rendinst". Keeps LOD out of the production meta struct.
buffer bvh_debug_lod_by_meta;

shader bvh_debug
{
  if (compatibility_mode == compatibility_mode_on || !use_hw_raytracing)
  {
    dont_render;
  }
  supports global_const_block;

  (cs)
  {
    debug_target@uav = bvh_debug_target hlsl { RWTexture2D<float4> debug_target@uav; }
    world_view_pos@f3 = world_view_pos;
    bvh_debug_mode@i1 = bvh_debug_mode;
    bvh_debug_use_atmosphere@i1 = bvh_debug_use_atmosphere;
    sun_angle_multiplier@f1 = rtsm_sun_angle_multiplier;
    bvh_debug_intersection_count_threshold@f1 = bvh_debug_intersection_count_threshold;
    bvh_debug_min_t@f1 = bvh_debug_min_t;
    bvh_debug_back_view@i1 = bvh_debug_back_view;
    bvh_disable_ahs_with_omm@u1 = bvh_disable_ahs_with_omm;
    bvh_debug_lod_by_meta@buf = bvh_debug_lod_by_meta hlsl { StructuredBuffer<uint> bvh_debug_lod_by_meta@buf; }
  }

  if (hardware.pc)
  {
    (cs)
    {
      bvhLruCollision@tlas = bvh_lru_collision;
      bvhLruCollisionValid@u1 = bvh_lru_collision_valid;
    }
    INIT_BVH_LRU_COLLISION_NORMALS(cs)
    USE_BVH_LRU_COLLISION_NORMALS(cs)
  }

  hlsl (cs) {
    #include <NRD.hlsli>
    #include <render/debug_mesh.hlsli>

    #define BVH_DEBUG_MODE_LIT 0
    #define BVH_DEBUG_MODE_TEXTURE_COLOR 1
    #define BVH_DEBUG_MODE_WORLD_NORMAL 2
    #define BVH_DEBUG_MODE_TEXCOORD 3
    #define BVH_DEBUG_MODE_SEC_TEXCOORD 4
    #define BVH_DEBUG_MODE_CAMO_TEXCOORD 5
    #define BVH_DEBUG_MODE_VERTEX_COLOR 6
    #define BVH_DEBUG_MODE_GI 7
    #define BVH_DEBUG_MODE_PAINT 8
    #define BVH_DEBUG_MODE_INTERSECTION_COUNT 9
    #define BVH_DEBUG_MODE_INSTANCES 10
    #define BVH_DEBUG_MODE_NAN 11
    #define BVH_DEBUG_MODE_LOD 12
    #define BVH_DEBUG_MODE_LRU_COLLISION 13

    #define RAY_FLAG_FORCE_OMM_2_STATE_MANUAL 1
  }

  INIT_BVH(cs, 0, true)
  USE_BVH_FOR_DEBUG(cs)
  USE_BVH_FX_RENDER(cs)

  USE_EMISSION_DECODE_COLOR_MAP_STUB(cs)
  INIT_PACK_UNPACK_DYNSTCODE(cs)
  INIT_BVH_BINDLESS_GBUFFER(cs)
  USE_LOAD_GBUFFER_BASE(cs, false)

  USE_ADAPTIVE_RAY_OFFSET(cs)

  INIT_RT_LIGHTING(cs, false, true, true, rt_debug_rt_shadow == on, rt_debug_use_csm, false)
  USE_RT_LIGHTING(cs, 0, false)
  INIT_BVH_ATMOSPHERE(cs)
  USE_BVH_ATMOPHERE(cs)

  INIT_LOAD_BVH_FLAGS_BASE(cs)
  USE_LOAD_BVH_FLAGS_BASE(cs)

  INIT_VIEW_VEC_STAGE(cs)
  USE_VIEW_VEC_STAGE(cs)
  INIT_ZNZFAR_STAGE(cs)
  USE_LOAD_DEPTH_GBUFFER_BASE(cs)
  USE_CALC_GEOMETRY_NORMAL(cs)

  hlsl(cs)
  {
    bool trace_ray_safe(float3 origin, float3 direction, float tmin, float tmax, float bias, uint group, out HitInfo hitInfo, uint extra_flags = 0)
    {
      if (!bvhMainValid)
        return false;
      return trace_ray(bvhMain, origin, direction, tmin, tmax, bias, group, hitInfo, extra_flags);
    }

    float3 bvh_debug_ray_dir(float2 pixel, float2 resolution)
    {
      float2 rate = pixel / resolution;
      float3 topT = lerp(view_vecLT, view_vecRT, rate.x);
      float3 botT = lerp(view_vecLB, view_vecRB, rate.x);
      float3 direction = normalize(lerp(topT, botT, rate.y));
      if (bvh_debug_back_view)
      {
        // works as a vertical mirror facing the camera
        float3 forward = view_vecLT + view_vecRT + view_vecLB + view_vecRB;
        forward.y = 0;
        // near-vertical camera leaves the horizontal forward at zero: normalize
        // is NaN and the mirror plane undefined, so trace a fixed ray instead
        float forwardLenSq = dot(forward, forward);
        if (forwardLenSq > 1e-6f)
        {
          forward *= rsqrt(forwardLenSq);
          direction = reflect(direction, forward);
        }
        else
        {
          direction = float3(0, 1, 0);
        }
      }
      return direction;
    }

    RT_GROUP_SIZE
    void main(uint2 thread : SV_DispatchThreadID)
    {
      float2 resolution;
      debug_target.GetDimensions(resolution.x, resolution.y);

      float3 direction = bvh_debug_ray_dir(thread + 0.5, resolution);

      ##if hardware.pc
      BRANCH
      if (bvh_debug_mode == BVH_DEBUG_MODE_LRU_COLLISION)
      {
        float3 lruColor = 0;
        if (bvhLruCollisionValid)
        {
          // the pool holds the exact per-triangle normal: fetch it instead of
          // reconstructing from neighbor rays. Closest hit, not first hit: the
          // displayed normal must be stable
          const uint flags = RAY_FLAG_FORCE_OPAQUE | RAY_FLAG_SKIP_PROCEDURAL_PRIMITIVES;
          RayQuery<flags> query;

          RayDesc ray;
          ray.Origin    = 0;
          ray.Direction = direction;
          ray.TMin      = bvh_debug_min_t;
          ray.TMax      = 100000;

          query.TraceRayInline(bvhLruCollision, flags, 0xFF, ray);
          query.Proceed();
          if (query.CommittedStatus() == COMMITTED_TRIANGLE_HIT)
          {
            float3 normal = bvh_lru_collision_hit_normal(query.CommittedInstanceID(), query.CommittedPrimitiveIndex(),
              query.CommittedWorldToObject3x4(), direction);
            lruColor = normal * 0.5 + 0.5;
          }
        }
        debug_target[thread] = float4(lruColor, 1);
        return;
      }
      ##endif

      float3 result = 0;
      bool isHit = false;

      HitInfo hitInfo;
      if (trace_ray_safe(0, direction, bvh_debug_min_t, 100000, 0, bvhGroupRender, hitInfo, 0))
      {
        isHit = true;
        SurfaceParams hitSurface = calc_surface_params(hitInfo, -direction, 0);
        if (bvh_debug_mode == BVH_DEBUG_MODE_LIT || bvh_debug_mode == BVH_DEBUG_MODE_NAN)
        {
          result = light_hit_surface(hitSurface, -direction, hitInfo.t, 100000);
          if (bvh_debug_mode == BVH_DEBUG_MODE_NAN)
            result = select(isfinite(result), 1, 0);
        }
        else if (bvh_debug_mode == BVH_DEBUG_MODE_TEXTURE_COLOR)
        {
          result = hitSurface.albedo;
        }
        else if (bvh_debug_mode == BVH_DEBUG_MODE_WORLD_NORMAL)
        {
          result = hitSurface.normal * 0.5 + 0.5;
        }
        else if (bvh_debug_mode == BVH_DEBUG_MODE_TEXCOORD)
        {
          result = float3(hitInfo.texcoord, 0);
        }
        else if (bvh_debug_mode == BVH_DEBUG_MODE_SEC_TEXCOORD)
        {
          result = float3(hitInfo.secTexcoord, 0);
        }
        else if (bvh_debug_mode == BVH_DEBUG_MODE_CAMO_TEXCOORD)
        {
          if (hitInfo.isCamo)
            result = float3(get_camo_params(hitInfo).rg, 0);
        }
        else if (bvh_debug_mode == BVH_DEBUG_MODE_VERTEX_COLOR)
        {
          result = hitInfo.vertexColor;
        }
        else if (bvh_debug_mode == BVH_DEBUG_MODE_GI)
        {
          if (get_material_type(hitInfo.material) == bvhMaterialTerrain)
          {
            DetailDesc microdetailDesc;
            Vtex textures = sample_clipmaps(hitInfo.position + bvh_origin, 0, 0, microdetailDesc, 0);
            result = textures.diffuse.rgb;
          }
          else if (get_material_type(hitInfo.material) == bvhMaterialLandclass)
          {
            float2 texcoord = hitInfo.texcoord * hitInfo.materialData1.xy + hitInfo.materialData1.zw;
            float2 spoofedWorldPosXZ = texcoord * ri_landscape_tc_to_world.xy + ri_landscape_tc_to_world.zw;
            float3 tcWorldPos = float3(spoofedWorldPosXZ.x, hitInfo.position.y, spoofedWorldPosXZ.y);

            int indirectionOffset = 0; // TODO: This should be calculated via get_clipmap_indirection_offset_by_index

            DetailDesc microdetailDesc;
            Vtex textures = sample_clipmaps(tcWorldPos, 0, 0, microdetailDesc, indirectionOffset);

            // TODO: Due to lack of proper indirectionOffset, we return debug magenta color instead of sample_clipmaps
            result = float3(1.0, 0.0, 1.0);
          }
          else if (get_material_type(hitInfo.material) == bvhMaterialInterior)
          {
            result = 0.5.xxx;
          }
          else
            result = hitInfo.vertexColor;
        }
        else if (bvh_debug_mode == BVH_DEBUG_MODE_PAINT)
        {
          if (get_material_type(hitInfo.material) == bvhMaterialRendinst && !hitInfo.isLayered && hitInfo.albedoTextureIndex != 0xFFFF && has_material_painted(hitInfo.material))
            result = hitSurface.albedo;
        }
        ##if hardware.pc
        else if (bvh_debug_mode == BVH_DEBUG_MODE_INTERSECTION_COUNT)
        {
          const uint flags = RAY_FLAG_SKIP_PROCEDURAL_PRIMITIVES;

          GenericRayQuery(flags, TraceRayAHSLambda) query;

          RayDesc ray;
          ray.Origin    = 0;
          ray.Direction = direction;
          ray.TMin      = 0;
          ray.TMax      = 100000;

          query.TraceRayInline(bvhMain, flags, bvhGroupRender, ray);

          int counter = 0;
          while (query.Proceed())
            counter++;

          float heat = saturate(counter/bvh_debug_intersection_count_threshold);
          result = float3(sin(heat*(PI/2)), sin(heat*PI), cos(heat*(PI/2))) * luminance(hitSurface.albedo);
        }
        else if (bvh_debug_mode == BVH_DEBUG_MODE_INSTANCES)
        {
          const uint flags = RAY_FLAG_SKIP_PROCEDURAL_PRIMITIVES;

          GenericRayQuery(flags, TraceRayAHSLambda) query;

          RayDesc ray;
          ray.Origin    = 0;
          ray.Direction = direction;
          ray.TMin      = 0;
          ray.TMax      = 100000;

          query.TraceRayInline(bvhMain, flags, bvhGroupRender, ray);

          while (query.Proceed())
          {
            query.CommitNonOpaqueTriangleHit();
          }

          bool isHit = query.CommittedStatus() == COMMITTED_TRIANGLE_HIT;
          uint instanceIdx = query.CommittedInstanceID();

          // bit of hashing so that instanceID that are close do not take almost the same color
          instanceIdx = ((instanceIdx >> 16) ^ instanceIdx) * 0x45d9f3b;
          instanceIdx = ((instanceIdx >> 16) ^ instanceIdx) * 0x45d9f3b;
          instanceIdx = (instanceIdx >> 16) ^ instanceIdx;

          // just encode the first 24 bits as color
          result = isHit ? float3((instanceIdx >> 16) & 0xff, (instanceIdx >> 8) & 0xff, instanceIdx & 0xff) / 255.0 : float3(0,0,0);
        }
        else if (bvh_debug_mode == BVH_DEBUG_MODE_LOD)
        {
          const uint flags = RAY_FLAG_SKIP_PROCEDURAL_PRIMITIVES;

          GenericRayQuery(flags, TraceRayAHSLambda) query;

          RayDesc ray;
          ray.Origin    = 0;
          ray.Direction = direction;
          ray.TMin      = 0;
          ray.TMax      = 100000;

          query.TraceRayInline(bvhMain, flags, bvhGroupRender, ray);

          while (query.Proceed())
            query.CommitNonOpaqueTriangleHit();

          // InstanceID is the object's base meta slot, which is what the CPU side keyed the table by.
          // 0 in the table means "not a rendinst" -> stays black.
          if (query.CommittedStatus() == COMMITTED_TRIANGLE_HIT)
          {
            uint lodPlusOne = bvh_debug_lod_by_meta[query.CommittedInstanceID()];
            result = lodPlusOne == 0 ? float3(0, 0, 0)
             : debug_mesh_shade_lod(lodPlusOne - 1, hitSurface.albedo, hitSurface.normal, -from_sun_direction.xyz);
          }
        }
        ##endif
      }
      else
      {
        if (bvh_debug_mode == BVH_DEBUG_MODE_LIT)
        {
          result = texCUBElod(envi_probe_specular, float4(direction, 0)).rgb;
        }
        else if (bvh_debug_mode != BVH_DEBUG_MODE_LOD) // LOD view shows only RI; sky/miss stays black
        {
          result = float3(0, 0, 1);
        }
      }

      if (bvh_debug_mode == BVH_DEBUG_MODE_LIT)
      {
        BRANCH
        if (isHit && bvh_debug_use_atmosphere)
          calc_atmosphere(result, hitInfo.position, hitInfo.t);

        float translucentT;
        trace_ray_fx_translucent(0, direction, 0, hitInfo.t, 0, result, translucentT, 1.0);
      }
      else
        result = pow(result, 1/2.2);

      debug_target[thread] = float4(result, 1);
    }
  }

  compile("cs_6_5", "main");
}

shader bvh_debug_postfx
{
  if (compatibility_mode == compatibility_mode_on || !use_hw_raytracing)
  {
    dont_render;
  }

  INIT_HDR(cs)
  USE_HDR(cs)
  INIT_FULL_TONEMAP_LUT(cs)
  USE_FULL_TONEMAP_LUT(cs)

  (cs)
  {
    debug_target@uav = bvh_debug_target hlsl { RWTexture2D<float4> debug_target@uav; }
    postfx_source@tex2d = bvh_postfx_source;
  }

  hlsl(cs)
  {
    [numthreads(16, 16, 1)]
    void main(uint2 dtId : SV_DispatchThreadID)
    {
      float2 resolution;
      debug_target.GetDimensions(resolution.x, resolution.y);

      BRANCH
      if (all(dtId < resolution))
      {
        float3 linearSample = postfx_source[dtId].rgb;
        float3 exposureApplied = pack_hdr(linearSample);
        float3 toneMapped = performLUTTonemap(exposureApplied);
        debug_target[dtId] = float4(toneMapped, 1);
      }
    }
  }

  compile("cs_6_5", "main");
}

buffer bvh_probe_instances;
buffer bvh_probe_sink;

int bvh_probe_ray_count = 256;
float bvh_probe_tmax = 5;

int bvh_probe_tlas = 0;
interval bvh_probe_tlas: probe_main < 1, probe_terrain < 2, probe_particles;

shader bvh_tlas_probe
{
  if (compatibility_mode == compatibility_mode_on || !use_hw_raytracing || hardware.ps5 || hardware.metal)
  {
    dont_render;
  }

  (cs) { immediate_dword_count = 2; }

  (cs)
  {
    probe_ray_count@i1 = bvh_probe_ray_count;
    probe_tmax@f1 = bvh_probe_tmax;
    probe_instances@buf = bvh_probe_instances hlsl {
      #include <RTHWInstance.hlsli>
      StructuredBuffer<RTHWInstance> probe_instances@buf;
    };
    probe_sink@uav = bvh_probe_sink hlsl { RWByteAddressBuffer probe_sink@uav; };
  }

  INIT_BVH(cs, 0, true)

  hlsl(cs)
  {
    // same as USE_MAIN_BVH_RECONSTRUCTION with less included
    static const uint probeGroupMask = 0xff;

    // add dummy lambda to compile on scarlett
    struct ProbeAHSLambda AHSLambda
    {
      bool InlineAHSImpl(AHSArgs) { return true; }
      ##if hardware.scarlett
        void InlineAHS(inout XboxRayQueryProxy query) { query.CommitNonOpaqueTriangleHit(); }
      ##endif
    };

    float3 probe_direction(uint index, uint count)
    {
      float z = 1.0 - (2.0 * index + 1.0) / count;
      float r = sqrt(saturate(1.0 - z * z));
      float phi = index * 2.39996323;
      return float3(r * cos(phi), z, r * sin(phi));
    }

    RT_GROUP_SIZE
    void bvh_tlas_probe_cs(uint2 dtId : SV_DispatchThreadID)
    {
      ##if bvh_probe_tlas == probe_main
        if (!bvhMainValid)
          return;
        #define PROBE_TLAS bvhMain
      ##elif bvh_probe_tlas == probe_terrain
        if (!bvhTerrainValid)
          return;
        #define PROBE_TLAS bvhTerrain
      ##else
        if (!bvhParticlesValid)
          return;
        #define PROBE_TLAS bvhParticles
      ##endif

      uint instanceIndex = get_immediate_dword_0();
      uint rayPitch = get_immediate_dword_1();
      uint rayIndex = dtId.y * rayPitch + dtId.x;
      if (rayIndex >= uint(probe_ray_count))
        return;

      RTHWInstance instance = structuredBufferAt(probe_instances, instanceIndex);
      float3 origin = float3(instance.transform0.w, instance.transform1.w, instance.transform2.w);

      // No RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH, make sure we touch our BLAS
      const uint flags = RAY_FLAG_SKIP_PROCEDURAL_PRIMITIVES | RAY_FLAG_FORCE_OPAQUE;
      GenericRayQuery(flags, ProbeAHSLambda) query;

      RayDesc ray;
      ray.Origin = origin;
      ray.Direction = probe_direction(rayIndex, uint(probe_ray_count));
      ray.TMin = 0;
      ray.TMax = probe_tmax;

      query.TraceRayInline(PROBE_TLAS, flags, probeGroupMask, ray);
      ##if hardware.scarlett
        ProbeAHSLambda lambda;
        query.Proceed(lambda);
      ##else
        while (query.Proceed())
          query.CommitNonOpaqueTriangleHit();
      ##endif

      // Keeps the trace from being dead code eliminated.
      if (query.CommittedStatus() == COMMITTED_TRIANGLE_HIT)
        storeBuffer(probe_sink, 0, asuint(query.CommittedRayT()) ^ instanceIndex);
    }
  }

  compile("cs_6_5", "bvh_tlas_probe_cs");
}

buffer bvh_validate_instances;
buffer bvh_validate_live_blas;
buffer bvh_validate_pooled_blas;
buffer bvh_validate_report;

buffer bvh_validate_tail_counter;

int bvh_validate_instance_count;
int bvh_validate_live_blas_count;
int bvh_validate_pooled_blas_count;
int bvh_validate_max_reports = 64;
int bvh_validate_tail_region_index;
int bvh_validate_tail_region_start;
int bvh_validate_tail_region_count;

// Checks the instance descriptors the TLAS build is about to consume: every non-null BLAS address
// must be one of the addresses the context currently owns.
shader bvh_validate_tlas
{
  if (compatibility_mode == compatibility_mode_on || !use_hw_raytracing || hardware.ps5 || hardware.metal)
  {
    dont_render;
  }

  (cs)
  {
    validate_instance_count@i1 = bvh_validate_instance_count;
    validate_live_blas_count@i1 = bvh_validate_live_blas_count;
    validate_pooled_blas_count@i1 = bvh_validate_pooled_blas_count;
    validate_max_reports@i1 = bvh_validate_max_reports;
    validate_instances@buf = bvh_validate_instances hlsl {
      #include <RTHWInstance.hlsli>
      StructuredBuffer<RTHWInstance> validate_instances@buf;
    };
    validate_live_blas@buf = bvh_validate_live_blas hlsl { StructuredBuffer<uint2> validate_live_blas@buf; };
    validate_pooled_blas@buf = bvh_validate_pooled_blas hlsl { StructuredBuffer<uint2> validate_pooled_blas@buf; };
    validate_report@uav = bvh_validate_report hlsl { RWByteAddressBuffer validate_report@uav; };
  }

  hlsl(cs)
  {
    #include "bvh_validate_tlas.hlsli"

    void store_validate_report(RWByteAddressBuffer report, uint report_index, uint slot, uint kind, RTHWInstance instance,
      uint region_index)
    {
      uint at = (BVH_VALIDATE_REPORT_HEADER_DWORDS + report_index * BVH_VALIDATE_REPORT_DWORDS) * 4;
      storeBuffer(report, at + BVH_VALIDATE_REPORT_INSTANCE * 4, slot);
      storeBuffer(report, at + BVH_VALIDATE_REPORT_KIND * 4, kind);
      storeBuffer(report, at + BVH_VALIDATE_REPORT_BLAS_LO * 4, instance.blas.x);
      storeBuffer(report, at + BVH_VALIDATE_REPORT_BLAS_HI * 4, instance.blas.y);
      storeBuffer(report, at + BVH_VALIDATE_REPORT_INSTANCE_ID_MASK * 4, instance.instanceId_mask);
      storeBuffer(report, at + BVH_VALIDATE_REPORT_REGION * 4, region_index);
      storeBuffer(report, at + BVH_VALIDATE_REPORT_SEQUENCE * 4, report_index + 1);
    }

    bool find_blas(StructuredBuffer<uint2> addresses, int count, uint2 address)
    {
      int lo = 0;
      int hi = count - 1;
      while (lo <= hi)
      {
        int mid = (lo + hi) / 2;
        uint2 probe = structuredBufferAt(addresses, mid);
        if (probe.y == address.y && probe.x == address.x)
          return true;
        if (probe.y < address.y || (probe.y == address.y && probe.x < address.x))
          lo = mid + 1;
        else
          hi = mid - 1;
      }
      return false;
    }

    [numthreads(64, 1, 1)]
    void bvh_validate_tlas_cs(uint dtId : SV_DispatchThreadID)
    {
      if (dtId >= uint(validate_instance_count))
        return;

      RTHWInstance instance = structuredBufferAt(validate_instances, dtId);
      if (all(instance.blas == 0))
        return; // a zero AS address is a legal inactive instance

      bool badTransform = any(isnan(instance.transform0)) || any(isnan(instance.transform1)) || any(isnan(instance.transform2)) ||
                          any(abs(instance.transform0) > 1e9) || any(abs(instance.transform1) > 1e9) ||
                          any(abs(instance.transform2) > 1e9);

      // Classified here rather than on the CPU: the report is read back a frame or more later, by
      // which time the pools have handed entries out and taken others back.
      uint kind = 0;
      if (!find_blas(validate_live_blas, validate_live_blas_count, instance.blas))
        kind = find_blas(validate_pooled_blas, validate_pooled_blas_count, instance.blas) ? BVH_VALIDATE_POOLED_BLAS
                                                                                         : BVH_VALIDATE_DEAD_BLAS;
      else if (badTransform)
        kind = BVH_VALIDATE_BAD_TRANSFORM;

      if (kind == 0)
        return;

      uint reportIndex;
      validate_report.InterlockedAdd(0, 1, reportIndex);
      if (reportIndex >= uint(validate_max_reports))
        return;

      store_validate_report(validate_report, reportIndex, dtId, kind, instance, BVH_VALIDATE_NO_REGION);
    }
  }

  compile("target_cs", "bvh_validate_tlas_cs");
}

// The TLAS build consumes a GPU fed region at full capacity, so everything past the producer's live
// count must be zeroed. A non-zero BLAS address there is a stale descriptor turned into a live
// instance.
shader bvh_validate_tlas_tail
{
  if (compatibility_mode == compatibility_mode_on || !use_hw_raytracing || hardware.ps5 || hardware.metal)
  {
    dont_render;
  }

  (cs)
  {
    tail_region_index@i1 = bvh_validate_tail_region_index;
    tail_region_start@i1 = bvh_validate_tail_region_start;
    tail_region_count@i1 = bvh_validate_tail_region_count;
    validate_max_reports@i1 = bvh_validate_max_reports;
    validate_instances@buf = bvh_validate_instances hlsl {
      #include <RTHWInstance.hlsli>
      StructuredBuffer<RTHWInstance> validate_instances@buf;
    };
    tail_counter@buf = bvh_validate_tail_counter hlsl { ByteAddressBuffer tail_counter@buf; };
    validate_report@uav = bvh_validate_report hlsl { RWByteAddressBuffer validate_report@uav; };
  }

  hlsl(cs)
  {
    #include "bvh_validate_tlas.hlsli"

    void store_validate_report(RWByteAddressBuffer report, uint report_index, uint slot, uint kind, RTHWInstance instance,
      uint region_index)
    {
      uint at = (BVH_VALIDATE_REPORT_HEADER_DWORDS + report_index * BVH_VALIDATE_REPORT_DWORDS) * 4;
      storeBuffer(report, at + BVH_VALIDATE_REPORT_INSTANCE * 4, slot);
      storeBuffer(report, at + BVH_VALIDATE_REPORT_KIND * 4, kind);
      storeBuffer(report, at + BVH_VALIDATE_REPORT_BLAS_LO * 4, instance.blas.x);
      storeBuffer(report, at + BVH_VALIDATE_REPORT_BLAS_HI * 4, instance.blas.y);
      storeBuffer(report, at + BVH_VALIDATE_REPORT_INSTANCE_ID_MASK * 4, instance.instanceId_mask);
      storeBuffer(report, at + BVH_VALIDATE_REPORT_REGION * 4, region_index);
      storeBuffer(report, at + BVH_VALIDATE_REPORT_SEQUENCE * 4, report_index + 1);
    }

    [numthreads(64, 1, 1)]
    void bvh_validate_tlas_tail_cs(uint dtId : SV_DispatchThreadID)
    {
      if (dtId >= uint(tail_region_count) || dtId < loadBuffer(tail_counter, 0))
        return;

      uint slot = uint(tail_region_start) + dtId;
      RTHWInstance instance = structuredBufferAt(validate_instances, slot);
      if (all(instance.blas == 0))
        return;

      // Only the first stale slot of the region gets a record; the rest just bump its counter, so a
      // large tail cannot exhaust the record budget.
      uint stalePrev;
      validate_report.InterlockedAdd((BVH_VALIDATE_REGION_COUNTERS + uint(tail_region_index)) * 4, 1, stalePrev);
      if (stalePrev != 0)
        return;

      uint reportIndex;
      validate_report.InterlockedAdd(0, 1, reportIndex);
      if (reportIndex >= uint(validate_max_reports))
        return;

      store_validate_report(validate_report, reportIndex, slot, BVH_VALIDATE_STALE_TAIL, instance, uint(tail_region_index));
    }
  }

  compile("target_cs", "bvh_validate_tlas_tail_cs");
}
