Root    ?= ../../../.. ;
local LibPath = gameLibs/daCSG/das ;
Location = prog/$(LibPath) ;
Target      = $(LibPath).lib ;
StrictCompile = yes ;
TargetType  = lib ;

include $(Root)/prog/_jBuild/defaults.jam ;
include $(Root)/prog/gameLibs/daCSG/daCSG-options.jam ;

AddIncludes +=
  $(Root)/prog/1stPartyLibs/daScript/include
;

Sources =
  csgModule.cpp
;

StringifySourceFile csg.das : csg.das.inl : csgModule.cpp ;

UseProgLibs =
  gameLibs/daCSG
  1stPartyLibs/daScript
;

include $(Root)/prog/_jBuild/build.jam ;
