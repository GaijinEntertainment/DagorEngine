Root    ?= ../../../.. ;
local LibPath = gameLibs/textureGen/das ;
Location = prog/$(LibPath) ;
Target      = $(LibPath).lib ;
StrictCompile = yes ;
TargetType  = lib ;

include $(Root)/prog/_jBuild/defaults.jam ;

AddIncludes +=
  $(Root)/prog
  $(Root)/prog/1stPartyLibs/daScript/include
;

Sources =
  texgenModule.cpp
  texgenScriptHost.cpp
;

StringifySourceFile texgen.das : texgen.das.inl : texgenModule.cpp ;
StringifySourceFile ../../../1stPartyLibs/daScript/daslib/builtin.das : builtin.das.inl : texgenScriptHost.cpp : --array ;

UseProgLibs =
  gameLibs/textureGen/graph
  1stPartyLibs/daScript
;

include $(Root)/prog/_jBuild/build.jam ;
