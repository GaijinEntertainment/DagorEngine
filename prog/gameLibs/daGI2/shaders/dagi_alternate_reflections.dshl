include "world_sdf.dshl"
include "dagi_lit_scene_helper.dshl"
include "dagi_media_scene_common.dshl"
include "dagi_quality.dshl"

macro GET_TRANSLUCENT_ALTERNATE_REFLECTIONS(code)
  if (gi_quality >= colored)
  {
    (code) {
      dagi_media_scene@tex3d = dagi_media_scene;
    }
    hlsl(code) {
      #define dagi_media_scene_samplerstate world_sdf_clipmap_samplerstate
    }
    DAGI_MEDIA_SCENE_SAMPLE_ON_NO_SRV(code)
    hlsl(code) {
      #define TRANSLUCENT_ALTERNATE_REFLECTIONS 1
      half4 get_translucent_alternate_reflections(float3 cameraToPoint, float3 rayDir, float dist)
      {
        return dagi_trace_media_scene(cameraToPoint*0.98 + world_view_pos.xyz, rayDir, dist);
      }
    }
  } else
  {
    hlsl(code) {
      half4 get_translucent_alternate_reflections(float3 cameraToPoint, float3 rayDir, float dist) {return 0;}
    }
  }
endmacro

macro DAGI_ALTERNATE_REFLECTIONS_SDF_TRACE(code)
  WORLD_SDF_STEP_OUT(code)
  hlsl(code) {
    #include <interleavedGradientNoise.hlsl>
    bool dagi_alternate_reflections_trace(uint2 pixelPos, float3 rayDir, float3 cameraToPoint, float3 normal, float maxT, bool start_on_ray,
      bool start_off_surface, out float t, out float3 worldPos, out float3 hitNorm)
    {
      float3 origin = cameraToPoint + world_view_pos.xyz;
      if (!start_on_ray)
      {
        float len = length(cameraToPoint);
        origin = cameraToPoint*0.98 + world_view_pos.xyz + rayDir*max(0.01, len*0.02)*interleavedGradientNoiseFramed(pixelPos.xy, uint(SSRParams.z));
      }
      if (!start_off_surface)
      {
        uint startClip = world_sdf_find_clip(origin);
        float sdfVoxelSize = startClip < MAX_WORLD_SDF_CLIPS ? world_sdf_voxel_size(startClip) : 1;
        origin += normal*0.25*sdfVoxelSize;
        world_sdf_step_out_clip(origin, startClip, 0.0, 0.5);
      }
      t = maxT;
      uint cascade;
      if (!world_sdf_trace(origin, rayDir, maxT, t, cascade, 1, true, start_off_surface))
        return false;
      worldPos = origin + rayDir*t;
      float3 gradient = world_sdf_sample_gradient(cascade, worldPos);
      float gradLen = length(gradient);
      hitNorm = gradLen > 0 ? -gradient.xzy/gradLen : -rayDir;
      return true;
    }
  }
endmacro

// a project with its own reflection trace defines this first, with the same function, and can fall back to the SDF one
define_macro_if_not_defined DAGI_ALTERNATE_REFLECTIONS_TRACE(code)
  DAGI_ALTERNATE_REFLECTIONS_SDF_TRACE(code)
endmacro

macro GET_ALTERNATE_REFLECTIONS(code)
  bool has_dagi_alternate_reflections = gi_quality >= colored;
  if (has_dagi_alternate_reflections)
  {
    READ_WORLD_SDF(code)
    DAGI_ALTERNATE_REFLECTIONS_TRACE(code)
    PROJECT_GET_WORLD_RADIANCE_AT(code)

    hlsl(code) {
      #define ALTERNATE_REFLECTIONS 1
      //opaque only
      void get_alternate_reflections_with_hit(inout half4 newTarget, inout float rayHitDist, out float3 rayHitPos, out float3 rayHitNorm, uint2 pixelPos, float3 rayDir, float3 cameraToPoint, float3 normal, bool hit, bool hit_not_zfar, float max_dist = 200, bool start_on_ray = false, bool start_off_surface = false)
      {
        float maxT = max_dist;
        rayHitDist = maxT;
        rayHitPos = cameraToPoint + rayDir*maxT;
        rayHitNorm = -rayDir;
        BRANCH
        if (!hit)
        {
          float t;
          float3 worldPos, hitNorm;
          if (dagi_alternate_reflections_trace(pixelPos, rayDir, cameraToPoint, normal, maxT, start_on_ray, start_off_surface, t, worldPos, hitNorm))
          {
            rayHitDist = t;
            rayHitPos = worldPos - world_view_pos.xyz;
            rayHitNorm = hitNorm;

            float3 radiance;
            if (!dagi_surface_cache_voxel_sample(worldPos, radiance))
              radiance = dagi_get_radiance_at(worldPos, hitNorm, float4(-rayDir, t));
            newTarget.rgb = radiance;
            newTarget.a = 1;
          } else
          {
            newTarget = 0;
            rayHitDist = maxT;
          }
        }
      }
      void get_alternate_reflections(inout half4 newTarget, inout float rayHitDist, uint2 pixelPos, float3 rayDir, float3 cameraToPoint, float3 normal, bool hit, bool hit_not_zfar, float max_dist = 200, bool start_on_ray = false, bool start_off_surface = false)
      {
        float3 rayHitPos, rayHitNorm;
        get_alternate_reflections_with_hit(newTarget, rayHitDist, rayHitPos, rayHitNorm, pixelPos, rayDir, cameraToPoint, normal, hit, hit_not_zfar, max_dist, start_on_ray, start_off_surface);
      }
    }
  }
  else
  {
    hlsl(code) {
      void get_alternate_reflections_with_hit(inout half4 newTarget, inout float rayHitDist, out float3 rayHitPos, out float3 rayHitNorm, uint2 pixelPos, float3 rayDir, float3 cameraToPoint, float3 normal, bool hit, bool hit_not_zfar, float max_dist = 200, bool start_on_ray = false, bool start_off_surface = false)
      {
        rayHitPos = cameraToPoint;
        rayHitNorm = -rayDir;
      }
      void get_alternate_reflections(inout half4 newTarget, inout float rayHitDist, uint2 pixelPos, float3 rayDir, float3 cameraToPoint, float3 normal, bool hit, bool hit_not_zfar, float max_dist = 200, bool start_on_ray = false, bool start_off_surface = false){}
    }
  }
endmacro
