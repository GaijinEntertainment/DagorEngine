include "project_trace.dshl"

// contract: a miss shades as the caller's fallback (radiance grid tail or sky).
// probes inside geometry must stay occluded: a single sheet world (collision
// proxies, testGI) hits back faces, a render mesh world models interior surfaces
// and may cull them. terrain is one sided, rays pass through the heightfield
// from below. hitNormal faces the ray origin
define_macro_if_not_defined PROJECT_TRACE(code, supports_raygen)
  bool dagi_project_use_rt = false;
  bool dagi_project_use_raygen = false;
  hlsl (code) {
    #define DAGI_PROJECT_TRACE_HAS_RADIANCE 0
    #define DAGI_PROJECT_TRACE_HAS_ALBEDO 0
    #define DAGI_HAS_PROJECT_TRACE 0
    struct DaGiProjectHitRes
    {
      float3 hitCamPos, hitNormal;
      float3 hitAlbedo, hitRadiance;
      float hitAt; bool hasRadiance;
    };
    bool dagi_project_trace_surface(float3 rel_from, float3 origin, float3 world_dir, float maxT, DaGiProjectHitRes hit){return false;}
  }
endmacro
