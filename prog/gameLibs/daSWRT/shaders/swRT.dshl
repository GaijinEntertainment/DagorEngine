
hlsl {
  #define LIMIT_AT_END 1
}
macro CONFIGURE_SW_RT(code)
  hlsl(code) {
    #define USE_BOX_HALVES 1
  }
endmacro

include "shader_global.dshl"
include "viewVecVS.dshl"
include "swBVH.dshl"
include "globtm.dshl"
include "project_swrt_shadows_step.dshl"
include "gbuffer.dshl"
include "halfres_close_depth_with_normals.dshl"

texture blue_noise_tex;

//todo: make hierarchial reduce.
// in first step find start ofs for tile of size 4*4 tiles, if possible (with just sampling farDepth)
texture combined_shadows;

buffer swrt_shadow_mask;
texture swrt_shadow_target;
int swrt_checkerboard_frame;
int swrt_frame_no; // real frame counter for the soft-sun jitter; distinct from checkerboard parity
float4 swrt_shadow_sun_step = (0.001, 0.00001, 0, 0); // metres + metres per camera metre, off the receiver's surface
float4 swrt_shadow_ray[2]; // hard shadows: [0] to-sun direction, [1] its reciprocal
float swrt_box_dist_ref = 0; // metres, 0 = off
interval swrt_box_dist_ref: off<0.000001, on;
float swrt_blas_leaf_skip_dist = -1; // metres, < 0 = no leaf boxes: leaf boxes nearer to the receiver do not cast
interval swrt_blas_leaf_skip_dist: off<0, on;
int4 swrt_shadow_target_size;
float4 swrt_shadow_tc_size = (1, 1, 0, 0); // half the full-res size, fractional at an odd height: the uv of half-res texel p is (p + 0.5) / it
buffer swrt_shadow_checkerboard;
float4 swrt_dir_to_sun_and_angle = (0.7071067811865476, 0.7071067811865476, 0, 0.0093 / 4);
// daSWRT::ShadowCasterReach: csm distance, csm reach, static distance, static top height (0 distance = off); static depth
float4 swrt_caster_reach;
float swrt_caster_static_depth = 10000;


define_macro_if_not_defined PROJECT_STEP_SWRT_SHADOW_OFFSET(code)
(code) {
  swrt_caster_reach@f4 = swrt_caster_reach;
  swrt_caster_static_depth@f1 = swrt_caster_static_depth;
}
hlsl (code) {
  // each reach fades out over the last 10% of its distance; the CSM covers a view depth, the static map a box
  // that the camera distance bounds
  float swrt_caster_reach_at(float view_depth, float camera_dist, float height)
  {
    float csmReach = swrt_caster_reach.y*saturate(10 - 10*view_depth*rcp(swrt_caster_reach.x));
    float staticReach = clamp((swrt_caster_reach.w - height)*rcp(max(swrt_dir_to_sun_basis[2].y, 0.001)), 0,
      max(swrt_caster_static_depth - camera_dist, 0));
    return max(csmReach, staticReach*saturate(10 - 10*camera_dist*rcp(swrt_caster_reach.z)));
  }
  float get_project_defined_swrt_shadow_offset_point(float3 cameraPos, float3 worldPos)
  {
    return swrt_caster_reach_at(mulPointTm(worldPos, globtm).w, length(cameraPos), worldPos.y);
  }
  // the farthest corner and the top get the least reach of the box
  float get_project_defined_swrt_shadow_offset_box(float3 worldPosBmin, float3 worldPosBmax)
  {
    float farDist = length(max(abs(worldPosBmin - swrt_world_view_pos), abs(worldPosBmax - swrt_world_view_pos)));
    return swrt_caster_reach_at(farDist, farDist, worldPosBmax.y);
  }
}
endmacro

shader draw_collision_swrt
{
  CONFIGURE_SW_RT(ps)

  supports none;
  supports global_frame;

  cull_mode  = none;


  DECL_POSTFX_TC_VS_SCR()

  USE_AND_INIT_VIEW_VEC_VS()
  hlsl {
    #define ALWAYS_PROCESS_QUAD 1
    #define BACKFACE_CULLING 1
  }

  (ps) {swrt_world_view_pos@f3 = world_view_pos;}
  SW_BVH_BLAS_BOXES_ONLY_VARIANT(ps)
  INIT_SW_BVH_RAYTRACING(ps)
  USE_SW_BVH_RAYTRACING(ps)
  INIT_AND_USE_GLOBTM(ps)
  INIT_HDR(ps)
  USE_HDR(ps)

  hlsl {
    struct VsOutput
    {
      VS_OUT_POSITION(pos)
      float2 tc : TEXCOORD0;
      float3 viewVect:TEXCOORD1;
    };
  }

  hlsl(vs) {
    VsOutput antialiasing_vs(uint vertexId : SV_VertexID)
    {
      VsOutput output;
      //float2 inpos = input.pos.xy;
      float2 inpos = get_fullscreen_inpos(vertexId);

      output.pos = float4(inpos,0,1);
      output.tc = inpos * RT_SCALE_HALF + float2(0.50000, 0.50000);
      output.viewVect = get_view_vec_by_vertex_id(vertexId);

      return output;
    }
  }


  hlsl(ps) {
    half4 xray_lighting(float3 point_to_eye, float4 hatching_color, float3 world_normal)
    {
      float4 hatching_type = float4(0.5,1,0,0);
      float fresnel = saturate(1 - abs(dot(world_normal, normalize(point_to_eye).xyz)));
      fresnel = saturate(lerp(hatching_type.y, hatching_type.z, pow4(fresnel)) + hatching_type.x * world_normal.y);
      float4 hatching_fresnel = hatching_color*0.5;
      half4 colorRet = lerp(hatching_color, hatching_fresnel, fresnel);
      return half4(colorRet.rgb, hatching_color.a);
    }

    struct Output
    {
      float3 color : SV_Target;
      float depth : SV_Depth;
    };
    Output antialiasing_ps(VsOutput input)
    {
      // return float4(1, 0, 0, 1);
      Output o = (Output)0;
      float3 rayDir = normalize(input.viewVect);
      float t;float3 triNorm;float2 bCoord = 0;
      int complexity = 0;
      if (rayTLAS(swrt_world_view_pos, rayDir, rcp(rayDir), 1e10, t, triNorm, bCoord, complexity))
      {
        float4 imagePos = mulPointTm(swrt_world_view_pos + rayDir*t, globtm);
        o.depth = imagePos.z/imagePos.w;
        o.color = pack_hdr(xray_lighting(rayDir, 0.5, triNorm).rgb);//*exp(-0.01*t);//return complexity/100.0;
        o.color = pack_hdr(triNorm*0.5 + 0.5);
        #if 0
        uint blasComplex = complexity&0xffff, tlasComplex = complexity>>16;
        complexity = blasComplex;
        if (complexity > 0 && 0)
        {
          #define N 5
          float3 colors[N] = {float3(0,0,1), float3(0,1,0), float3(1,1,0), float3(2,0,0), float3(1,0,1)};
          float log10 = log2(complexity)/log2(2);
          o.color = pack_hdr(lerp(colors[int(log10)], colors[min(N - 1, int(log10) + 1)], frac(log10)));
        }
        #endif
        // float r = saturate(complexity / 1000.0);
        // return float4(r, r, r, 1);
      } else
      {
        discard;
        /*uint blasComplex = complexity&0xffff, tlasComplex = complexity>>16;
        if (tlasComplex > 2 && 0)
        {
          float3 colors[N] = {float3(0,0,1), float3(0,1,0), float3(1,1,0), float3(2,0,0), float3(1,0,1)};
          float log10 = log2(complexity)/log2(2);
          o.color = pack_hdr(lerp(colors[int(log10)], colors[min(N - 1, int(log10) + 1)], frac(log10)));
          o.depth = 1;
          return o;
        }*/
      }
      return o;
    }
  }


  compile("target_ps", "antialiasing_ps");
  compile("target_vs", "antialiasing_vs");
}

float4 swrt_dir_to_sun_basis[3];
float4 swrt_shadow_planes[4];
int swrt_tile_16 = 0;
interval swrt_tile_16: off<1, on; // one tile per quarter rate thread group
shader mask_shadow_swrt_cs
{
  CONFIGURE_SW_RT(cs)

  supports none;
  supports global_frame;

  (cs) {swrt_world_view_pos@f3 = world_view_pos;}
  hlsl(cs)
  {
    #define SWRT_USE_CONSTANT_PLANES swrt_shadow_planes
  }
  INIT_SW_BVH_RAYTRACING(cs)
  USE_SW_BVH_RAYTRACING(cs)
  INIT_AND_USE_GLOBTM(cs)
  VIEW_VEC_OPTIMIZED(cs)
  //INIT_LOAD_DEPTH_GBUFFER_BASE(cs)
  //USE_LOAD_DEPTH_GBUFFER_BASE(cs)
  INIT_HALF_RES_CLOSE_DEPTH(cs)

  INIT_ZNZFAR_STAGE(cs)
  USE_DECODE_DEPTH_STAGE(cs)
  PROJECT_STEP_SWRT_SHADOW_OFFSET(cs)
  local float4 tile_mip_dim = get_dimensions(downsampled_close_depth_tex, 3);
  (cs) {
    downsampled_far_depth_tex@tex2d = downsampled_far_depth_tex;
    swrt_shadow_planes@f4[] = swrt_shadow_planes;
    target_size@i4 = swrt_shadow_target_size;
    inv_target_size@f4 = (1./swrt_shadow_tc_size.x, 1./swrt_shadow_tc_size.y, 0.5/swrt_shadow_tc_size.x, 0.5/swrt_shadow_tc_size.y);
    swrt_tile_mip_max@f2 = (tile_mip_dim.x - 1, tile_mip_dim.y - 1);
    swrt_shadow_mask@uav = swrt_shadow_mask hlsl { RWByteAddressBuffer swrt_shadow_mask@uav;}
    swrt_dir_to_sun_basis@f4[] = swrt_dir_to_sun_basis;
    //swrt_shadow_target@uav = swrt_shadow_target hlsl { RWTexture2D<float> swrt_shadow_target@uav;}
  }

  //local float len = max(0.000000001, sqrt(from_sun_direction.x*from_sun_direction.x + from_sun_direction.z*from_sun_direction.z));
  (cs) {
    //to_sun_direction@f3 = -from_sun_direction;
    //inv_to_sun_direction@f3 = (-1./from_sun_direction.x, -1./from_sun_direction.y, -1./from_sun_direction.z, 0);
    //to_sun_light_dir_xz@f2 = (-from_sun_direction.x/len, -from_sun_direction.z/len,0,0);
  }

  hlsl(cs) {
    #if SWRT_TILE_MIP != 3
      #error "swrt_tile_mip_max preshader value uses a hardcoded mip 3 that *must* match SWRT_TILE_MIP"
    #endif
##if swrt_tile_16 == on
    #define SWRT_MASK_TILE 16
##else
    #define SWRT_MASK_TILE SWRT_TILE_SIZE
##endif
    #define SWRT_MASK_SUB (SWRT_MASK_TILE/SWRT_TILE_SIZE)
    void tile_raw_depth(uint2 tile, out float max_raw, out float min_raw)
    {
      max_raw = 0;
      min_raw = 1;
      UNROLL
      for (uint i = 0; i < SWRT_MASK_SUB*SWRT_MASK_SUB; ++i)
      {
        uint2 tc = min(tile*SWRT_MASK_SUB + uint2(i % SWRT_MASK_SUB, i / SWRT_MASK_SUB), uint2(swrt_tile_mip_max));
        max_raw = max(max_raw, texelFetch(half_res_close_depth, tc, SWRT_TILE_MIP).x);
        min_raw = min(min_raw, texelFetch(downsampled_far_depth_tex, tc, SWRT_TILE_MIP).x);
      }
    }
    void get_bbox(float2 uv0, float2 uv1, float df, float dn, out float3 bmin, out float3 bmax)
    {
      float3 vmin = min(min(getViewVecOptimized(float2(uv0.x, uv0.y)), getViewVecOptimized(float2(uv1.x, uv0.y))),
                        min(getViewVecOptimized(float2(uv0.x, uv1.y)), getViewVecOptimized(float2(uv1.x, uv1.y))));
      float3 vmax = max(max(getViewVecOptimized(float2(uv0.x, uv0.y)), getViewVecOptimized(float2(uv1.x, uv0.y))),
                        max(getViewVecOptimized(float2(uv0.x, uv1.y)), getViewVecOptimized(float2(uv1.x, uv1.y))));
      bmin = min(min(vmin*dn, vmin*df), min(vmax*dn, vmax*df)) + swrt_world_view_pos,
      bmax = max(max(vmin*dn, vmin*df), max(vmax*dn, vmax*df)) + swrt_world_view_pos;
      float offset = get_project_defined_swrt_shadow_offset_box(bmin, bmax);
      // the penumbra planes lean out by the sun cone, so a ray that starts farther along can leave the moved box
      float grow = offset*swrt_dir_to_sun_basis[0].w;
      bmin += offset*swrt_dir_to_sun_basis[2].xyz - grow;
      bmax += offset*swrt_dir_to_sun_basis[2].xyz + grow;
    }
    float minPlaneDist(float3 normal, float3 bmin, float3 bmax)
    {
      return min(min(min(dot(normal, bmin), dot(normal, bmax)),
                     min(dot(normal, float3(bmin.xy, bmax.z)), dot(normal, float3(bmin.x, bmax.yz)))),
                 min(min(dot(normal, float3(bmin.x, bmax.y, bmin.z)), dot(normal, float3(bmax.x, bmin.yz))),
                     min(dot(normal, float3(bmax.x, bmin.y, bmax.z)), dot(normal, float3(bmax.xy, bmin.z)))));
    }
    void storeResult(uint2 at, uint walk, uint leafOfs)
    {
      uint address = at.x + at.y*((uint(target_size.z)+SWRT_MASK_TILE)/SWRT_MASK_TILE);
      storeBuffer(swrt_shadow_mask, (address*2 + walk)*4, leafOfs);
    }
    [numthreads(SWRT_TILE_SIZE, SWRT_TILE_SIZE, 2)]
    void calc_trace_shadows_cs(uint3 dispatchId : SV_DispatchThreadID)
    {
      // return float4(1, 0, 0, 1);
      uint2 dtId = dispatchId.xy;
      uint walk = dispatchId.z;
      uint2 start = SWRT_MASK_TILE*dtId;
      if (any(start > target_size.zw))
        return;
      float maxRawDepth, minRawDepth;
      tile_raw_depth(dtId, maxRawDepth, minRawDepth);
      if (maxRawDepth == 0)
      {
        storeResult(dtId, walk, 0);
        return;
      }
      float2 uv = start*inv_target_size.xy;
      BRANCH
      if (minRawDepth == 0)
      {
        // this is slightly unoptimal, as we'd better find it recursively
        float4 minRawDepth4 = 2;
        for (uint i = 0; i < (SWRT_MASK_TILE/2)*(SWRT_MASK_TILE/2); ++i)
        {
          float2 uv0 = uv + inv_target_size.xy*(2*uint2(i%(SWRT_MASK_TILE/2),i/(SWRT_MASK_TILE/2)));
          half4 rawDepth = half_res_close_depth.GatherRed(half_res_close_depth_samplerstate, uv0 + inv_target_size.xy);
          //this one is not, since it is build for rawDepth == 0 as well
          minRawDepth4 = select(rawDepth != 0, min(minRawDepth4, rawDepth), minRawDepth4);
        }
        minRawDepth = min(min(minRawDepth4.x, minRawDepth4.y), min(minRawDepth4.z, minRawDepth4.w));
        if (minRawDepth > maxRawDepth)
        {
          storeResult(dtId, walk, 0);
          return;
        }
      }
      float closeDepth = linearize_z(maxRawDepth, zn_zfar.zw), farDepth = linearize_z(minRawDepth, zn_zfar.zw);

      float2 uv1 = min(uv + SWRT_MASK_TILE*inv_target_size.xy, 1);
      float3 bmin, bmax;
      get_bbox(uv, uv1, closeDepth, farDepth, bmin, bmax);
      //4 first planes are stored transposed to save VGPR
      float4x4 frustum = {swrt_shadow_planes[0], swrt_shadow_planes[1], swrt_shadow_planes[2], float4(0,0,0,0)};
      float4x4 planes = transpose(frustum);
      frustum[3] = -float4(minPlaneDist(planes[0].xyz, bmin, bmax),
                           minPlaneDist(planes[1].xyz, bmin, bmax),
                           minPlaneDist(planes[2].xyz, bmin, bmax),
                           minPlaneDist(planes[3].xyz, bmin, bmax));
      float4 plane4 = float4(swrt_shadow_planes[3].xyz, -minPlaneDist(swrt_shadow_planes[3].xyz, bmin, bmax));

      //2. traverse tlas for frustum check, and check tlas leaves visibility
      uint ofs = 0;
      BRANCH
      if (walk)
        ofs = findLastLeafInFrustum(frustum, plane4);
      else
        isSomethingInFrustum(frustum, plane4, ofs);
      storeResult(dtId, walk, ofs);
    }
  }

  compile("target_cs", "calc_trace_shadows_cs");
}

include "bvh.dshl"
int swrt_use_hw_rt = 0;
interval swrt_use_hw_rt:off<1, on;

macro COMMON_SWRT_SHADOW(code)
  CONFIGURE_SW_RT(code)

  hlsl(code) {
    #define BVH_TLAS_BOX_OUTSIDE_ONLY 1
  }
  INIT_SW_BVH_RAYTRACING(code)
  USE_SW_BVH_RAYTRACING(code)
  INIT_AND_USE_GLOBTM(code)
  VIEW_VEC_OPTIMIZED(code)
  hlsl(code) {
    float3 lerp_view_vec(float2 tc)
    {
      return getViewVecOptimized(tc);
    }
  }
  //INIT_LOAD_DEPTH_GBUFFER_BASE(cs)
  //USE_LOAD_DEPTH_GBUFFER_BASE(cs)
  //INIT_READ_DEPTH_GBUFFER_BASE(cs)
  //USE_READ_DEPTH_GBUFFER_BASE(cs)
  INIT_HALF_RES_CLOSE_DEPTH(code)
  INIT_HALF_RES_CLOSE_DEPTH_NORMALS(code)
  PROJECT_STEP_SWRT_SHADOW_OFFSET(code)
  //INIT_BLUE_NOISE(code)
  //USE_BLUE_NOISE(code)
  if (swrt_use_hw_rt == on)
  {
    hlsl (code) {
      #define TRACE_RAY_EXTRA_FLAGS RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH
      #define HW_RT_SHADOWS 1
    }

    INIT_BVH(code, 1, true)
    USE_BVH_FOR_SHADOW(code, false)
    USE_ADAPTIVE_RAY_OFFSET(code)
  }

  INIT_ZNZFAR_STAGE(code)
  local float4 src_dim = get_dimensions(downsampled_close_depth_tex, 0);
  (code) {
    swrt_dir_to_sun_basis@f4[] = swrt_dir_to_sun_basis;
    combined_shadows@smp2d = combined_shadows;
    target_size@i4 = swrt_shadow_target_size;
    swrt_src_pixel_max@f2 = (src_dim.x - 1, src_dim.y - 1);
    swrt_shadow_sun_step@f2 = swrt_shadow_sun_step;
    inv_target_size@f4 = (1./swrt_shadow_tc_size.x, 1./swrt_shadow_tc_size.y, 0.5/swrt_shadow_tc_size.x, 0.5/swrt_shadow_tc_size.y);
    //swrt_shadow_target@uav = swrt_shadow_target hlsl { RWTexture2D<float> swrt_shadow_target@uav;}
    //to_sun_direction@f3 = -from_sun_direction;
    //inv_to_sun_direction@f3 = (-1./from_sun_direction.x, -1./from_sun_direction.y, -1./from_sun_direction.z, 0);
    swrt_shadow_mask@buf = swrt_shadow_mask hlsl { ByteAddressBuffer swrt_shadow_mask@buf;}
    swrt_checkerboard_frame@i1 = swrt_checkerboard_frame;
  }
  // the quarter target has no temporal filter of its own to integrate a penumbra jitter
  if (shader == quarter_shadows_swrt_cs)
  {
    (code) { swrt_shadow_ray@f4[] = swrt_shadow_ray; }
  }
  else
  {
    (code) {
      blue_noise_tex@tex2d = blue_noise_tex;
      swrt_frame_no@i1 = swrt_frame_no;
    }
    hlsl(code) {
      float2 sampleRandomVector2D(uint2 pixel, uint frame_index)
      {
        float2 E = texture2DAt(blue_noise_tex, pixel % 128).xy;
        #define R2_STEPS float2(0.7548776662, 0.5698402910)
        return frac(E + (frame_index & 0xFFu) * R2_STEPS);
      }
      #include <monteCarlo.hlsl>

      float3 get_sun_direction(uint2 pixel_pos)
      {
        // Jitter from the real frame counter, not swrt_checkerboard_frame (which is 0 in non-checkerboard mode),
        // so the soft sun disk integrates over time in both modes.
        float2 disk = swrt_dir_to_sun_basis[0].w*uniform_sample_disk(sampleRandomVector2D(pixel_pos, swrt_frame_no));
        return normalize(swrt_dir_to_sun_basis[0].xyz*disk.x + swrt_dir_to_sun_basis[1].xyz*disk.y + swrt_dir_to_sun_basis[2].xyz);
      }
    }
  }
endmacro

shader shadows_swrt_cs, checkerboard_shadows_swrt_cs, quarter_shadows_swrt_cs
{
  supports none;
  supports global_frame;

  // before COMMON_SWRT_SHADOW, so the defines precede the walk's defaults
  if (swrt_box_dist_ref == on && swrt_use_hw_rt == off)
  {
    (cs) { swrt_box_dist_ref@f1 = swrt_box_dist_ref; }
    hlsl(cs) {
      static float swrt_box_dist_mul;
      #define BVH_TLAS_BOX_DIST_MUL swrt_box_dist_mul
    }
  }
  if (swrt_blas_leaf_skip_dist == on && swrt_use_hw_rt == off)
  {
    (cs) { swrt_blas_leaf_skip_dist@f1 = swrt_blas_leaf_skip_dist; }
    hlsl(cs) {
      #define BVH_BLAS_SHADOW_LEAF_BOXES 1
    }
    SW_BVH_BLAS_BOXES_ONLY_VARIANT(cs)
  }
  COMMON_SWRT_SHADOW(cs)
  if (shader == quarter_shadows_swrt_cs)
  {
    // .y: linear depth for the bilateral upscale
    (cs) { swrt_shadow_target@uav = swrt_shadow_target hlsl { RWTexture2D<float2> swrt_shadow_target@uav;} }
    hlsl(cs) { #define USE_QUARTER 1 }
  }
  else
  {
    (cs) { swrt_shadow_target@uav = swrt_shadow_target hlsl { RWTexture2D<float> swrt_shadow_target@uav;} }
  }
  (cs) { swrt_world_view_pos@f3 = world_view_pos; }
  if (shader == checkerboard_shadows_swrt_cs)
  {
    if (swrt_shadow_checkerboard != NULL)
    {
      (cs) {
        swrt_shadow_checkerboard@uav = swrt_shadow_checkerboard hlsl { RWByteAddressBuffer swrt_shadow_checkerboard@uav;}
      }
      hlsl(cs) {
        #define NO_TYPED_UAV_TARGET 1
      }
    }
    hlsl(cs) {
      #define USE_CHECKERBOARD 1
    }
  }

  hlsl(cs) {
    #pragma hlsl2021
    // matches swrt_tile_16 of the mask pass
    #if USE_QUARTER
    #include <swrt_quarter_upsample.hlsl>
    #define SWRT_PIXEL_TILE 16
    #else
    #define SWRT_PIXEL_TILE SWRT_TILE_SIZE
    #endif

    ##if (swrt_use_hw_rt == off)
##if shader == checkerboard_shadows_swrt_cs && (hardware.scarlett || hardware.ps5)
    //warp size doesn't have to match tileSize
    //in case of checkerboard, it would be hypothetically better if it is 4,8 and we use wave32 (less divergence)
    //I have tried and it is 0.5% faster on Scarlett (not that much)
    //still worth to implement everywhere, but would explode shaders a bit, so only keep it for Scarlett

    #pragma wave32
    [numthreads(SWRT_TILE_SIZE/2, SWRT_TILE_SIZE, 1)]
##elif shader == quarter_shadows_swrt_cs && (hardware.scarlett || hardware.ps5)
    #pragma wave32
    [numthreads(SWRT_TILE_SIZE, SWRT_TILE_SIZE, 1)]
##else
    [numthreads(SWRT_TILE_SIZE, SWRT_TILE_SIZE, 1)]
##endif
    ##else
    RT_GROUP_SIZE
    ##endif
    void calc_trace_shadows_cs(uint2 gtId : SV_GroupThreadID, uint2 gId : SV_GroupID, uint2 dtId : SV_DispatchThreadID, uint tid:SV_GroupIndex)
    {
      // return float4(1, 0, 0, 1);
      uint2 pixelCoord = dtId;
      #if USE_CHECKERBOARD
        pixelCoord.x += pixelCoord.x + uint( (swrt_checkerboard_frame & 1) == (pixelCoord.y & 1) );
      #endif
      #if USE_QUARTER
        if (any(dtId >= uint2(target_size.xy)))
          return;
        // a 4 frame phase rotation, clamped at the odd edges of the active view, as the readers' src_max
        uint frame = uint(swrt_checkerboard_frame);
        pixelCoord = min(2*pixelCoord + swrt_quarter_phase(frame), uint2(target_size.zw));
        float quarterW = linearize_z(texelFetch(half_res_close_depth, pixelCoord, 0).x, zn_zfar.zw);
        #define WRITE_MASK(v) {swrt_shadow_target[dtId] = float2(v, quarterW);}
      #else
        #define WRITE_MASK(v) {swrt_shadow_target[dtId] = v;}
      #endif
      if (any(pixelCoord > uint2(swrt_src_pixel_max)))
        return;
      uint startOfs = 0, endOfs = 0;
##if shader == checkerboard_shadows_swrt_cs && !(hardware.scarlett || hardware.ps5)
      #define SWRT_MERGE_X 2
##else
      #define SWRT_MERGE_X 1
##endif
      #if !HW_RT_SHADOWS
        uint maskTilesX = (uint(target_size.z) + SWRT_PIXEL_TILE)/SWRT_PIXEL_TILE;
        UNROLL
        for (uint i = 0; i < SWRT_MERGE_X; ++i)
        {
          uint tileX = min(gId.x*SWRT_MERGE_X + i, maskTilesX - 1);
          uint2 leafRange = loadBuffer2(swrt_shadow_mask, (tileX + gId.y*maskTilesX)*8);
          if (leafRange.x)
          {
            startOfs = startOfs ? min(startOfs, leafRange.x) : leafRange.x;
            endOfs = max(endOfs, leafRange.y);
          }
        }
        BRANCH
        // startOfs == 0 means "nothing in its tiles' frustums" (mask pass stored 0). Safe as a
        // sentinel only because the TLAS root node at offset 0 is never itself a leaf -- guaranteed
        // by createBVHNodeSAH (a single-instance TLAS still gets an internal root).
        if (!startOfs)
        {
          WRITE_MASK(1);
          return;
        }
      #endif
      float rawDepth = texelFetch(half_res_close_depth, pixelCoord, 0).x;
      if (rawDepth == 0) // sky: write lit (1) like every other early-out, so reconstruction never reads stale
      {
        WRITE_MASK(1);
        return;
      }

      //todo: combine both shadow_strength & combined shadows in one bitmask
      // it is more accurate, as it takes full res normal into account, not half res
      // probably not very expensive also
      {
        half3 wsNormal = normalize(half3(texelFetch(half_res_close_depth_normals, pixelCoord, 0).xyz) * 2.h - 1.h);
        // Backlit cull with slack: strength>0 iff dot(N,sun) > -sqrt(0.5)/2 ~= -0.35, i.e. surfaces
        // up to ~110deg from the sun still trace (slack for normal-map divergence).
        half shadow_strength = saturate(dot(wsNormal, half3(swrt_dir_to_sun_basis[2].xyz))*2.h + sqrt(0.5h));
        if (shadow_strength <= 0)
        {
          WRITE_MASK(0);
          return;
        }
      }

      //if we first calculate full res shadows, than we can and should skip completely darkened
      float2 uv = pixelCoord*inv_target_size.xy + inv_target_size.zw;
      half4 shadows = (half4)combined_shadows.GatherRed(combined_shadows_samplerstate, uv);
      bool allShadowed = all(shadows == 0);
      if (allShadowed)
      {
        WRITE_MASK(0);
        return;
      }

      float3 viewVect = getViewVecOptimized(uv);
      float w = linearize_z(rawDepth, zn_zfar.zw);
      float3 cameraPos = viewVect * w;
      float3 worldPos = swrt_world_view_pos.xyz + cameraPos;
      #if USE_QUARTER
      // uniform: the walk keeps it in SGPRs
      float3 to_sun_dir = swrt_shadow_ray[0].xyz;
      float3 to_sun_dir_inv = swrt_shadow_ray[1].xyz;
      #else
      float3 to_sun_dir = get_sun_direction(pixelCoord);
      float3 to_sun_dir_inv = rcp(to_sun_dir);
      #endif
      float stepOfs = get_project_defined_swrt_shadow_offset_point(cameraPos, worldPos.xyz);
      // the caster reach (or more with leaf boxes), then a constant + distance-scaled bias; no slope (normal) term,
      // so grazing-angle acne relies on the backlit cull and soft-sun dither. If acne shows up, scale by (1 + k*(1 - dot(N,L))).
      float cameraDist = length(cameraPos);
      float sunStep = swrt_shadow_sun_step.x + swrt_shadow_sun_step.y*cameraDist;
      #if BVH_BLAS_SHADOW_LEAF_BOXES
      stepOfs = max(stepOfs, swrt_blas_leaf_skip_dist) + sunStep;
      #endif
      float step_to_sun = stepOfs + sunStep;

      #if HW_RT_SHADOWS
      {
        HitInfo hitInfo;
        half3 rayColor;
        float translucentT;
        uint groupMask = bvhGroupHardShadow;
        uint extraFlags = 0;

        bool shadowHit = !trace_ray(bvhMain, cameraPos.xyz, to_sun_dir, step_to_sun, 100000, w, groupMask, hitInfo, rayColor, translucentT, extraFlags);
        WRITE_MASK(shadowHit);
        return;
      }
      #endif
      ##if swrt_box_dist_ref == on && swrt_use_hw_rt == off
      swrt_box_dist_mul = min(1, swrt_box_dist_ref * rcp(cameraDist));
      ##endif

      bool shadowHit = !rayShadowTLAS(worldPos.xyz + step_to_sun*to_sun_dir, to_sun_dir, to_sun_dir_inv, startOfs, endOfs);

      WRITE_MASK(shadowHit);
      //swrt_shadow_target[pixelCoord] = shadowHit && !mask;
      //swrt_shadow_target[pixelCoord] = !shadowHit;
      //swrt_shadow_target[pixelCoord] = !mask;
      return;

      float t;float3 triNorm;float2 bCoord;
      int complexity = 0;
      swrt_shadow_target[pixelCoord] = !rayTLAS(worldPos.xyz + step_to_sun*to_sun_dir, to_sun_dir, rcp(to_sun_dir), 1e15, t, triNorm, bCoord, complexity);
    }
  }

  if (swrt_use_hw_rt == on)
  {
    compile("cs_6_5_half", "calc_trace_shadows_cs");
  } else
  {
    compile("target_cs", "calc_trace_shadows_cs");
  }
}
