let {Point2} = require("dagor.math")

let TestInput = class {
  function mouseClick(button) { assert(type(button)=="integer") }
  function mousePosition(at) { assert(at instanceof Point2, "at should be Point2") }
  function mouseMove(from, to, over_seconds) {
    assert(from instanceof Point2, "from should be Point2")
    assert(to instanceof Point2, "to should be Point2")
    assert(type(over_seconds)=="float")
  }
  function keyPress(key) { assert(type(key)=="integer") }
  function keyPressModifier(key, modifier) { assert(type(key)=="integer" && type(modifier)=="integer") }
  function keyHeld(key, over_seconds) { assert(type(key)=="integer" && type(over_seconds)=="float") }
  function keyHeldModifier(key, modifier, over_seconds) {
    assert(type(key)=="integer")
    assert(type(modifier)=="integer")
    assert(type(over_seconds)=="float")
  }
  function characterInput(text, between_seconds) { assert(type(text)=="string" && type(between_seconds)=="float") }
  function mouseDrag(button, from, to, over_seconds) {
    assert(type(button)=="integer")
    assert(from instanceof Point2, "from should be Point2")
    assert(to instanceof Point2, "to should be Point2")
    assert(type(over_seconds)=="float")
  }
  function mouseMoveItem(path, over_seconds) {
    assert(type(path)=="string" && type(over_seconds)=="float")
    return true
  }
  function mouseClickItem(path, button) {
    assert(type(path)=="string" && type(button)=="integer")
    return true
  }
}

let TestRuntime = class {
  function registerTest(name, func) {
    assert(type(name)=="string" && type(func)=="function")
    println($"--- registerTest({name}):")
    func(this)
  }
  isRunning = @() true
  markFailed = @() {}
  yieldFrame = @() {}
  function yieldTime(seconds) { assert(type(seconds)=="float") }
  function queryItem(path) {
    assert(type(path)=="string")
    return {
      id = 1
      bb = {
        Min = Point2(2, 3)
        Max = Point2(4, 5)
      }
      parentId = 0
    }
  }
  input = @() TestInput()
}

return {
  getInstance = @() TestRuntime()

  Mouse = {
    Left   = 0
    Right  = 1
    Middle = 2
  }

  Modifier = {
    None  = 0
    Ctrl  = 0
    Shift = 0
    Alt   = 0
    Super = 0
