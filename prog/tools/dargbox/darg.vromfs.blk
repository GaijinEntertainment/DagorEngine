output:t ="../../../tools/dargbox/dargbox.vromfs.bin"
pack:b=true

allowMkDir:b=yes

rootFolder:t="."

sign_private_key:t=""
sign_digest:t="sha256"


folder {
  path:t="../../../prog/scripts/sq/daRg"
  dest_path:t="sq/darg"
  scan_subfolders:b=true
  wildcard:t=*.nut
}

folder {
  path:t="../../../prog/scripts/sq/std"
  dest_path:t="sq/std"
  scan_subfolders:b=true
  wildcard:t=*.nut
}

folder {
  path:t="../../../prog/1stPartyLibs/daScript/daslib"
  dest_path:t="daslib"
  scan_subfolders:b=false
  wildcard:t=*.das
}

folder {
  path:t="gamebase/"
  dest_path:t="./"
  scan_subfolders:b=false
  wildcard:t=init.nut
}

folder {
  path:t="gamebase/browser"
  dest_path:t="browser"
  scan_subfolders:b=true
  wildcard:t=*.*
}

folder {
  path:t="gamebase/samples_prog/_basic/components"
  dest_path:t="samples_prog/_basic/components"
  scan_subfolders:b=true
  wildcard:t=*.nut
}

exclude {
}
