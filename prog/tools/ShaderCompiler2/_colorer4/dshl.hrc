<?xml version="1.0" encoding="Windows-1251"?>
<!DOCTYPE hrc SYSTEM "../hrc.dtd">
<?xml-stylesheet type="text/xsl" href="../hrc.xsl"?>
<!-- Dagor shader language (*.dshl) for Colorer 4ever, the engine in Far 2.0.
     For Far3 / FarColorer use ../_colorer5 instead; that version registers itself.

     Install: copy this file to <Far2>\Plugins\Colorer\hrc\base\, then register the type centrally - 4ever has no
     per-file prototype - by pasting the <type/> block of colorer.hrc.add into <Far2>\Plugins\Colorer\hrc\colorer.hrc
     beside the other <type/> entries. Skip that step when a <type ... name="dshl"> already stands there, because a type
     registered twice loads twice. Colorer usually reloads by itself; if it does not, F11 -> colorer -> C Configure ->
     Reload. F11 -> colorer -> 1 List types then holds dshl, which is what shows the type registered.

     The keyword lists and the @-binding rules are generated; read the module docstring of ../_colorer_keywords.py
     before editing them by hand. -->
<hrc>

<include name="regions.hrc"/>
<include name="defines.hrc"/>

<define name="dNamespace"    value="dString"/>
<define name="dState"        value="dString"/>
<define name="dStateValue"   value="dNumDec"/>
<define name="dType"         value="dNumDec"/>
<define name="dHlslKeyword"  value="dParam"/>
<define name="dHlslIntrinsic"  value="dParam"/>
<define name="dHlslType"     value="dParam"/>
<define name="dHlslSemantic" value="dNumDec"/>
<define name="dHlslPreProc"  value="dDirective"/>
<define name="dHlslPreProc2"  value="dNumHex"/>

<scheme name="commonSyntax">
   <inherit scheme="mCHexNumb"/>
   <inherit scheme="mFloatNumb"/>
   <inherit scheme="mDecNumb"/>
   <inherit scheme="mStdStr"/>
   <regexp match="/\c(0x[\da-fA-F]*?([^\s\W\da-fA-F]).*?)\B/i" region0="dError"/>

   <regexp match="/\/\/.*$/" region0="dComment"/>
   <block  start="/\/\*/" end="/\*\//" scheme="Comment"
           region="dComment" region00="dpOpenStruct" region10="dpCloseStruct"/>

   <!-- @-binding types, one rule per PRESHADER_VARIABLE_TYPE_LIST_* group in variantSemantic.h plus
        the state-block binding types. Generated by _colorer_keywords.py. Longest alternative first
        (texCubeArray before texCube before tex), and every branch bracketed: 4ever matches nothing at
        all for a bare a|b|c in a match regexp. -->
   <regexp match='/\b[a-zA-Z_]\w*\s*(@)((f43)|(f44)|(f1)|(f2)|(f3)|(f4))\B/' region1="dKeyword" region2="dString"/> <!-- FLOAT -->
   <regexp match='/\b[a-zA-Z_]\w*\s*(@)((i1)|(i2)|(i3)|(i4))\B/' region1="dKeyword" region2="dString"/> <!-- INT -->
   <regexp match='/\b[a-zA-Z_]\w*\s*(@)((u1)|(u2)|(u3)|(u4))\B/' region1="dKeyword" region2="dString"/> <!-- UINT -->
   <regexp match='/\b[a-zA-Z_]\w*\s*(@)((cbuf)|(buf))\B/' region1="dKeyword" region2="dString"/> <!-- BUF -->
   <regexp match='/\b[a-zA-Z_]\w*\s*(@)((texCubeArray)|(texArray)|(texCube)|(tex2d)|(tex3d)|(tex))\B/' region1="dKeyword" region2="dString"/> <!-- TEX -->
   <regexp match='/\b[a-zA-Z_]\w*\s*(@)((cmpSampler)|(smpArray)|(sampler)|(smp2d)|(smp3d))\B/' region1="dKeyword" region2="dString"/> <!-- SMP -->
   <regexp match='/\b[a-zA-Z_]\w*\s*(@)((staticSmpCubeArray)|(staticSmpArray)|(staticSmpCube)|(staticSmp3D)|(staticSmp))\B/' region1="dKeyword" region2="dString"/> <!-- STATIC_SMP -->
   <regexp match='/\b[a-zA-Z_]\w*\s*(@)((staticTexCubeArray)|(staticTexArray)|(staticTexCube)|(staticTex3D)|(staticTex))\B/' region1="dKeyword" region2="dString"/> <!-- STATIC_TEX -->
   <regexp match='/\b[a-zA-Z_]\w*\s*(@)((tlas)|(uav))\B/' region1="dKeyword" region2="dString"/> <!-- OTHER -->
   <regexp match='/\b[a-zA-Z_]\w*\s*(@)((bindlessTexCubeArray)|(bindlessByteBuffer)|(bindlessTexArray)|(bindlessSampler)|(bindlessTexCube)|(bindlessTex2D)|(bindlessTex3D))\B/' region1="dKeyword" region2="dString"/> <!-- BINDLESS -->
   <regexp match='/\b[a-zA-Z_]\w*\s*(@)((subpass_read))\B/' region1="dKeyword" region2="dString"/> <!-- SUBPASS_READ -->
   <regexp match='/\b[a-zA-Z_]\w*\s*(@)((ps_output))\B/' region1="dKeyword" region2="dString"/> <!-- STATE_BLOCK -->
   <keywords region="dHlslPreProc2">
      <word name="globtm"/>
      <word name="immediate_dword_count"/>
      <word name="local_view_pos"/>
      <word name="local_view_x"/>
      <word name="local_view_y"/>
      <word name="local_view_z"/>
      <word name="projtm"/>
      <word name="viewprojtm"/>
      <word name="world_local_pos"/>
      <word name="world_local_x"/>
      <word name="world_local_y"/>
      <word name="world_local_z"/>
   </keywords>

   <keywords region="dSymbol">
      <symb name=";"/><symb name="="/><symb name="+"/><symb name="-"/>
      <symb name="/"/><symb name="*"/><symb name="&amp;"/><symb name="|"/>
      <symb name="^"/><symb name="("/><symb name=")"/><symb name="["/>
      <symb name="]"/><symb name=","/><symb name="."/><symb name=":"/>
      <symb name="!"/><symb name="~"/><symb name="&lt;"/><symb name="&gt;"/>
      <symb name="%"/><symb name="?"/><symb name="#"/>
   </keywords>
</scheme>

<!-- the stage block gets a scheme of its own so the braces of a '@f44 = { ... }' binding value
     open a nested block; without one the block's own end takes the '}' of that value and closes
     early. It cannot live in commonSyntax: hlsl reaches that through hlslBase, and a brace inside
     an hlsl body would switch to it and lose every HLSL keyword. -->
<scheme name="stageBlock">
   <inherit scheme="commonSyntax"/>
   <inherit scheme="mPairedBrackets">
      <virtual scheme="mPairedBrackets" subst="stageBlock"/>
   </inherit>
</scheme>

<scheme name="CPrePro">
   <inherit scheme="commonSyntax"/>

   <keywords region="dHlslPreProc">
      <word name="declare"/>
      <word name="elif"/>
      <word name="else"/>
      <word name="endif"/>
      <word name="error"/>
      <word name="if"/>
   </keywords>
</scheme>

<scheme name="CPrePro2">
   <inherit scheme="commonSyntax"/>

   <keywords region="dHlslPreProc2">
      <word name="pragma"/>
      <word name="define"/>
      <word name="undef"/>
      <word name="elif"/>
      <word name="else"/>
      <word name="endif"/>
      <word name="error"/>
      <word name="if"/>
      <word name="ifdef"/>
      <word name="ifndef"/>
      <word name="include"/>
      <word name="line"/>
      <word name="__LINE__"/>
      <word name="__FILE__"/>
   </keywords>
</scheme>

<scheme name="hlslBase">
   <block  start="/^\s*##/" end="/^ | ([^\\]?#1) $/x" scheme="cPrePro" region="dHlslPreProc"/>
   <block  start="/^\s*#/" end="/^ | ([^\\]?#1) $/x" scheme="cPrePro2" region="dHlslPreProc2"/>
   <inherit scheme="commonSyntax"/>

   <regexp match="/\b((bool)|(int)|(uint)|(fixed)|(half)|(float)|(double))[1-4]\B/" region0="dHlslType"/>
   <regexp match="/\b((bool)|(int)|(uint)|(fixed)|(half)|(float)|(double))[1-4]x[1-4]\B/" region0="dHlslType"/>

   <keywords ignorecase="ignorecase" region="dHlslKeyword">
      <word name="BlendState"/>
      <word name="Bool"/>
      <word name="Break"/>
      <word name="Case"/>
      <word name="CBuffer"/>
      <word name="Class"/>
      <word name="Compile"/>
      <word name="Const"/>
      <word name="Continue"/>
      <word name="Default"/>
      <word name="DepthStencilState"/>
      <word name="DepthStencilView"/>
      <word name="Discard"/>
      <word name="Do"/>
      <word name="Double"/>
      <word name="Else"/>
      <word name="Enum"/>
      <word name="Extern"/>
      <word name="False"/>
      <word name="Float"/>
      <word name="For"/>
      <word name="GeometryShader"/>
      <word name="Half"/>
      <word name="If"/>
      <word name="In"/>
      <word name="Inline"/>
      <word name="Inout"/>
      <word name="Int"/>
      <word name="Matrix"/>
      <word name="Namespace"/>
      <word name="Nointerpolation"/>
      <word name="Operator"/>
      <word name="Out"/>
      <word name="Pass"/>
      <word name="PixelShader"/>
      <word name="RasterizerState"/>
      <word name="RenderTargetView"/>
      <word name="Return"/>
      <word name="Register"/>
      <word name="Sampler"/>
      <word name="sampler"/>
      <word name="Sampler1D"/>
      <word name="Sampler2D"/>
      <word name="Sampler3D"/>
      <word name="SamplerCUBE"/>
      <word name="hsampler"/>
      <word name="hsampler1D"/>
      <word name="hsampler2D"/>
      <word name="hsampler3D"/>
      <word name="hsamplerCUBE"/>
      <word name="fxsampler"/>
      <word name="fxsampler1D"/>
      <word name="fxsampler2D"/>
      <word name="fxsampler3D"/>
      <word name="fxsamplerCUBE"/>
      <word name="fltsampler"/>
      <word name="fltsampler1D"/>
      <word name="fltsampler2D"/>
      <word name="fltsampler3D"/>
      <word name="fltsamplerCUBE"/>
      <word name="sampler_state"/>
      <word name="SamplerComparisonState"/>
      <word name="Shared"/>
      <word name="Sizeof"/>
      <word name="Stateblock"/>
      <word name="Stateblock_state"/>
      <word name="Static"/>
      <word name="String"/>
      <word name="Struct"/>
      <word name="Switch"/>
      <word name="TBuffer"/>
      <word name="Technique"/>
      <word name="Technique10"/>
      <word name="Template"/>
      <word name="texture1"/>
      <word name="Texture1D"/>
      <word name="Texture1D"/>
      <word name="Texture1DArray"/>
      <word name="texture2D"/>
      <word name="Texture2D"/>
      <word name="Texture2DArray"/>
      <word name="Texture2DMS"/>
      <word name="Texture2DMSArray"/>
      <word name="texture3D"/>
      <word name="Texture3D"/>
      <word name="texturecube"/>
      <word name="TextureCube"/>
      <word name="This"/>
      <word name="True"/>
      <word name="Typedef"/>
      <word name="Typename"/>
      <word name="Uniform"/>
      <word name="Unsigned"/>
      <word name="Using"/>
      <word name="Vector"/>
      <word name="VertexShader"/>
      <word name="Void"/>
      <word name="Volatile"/>
      <word name="While"/>
   </keywords>

   <keywords region="dHlslIntrinsic">
      <word name="abs"/>
      <word name="acos"/>
      <word name="all"/>
      <word name="any"/>
      <word name="asfloat"/>
      <word name="asin"/>
      <word name="asint"/>
      <word name="asuint"/>
      <word name="atan"/>
      <word name="atan2"/>
      <word name="ceil"/>
      <word name="clamp"/>
      <word name="clip"/>
      <word name="cos"/>
      <word name="cosh"/>
      <word name="cross"/>
      <word name="D3DCOLORtoUBYTE4"/>
      <word name="ddx"/>
      <word name="ddy"/>
      <word name="degrees"/>
      <word name="determinant"/>
      <word name="distance"/>
      <word name="dot"/>
      <word name="exp"/>
      <word name="exp2"/>
      <word name="faceforward"/>
      <word name="floor"/>
      <word name="fmod"/>
      <word name="frac"/>
      <word name="frexp"/>
      <word name="fwidth"/>
      <word name="GetRenderTargetSampleCount"/>
      <word name="GetRenderTargetSamplePosition"/>
      <word name="isfinite"/>
      <word name="isinf"/>
      <word name="isnan"/>
      <word name="ldexp"/>
      <word name="length"/>
      <word name="lerp"/>
      <word name="lit"/>
      <word name="log"/>
      <word name="log10"/>
      <word name="log2"/>
      <word name="max"/>
      <word name="min"/>
      <word name="modf"/>
      <word name="mul"/>
      <word name="noise"/>
      <word name="normalize"/>
      <word name="pow"/>
      <word name="radians"/>
      <word name="reflect"/>
      <word name="refract"/>
      <word name="round"/>
      <word name="rsqrt"/>
      <word name="saturate"/>
      <word name="sign"/>
      <word name="sin"/>
      <word name="sincos"/>
      <word name="sinh"/>
      <word name="smoothstep"/>
      <word name="sqrt"/>
      <word name="step"/>
      <word name="tan"/>
      <word name="tanh"/>
      <word name="tex1D"/>
      <word name="tex1Dbias"/>
      <word name="tex1Dgrad"/>
      <word name="tex1Dlod"/>
      <word name="tex1Dproj"/>
      <word name="tex2D"/>
      <word name="tex2Dbias"/>
      <word name="tex2Dgrad"/>
      <word name="tex2Dlod"/>
      <word name="tex2Dproj"/>
      <word name="tex3D"/>
      <word name="tex3Dbias"/>
      <word name="tex3Dgrad"/>
      <word name="tex3Dlod"/>
      <word name="tex3Dproj"/>
      <word name="texCUBE"/>
      <word name="texCUBEbias"/>
      <word name="texCUBEgrad"/>
      <word name="texCUBElod"/>
      <word name="texCUBEproj"/>
      <word name="h4tex2D"/>
      <word name="h4tex2Dbias"/>
      <word name="h4tex2Dgrad"/>
      <word name="h4tex2Dlod"/>
      <word name="h4tex2Dproj"/>
      <word name="h4tex3D"/>
      <word name="h4tex3Dbias"/>
      <word name="h4tex3Dgrad"/>
      <word name="h4tex3Dlod"/>
      <word name="h4tex3Dproj"/>
      <word name="h4texCUBE"/>
      <word name="h4texCUBEbias"/>
      <word name="h4texCUBEgrad"/>
      <word name="h4texCUBElod"/>
      <word name="h4texCUBEproj"/>
      <word name="transpose"/>
   </keywords>

   <!-- Reserved keywords -->
   <keywords region="dError">
      <word name="catch"/>
      <word name="char"/>
      <word name="const_cast"/>
      <word name="delete"/>
      <word name="dynamic_cast"/>
      <word name="explicit"/>
      <word name="friend"/>
      <word name="goto"/>
      <word name="long"/>
      <word name="mutable"/>
      <word name="new"/>
      <word name="private"/>
      <word name="protected"/>
      <word name="public"/>
      <word name="reinterpret_cast"/>
      <word name="short"/>
      <word name="signed"/>
      <word name="static_cast"/>
      <word name="throw"/>
      <word name="try"/>
      <word name="union"/>
      <word name="virtual"/>
   </keywords>

   <regexp match="/\b((SV_IsFrontFace)|(SV_InstanceID)|(SV_Depth)|(SV_Position)|(SV_Target)|(COLOR)|(NORMAL)|(POSITION))[0-1]\B/" region0="dHlslSemantic"/>
   <regexp match="/\bTEXCOORD[0-9]\B/" region0="dHlslSemantic"/>
   <regexp match="/\bTEXCOORD1[0-5]\B/" region0="dHlslSemantic"/>

   <keywords region="dHlslSemantic">
      <word name="BINORMAL"/>
      <word name="BINORMAL0"/>
      <word name="BLENDINDICES"/>
      <word name="BLENDINDICES0"/>
      <word name="BLENDWEIGHT"/>
      <word name="BLENDWEIGHT0"/>
      <word name="COLOR"/>
      <word name="NORMAL"/>
      <word name="POSITION"/>
      <word name="POSITIONT"/>
      <word name="PSIZE"/>
      <word name="TANGENT"/>
      <word name="TANGENT0"/>
      <word name="TEXCOORD"/>
      <word name="FOG"/>
      <word name="PSIZE"/>
      <word name="PSIZE0"/>
      <word name="TESSFACTOR"/>
      <word name="TESSFACTOR0"/>
      <word name="VFACE"/>
      <word name="VPOS"/>
      <word name="DEPTH"/>
      <word name="DEPTH0"/>
   </keywords>
</scheme>


<scheme name="hlslBlock">
   <inherit scheme="hlslBase"/>
   <!-- The braces take their pair regions from a regexp rather than a block: a block would consume the
        '}' aligned with the 'hlsl' keyword, which the enclosing block has to close on. A regexp only
        marks, so that block still sees its end, and the marks are matched by nesting. -->
   <regexp match="/(\{)/" region0="dSymbol2" region1="dpOpenStruct"/>
   <regexp match="/(\})/" region0="dSymbol2" region1="dpCloseStruct"/>
</scheme>

<scheme name="hlsl">
   <inherit scheme="hlslBase"/>
   <inherit scheme="mPairedBrackets">
     <virtual scheme="mPairedBrackets" subst="hlsl"/>
   </inherit>
</scheme>

<scheme name="shader">
   <inherit scheme="mPairedBrackets">
     <virtual scheme="mPairedBrackets" subst="shader"/>
   </inherit>
   <block start="/^\s*(hlsl)\s*(\(\s*(([acdeghlmpv]s)|([A-Za-z_][A-Za-z0-9_]{2,}))\s*\))?\s*(\{)\s*/" end="/\s*(\})/"
          scheme="hlsl"
          region00="dSymbol2" region06="dpOpenStruct"
          region10="dSymbol2" region11="dpCloseStruct"/>
   <block start="/^\s*\(\s*(([cpvm]s)|([A-Za-z_][A-Za-z0-9_]{2,}))\s*\)\s*(\{)\s*/" end="/\s*(\})/"
          scheme="stageBlock"
          region00="dSymbol2" region04="dpOpenStruct"
          region10="dSymbol2" region11="dpCloseStruct"/>

   <!-- hlsl / hlsl(vs) with the opening brace on the following line. \y1 links the end regexp back to
        bracket 1 of start (the indentation), so the block closes on the '}' aligned with the 'hlsl'
        keyword. Its dpCloseStruct is answered by the dpOpenStruct that hlslBlock puts on the first
        brace, the one a line below the header, so the pair spans the whole body. -->
   <block start="/^(\s*)(hlsl)\s*(\(\s*(([acdeghlmpv]s)|([A-Za-z_][A-Za-z0-9_]{2,}))\s*\))?\s*$/" end="/^\y1(\})/"
          scheme="hlslBlock"
          region02="dKeyword"
          region10="dSymbol2" region11="dpCloseStruct"/>

   <regexp match="/^\s*(hlsl)\s*(\(\s*((([acdeghlmpv]s)|([A-Za-z_][A-Za-z0-9_]{2,}))\s*\))?![^)]*\))\s*\{?\s*$/" region2="dError"/>
   <regexp match="/^\s*(\(\s*((([cpvm]s)|([A-Za-z_][A-Za-z0-9_]{2,}))\s*\))?![^)]*\))\s*\{?\s*$/" region1="dError"/>

   <inherit scheme="commonSyntax"/>
   
   <keywords region="dKeyword">
      <word name="allow_opacity_micromaps"/>
      <word name="always_referenced"/>
      <word name="assume"/>
      <word name="assume_if_not_assumed"/>
      <word name="block"/>
      <word name="bounding_pack"/>
      <word name="buffer"/>
      <word name="channel"/>
      <word name="compile"/>
      <word name="const"/>
      <word name="const_buffer"/>
      <word name="dont_render"/>
      <word name="dynamic"/>
      <word name="else"/>
      <word name="error"/>
      <word name="framebuffer_layout"/>
      <word name="global"/>
      <word name="hardware"/>
      <word name="if"/>
      <word name="immediate_dword_count"/>
      <word name="interval"/>
      <word name="literal"/>
      <word name="local"/>
      <word name="material"/>
      <word name="max_recursion"/>
      <word name="maybe"/>
      <word name="mul_16k"/>
      <word name="mul_1k"/>
      <word name="mul_2k"/>
      <word name="mul_32767"/>
      <word name="mul_4k"/>
      <word name="mul_8k"/>
      <word name="multi_render_pass"/>
      <word name="no_ablend"/>
      <word name="no_dynstcode"/>
      <word name="no_warnings"/>
      <word name="pass"/>
      <word name="pixel"/>
      <word name="real_two_sided"/>
      <word name="register"/>
      <word name="render_pass"/>
      <word name="render_stage"/>
      <word name="render_trans"/>
      <word name="sampler"/>
      <word name="shader"/>
      <word name="signed_pack"/>
      <word name="static"/>
      <word name="subpass"/>
      <word name="supports"/>
      <word name="texture"/>
      <word name="tlas"/>
      <word name="two_sided"/>
      <word name="unsigned_pack"/>
      <word name="vertex"/>
   </keywords>

   <keywords region="dType">
      <word name="bool"/>
      <word name="color8"/>
      <word name="dec3n"/>
      <word name="float"/>
      <word name="float1"/>
      <word name="float2"/>
      <word name="float3"/>
      <word name="float4"/>
      <word name="float4x3"/>
      <word name="float4x4"/>
      <word name="half2"/>
      <word name="half4"/>
      <word name="int"/>
      <word name="int4"/>
      <word name="short2"/>
      <word name="short2n"/>
      <word name="short4"/>
      <word name="short4n"/>
      <word name="ubyte4"/>
      <word name="udec3"/>
      <word name="ushort2n"/>
      <word name="ushort4n"/>
   </keywords>

   <keywords region="dState">
      <word name="alpha_to_coverage"/>
      <word name="ambient"/>
      <word name="blend_adst"/>
      <word name="blend_aop"/>
      <word name="blend_asrc"/>
      <word name="blend_dst"/>
      <word name="blend_factor"/>
      <word name="blend_op"/>
      <word name="blend_src"/>
      <word name="color_write"/>
      <word name="cull_mode"/>
      <word name="diffuse"/>
      <word name="emissive"/>
      <word name="extra"/>
      <word name="norm"/>
      <word name="pos"/>
      <word name="slope_z_bias"/>
      <word name="specular"/>
      <word name="stencil"/>
      <word name="stencil_fail"/>
      <word name="stencil_func"/>
      <word name="stencil_pass"/>
      <word name="stencil_ref"/>
      <word name="stencil_zfail"/>
      <word name="tc"/>
      <word name="vcol"/>
      <word name="view_instances"/>
      <word name="z_bias"/>
      <word name="z_func"/>
      <word name="z_test"/>
      <word name="z_write"/>
   </keywords>

   <keywords region="dStateValue">
      <word name="NULL"/>
      <word name="android"/>
      <word name="bindless"/>
      <word name="dx11"/>
      <word name="dx12"/>
      <word name="false"/>
      <word name="fsh_4_0"/>
      <word name="fsh_5_0"/>
      <word name="fsh_6_0"/>
      <word name="fsh_6_2"/>
      <word name="fsh_6_6"/>
      <word name="globtm"/>
      <word name="local_view_pos"/>
      <word name="local_view_x"/>
      <word name="local_view_y"/>
      <word name="local_view_z"/>
      <word name="mesh"/>
      <word name="metal"/>
      <word name="metaliOS"/>
      <word name="none"/>
      <word name="pc"/>
      <word name="projtm"/>
      <word name="ps4"/>
      <word name="ps5"/>
      <word name="scarlett"/>
      <word name="true"/>
      <word name="viewprojtm"/>
      <word name="vulkan"/>
      <word name="world_local_pos"/>
      <word name="world_local_x"/>
      <word name="world_local_y"/>
      <word name="world_local_z"/>
      <word name="xbox"/>
   </keywords>

   <keywords region="dDirective">
      <word name="define_macro_if_not_defined"/>
      <word name="endmacro"/>
      <word name="include"/>
      <word name="include_optional"/>
      <word name="macro"/>
   </keywords>
</scheme>

</hrc>
