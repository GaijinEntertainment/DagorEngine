    if (!argv.contains("-check_es"))
      return
    let components = {}
    foreach (comps_rwtype, cmps in comps){
      if (comps_rwtype=="comps_rq") {
        foreach (cmp in cmps)
          components[cmp] <- cmp
      }
      else {
        foreach (cmp in cmps) {
