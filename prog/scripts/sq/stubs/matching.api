  matching_listen_rpc = @(...) null
  matching_logout = @() null
  matching_login = @(...) null
  matching_call = offline
  matching_call_fixed_event = offline
  matching_notify = @(...) null
  matching_send_response = @(...) null
  get_mgates_count = @(...) 0
  is_stun_compatible = @() false
}
