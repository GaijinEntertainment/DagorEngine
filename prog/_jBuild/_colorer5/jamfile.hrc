<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hrc PUBLIC "-//Cail Lomecb//DTD Colorer HRC take5//EN"
  "http://colorer.sf.net/2003/hrc.dtd">
<hrc version="take5" xmlns="http://colorer.sf.net/2003/hrc"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://colorer.sf.net/2003/hrc http://colorer.sf.net/2003/hrc.xsd">

<annotation>
   <documentation>
      Jam / Jamfile syntax, ported to take5 from the 4ever description that ships with Far 2.0
      (Plugins/Colorer/hrc/base/jamfile.hrc), so Far3 and Far 2.0 colour jamfiles identically.

      Region mapping used for the port (4ever -&gt; take5):
        dString  -&gt; def:String        dParam        -&gt; def:Parameter
        dKeyword -&gt; def:Keyword       dSymbol       -&gt; def:Symbol
        dSymbol2 -&gt; def:SymbolStrong  cStructOp     -&gt; def:SymbolStrong
        dComment -&gt; def:Comment       dError        -&gt; def:Error
        dPath    -&gt; def:Path          dText         -&gt; def:Text
        dpOpenStruct -&gt; def:PairStart dpCloseStruct -&gt; def:PairEnd
        dPod     -&gt; def:Directive (same light-gray slot in the 4ever palette)
        dTag     -&gt; def:Tag           dString3      -&gt; def:StringContent
        dVar2    -&gt; def:VarStrong     dType         -&gt; def:TypeKeyword
        dString2 -&gt; def:Text (the Value region below; dText maps there too)
      4ever's shared "Comment" helper scheme is take5's "def:Comment".

      Names are spelled exactly here, because take5 resolves them case sensitively while 4ever does not:
      4ever compares region names with stricmp (shared/colorer/ccdata.cpp, CColorData::getregion),
      so its "dKeyWord" reached the region defined as "dKeyword". That would not resolve in take5,
      so the canonical spelling is used on both sides: def:Keyword here, dKeyword in the 4ever file.

      Install: copy this file to &lt;Far3&gt;/Plugins/FarColorer/base/auto/ and reload the base (F11 -&gt;
      FarColorer -&gt; Reload base). It carries its own &lt;prototype&gt;,
      so unlike the 4ever version it needs no edit to a central colorer.hrc.
      Jamfile then stands in the file-type list (F11 -&gt; FarColorer -&gt; the type list), which is what shows the
      &lt;prototype&gt; registered; the schema-library test parses the scheme but does not prove registration.

      The predefined-variable list is maintained by hand - jam has no declaration site to generate it from.
      The keyword list and the built-in rule list are jam's own tables, jam_src/jamgramtab.h and jam_src/builtins.c.
      This file and ../_colorer4/jamfile.hrc describe the same colouring rule for rule;
      change one and make the matching change in the other. The 4ever/take5 spellings that differ are tabulated
      in the annotation of prog/tools/ShaderCompiler2/_colorer5/dshl.hrc.
   </documentation>
</annotation>

<prototype name="jamfile" group="main" description="Jamfile">
   <location link="jamfile.hrc"/>
   <filename>/(\.(jam)$)|(jamfile[^\.]*$)|(j\~[^\.]*$)|(\-jam$)/i</filename>
</prototype>

<type name="jamfile">

   <import type="def"/>

   <region name="Variable"     parent="def:VarStrong"/>
   <region name="Parameter"    parent="def:Parameter"/>
   <region name="Keyword"      parent="def:Keyword"/>
   <region name="Symbol"       parent="def:Symbol"/>
   <region name="StructSymbol" parent="def:SymbolStrong"/>
   <region name="Comment"      parent="def:Comment"/>
   <region name="Error"        parent="def:Error"/>
   <region name="Path"         parent="def:Path"/>
   <region name="Pod"          parent="def:Directive"/>
   <region name="Text"         parent="def:Text"/>
   <!-- take5 has no <define/>, so the slots the 4ever file aliases are named regions here.
        OtherVar is its jamOtherVar (dString3) and Rule below is its jamRule (dTag);
        its jamBuiltinVar is Variable above and its jamBuiltinRule is simply Keyword.
        Value and Modifier alias nothing in 4ever - they stand for dString2 and dType,
        which the 4ever rules name directly. In the far20 HRD def:StringContent is light purple,
        def:Text yellow and def:Tag grey. -->
   <region name="OtherVar"     parent="def:StringContent"/>
   <region name="Value"        parent="def:Text"/>
   <region name="Modifier"     parent="def:TypeKeyword"/>
   <!-- rules and actions this build defines; jam's own rules keep the keyword colour instead,
        because they are part of the language and not of the build -->
   <region name="Rule"         parent="def:Tag"/>

   <scheme name="jamBracketCall">
      <!-- a word opening with '[[' is a placeholder and no call: jam splits on whitespace, so
           '[[PATH_TO_ROOT]]' is one argument. This match starts at the space, ahead of the blocks -->
      <regexp match="/(^|\s)(\[\[[^\s]*)/" region2="Value"/>
      <!-- [ RuleName args ] wherever the form appears, one scheme, defined before the jamBracketArgs that
           inherits it - a forward inherit fails - or a nested call would end the outer at the inner ']' -->
      <block start="/(^|\s)(\[)\s+((TEMPORARY)|(Temporary)|(INCLUDES)|(Includes)|(NOUPDATE)|(NoUpdate)|(DEPENDS)|(Depends)|(NOTFILE)|(NotFile)|(ALWAYS)|(Always)|(LEAVES)|(Leaves)|(NOCARE)|(NOTIME)|(NoCare)|(MATCH)|(Match)|(ECHO)|(EXIT)|(Echo)|(Exit)|(GLOB)|(Glob)|(echo)|(exit))((\s)|($))?=/" end="/(^|\s)((\])|(;))/" scheme="jamBracketArgs"
             region00="StructSymbol" region02="def:PairStart" region03="Keyword"
             region10="StructSymbol" region13="def:PairEnd" region14="Error"/>
      <block start="/(^|\s)(\[)\s+([A-Za-z_][^\s\]]*)/" end="/(^|\s)((\])|(;))/" scheme="jamBracketArgs"
             region00="StructSymbol" region02="def:PairStart" region03="Rule"
             region10="StructSymbol" region13="def:PairEnd" region14="Error"/>
      <!-- a call whose rule name the block above cannot read: one that comes from a variable, as [ $(RULE) a ],
           from a quoted word, or from a name that does not open with a letter. The bracket is whole either way,
           and pairs as the two above do - jam invokes a rule here just the same -->
      <block start="/(^|\s)(\[)(\S)?!/" end="/(^|\s)((\])|(;))/" scheme="jamBracketArgs"
             region00="StructSymbol" region02="def:PairStart"
             region10="StructSymbol" region13="def:PairEnd" region14="Error"/>
   </scheme>

   <scheme name="jamGluedMarks">
      <!-- jam reads ( ) { } as tokens of their own, so punctuation glued to a word is part of that word.
           A block hides these from what it spans, so each scheme that needs them inherits this one. -->
      <!-- a closing bracket glued to what stands before it is a missing space -->
      <regexp match="/(^|\s)\s*((([^\s(#&quot;\\](\\\\)*)|([^\s(#&quot;][^\s(]*[^\s(\\](\\\\)*)|((\\\\)+))\))((\s)|($))?=/" region2="Error"/>
      <!-- a brace glued to anything else is a missing space; a leading '#' or quote exempts the token, and an
           odd run of backslashes escapes the brace -->
      <regexp match="/(^|\s)\s*(([\{\}][^\s]+)|([^\s#&quot;\\](\\\\)*[\{\}][^\s]*)|([^\s#&quot;][^\s]*[^\s\\](\\\\)*[\{\}][^\s]*)|((\\\\)+[\{\}][^\s]*))/" region2="Error"/>
   </scheme>

   <scheme name="jamfileVariables">
      <keywords region="Variable">
         <word name="OS"/>
         <word name="OSPLAT"/>
         <word name="MAC"/>
         <word name="NT"/>
