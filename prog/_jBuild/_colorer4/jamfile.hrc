<?xml version="1.0" encoding="Windows-1251"?>
<!DOCTYPE hrc SYSTEM "../hrc.dtd">
<?xml-stylesheet type="text/xsl" href="../hrc.xsl"?>
<!-- Jam / Jamfile syntax for Colorer 4ever (Far 2.0).

     Install:
      1. copy this file to <Far2>/Plugins/Colorer/hrc/base/jamfile.hrc
      2. paste the <type/> block from colorer.hrc.add into
         <Far2>/Plugins/Colorer/hrc/colorer.hrc, unless it already has a
         <type ... name="jamfile">
      3. Colorer usually reloads by itself; if not, F11 -> colorer -> C Configure -> Reload, or restart Far

     For Far3 / FarColorer use ../_colorer5 instead; that version registers itself and needs no edit to a central file.

     The predefined-variable list is maintained by hand - jam has no declaration site to generate it from.
     The keyword list and the built-in rule list are not guesswork: they are jam's own tables,
     jam_src/jamgramtab.h and jam_src/builtins.c. -->
<hrc>

<!-- the base this scheme draws on: regions.hrc numbers the regions it assigns to and
     defines.hrc carries the Comment helper it borrows. Named here as the sibling 4ever
     schemes name theirs, although a colorer.hrc has already included both. -->
<include name="regions.hrc"/>
<include name="defines.hrc"/>

<!-- Colour slots. Each name below is only an alias, so a colour can be changed in one place here;
     the value has to be a region the HRD already defines, since no HRD ships with this file.
        dVar2 light green     dTag grey     dString3 light purple
     Still free in the stock palette: dURL (light red), dRegister (light blue), dParam2 (dark green).
     dPath is the same light red but is already spoken for - jamActions paints an action's ':path' line with it.
     dVar is light cyan and would read as a comment. -->
<define name="jamBuiltinVar" value="dVar2"/>    <!-- predefined build variables -->
<define name="jamRule"       value="dTag"/>     <!-- rule and action names the project defines -->
<define name="jamBuiltinRule" value="dKeyword"/> <!-- rules jam itself provides: part of the language -->
<define name="jamOtherVar"   value="dString3"/> <!-- everything else, i.e. local variables -->

<scheme name="jamBracketCall">
   <!-- a word opening with '[[' is a placeholder and no call: jam splits on whitespace, so
        '[[PATH_TO_ROOT]]' is one argument. This match starts at the space, ahead of the blocks -->
   <regexp match="/(^|\s)(\[\[[^\s]*)/" region2="dString2"/>
   <!-- [ RuleName args ] wherever the form appears, one scheme, defined before the jamBracketArgs that
        inherits it - a forward inherit fails - or a nested call would end the outer at the inner ']' -->
   <block start="/(^|\s)(\[)\s+((TEMPORARY)|(Temporary)|(INCLUDES)|(Includes)|(NOUPDATE)|(NoUpdate)|(DEPENDS)|(Depends)|(NOTFILE)|(NotFile)|(ALWAYS)|(Always)|(LEAVES)|(Leaves)|(NOCARE)|(NOTIME)|(NoCare)|(MATCH)|(Match)|(ECHO)|(EXIT)|(Echo)|(Exit)|(GLOB)|(Glob)|(echo)|(exit))((\s)|($))?=/" end="/(^|\s)((\])|(;))/" scheme="jamBracketArgs"
          region00="dSymbol2" region02="dpOpenStruct" region03="jamBuiltinRule"
          region10="dSymbol2" region13="dpCloseStruct" region14="dError"/>
   <block start="/(^|\s)(\[)\s+([A-Za-z_][^\s\]]*)/" end="/(^|\s)((\])|(;))/" scheme="jamBracketArgs"
          region00="dSymbol2" region02="dpOpenStruct" region03="jamRule"
          region10="dSymbol2" region13="dpCloseStruct" region14="dError"/>
   <!-- a call whose rule name the block above cannot read: one that comes from a variable, as [ $(RULE) a ],
        from a quoted word, or from a name that does not open with a letter. The bracket is whole either way,
        and pairs as the two above do - jam invokes a rule here just the same -->
   <block start="/(^|\s)(\[)(\S)?!/" end="/(^|\s)((\])|(;))/" scheme="jamBracketArgs"
          region00="dSymbol2" region02="dpOpenStruct"
          region10="dSymbol2" region13="dpCloseStruct" region14="dError"/>
</scheme>

<scheme name="jamGluedMarks">
   <!-- jam reads ( ) { } as tokens of their own, so punctuation glued to a word is part of that word.
        A block hides these from what it spans, so each scheme that needs them inherits this one. -->
   <!-- a closing bracket glued to what stands before it is a missing space -->
   <regexp match="/(^|\s)\s*((([^\s(#&quot;\\](\\\\)*)|([^\s(#&quot;][^\s(]*[^\s(\\](\\\\)*)|((\\\\)+))\))((\s)|($))?=/" region2="dError"/>
   <!-- a brace glued to anything else is a missing space; a leading '#' or quote exempts the token, and an
        odd run of backslashes escapes the brace -->
   <regexp match="/(^|\s)\s*(([\{\}][^\s]+)|([^\s#&quot;\\](\\\\)*[\{\}][^\s]*)|([^\s#&quot;][^\s]*[^\s\\](\\\\)*[\{\}][^\s]*)|((\\\\)+[\{\}][^\s]*))/" region2="dError"/>
</scheme>

<scheme name="jamfileVariables">
   <keywords region="jamBuiltinVar">
      <word name="OS"/>
      <word name="OSPLAT"/>
      <word name="MAC"/>
