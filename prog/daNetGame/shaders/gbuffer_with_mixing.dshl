//| --------------------------------------- |
//| ONLY USE THIS FILE IN THE MIXING REGION |
//| --------------------------------------- |
include "gbuffer.dshl"
include "shader_global.dshl"
include "gbuffer_mixing_tex.dshl"

interval packed_gbuf_normals : no < 1, yes;


macro DYNAMIC_FILTER_FOR_MIXING(is_dynamic, declare_mixing_uav)
  if (packed_gbuf_normals == yes && !is_dynamic)
  {
    if (declare_mixing_uav)
    {
      INIT_GBUFFER_MIXING_UAV()
    }
    hlsl { #define FILTER_DYNAMIC 1 }

    hlsl(ps)
    {
      void filterDynamic(float2 tc)
      {
        float packedBits = packed_gbuf_1[uint2(tc)].z;
        uint extraBits = uint(packedBits * 1023.f + 0.5f);
        if ((extraBits & 1) == 1) discard;
      }
    }
  }
  else
  {
    hlsl(ps) { void filterDynamic(float2 tc) {} }
  }
endmacro

//Always include this macro after blend is set to avoid accidental errors
macro WRITE_GBUFFER_WITH_MIXING(blending, normal_blend, declare_mixing_uav)
  USE_PARTIAL_PACK_UNPACK_GBUFF(ps)
  if (compatibility_mode == compatibility_mode_on)
  {
    WRITE_GBUFFER_THIN()
    hlsl(ps)
    {
      #define isGbufferEmissive(screen_pos) false
      #define encode_gbuffer_alpha_cover_emission encode_gbuffer_alpha
      #define MATERIAL_UAV_VRS_PS_INPUT
      #define MATERIAL_UAV_VRS_ARGS 0, 0
    }
  }
  else
  {
    if(blending && normal_blend && packed_gbuf_normals == yes)
    {
      blend_adst[1] = 0;
      color_write[1] = rgba;
    }

    if (packed_gbuf_normals == yes && declare_mixing_uav)
    {
      INIT_GBUFFER_MIXING_UAV()
    }
    if (!blending && packed_gbuf_normals == yes)
    {
      if (hardware.dx12 && !hardware.scarlett) // VRS_SUPPORT
      {
        (ps) { mixing_depth_gbuf@tex2d = depth_gbuf; }
      }
      hlsl(ps) {
        #define UAV_5th_TARGET 1
        #if SUPPORTS_VRS
          #define MATERIAL_UAV_VRS_PS_INPUT HW_USE_READ_SHADING_RATE , uint coverage : SV_Coverage
          #define MATERIAL_UAV_VRS_ARGS shading_rate, coverage
        #endif
      }
    }
    else
    {
      hlsl(ps) { #define UAV_5th_TARGET 0 }
    }
    hlsl(ps){
      #ifndef MATERIAL_UAV_VRS_PS_INPUT
        #define MATERIAL_UAV_VRS_PS_INPUT
        #define MATERIAL_UAV_VRS_ARGS 0, 0
      #endif
      struct GBUFFER_OUTPUT
      {
        float4 albedo_ao : SV_Target0;
        float4 normal : SV_Target1;
        float4 smoothness_reflectance_metallTranslucency_shadow : SV_Target2;
        #ifdef MOTION_VECTORS_ENABLED
          float4 motion_reactive : SV_Target3;
        #endif
      };
      #if UAV_5th_TARGET
        #ifndef MIXING_UAV_DEPTH_TEST
          #define MIXING_UAV_DEPTH_TEST(z, scene_z) ((z) >= (scene_z))
        #endif
        // Under VRS we need manual depth testing for the UAV, to write the appropiate pixel in the 2x2 / 4x4 coarse grid
        void store_mixing_material(float4 pos, uint shading_rate, uint coverage, float4 normal_material)
        {
          #if SUPPORTS_VRS
            uint2 rate = GET_SHADING_RATE;
            BRANCH
            if (any(rate > 1))
            {
              uint2 base = uint2(pos.xy) & ~(rate - 1u);
              float2 dz = float2(ddx_fine(pos.z), ddy_fine(pos.z)) / float2(rate);
              uint bit = rate.x * rate.y - 1;
              for (uint y = 0; y < rate.y; ++y)
                for (uint x = 0; x < rate.x; ++x, --bit)
                {
                  uint2 fine = base + uint2(x, y);
                  float fineZ = pos.z + dot(dz, float2(fine) + 0.5 - pos.xy);
                  if ((coverage & (1u << bit)) && MIXING_UAV_DEPTH_TEST(fineZ, texelFetch(mixing_depth_gbuf, int2(fine), 0).r))
                    packed_gbuf_1[fine] = normal_material;
                }
              return;
            }
          #endif
          packed_gbuf_1[uint2(pos.xy)] = normal_material;
        }
      #endif
      GBUFFER_OUTPUT encode_gbuffer_raw(UnpackedGbuffer gbuf, float4 pos, uint shading_rate, uint coverage)
      {
        GBUFFER_OUTPUT ret;
        PackedGbuffer packedGbuf = pack_gbuffer(gbuf);
        ret.albedo_ao = packedGbuf.albedo_ao;
        ret.smoothness_reflectance_metallTranslucency_shadow = packedGbuf.smoothness_reflectance_metallTranslucency_shadow;
        #ifdef MOTION_VECTORS_ENABLED
          ret.motion_reactive = packedGbuf.motion_reactive;
        #endif
        ##if packed_gbuf_normals == yes
          ret.normal = float4(gbuf.normal * 0.5f + 0.5f, 0);
        ##else
          ret.normal = packedGbuf.normal_material;
        ##endif
        #if UAV_5th_TARGET
          store_mixing_material(pos, shading_rate, coverage, packedGbuf.normal_material);
        #endif
        return ret;
      }

      GBUFFER_OUTPUT encode_gbuffer_alpha_raw(UnpackedGbuffer gbuf, half alpha, half gbuf2_alpha)
      {
        GBUFFER_OUTPUT ret;
        PackedGbuffer packedGbuf = pack_gbuffer(gbuf);
        ret.albedo_ao = packedGbuf.albedo_ao;
        ret.smoothness_reflectance_metallTranslucency_shadow = packedGbuf.smoothness_reflectance_metallTranslucency_shadow;
        #ifdef MOTION_VECTORS_ENABLED
          ret.motion_reactive = packedGbuf.motion_reactive;
        #endif
        ret.normal = float4(gbuf.normal * 0.5f + 0.5f, alpha);
        ret.albedo_ao.w = alpha;
        ret.smoothness_reflectance_metallTranslucency_shadow.w = gbuf2_alpha;
        return ret;
      }

      GBUFFER_OUTPUT encode_gbuffer_alpha3_raw(UnpackedGbuffer gbuf, half3 alpha)
      {
        GBUFFER_OUTPUT ret;
        PackedGbuffer packedGbuf = pack_gbuffer(gbuf);
        ret.albedo_ao = packedGbuf.albedo_ao;
        ret.smoothness_reflectance_metallTranslucency_shadow = packedGbuf.smoothness_reflectance_metallTranslucency_shadow;
        #ifdef MOTION_VECTORS_ENABLED
          ret.motion_reactive = packedGbuf.motion_reactive;
        #endif
        ret.normal = float4(gbuf.normal * 0.5f + 0.5f, alpha.y);
        ret.albedo_ao.w = alpha.x;
        ret.smoothness_reflectance_metallTranslucency_shadow.w = alpha.z;
        return ret;
      }

      GBUFFER_OUTPUT encode_gbuffer_alpha_cover_emission_raw(UnpackedGbuffer gbuf, half alpha, uint surface_material)
      {
        if (!isEmissiveShader(surface_material))
          return encode_gbuffer_alpha_raw(gbuf, alpha, alpha);
        if (isNoLightEmissiveShader(surface_material))
          discard;
        const half SOLID_DECAL_MIN_ALPHA = 0.8;
        bool isSolid = alpha >= SOLID_DECAL_MIN_ALPHA;
        if (isSolid)
          init_metalness(gbuf, 0); // emission in this case, not metalness
        else
          init_albedo(gbuf, 0);
        return encode_gbuffer_alpha_raw(gbuf, alpha, isSolid ? 1 : 0);
      }

      ##if packed_gbuf_normals == yes
        uint unpackGbufferMaterial(half4 normal_material)
        {
          uint extra, material;
          unpackMaterialExtra(normal_material, extra, material);
          return material;
        }
        #define gbufferMaterial(screen_pos) unpackGbufferMaterial(packed_gbuf_1[uint2((screen_pos).xy)])
      ##else
        #define gbufferMaterial(screen_pos) SHADING_NORMAL
      ##endif
      #define isGbufferEmissive(screen_pos) isEmissiveShader(gbufferMaterial(screen_pos))
      #define encode_gbuffer_alpha(a,b,c,d) encode_gbuffer_alpha_raw(a, b, isGbufferEmissive(d) ? 0 : (b))
      #define encode_gbuffer_alpha3(a,b,c,d) encode_gbuffer_alpha3_raw(a, half3((b).xy, isGbufferEmissive(d) ? 0 : (b).z))
      #define encode_gbuffer_alpha_cover_emission(a,b,c,d) encode_gbuffer_alpha_cover_emission_raw(a, b, gbufferMaterial(d))
      #define encode_gbuffer(a,b,c) encode_gbuffer_raw(a, c, MATERIAL_UAV_VRS_ARGS)
    }
  }
endmacro