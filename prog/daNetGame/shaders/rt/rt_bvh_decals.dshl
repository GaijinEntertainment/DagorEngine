include "bvh_common_includes.dshl"
include "skinning_inc2.dshl"

int bvh_dynamic_decals_atlas_tex_slot;
int bvh_dynamic_decals_atlas_smp_slot;
int bvh_instance_data_buffer_cur_offset;
buffer bvh_instance_data_buffer;

macro INIT_BVH_DECALS(stage)
  (stage)
  {
    bvh_dynamic_decals_atlas_tex_slot@i1 = bvh_dynamic_decals_atlas_tex_slot;
    bvh_dynamic_decals_atlas_smp_slot@i1 = bvh_dynamic_decals_atlas_smp_slot;
    bvh_instance_data_buffer_cur_offset@i1 = bvh_instance_data_buffer_cur_offset;
  }
  if (small_sampled_buffers == no)
  {
    (stage) {
      instance_data_buffer@buf = bvh_instance_data_buffer hlsl { Buffer<float4> instance_data_buffer@buf; }
    }
  } else
  {
    (stage) {
      instance_data_buffer@buf = bvh_instance_data_buffer hlsl { StructuredBuffer<float4> instance_data_buffer@buf; }
    }
  }
endmacro

macro USE_BVH_DECALS(stage)
  hlsl(stage)
  {
    // Hard coded values, to not need to pass them in material parameter
    static const float tank_decals_smoothness = 0.4;
    static const float diffuse_to_decal = 0.01;
    float4 get_decal_depth_rcp__diff_mul__decal_smoothness()
    {
      return float4(0, 0, 1. / (diffuse_to_decal * diffuse_to_decal + 1e-6), tank_decals_smoothness);
    }

    #define vehicle_decals_atlas uniformBindlessTex2D(bvh_textures, bvh_dynamic_decals_atlas_tex_slot)
    #define vehicle_decals_atlas_samplerstate bvh_clamp_sampler

    static int instance_offset_for_decal = 0;
    #define INST_OFFSET_GETTER instance_offset_for_decal
    #define OFFSET_TO_INSTANCE_DATA (instance_offset_for_decal)
  }
  INIT_PER_INSTANCE_DATA(stage)
  hlsl(stage) {
    // Copy pasted from vehicle_decals.dshl, but mip level is an input parameter, to avoid derivates
    float GetInfluence(float influence)
    {
      float minAng80 = 0.174;
      float maxAng45 = 0.707;
      return saturate((influence - minAng80) / (maxAng45 - minAng80));
    }

    half apply_decals_impl(inout float3 diffuseColor, float3 model_pos, float3 model_normal, float mipLevel)
    {
      // Can't rely on daNetGameLibs directly, so copy pasted
      // #include "vehicle_decals.hlsli"
      const int DECALS_SIZE = 4;
      const int MAX_DECALS = 8;//one sided

      const uint MAX_DECALS_SIZE = MAX_DECALS * DECALS_SIZE;
      uint2 offset_count = get_offset_count_additional_data(AAD_DECALS_TYPE);

      half diffMul = saturate(luminance(diffuseColor.rgb) * get_decal_depth_rcp__diff_mul__decal_smoothness().z);
      float4 modelPos4 = float4(model_pos, 1);
      float underDecalEffect = 1;

      for (int i = 0, n = min(MAX_DECALS_SIZE, offset_count.y); i < n; i += DECALS_SIZE)
      {
        float2 uv;
        float4 depthProjection = get_additional_data_unsafe(offset_count, i + 0);
        float decDepth = dot(modelPos4, depthProjection);
        float decTexInfluence = GetInfluence(dot(model_normal, depthProjection.xyz));
        uv.x = dot(modelPos4, get_additional_data_unsafe(offset_count, i + 1));
        uv.y = dot(modelPos4, get_additional_data_unsafe(offset_count, i + 2));

        if (all(and(0.0 <= uv, uv <= 1.0)))
        {
          float4 uvOffsetScale = get_additional_data_unsafe(offset_count, i + 3);
          uv = uv * uvOffsetScale.zw + uvOffsetScale.xy;
          float4 decal = vehicle_decals_atlas.SampleLevel(vehicle_decals_atlas_samplerstate, uv, mipLevel);

          float decalEffect = decTexInfluence * (abs(decDepth) < 1) * decal.a;
          diffuseColor.rgb = lerp(diffuseColor.rgb, diffMul * decal.rgb, decalEffect);
          underDecalEffect *= (1-decalEffect);
        }
      }
      return saturate(underDecalEffect);
    }

    void apply_decals(float3 modelPos, float3 modelNorm, inout float3 diffuseColor, inout float smoothness, inout float metallness, float mipLevel)
    {
      float4 decalsColor = float4(diffuseColor.rgb, 1);
      decalsColor.a = apply_decals_impl(decalsColor.rgb, modelPos, modelNorm, mipLevel);
      diffuseColor.rgb = lerp(decalsColor.rgb, diffuseColor.rgb, decalsColor.a);
      smoothness = lerp(get_decal_depth_rcp__diff_mul__decal_smoothness().w, smoothness, decalsColor.a);
      metallness = lerp(0, metallness, decalsColor.a);
    }

    void apply_node_transformation_to_model(inout HitInfo hitInfo)
    {
      uint nodeId = hitInfo.packed_normal_w;
      uint2 tm_st_pos = get_offset_count_additional_data(AAD_MODEL_TM);
      const int POINT4_FOR_MATRIX = 3;
      uint tmOffset = tm_st_pos.y - nodeId * POINT4_FOR_MATRIX;
      float3x4 mat = float3x4(
        get_additional_data(tm_st_pos, tmOffset - 1),
        get_additional_data(tm_st_pos, tmOffset - 2),
        get_additional_data(tm_st_pos, tmOffset - 3)
      );

      hitInfo.modelPosition = mul(mat, float4(hitInfo.modelPosition, 1));
      hitInfo.modelNormal = mul(mat, float4(hitInfo.modelNormal, 0));
    }
  }
endmacro
