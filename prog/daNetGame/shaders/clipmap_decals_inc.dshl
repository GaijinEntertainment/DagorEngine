include "land_block_inc.dshl"
include "water_heightmap.dshl"
include "rendinst_heightmap_ofs.dshl"
include "vtex.dshl"
include "clipmap_decals_common.dshl"

int clipmap_decal_array_tex = 0;
interval clipmap_decal_array_tex: off<1, on;

texture clipmap_decal_diffuse_tex;
texture clipmap_decal_normal_tex;
int clipmap_decal_use_displacement_mask;
interval clipmap_decal_use_displacement_mask: no<1, yes;

float4 clipmap_decals_parameters; //microdetails, reflectance, ao, sizeScale
float clipmap_decals_displacement_falloff_radius;
interval clipmap_decals_displacement_falloff_radius: no<0, yes;

macro CLIPMAP_DECALS_COMMON()
  supports land_mesh_prepare_clipmap;

  if (lmesh_rendering_mode != rendering_clipmap || in_editor_assume == yes || use_editor_render)
  {
    dont_render;
  }

  if (clipmap_decal_array_tex == off)
  {
    (ps) {
      d_tex@tex2d = clipmap_decal_diffuse_tex;
      n_tex@tex2d = clipmap_decal_normal_tex;
    }
  }
  else
  {
    (ps) {
      d_tex@texArray = clipmap_decal_diffuse_tex;
      n_tex@texArray = clipmap_decal_normal_tex;
    }
  }
  INIT_GLOBAL_LINEAR_WRAP_SAMPLER(ps)
  hlsl(ps) {
    #define d_tex_samplerstate global_linear_wrap_sampler
    #define n_tex_samplerstate global_linear_wrap_sampler
  }
  USE_CLIPMAP_MRT_OUTPUT()

  // setup constants

  blend_src=sa; blend_dst=isa;
  blend_asrc=zero; blend_adst=isa;

  z_write=false;

  cull_mode = none;
  static int writemask = 0xf73f; // 0 target (diffuse), .rg 1 target (normals), .rgb 2 target (ao, reflectance, detail), 3 target (displacement)
  color_write = static writemask;

  USE_ATEST_1()

  hlsl {
    struct VsOutput
    {
      VS_OUT_POSITION(pos)
      float4 diffuseTexcoord : TEXCOORD0;
      float4 tangent : TEXCOORD1;
      float2 worldPosXZ : TEXCOORD2;
    ##if clipmap_decal_use_displacement_mask == yes
      float4 displacementMaskParams : TEXCOORD3;
    ##endif
    ##if clipmap_decals_displacement_falloff_radius == yes
      float2 vertexPos : TEXCOORD4;
    ##endif
    };
  }

  (vs) {
    decal_size_scale@f1 = (clipmap_decals_parameters.w);
    decal_params@buf : register(8) hlsl {
      Buffer<float4> decal_params@buf;
    }
  }

  USE_CLIPMAP_DECALS_DEFAULT_VERTEX_SHADING(vs, clipmap_decal_array_tex == on)
  hlsl(vs) {
    VsOutput landmesh_decal_clipmap_vs(uint vertexId : SV_VertexID)
    {
      DecalsVertexData data = clipmap_decals_default_vertex_shading(decal_params, vertexId, decal_size_scale);

      VsOutput output;
      output.pos.xy = mul(float4(data.worldPosXZ.x, 0, data.worldPosXZ.y, 1), globtm).xy;
      output.pos.zw = float2(0.5, 1.0);

      output.diffuseTexcoord.xyz = data.diffuseTexcoord;
      output.diffuseTexcoord.w = data.maxBaseLen;

      output.tangent = data.tangent;
      output.worldPosXZ = data.worldPosXZ;
      ##if clipmap_decal_use_displacement_mask == yes
        output.displacementMaskParams = data.displacementMaskParams;
      ##endif

      ##if clipmap_decals_displacement_falloff_radius == yes
        output.vertexPos = data.vertexPos;
      ##endif

      return output;
    }
  }


  hlsl(ps) {
    ##if clipmap_decal_array_tex == off
      #define getDecalTex(_tex, _tc) tex2D(_tex, _tc.xy)
    ##else
      #define getDecalTex(_tex, _tc) tex3D(_tex, _tc.xyz)
    ##endif
  }
endmacro