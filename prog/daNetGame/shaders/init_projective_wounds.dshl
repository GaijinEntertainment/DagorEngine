texture teared_wounds_decal;
texture wounds_decal_array;
texture burned_cloth;
texture burned_flesh;

float blood_wound_flesh_smoothness = 0.8;
float blood_wound_flesh_reflectance = 0.21;
float blood_wound_flesh_intensity_border = 0.2;
float blood_wound_flesh_edge_scale = 0.3;
float4 blood_wound_flesh_color_high_intensity = (0.007, 0, 0, 1);
float4 blood_wound_flesh_color_low_intensity = (0.002, 0, 0, 1);
float4 blood_wound_skin_flesh_color_high_intensity = (0.007, 0, 0, 1);
float4 blood_wound_skin_flesh_color_low_intensity = (0.002, 0, 0, 1);

// zw is the distance fade in center-relative squared uv radius
float4 blood_wound_angle_dist_fadeoff_range = (0.0, 0.9, 0.25, 0.15);

float blood_wound_dark_albedo_compensation_factor = 0.04;
float blood_wound_low_porosity_reflectance = 0.3;
float blood_wound_dry_edge_scale = 0.5;
float4 blood_wound_color_high_intensity = (0.05, 0, 0, 1);
float4 blood_wound_color_low_intensity = (0.3, 0.02, 0, 1);
float4 blood_wound_skin_color_high_intensity = (0.05, 0, 0, 1);
float4 blood_wound_skin_color_low_intensity = (0.3, 0.02, 0, 1);

float bloody_time = 0.25;
float wound_hole_cut_radius = 0.35;
float wound_hole_edge_reach = 1.5;
float wound_hole_splatter_cut_threshold = 0.85;
float wound_hole_vertex_cut_ratio = 0.5;
float blood_tex_discard_threshold = 0.85;
float sample_tex_inside_of = 0.9;
float blood_brightness = 2.0;
float blood_edge_fade_width = 0.0;
int debug_torn_wounds = 0;
interval debug_torn_wounds: off<1, coverage<2, distance<3, bands;

macro INIT_BURNED_DIFFUSE_FUNCTION()
  (ps) {
    burned_cloth@tex2d = burned_cloth;
    burned_flesh@tex2d = burned_flesh;
  }
endmacro

macro MODEL_SPACE_PROJECTION()

hlsl(ps)
{
  float4 sample_texture_from_pos(Texture2D tex, SamplerState tex_samplerstate, float3 frag_pos, float3 frag_norm, float scale)
  {
    float3 n = pow4_vec4(frag_norm.xyzz).xyz;

    n /= n.x + n.y + n.z;
    frag_pos = frag_pos * scale + 0.5;
    return  tex2D(tex, frag_pos.xy) * n.z +
            tex2D(tex, frag_pos.xz) * n.y +
            tex2D(tex, frag_pos.zy) * n.x;
  }
  float4 sample_texture_from_pos(Texture2DArray tex, SamplerState tex_samplerstate, int slice, float3 frag_pos, float3 frag_norm, float scale)
  {
    float3 n = pow4_vec4(frag_norm.xyzz).xyz;

    n /= n.x + n.y + n.z;
    frag_pos = frag_pos * scale + 0.5;
    return  tex3D(tex, float3(frag_pos.xy, slice)) * n.z +
            tex3D(tex, float3(frag_pos.xz, slice)) * n.y +
            tex3D(tex, float3(frag_pos.zy, slice)) * n.x;
  }

  float4 sample_texture_from_pos_regular(Texture2DArray tex, SamplerState tex_samplerstate, int slice, float2 frag_pos)
  {
    return  tex3D(tex, float3(frag_pos.xy, slice));
  }
}
endmacro

macro SET_BURNED_DIFFUSE_FUNCTION(samplerName)
  hlsl(vs) {
    float getBurnedEffect() //can't get additional_data in frag shader
    {
      uint2 dataOffsetCount = get_offset_count_additional_data(AAD_HUMAN_COMBINED_PARAMS);
      return get_optional_additional_data(dataOffsetCount, 0, float4(0,0,0,0)).w;
    }
  }

  hlsl(ps) {
    void apply_burning_effect(inout float3 diffuse, inout float smoothness, float3 frag_pos, float3 frag_norm, float burning_effect, bool flesh)
    {
      float3 burned_color = flesh ? // compile time branch
          sample_texture_from_pos(burned_flesh, samplerName, frag_pos, frag_norm, 3).rgb :
          sample_texture_from_pos(burned_cloth, samplerName, frag_pos, frag_norm, 3).rgb;

      diffuse = lerp(diffuse, burned_color, burning_effect);
      smoothness *= 1 - burning_effect;
    }
  }
endmacro

macro INIT_PROJECTIVE_WOUNDS()
(ps) {
  teared_wounds_decal@tex2d = teared_wounds_decal;
  wounds_decal_array@texArray = wounds_decal_array;
  time_wetness_bloody_time@f2 = (time_phase(0,0), bloody_time, 0,0);
  blood_tex_discard_threshold@f1 = blood_tex_discard_threshold;
  sample_tex_inside_of@f1 = sample_tex_inside_of;
  blood_brightness@f1 = blood_brightness;
  blood_edge_fade_inv_width@f1 = (1.0 / max(blood_edge_fade_width, 1e-4));
  wound_hole_cut_radius@f1 = wound_hole_cut_radius;
  wound_hole_edge_reach@f1 = max(wound_hole_edge_reach, 1.0001);
  wound_hole_splatter_cut_threshold@f1 = wound_hole_splatter_cut_threshold;
}

(vs) {
  wounds_time@f1 = time_phase(0,0);
  wound_hole_cut_radius@f1 = wound_hole_cut_radius;
  wound_hole_edge_reach@f1 = max(wound_hole_edge_reach, 1.0001);
  wound_hole_vertex_cut_ratio@f1 = wound_hole_vertex_cut_ratio;
}

local float blood_wound_flesh_begin_thickness = 1.0 - blood_wound_flesh_intensity_border;
local float blood_wound_flesh_edge_thickness_width = blood_wound_flesh_begin_thickness*blood_wound_flesh_edge_scale;

(ps) {
  blood_wound_flesh_smoothness@f1 = blood_wound_flesh_smoothness;
  blood_wound_flesh_reflectance@f1 = blood_wound_flesh_reflectance;
  blood_wound_flesh_begin_thickness@f1 = blood_wound_flesh_begin_thickness;
  blood_wound_flesh_edge_scale@f1 = blood_wound_flesh_edge_scale;
  blood_wound_flesh_edge_thickness_width@f1 = blood_wound_flesh_edge_thickness_width;
  blood_wound_flesh_edge_ending_thickness@f1 = (blood_wound_flesh_begin_thickness + blood_wound_flesh_edge_thickness_width);
  blood_wound_flesh_color_high_intensity@f3 = blood_wound_flesh_color_high_intensity.xyz;
  blood_wound_flesh_color_low_intensity@f3 = blood_wound_flesh_color_low_intensity.xyz;
  blood_wound_skin_flesh_color_high_intensity@f3 = blood_wound_skin_flesh_color_high_intensity.xyz;
  blood_wound_skin_flesh_color_low_intensity@f3 = blood_wound_skin_flesh_color_low_intensity.xyz;
  one_minus_flesh_puddle_begin_thickness@f1 = (1.0 - blood_wound_flesh_begin_thickness);

  blood_wound_dark_albedo_compensation_factor@f1 = blood_wound_dark_albedo_compensation_factor;
  blood_wound_low_porosity_reflectance@f1 = blood_wound_low_porosity_reflectance;
  blood_wound_dry_edge_scale@f1 = blood_wound_dry_edge_scale;
  blood_wound_color_high_intensity@f3 = blood_wound_color_high_intensity.xyz;
  blood_wound_color_low_intensity@f3 = blood_wound_color_low_intensity.xyz;
  blood_wound_skin_color_high_intensity@f3 = blood_wound_skin_color_high_intensity.xyz;
  blood_wound_skin_color_low_intensity@f3 = blood_wound_skin_color_low_intensity.xyz;

  blood_wound_angle_fadeoff_range@f2 = blood_wound_angle_dist_fadeoff_range.xy;
  blood_wound_dist_fadeoff_range@f2 = blood_wound_angle_dist_fadeoff_range.zw;
}

endmacro

macro INIT_BURNED_DIFFUSE_FUNCTION_BLOCK()
if (compatibility_mode != compatibility_mode_on)
{
  INIT_BURNED_DIFFUSE_FUNCTION()
}
endmacro

macro INIT_PROJECTIVE_WOUNDS_BLOCK()
if (compatibility_mode != compatibility_mode_on)
{
  INIT_PROJECTIVE_WOUNDS()
}
endmacro

macro INIT_BURNED_DIFFUSE_FUNCTION_SHADER()
if (!(compatibility_mode != compatibility_mode_on))
{
  INIT_BURNED_DIFFUSE_FUNCTION()
}
endmacro

macro INIT_PROJECTIVE_WOUNDS_SHADER()
if (!(compatibility_mode != compatibility_mode_on))
{
  INIT_PROJECTIVE_WOUNDS()
}
endmacro
