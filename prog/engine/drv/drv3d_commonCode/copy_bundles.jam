include $(Root)/prog/_jBuild/defaults.jam ;

if $(UseStreamline) = yes {
  local ArchDir_x86_64 = x64 ;
  local ArchDir_arm64 = arm64 ;
  local ArchDir_arm64ec = arm64ec ;

  local Dlls_dlss    = sl.dlss.dll nvngx_dlss.dll ;
  local Dlls_dlss_d  = sl.dlss_d.dll nvngx_dlssd.dll ;
  local Dlls_dlss_g  = sl.dlss_g.dll nvngx_dlssg.dll ;
  local Dlls_dlss_nr = sl.dlss_nr.dll nvngx_dlssnr.dll ;
  local Dlls_reflex  = sl.reflex.dll ;

  # the interposer needs common and pcl whichever feature loads on top of it
  local dlls = sl.interposer.dll sl.common.dll sl.pcl.dll ;

  for feature in $(StreamlineFeatures) {
    if ! $(Dlls_$(feature)) { exit unknown StreamlineFeatures value\: $(feature) ; }
    dlls += $(Dlls_$(feature)) ;
  }

  local SdkBinDir = $(StreamlineSdkPath)/bin/$(ArchDir_$(PlatformArch)) ;
  for dll in $(dlls) { BundleCopy += @$(SdkBinDir)/$(dll) $(dll) ; }
}
