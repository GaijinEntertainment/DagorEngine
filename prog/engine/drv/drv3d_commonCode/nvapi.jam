if $(Platform) in windows && $(PlatformArch) in x86 x86_64 arm64 arm64ec {
  local NvApiDir = $(_DEVTOOL)/nvapi-$(NvApiVer) ;
  if ! [ GLOB $(NvApiDir) : * ] { exit "FATAL: \"$(NvApiDir)\" not found!  Please, update DEVTOOLS" ; }

  local lib_x86    = $(NvApiDir)/x86/nvapi.lib ;
  local lib_x86_64 = $(NvApiDir)/amd64/nvapi64.lib ;
  local lib_arm64  = $(NvApiDir)/aarch64/nvapia64.lib ;
  local lib_arm64ec = $(NvApiDir)/arm64ec/nvapia64ec.lib ;
  if [ GLOB $(lib_$(PlatformArch):D) : $(lib_$(PlatformArch):D=) ] {
    AddIncludes += $(NvApiDir) ;
    CPPopt += -DHAS_NVAPI ;
    if $(Location:B) = drv3d_commonCode { AddLibs += $(lib_$(PlatformArch)) ; }
  }
}
