PlatformArch_windows ?= x86_64 ;

Root    ?= ../../../.. ;
Location = prog/engine/drv/drv3d_DX12 ;
StrictCompile = yes ;

TargetType  = lib ;
Target      = engine/drv/drv3d_DX12.lib ;

include $(Root)/prog/_jBuild/defaults.jam ;

if ! $(Platform) in windows xboxOne scarlett {
  exit FATAL\: $(Platform) is not supported platform for drv3d_DX12 ;
}

if ! $(PlatformArch) in x86_64 arm64 {
  exit FATAL\: $(PlatformArch) is not supported platform architecture for drv3d_DX12 ;
}

local 1stPartyDir = $(Root)/prog/1stPartyLibs ;
local 3rdPartyDir = $(Root)/prog/3rdPartyLibs ;

Sources =
  init_d3di.cpp
  dx12.cpp
  device.cpp
  device_queue.cpp
  swapchain.cpp
  format_store.cpp
  device_context.cpp
  query_manager.cpp
  synced_command_store.cpp
  mirrored_ring_memory.cpp
  shader.cpp
  texture.cpp
  pipeline.cpp
  pipeline_cache.cpp
  bindless.cpp
  d3d12_error_handling.cpp
  resource_memory_heap.cpp
  resource_manager/heap_components.cpp
  resource_manager/buffer_components.cpp
  resource_manager/buffer_components_heap.cpp
  resource_manager/buffer_components_heap_state.cpp
  resource_manager/buffer_components_heap_suballocator.cpp
  resource_manager/rtx_components.cpp
  resource_manager/host_shared_components.cpp
  resource_update_buffer.cpp
  pipeline/blk_cache.cpp
  ray_trace_pipeline.cpp
;

AddIncludes +=
  $(Root)/prog/engine/sharedInclude
  $(Root)/prog/engine/drv/drv3d_commonCode
  $(Root)/prog/engine/drv/drv3d_DX12
  $(Root)/prog/engine/shaders
  $(Root)/prog/dagorInclude
  $(3rdPartyDir)/imgui
;

CPPopt = -DINSIDE_DRIVER ;
# do not include stuff that depends on wrl, including wrl is a mess
CPPopt += -DD3DX12_NO_STATE_OBJECT_HELPERS ;
CPPopt += -FId3d_config.h ;

if $(Config) != rel {
  Sources +=
    debug/debug_types.cpp
    debug/frame_command_logger.cpp
    resource_usage_debugger.cpp
  ;
}

if $(Platform) in windows {
  Sources +=
    platform_pc.cpp
    debug/global_state.cpp
    debug/device_state_pc.cpp
    debug/gpu_postmortem_dagor_trace.cpp
    debug/gpu_postmortem_microsoft_dred.cpp
    debug/pipeline_resource_reporter.cpp
    shader_library.cpp

    debug/gpu_capture/generic_tools.cpp
    debug/gpu_capture/legacy_pix.cpp
    debug/gpu_capture/nsight.cpp
    debug/gpu_capture/render_doc.cpp
  ;

  # for GPU crash dump sending
  AddIncludes += $(1stPartyDir)/jsoncpp/include ;
  UseProgLibs += 1stPartyLibs/jsoncpp ;

  local AgsSdkDir = $(_DEVTOOL)/AGS.SDK.$(AgsSdkVer) ;
  if [ GLOB $(AgsSdkDir) : * ] && $(PlatformArch) = x86_64 {
    AddIncludes += $(AgsSdkDir)/inc ;
    AddLibs +=
      $(AgsSdkDir)/lib/amd_ags_x64.lib
      delayimp.lib
      -delayload:amd_ags_x64.dll
    ;
    CPPopt += -DHAS_AGS ;
    Sources +=
      debug/amd_ags_init.cpp
      debug/gpu_capture/radeon_gpu_profiler.cpp
      debug/gpu_postmortem_ags_trace.cpp
    ;
  }

  local AftermathSdkDir = $(_DEVTOOL)/aftermath-$(AftermathSdkVer) ;
  if [ GLOB $(AftermathSdkDir) : * ] {
    AddIncludes += $(AftermathSdkDir)/include ;
    CPPopt += -DHAS_AFTERMATH ;
    Sources +=
      debug/gpu_postmortem_nvidia_aftermath.cpp
    ;
  }

  local NvapiDir = $(_DEVTOOL)/nvapi-$(NvApiVer) ;
  if [ GLOB $(NvapiDir) : * ] && $(PlatformArch) != arm64 {
    AddIncludes += $(NvapiDir) ;
    # nvapiXXX.lib is added to AddLibs throughd drv3d_commonCode
    CPPopt += -DHAS_NVAPI ;
  }

  local WinPixEventRuntimeDir = $(3rdPartyDir)/winpixeventruntime ;
  if [ GLOB $(WinPixEventRuntimeDir) : * ] && $(Config) != rel {
    local ArchName = x64 ;
    if $(PlatformArch) = arm64 {
      ArchName = ARM64 ;
    }

    AddIncludes += $(WinPixEventRuntimeDir)/Include/WinPixEventRuntime ;
    AddLibs +=
      $(WinPixEventRuntimeDir)/bin/$(ArchName)/WinPixEventRuntime.lib
      delayimp.lib
      -delayload:WinPixEventRuntime.dll
    ;
    CPPopt += -DUSE_PIX -DPIX_USE_GPU_MARKERS_V2 ;
    Sources += debug/gpu_capture/pix.cpp ;
  }
} else {
  CPPopt += /wd4062 ; # enumerator 'XXX' in switch of enum 'YYY' is not handled
  if $(Config) != rel {
    AddLibs += PIXEvt.lib ;
    CPPopt += -DUSE_PIX ;
  }
  if $(Platform) = xboxOne {
    AddLibs += d3d12_x.lib xg_x.lib ;
  } else {
    AddLibs += d3d12_xs.lib xg_xs.lib ;
    Sources += shader_library.cpp ;
  }
  Sources += platform_xbox.cpp ;
}

# Upscalers: each has a stub implementation for the platforms without its SDK.
if $(Platform)-$(PlatformArch) = windows-x86_64 {
  local FidelityFXSDKDir = $(_DEVTOOL)/FidelityFX-SDK-$(FidelityFXVer) ;

  if ! [ GLOB $(FidelityFXSDKDir) : * ] { exit FATAL\: \"$(FidelityFXSDKDir)\" not found!  Please, update DEVTOOLS ; }

  AddIncludes +=
    $(FidelityFXSDKDir)/Kits/FidelityFX
    $(FidelityFXSDKDir)/Kits/FidelityFX/api/include
    $(FidelityFXSDKDir)/Kits/FidelityFX/framegeneration/include
    $(FidelityFXSDKDir)/Kits/FidelityFX/upscalers/include
  ;
  Sources +=
    amdFsrD3D12_windows.cpp
    fsr_wrapper.cpp
   ;
} else if $(Platform) in xboxOne scarlett {
  AddIncludes += $(3rdPartyDir)/fsr3.1.3_xbox/include ;
  Sources +=
    amdFsrD3D12_xbox.cpp
    fsr_wrapper.cpp
  ;
} else {
  Sources += fsr_wrapper_stub.cpp ;
}

if $(Platform)-$(PlatformArch) = windows-x86_64 && $(XessEnabled) = yes && [ GLOB $(3rdPartyDir)/xess_sdk : * ] {
  Target = $(Target:S=~xess.lib) ;
  Sources += xess_wrapper.cpp ;
} else {
  Sources += xess_wrapper_stub.cpp ;
}

# The Agility SDK provides d3d12.h and has to precede the Windows SDK on the command line,
# hence pre_opt. Keep this after every source was added, it binds the current $(Sources).
if $(Platform) in windows {
  local AgilitySdkDir = $(_DEVTOOL)/Agility.SDK.$(AgilitySdkVer) ;

  if ! [ GLOB $(AgilitySdkDir) : * ] { exit FATAL\: \"$(AgilitySdkDir)\" not found!  Please, update DEVTOOLS ; }

  pre_opt on $(Sources) = -I$(AgilitySdkDir)/include ;

  AddIncludes += $(AgilitySdkDir)/include/d3dx12 ;
}

UseProgLibs +=
  engine/drv/drv3d_commonCode
  engine/shaders
;

include $(Root)/prog/_jBuild/build.jam ;
