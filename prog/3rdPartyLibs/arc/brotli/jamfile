Root    ?= ../../../.. ;
Location = prog/3rdPartyLibs/arc/brotli ;

TargetType  = lib ;
Target      = 3rdPartyLibs/arc/brotli.lib ;

AddIncludes =
  $(Root)/prog/3rdPartyLibs/arc/brotli/common
  $(Root)/prog/3rdPartyLibs/arc/brotli/include
;

include $(Root)/prog/_jBuild/defaults.jam ;

local AllSrcFolder_C =
  enc
  dec
  common
;

AutoscanBuildLists $(AllSrcFolder_C) : *.c       : Sources ;

# constraint: a binary that links system OpenSSL loads the system brotli, so it must not export ours
if $(Platform) = linux && brotli in $(ExcludeStaticLibSymbols) { AddLibs += --exclude-libs,$(Target:D=) ; }

include $(Root)/prog/_jBuild/build.jam ;
