        var a = ubyte4(1u, 2u, 3u, 4u)
        t |> equal(a[0], uint8(1))
        t |> equal(a[1], uint8(2))
        t |> equal(a[2], uint8(3))
        t |> equal(a[3], uint8(4))
        a[3] = uint8(9)
        t |> equal(a[3], uint8(9))
    }
    t |> run("swizzle") @(t : T?) {
        var a = ubyte4(1u, 2u, 3u, 4u)
        t |> equal(a.x, uint8(1))
        t |> equal(a.w, uint8(4))
        t |> success(a.wzyx == ubyte4(4u, 3u, 2u, 1u), "reverse read")
        t |> success(a.xy == ubyte2(1u, 2u), "pair read")
        a.w = uint8(9)
        t |> equal(a.w, uint8(9))
        a.xy = ubyte2(7u, 8u)
        t |> equal(a.x, uint8(7))
        t |> equal(a.y, uint8(8))
    }
    t |> run("s-namespace swizzle") @(t : T?) {
        var a = ubyte4(1u, 2u, 3u, 4u)
        t |> equal(a.s3, uint8(4))
        t |> success(a.s30 == ubyte2(4u, 1u), "pair reorder")
        a.s0 = uint8(9)
        t |> equal(a.s0, uint8(9))
    }
