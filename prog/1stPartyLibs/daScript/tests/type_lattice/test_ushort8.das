    }
    t |> run("shift right") @(t : T?) {
        let a = ushort8(200u, 203u, 206u, 209u, 212u, 215u, 218u, 221u)
        t |> success(a >> 2 == ushort8(50u, 50u, 51u, 52u, 53u, 53u, 54u, 55u), "logical shift")
