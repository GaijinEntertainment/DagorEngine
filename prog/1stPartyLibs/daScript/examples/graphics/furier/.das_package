options gen2
require daslib/daspkg

[export]
def package() {
    package_name("furier")
    package_author("borisbat")
    package_description("Fourier epicycles — OpenGL viz + Dear ImGui controls, the ImGui-in-wasm examples showcase")
}

[export]
def release() {
    // The source lives one level up (shared examples/graphics tree); dasImgui is in-tree,
    // discovered from the compiled require chain at release time — no deps to declare.
    // dashv is skipped on wasm (the harness ?dashv-guards live_api), so a single source
    // serves desktop live-reload and wasm64.
    release_main("../furier_opengl_imgui_example.das")
}
