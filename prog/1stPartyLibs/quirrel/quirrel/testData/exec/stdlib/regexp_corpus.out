/^abc/ on 'abcdef' -> 0..3
/abc$/ on 'abcz' -> NOMATCH
/a.c/ on 'axc' -> 0..3
/[abc]+/ on 'zzabcabx' -> 2..7
/[^abc]+/ on 'abcXYZabc' -> 3..6
/[a-z]+/ on 'ABCdefGHI' -> 3..6
/[0-9]{2,4}/ on 'ab12345cd' -> 2..6
/\w+/ on '  foo_bar123!! ' -> 2..12
/\d+/ on 'abc007xyz' -> 3..6
/\s+/ on 'ab   cd' -> 2..5
/a*/ on 'aaab' -> 0..3
/a*/ on 'bbb' -> 0..0
/a+/ on 'baaab' -> 1..4
/a?b/ on 'b' -> 0..1
/a{3}/ on 'aaaaa' -> 0..3
/a{2,3}/ on 'aaaaa' -> 0..3
/ab{0,2}c/ on 'ac' -> 0..2
/(a)(b)(c)/ on 'abc' -> 0..3;0..1;1..2;2..3
/(a(b)c)/ on 'abc' -> 0..3;0..3;1..2
/(?:abc)+/ on 'abcabc' -> 0..6
/(a*)(b+)/ on 'xxbb' -> 2..4;2..2;2..4
/(a)?b/ on 'b' -> 0..1;0..0
/abc|abd/ on 'abd' -> 0..3
/(a|ab)/ on 'ab' -> 0..1;0..1
/(foo|foobar)/ on 'foobar' -> 0..3;0..3
/x(a*)c|xb/ on 'xb' -> 0..2;0..0
/(a*)c|(b)/ on 'xb' -> 1..2;0..0;1..2
/(ab)|(cd)|(ef)/ on 'cd' -> 0..2;0..0;0..2;0..0
/(ab|a)*bc/ on 'abc' -> 0..3;0..1
/\bfoo\b/ on 'foo!bar' -> 0..3
/\Bfoo/ on 'abfoo' -> 2..5
/(ab)+/ on 'ababab' -> 0..6;4..6
/(a)+(b)/ on 'aab' -> 0..3;1..2;2..3
/(?:a)+(b)/ on 'aab' -> 0..3;2..3
/(ab)+(cd)/ on 'ababcd' -> 0..6;2..4;4..6
/^$/ on '' -> 0..0
/a?/ on '' -> 0..0
/a*$/ on 'bbb' -> 3..3
/\m()/ on '(a(b)c)d' -> 0..7
/\m()/ on 'x(a)b' -> 1..4
/\m()/ on '(unbalanced' -> NOMATCH
/\a+/ on '12abcXY!!' -> 2..7
/\l+/ on 'ABCdefGHI' -> 3..6
/\u+/ on 'abcDEFghi' -> 3..6
/\p+/ on 'ab!?.,cd' -> 2..6
/\x+/ on 'zzDEADbeefGG' -> 2..10
